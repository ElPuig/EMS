<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_cfgs" model="product.template">
            <field name="name">Tasa CFGS</field>
            <field name="default_code">tasa_cfgs</field>
            <field name="categ_id" ref="ems_category_academic"/>
            
            <field name="type">service</field>
            
            <field name="list_price">360.0</field>
            <field name="ems_subject_unit_cost">65.0</field>
            
            <field name="is_generic" eval="True"/>
            <field name="ems_is_enrollment_fee" eval="True"/>
            
            <field name="ems_level_ids" eval="[(4, ref('ems.level_cfgs'))]"/> 
            
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
        </record>
    </data>
</odoo>