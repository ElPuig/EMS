<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_google_welcome_employee" model="mail.template">
            <field name="name">Google Workspace - Welcome credentials (staff)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Your corporate account @elpuig.xeill.net</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.private_email }}</field>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333;">
                    <p>Hello <t t-out="object.name or ''"/>,</p>
                    <p>Your school corporate account has been created to access Google Workspace
                       (email, Drive, Classroom...) and the services that use this account.</p>
                    <table style="border-collapse:collapse;margin:16px 0;">
                        <tr>
                            <td style="padding:6px 10px;border:1px solid #ddd;"><strong>Username (email)</strong></td>
                            <td style="padding:6px 10px;border:1px solid #ddd;"><t t-out="ctx.get('gw_email') or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding:6px 10px;border:1px solid #ddd;"><strong>Temporary password</strong></td>
                            <td style="padding:6px 10px;border:1px solid #ddd;"><t t-out="ctx.get('gw_password') or ''"/></td>
                        </tr>
                    </table>
                    <p style="color:#b00;"><strong>Important:</strong> for security reasons, you will be
                       required to change the password on your first login.</p>
                    <p>You can sign in at <a href="https://mail.google.com/a/elpuig.xeill.net/">mail.google.com</a>.</p>
                    <p>Best regards,<br/>School Secretariat</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
