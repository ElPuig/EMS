<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Issue #835: the FCT certificate, with its circuit. noupdate: the centre configures types
         and circuits from the UI (Academic management > Configuration > Certificates), and no
         upgrade must revert that. -->
    <data noupdate="1">
        <record id="certificate_type_fct" model="ems.certificate.type">
            <field name="name">FCT (Formació en Centres de Treball)</field>
            <field name="kind">fct</field>
            <field name="description">Certifies the hours of workplace training (FCT) you did at a company. Fill in your details; the company's are optional: the centre completes them.</field>
            <field name="requires_annex" eval="True"/>
            <field name="level_ids" eval="[(6, 0, [ref('ems.level_cfgm'), ref('ems.level_cfgs')])]"/>
        </record>

        <!-- Each step a record of its own, with an XML id, so its name is translated (an inline
             child would have none). -->
        <record id="certificate_step_fct_complete" model="ems.certificate.type.step">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">10</field>
            <field name="name">Complete the workplace training</field>
            <field name="role_id" ref="ems.role_vetcoord"/>
            <field name="action">complete</field>
        </record>
        <record id="certificate_step_fct_issue" model="ems.certificate.type.step">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">20</field>
            <field name="name">Issue the certificate</field>
            <field name="role_id" ref="ems.role_secretary"/>
            <field name="action">issue</field>
        </record>
        <record id="certificate_step_fct_approve" model="ems.certificate.type.step">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">30</field>
            <field name="name">Approve the certificate</field>
            <field name="role_id" ref="ems.role_director"/>
            <field name="action">approve</field>
        </record>
    </data>
</odoo>
