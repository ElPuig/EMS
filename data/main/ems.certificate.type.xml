<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Issue #835: the FCT certificate, with its circuit. noupdate: the centre configures types
         and circuits from the UI (Academic management > Configuration > Certificates), and no
         upgrade must revert that. -->
    <data noupdate="1">
        <record id="certificate_type_fct" model="ems.certificate.type">
            <field name="name">FCT (Formació en Centres de Treball)</field>
            <field name="description">Certifies the hours of workplace training (FCT) you did at a company. Fill in your details and as much information about the company and the training as you can; the centre completes the rest.</field>
            <field name="level_ids" eval="[(6, 0, [ref('ems.level_cfgm'), ref('ems.level_cfgs')])]"/>
        </record>

        <!-- The agreement: anyone taking part may attach it (the applicant, if they keep a copy, or
             the centre), and its pages are appended to the certificate. -->
        <record id="certificate_document_fct_agreement" model="ems.certificate.type.document">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">10</field>
            <field name="name">FCT agreement</field>
            <field name="append_to_certificate" eval="True"/>
        </record>

        <!-- Ticked once its document exists: the type refuses requiring documentation with none
             listed (_check_documents), and a clean install creates the type first. -->
        <record id="certificate_type_fct" model="ems.certificate.type">
            <field name="requires_documents" eval="True"/>
        </record>

        <!-- Each step a record of its own, with an XML id, so its name is translated (an inline
             child would have none). -->
        <record id="certificate_step_fct_complete" model="ems.certificate.type.step">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">10</field>
            <field name="name">Complete the workplace training</field>
            <field name="role_ids" eval="[(6, 0, [ref('ems.role_vetcoord'), ref('ems.role_secretary_technician')])]"/>
            <field name="action">complete</field>
        </record>
        <record id="certificate_step_fct_issue" model="ems.certificate.type.step">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">20</field>
            <field name="name">Issue the certificate</field>
            <field name="role_ids" eval="[(6, 0, [ref('ems.role_secretary')])]"/>
            <field name="action">issue</field>
        </record>
        <record id="certificate_step_fct_approve" model="ems.certificate.type.step">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">30</field>
            <field name="name">Approve the certificate</field>
            <field name="role_ids" eval="[(6, 0, [ref('ems.role_director')])]"/>
            <field name="action">approve</field>
        </record>

        <!-- Issue #851: what the FCT certificate needs besides the student's details, and its text.
             The company, the period and the hours are required by the coordinator's step. -->
        <record id="certificate_field_fct_school_year" model="ems.certificate.type.field">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">10</field>
            <field name="name">School year of the training</field>
            <field name="key">school_year</field>
            <field name="field_type">school_year</field>
            <field name="applicant_input">required</field>
        </record>
        <record id="certificate_field_fct_company" model="ems.certificate.type.field">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">20</field>
            <field name="name">Collaborating company</field>
            <field name="key">company</field>
            <field name="field_type">company</field>
            <field name="applicant_input">optional</field>
            <field name="required_step_id" ref="certificate_step_fct_complete"/>
        </record>
        <record id="certificate_field_fct_start" model="ems.certificate.type.field">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">30</field>
            <field name="name">Start date</field>
            <field name="key">start</field>
            <field name="field_type">date</field>
            <field name="applicant_input">optional</field>
            <field name="required_step_id" ref="certificate_step_fct_complete"/>
        </record>
        <record id="certificate_field_fct_end" model="ems.certificate.type.field">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">40</field>
            <field name="name">End date</field>
            <field name="key">end</field>
            <field name="field_type">date</field>
            <field name="applicant_input">optional</field>
            <field name="required_step_id" ref="certificate_step_fct_complete"/>
        </record>
        <record id="certificate_field_fct_hours" model="ems.certificate.type.field">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">50</field>
            <field name="name">Hours</field>
            <field name="key">hours</field>
            <field name="field_type">integer</field>
            <field name="applicant_input">optional</field>
            <field name="required_step_id" ref="certificate_step_fct_complete"/>
        </record>
        <record id="certificate_field_fct_agreement" model="ems.certificate.type.field">
            <field name="type_id" ref="certificate_type_fct"/>
            <field name="sequence">60</field>
            <field name="name">Agreement registration number (sBID)</field>
            <field name="key">agreement</field>
            <field name="field_type">char</field>
            <field name="applicant_input">optional</field>
        </record>

        <!-- Written once its details exist: the type refuses a text with keys it does not have
             (_check_certificate_text). -->
        <record id="certificate_type_fct" model="ems.certificate.type">
            <field name="certificate_text">That {name}, with identity document {document}, a student of {study}, did {hours} hours of workplace training (FCT) in the school year {school_year} at the company {company}[, with VAT number {company_vat}], from {start} to {end}.

Source: the training agreement[ registered in sBID with number {agreement}], a copy of which is attached.</field>
        </record>
    </data>
</odoo>
