<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated activity type to identify (and sibling-close) the secretary
             tasks generated when a student/family comments on their enrollment.
             'ems_task_assignment' lists the type under Academic Management >
             Configuration > Task Assignment, where the centre picks its recipients.
             NOTE: this file is noupdate="1", so the flag only lands on a fresh
             install; existing databases get it from migrations/18.0.0.20.1. -->
        <record model="mail.activity.type" id="mail_activity_enrollment_comment">
            <field name="name">Review enrollment comment</field>
            <field name="category">default</field>
            <field name="res_model">sale.order</field>
            <field name="icon">fa-comments-o</field>
            <field name="ems_task_assignment" eval="True"/>
        </record>

        <!-- Dedicated activity type for student document review, so the systray
             shows a meaningful type instead of the generic "To Do". -->
        <record model="mail.activity.type" id="mail_activity_student_document_review">
            <field name="name">Review student document</field>
            <field name="category">default</field>
            <field name="res_model">ems.student.document</field>
            <field name="icon">fa-file-text-o</field>
            <field name="ems_task_assignment" eval="True"/>
        </record>

        <!-- Dedicated activity type for the Head of Studies to-do generated when a
             teacher requests an attendance correction. -->
        <record model="mail.activity.type" id="mail_activity_attendance_correction">
            <field name="name">Review attendance correction request</field>
            <field name="category">default</field>
            <field name="res_model">ems.attendance_correction</field>
            <field name="icon">fa-clock-o</field>
        </record>
    </data>
</odoo>
