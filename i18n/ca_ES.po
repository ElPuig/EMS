#. module: ems
#: model:mail.template,body_html:ems.mail_strike_escalation
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Dear coexistence coordinator,\n"
"                        </p>\n"
"                        <p>\n"
"                            This is an automated email: a student has reached a strike count that requires your attention:\n"
"                            </p><ul>\n"
"                                <li><strong>Student:</strong> <span t-field=\"object.student_id\"/></li>\n"
"                                <li><strong>Total strikes:</strong> <span t-field=\"object.strike_count\"/></li>\n"
"                                <li><strong>Latest strike date and time:</strong> <span t-field=\"object.date\"/></li>\n"
"                                <li><strong>Issued by:</strong> <span t-field=\"object.teacher_id\"/></li>\n"
"                                <li><strong>Latest reason:</strong> <span t-field=\"object.reason_id\"/></li>\n"
"                            </ul>\n"
"                        \n"
"                        <p>You can review the full history under Coexistence &gt; Strikes.</p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Benvolgut/da coordinador/a de convivència,\n"
"                        </p>\n"
"                        <p>\n"
"                            Aquest és un correu automàtic: un alumne ha arribat a un recompte de strikes que requereix la vostra atenció:\n"
"                            </p><ul>\n"
"                                <li><strong>Alumne:</strong> <span t-field=\"object.student_id\"/></li>\n"
"                                <li><strong>Total de strikes:</strong> <span t-field=\"object.strike_count\"/></li>\n"
"                                <li><strong>Data i hora de l'últim strike:</strong> <span t-field=\"object.date\"/></li>\n"
"                                <li><strong>Posat per:</strong> <span t-field=\"object.teacher_id\"/></li>\n"
"                                <li><strong>Últim motiu:</strong> <span t-field=\"object.reason_id\"/></li>\n"
"                            </ul>\n"
"                        \n"
"                        <p>Podeu consultar l'historial complet a Convivència &gt; Strikes.</p>\n"
"                        <p>\n"
"                            Salutacions cordials,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

