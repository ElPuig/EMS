#. module: ems
#: model:mail.template,body_html:ems.mail_template_google_welcome_employee
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333;\">\n"
"                    <p>Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"                    <p>Your school corporate account has been created to access Google Workspace\n"
"                       (email, Drive, Classroom...) and the services that use this account.</p>\n"
"                    <table style=\"border-collapse:collapse;margin:16px 0;\">\n"
"                        <tr>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><strong>Username (email)</strong></td>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><t t-out=\"ctx.get('gw_email') or ''\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><strong>Temporary password</strong></td>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><t t-out=\"ctx.get('gw_password') or ''\"/></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <p style=\"color:#b00;\"><strong>Important:</strong> for security reasons, you will be\n"
"                       required to change the password on your first login.</p>\n"
"                    <p>You can sign in at <a href=\"https://mail.google.com/a/elpuig.xeill.net/\">mail.google.com</a>.</p>\n"
"                    <p>You can also access the school management platform (EMS) at\n"
"                       <a t-att-href=\"object.get_base_url()\"><t t-out=\"object.get_base_url()\"/></a>:\n"
