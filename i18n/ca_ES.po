#. module: ems
#: model:mail.template,body_html:ems.mail_template_google_welcome
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333;\">\n"
"                    <p>Hello <t t-out=\"object.firstname or object.name or ''\"/>,</p>\n"
"                    <p>Your school corporate account has been created to access Google Workspace\n"
"                       (email, Drive, Classroom...) and the services that use this account.</p>\n"
"                    <table style=\"border-collapse:collapse;margin:16px 0;\">\n"
"                        <tr>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><strong>Username (email)</strong></td>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><t t-out=\"ctx.get('gw_email') or ''\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><strong>Temporary password</strong></td>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><t t-out=\"ctx.get('gw_password') or ''\"/></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <p style=\"color:#b00;\"><strong>Important:</strong> for security reasons, you will be\n"
"                       required to change the password on your first login.</p>\n"
"                    <p>You can sign in at <a href=\"https://mail.google.com/a/elpuig.xeill.net/\">mail.google.com</a>.</p>\n"
"                    <p>Best regards,<br/>School Secretariat</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333;\">\n"
"                    <p>Hola <t t-out=\"object.firstname or object.name or ''\"/>,</p>\n"
"                    <p>El teu compte corporatiu del centre ha estat creat per accedir a Google Workspace\n"
"                       (correu electrònic, Drive, Classroom...) i els serveis que utilitzen aquest compte.</p>\n"
"                    <table style=\"border-collapse:collapse;margin:16px 0;\">\n"
"                        <tr>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><strong>Usuari (email)</strong></td>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><t t-out=\"ctx.get('gw_email') or ''\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><strong>Contrasenya temporal</strong></td>\n"
"                            <td style=\"padding:6px 10px;border:1px solid #ddd;\"><t t-out=\"ctx.get('gw_password') or ''\"/></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <p style=\"color:#b00;\"><strong>Important:</strong> per motius de seguretat, hauràs\n"
"                       de canviar la contrasenya en el primer inici de sessió.</p>\n"
"                    <p>Pots iniciar sessió a <a href=\"https://mail.google.com/a/elpuig.xeill.net/\">mail.google.com</a>.</p>\n"
"                    <p>Salutacions,<br/>Secretaria del centre</p>\n"
"                </div>\n"
"            "

