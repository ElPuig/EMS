#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_resolution_published
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <t t-set=\"call\" t-value=\"object.resolution_id.call_id\"/>\n"
"                        <t t-set=\"claims_deadline\" t-value=\"call.claims_deadline or object.resolution_id.group_mobility_id.claims_deadline\"/>\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <p>\n"
"                            A new list has been published: <strong t-out=\"object.resolution_id.name\"/>.\n"
"                        </p>\n"
"                        <p t-if=\"object.resolution_id.notes\" t-out=\"object.resolution_id.notes\"/>\n"
"                        <t t-if=\"object.result == 'excluded'\">\n"
"                            <p>Your application has been excluded.</p>\n"
"                            <p t-if=\"object.exclusion_reason\">Reason: <t t-out=\"object.exclusion_reason\"/></p>\n"
"                        </t>\n"
"                        <p t-elif=\"object.result == 'admitted' and object.audience == 'staff'\">\n"
"                            Your application has been admitted. The panel will now rate your mobility plan.\n"
"                        </p>\n"
"                        <p t-elif=\"object.result == 'admitted'\">\n"
"                            Your application has been admitted. The Erasmus team will call you to the personal interview.\n"
"                        </p>\n"
"                        <t t-else=\"\">\n"
"                            <p t-if=\"object.audience == 'staff'\">\n"
"                                Position <strong t-out=\"object.rank\"/>, <strong t-out=\"object._ems_format_score()\"/> points.\n"
"                            </p>\n"
"                            <p t-elif=\"object.group_registration_id\">\n"
"                                Position <strong t-out=\"object.rank\"/>, record average <strong t-out=\"object._ems_format_score()\"/>.\n"
"                            </p>\n"
"                            <p t-else=\"\">\n"
"                                Modality <strong t-out=\"object.modality_id.name\"/>: position <strong t-out=\"object.rank\"/>,\n"
"                                <strong t-out=\"object._ems_format_score()\"/> points.\n"
"                            </p>\n"
"                            <t t-if=\"object.resolution_id.kind == 'provisional'\">\n"
"                                <p t-if=\"object.result == 'selected'\">With this provisional result you would get a place.</p>\n"
"                                <p t-elif=\"object.result == 'reserve'\">With this provisional result you would be on the reserve list.</p>\n"
"                                <p t-else=\"\">With this provisional result you do not reach the minimum score.</p>\n"
"                                <p>\n"
"                                    If you disagree, you can claim from the Erasmus+ page of the EMS portal\n"
"                                    <t t-if=\"claims_deadline\">until <strong t-out=\"object.env['ems.erasmus.call']._ems_local_format(claims_deadline)\"/></t>.\n"
"                                </p>\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <p t-if=\"object.application_id.state == 'accepted'\">\n"
"                                    You keep the place you have already accepted.\n"
"                                </p>\n"
"                                <p t-elif=\"object.application_id._ems_offer_expired()\">\n"
"                                    You did not answer the place offer in time earlier: this list does not change it.\n"
"                                </p>\n"
"                                <p t-elif=\"object.application_id.state == 'renounced'\">\n"
"                                    You renounced the place earlier: this list does not change it.\n"
"                                </p>\n"
"                                <t t-elif=\"object.result == 'selected'\">\n"
"                                    <p>\n"
"                                        You have been <strong>selected</strong>. Accept or renounce the place <t t-out=\"object._ems_mail_place()\"/>\n"
"                                        before <strong t-out=\"call._ems_local_format(call.acceptance_deadline)\"/>:\n"
"                                        without an answer by then, the place is considered renounced.\n"
"                                    </p>\n"
"                                    <t t-set=\"offer_destinations\" t-value=\"object.audience == 'student' and object.modality_id and object.modality_id._ems_offer_destinations()\"/>\n"
"                                    <p t-if=\"offer_destinations\">\n"
"                                        Destinations and places of the modality (you will choose one by turns, by your position):\n"
"                                    </p>\n"
"                                    <ul t-if=\"offer_destinations\">\n"
"                                        <li t-foreach=\"offer_destinations\" t-as=\"destination\" t-out=\"destination._ems_offer_label()\"/>\n"
"                                    </ul>\n"
"                                </t>\n"
"                                <p t-elif=\"object.result == 'reserve'\">\n"
"                                    You are on the <strong>reserve list</strong>, number <strong t-out=\"object._ems_reserve_number()\"/><t t-if=\"object.audience == 'student'\"> of <t t-out=\"object.modality_id.name\"/></t>.\n"
"                                    If a place becomes free, we will offer it to you by email.\n"
"                                </p>\n"
"                                <p t-else=\"\">You have not been selected: you do not reach the minimum score.</p>\n"
"                            </t>\n"
"                        </t>\n"
"                        <p t-if=\"object.resolution_id.kind in ('definitive', 'rectification')\" t-out=\"object.resolution_id._ems_appeal_notice()\"/>\n"
"                        <p t-if=\"object.result in ('excluded', 'admitted')\">\n"
"                            You can see the published list <t t-out=\"object._ems_mail_place()\"/>:\n"
"                            <a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            You can see the detail of your score and the published list <t t-out=\"object._ems_mail_place()\"/>:\n"
"                            <a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>.\n"
"                        </p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <t t-set=\"call\" t-value=\"object.resolution_id.call_id\"/>\n"
"                        <t t-set=\"claims_deadline\" t-value=\"call.claims_deadline or object.resolution_id.group_mobility_id.claims_deadline\"/>\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <p>\n"
"                            Se ha publicado una nueva lista: <strong t-out=\"object.resolution_id.name\"/>.\n"
"                        </p>\n"
"                        <p t-if=\"object.resolution_id.notes\" t-out=\"object.resolution_id.notes\"/>\n"
"                        <t t-if=\"object.result == 'excluded'\">\n"
"                            <p>Tu solicitud ha quedado excluida.</p>\n"
"                            <p t-if=\"object.exclusion_reason\">Motivo: <t t-out=\"object.exclusion_reason\"/></p>\n"
"                        </t>\n"
"                        <p t-elif=\"object.result == 'admitted' and object.audience == 'staff'\">\n"
"                            Tu solicitud ha sido admitida. Ahora la comisión valorará tu plan de movilidad.\n"
"                        </p>\n"
"                        <p t-elif=\"object.result == 'admitted'\">\n"
"                            Tu solicitud ha sido admitida. El equipo Erasmus te convocará a la entrevista personal.\n"
"                        </p>\n"
"                        <t t-else=\"\">\n"
"                            <p t-if=\"object.audience == 'staff'\">\n"
"                                Posición <strong t-out=\"object.rank\"/>, <strong t-out=\"object._ems_format_score()\"/> puntos.\n"
"                            </p>\n"
"                            <p t-elif=\"object.group_registration_id\">\n"
"                                Posición <strong t-out=\"object.rank\"/>, nota media del expediente <strong t-out=\"object._ems_format_score()\"/>.\n"
"                            </p>\n"
"                            <p t-else=\"\">\n"
"                                Modalidad <strong t-out=\"object.modality_id.name\"/>: posición <strong t-out=\"object.rank\"/>,\n"
"                                <strong t-out=\"object._ems_format_score()\"/> puntos.\n"
"                            </p>\n"
"                            <t t-if=\"object.resolution_id.kind == 'provisional'\">\n"
"                                <p t-if=\"object.result == 'selected'\">Con este resultado provisional obtendrías plaza.</p>\n"
"                                <p t-elif=\"object.result == 'reserve'\">Con este resultado provisional quedarías en reserva.</p>\n"
"                                <p t-else=\"\">Con este resultado provisional no llegas a la puntuación mínima.</p>\n"
"                                <p>\n"
"                                    Si no estás de acuerdo, puedes reclamar desde la página Erasmus+ del portal de EMS\n"
"                                    <t t-if=\"claims_deadline\">hasta el <strong t-out=\"object.env['ems.erasmus.call']._ems_local_format(claims_deadline)\"/></t>.\n"
"                                </p>\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <p t-if=\"object.application_id.state == 'accepted'\">\n"
"                                    Mantienes la plaza que ya has aceptado.\n"
"                                </p>\n"
"                                <p t-elif=\"object.application_id._ems_offer_expired()\">\n"
"                                    No respondiste a tiempo a la oferta de plaza: esta lista no lo cambia.\n"
"                                </p>\n"
"                                <p t-elif=\"object.application_id.state == 'renounced'\">\n"
"                                    Ya habías renunciado a la plaza: esta lista no lo cambia.\n"
"                                </p>\n"
"                                <t t-elif=\"object.result == 'selected'\">\n"
"                                    <p>\n"
"                                    Tienes <strong>plaza</strong>. Acepta la plaza o renuncia a ella <t t-out=\"object._ems_mail_place()\"/>\n"
"                                    antes del <strong t-out=\"call._ems_local_format(call.acceptance_deadline)\"/>:\n"
"                                    si no respondes dentro del plazo, se considera que renuncias.\n"
"                                </p>\n"
"                                    <t t-set=\"offer_destinations\" t-value=\"object.audience == 'student' and object.modality_id and object.modality_id._ems_offer_destinations()\"/>\n"
"                                    <p t-if=\"offer_destinations\">\n"
"                                        Destinos y plazas de la modalidad (elegirás uno por turnos, según tu posición):\n"
"                                    </p>\n"
"                                    <ul t-if=\"offer_destinations\">\n"
"                                        <li t-foreach=\"offer_destinations\" t-as=\"destination\" t-out=\"destination._ems_offer_label()\"/>\n"
"                                    </ul>\n"
"                                </t>\n"
"                                <p t-elif=\"object.result == 'reserve'\">\n"
"                                    Estás en la <strong>lista de reserva</strong>, número <strong t-out=\"object._ems_reserve_number()\"/><t t-if=\"object.audience == 'student'\"> de <t t-out=\"object.modality_id.name\"/></t>.\n"
"                                    Si queda libre alguna plaza, te la ofreceremos por correo.\n"
"                                </p>\n"
"                                <p t-else=\"\">No has obtenido plaza: no llegas a la puntuación mínima.</p>\n"
"                            </t>\n"
"                        </t>\n"
"                        <p t-if=\"object.resolution_id.kind in ('definitive', 'rectification')\" t-out=\"object.resolution_id._ems_appeal_notice()\"/>\n"
"                        <p t-if=\"object.result in ('excluded', 'admitted')\">\n"
"                            Puedes consultar la lista publicada <t t-out=\"object._ems_mail_place()\"/>:\n"
"                            <a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Puedes consultar el detalle de tu puntuación y la lista publicada <t t-out=\"object._ems_mail_place()\"/>:\n"
"                            <a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>.\n"
"                        </p>\n"
"                        <p>\n"
"                            Un saludo,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_offer
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <p t-if=\"object.modality_id and object.call_id.audience == 'student'\">\n"
"                            A place of the modality <strong t-out=\"object.modality_id.name\"/> of\n"
"                            <strong t-out=\"object.call_id.name\"/> has become free and it is offered to you.\n"
"                        </p>\n"
"                        <t t-if=\"object.modality_id and object.call_id.audience == 'student'\">\n"
"                            <t t-set=\"offer_destinations\" t-value=\"object.modality_id._ems_offer_destinations()\"/>\n"
"                            <p t-if=\"offer_destinations\">\n"
"                                Destinations and places of the modality (you will choose one by turns, by your position):\n"
"                            </p>\n"
"                            <ul t-if=\"offer_destinations\">\n"
"                                <li t-foreach=\"offer_destinations\" t-as=\"destination\" t-out=\"destination._ems_offer_label()\"/>\n"
"                            </ul>\n"
"                        </t>\n"
"                        <p t-else=\"\">\n"
"                            A place of <strong t-out=\"object.call_id.name\"/> has become free and it is offered to you.\n"
"                        </p>\n"
"                        <p>\n"
"                            Accept or renounce it <t t-out=\"object._ems_mail_place()\"/>\n"
"                            (<a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>)\n"
"                            before <strong t-out=\"object.call_id._ems_local_format(object.deadline)\"/>.\n"
"                            Without an answer by then, the place is considered renounced.\n"
"                        </p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <p t-if=\"object.modality_id and object.call_id.audience == 'student'\">\n"
"                            Ha quedado libre una plaza de la modalidad <strong t-out=\"object.modality_id.name\"/> de\n"
"                            <strong t-out=\"object.call_id.name\"/> y te la ofrecemos.\n"
"                        </p>\n"
"                        <t t-if=\"object.modality_id and object.call_id.audience == 'student'\">\n"
"                            <t t-set=\"offer_destinations\" t-value=\"object.modality_id._ems_offer_destinations()\"/>\n"
"                            <p t-if=\"offer_destinations\">\n"
"                                Destinos y plazas de la modalidad (elegirás uno por turnos, según tu posición):\n"
"                            </p>\n"
"                            <ul t-if=\"offer_destinations\">\n"
"                                <li t-foreach=\"offer_destinations\" t-as=\"destination\" t-out=\"destination._ems_offer_label()\"/>\n"
"                            </ul>\n"
"                        </t>\n"
"                        <p t-else=\"\">\n"
"                            Ha quedado libre una plaza de <strong t-out=\"object.call_id.name\"/> y te la ofrecemos.\n"
"                        </p>\n"
"                        <p>\n"
"                            Acéptala o renuncia a ella <t t-out=\"object._ems_mail_place()\"/>\n"
"                            (<a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>)\n"
"                            antes del <strong t-out=\"object.call_id._ems_local_format(object.deadline)\"/>.\n"
"                            Si no respondes dentro del plazo, se considera que renuncias.\n"
"                        </p>\n"
"                        <p>\n"
"                            Un saludo,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_offer_answer
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <t t-set=\"call\" t-value=\"object.call_id\"/>\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <t t-if=\"object.state == 'accepted'\">\n"
"                            <p>\n"
"                                We have received your acceptance of the place<t t-if=\"object.modality_id and call.audience == 'student'\"> of\n"
"                                <strong t-out=\"object.modality_id.name\"/></t> of <strong t-out=\"call.name\"/>\n"
"                                on <strong t-out=\"call._ems_local_format(object.answer_date)\"/>.\n"
"                            </p>\n"
"                            <p>\n"
"                                You will find the next steps <t t-out=\"object._ems_mail_place()\"/> (<a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>). We will email you whenever you have to do something.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p t-elif=\"object.state == 'renounced'\">\n"
"                            We have received your renunciation of the place<t t-if=\"object.modality_id and call.audience == 'student'\"> of\n"
"                            <strong t-out=\"object.modality_id.name\"/></t> of <strong t-out=\"call.name\"/>\n"
"                            on <strong t-out=\"call._ems_local_format(object.answer_date)\"/>.\n"
"                            The place will be offered to the next person on the reserve list.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            The deadline to answer the place offered to you in <strong t-out=\"call.name\"/>\n"
"                            (<t t-out=\"call._ems_local_format(object.deadline)\"/>) has passed without an answer.\n"
"                            As the call says, the place is considered renounced and will be offered to the next\n"
"                            person on the reserve list.\n"
"                        </p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <t t-set=\"call\" t-value=\"object.call_id\"/>\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <t t-if=\"object.state == 'accepted'\">\n"
"                            <p>\n"
"                                Hemos recibido tu aceptación de la plaza<t t-if=\"object.modality_id and call.audience == 'student'\"> de\n"
"                                <strong t-out=\"object.modality_id.name\"/></t> de <strong t-out=\"call.name\"/>\n"
"                                el <strong t-out=\"call._ems_local_format(object.answer_date)\"/>.\n"
"                            </p>\n"
"                            <p>\n"
"                                Encontrarás los siguientes pasos <t t-out=\"object._ems_mail_place()\"/> (<a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>).\n"
"                                Te escribiremos cada vez que tengas que hacer algo.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p t-elif=\"object.state == 'renounced'\">\n"
"                            Hemos recibido tu renuncia a la plaza<t t-if=\"object.modality_id and call.audience == 'student'\"> de\n"
"                            <strong t-out=\"object.modality_id.name\"/></t> de <strong t-out=\"call.name\"/>\n"
"                            el <strong t-out=\"call._ems_local_format(object.answer_date)\"/>.\n"
"                            La plaza se ofrecerá a la siguiente persona de la lista de reserva.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Ha terminado el plazo para responder a la plaza que se te ofrecía en <strong t-out=\"call.name\"/>\n"
"                            (<t t-out=\"call._ems_local_format(object.deadline)\"/>) sin que respondieras.\n"
"                            Tal como dicen las bases, se considera que renuncias y la plaza se ofrecerá a la\n"
"                            siguiente persona de la lista de reserva.\n"
"                        </p>\n"
"                        <p>\n"
"                            Un saludo,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

