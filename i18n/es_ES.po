#. module: ems
#: model_terms:ir.ui.view,arch_db:ems.view_student_import_wizard_form
msgid ""
"<strong>Import Process:</strong><br/>\n"
"                                This wizard will import student data from an Excel file exported from Esfera (SAGA system).\n"
"                                The import will:<br/>\n"
"                                • Create new student records for students not yet in the system (identified by RALC)<br/>\n"
"                                • Update existing student records if found by RALC identifier<br/>\n"
"                                • Create family contacts for tutors/guardians<br/>\n"
"                                • Link family members to students using relationship types<br/>\n"
"                                • Deduce family relationships from comments (mother, father, guardian, etc.)<br/>\n"
"                                <br/>\n"
"                                Select an Excel file below and click \"Import students\" to proceed."
msgstr ""
"<strong>Proceso de importación:</strong><br/>\n"
"                                Este asistente importará datos de alumnos desde un archivo Excel exportado desde Esfera (sistema SAGA).\n"
"                                La importación:<br/>\n"
"                                • Creará nuevos registros de alumnos para aquellos que aún no están en el sistema (identificados por RALC)<br/>\n"
"                                • Actualizará los registros existentes si se encuentran por el identificador RALC<br/>\n"
"                                • Creará contactos familiares para tutores/responsables<br/>\n"
"                                • Vinculará los miembros de la familia con los alumnos mediante tipos de relación<br/>\n"
"                                • Deducirá las relaciones familiares a partir de los comentarios (madre, padre, tutor, etc.)<br/>\n"
"                                <br/>\n"
"                                Seleccione un archivo Excel a continuación y haga clic en \"Importar alumnos\" para continuar."

