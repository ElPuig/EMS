"                        </p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <p>\n"
"                            Tu propuesta para la movilidad Erasmus+ (<strong t-out=\"object.call_id.name\"/>) no\n"
"                            se ha validado, por este motivo:\n"
"                        </p>\n"
"                        <p style=\"white-space: pre-line;\" t-out=\"object.decision_note\"/>\n"
