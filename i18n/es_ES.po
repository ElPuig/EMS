"                        <p t-if=\"object.turn_deadline\">\n"
"                            Choose it on the school portal\n"
"                            (<a t-attf-href=\"{{ object.get_base_url() }}/my/erasmus\">Erasmus+</a>)\n"
"                            before <strong t-out=\"object._ems_local_format(object.turn_deadline)\"/>.\n"
