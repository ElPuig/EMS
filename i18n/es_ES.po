#. module: ems
#: model:mail.template,body_html:ems.mail_attendance_issue_status
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Dear family,\n"
"                        </p>\n"
"                        <p>\n"
"                            This is an automated email, in order to inform you about an attendance status:\n"
"                            </p><ul>\n"
"                                <li><strong>Student:</strong> <span t-field=\"object.attendance_issue_student_id.student_id\"/></li>\n"
"                                <li><strong>Date:</strong> <span t-field=\"object.attendance_session_id.weekday\"/>, <t t-out=\"object.attendance_session_id.date\"/> from <span t-field=\"object.attendance_session_id.start_time\" t-options=\"{'widget': 'float_time'}\"/> to <span t-field=\"object.attendance_session_id.end_time\" t-options=\"{'widget': 'float_time'}\"/></li>                                \n"
"                                <li><strong>Session:</strong> <span t-field=\"object.attendance_session_id.attendance_schedule_id.attendance_template_id\"/></li>\n"
"                                <li><strong>Status:</strong> <span t-field=\"object.attendance_session_line\"/></li>\n"
"                                <t t-if=\"object.notes\">\n"
"                                    <li><strong>Details:</strong> <span t-field=\"object.notes\"/></li>\n"
"                                </t>\n"
"                            </ul>                        \n"
"                        \n"
"                        <p>If you need further information, you can contact with <t t-out=\"object.attendance_issue_student_id.attendance_issue_tutor_id.tutor_id.display_name\"/> just replaying to this email.</p>                                                \n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Estimada família,\n"
"                        </p>\n"
"                        <p>\n"
"                            Este es un correo automático, para informarles sobre una asistencia:\n"
"                            </p><ul>\n"
"                                <li><strong>Estudiante:</strong> <span t-field=\"object.attendance_issue_student_id.student_id\"/></li>\n"
"                                <li><strong>Fecha:</strong> <span t-field=\"object.attendance_session_id.weekday\"/>, <t t-out=\"object.attendance_session_id.date\"/> de <span t-field=\"object.attendance_session_id.start_time\" t-options=\"{'widget': 'float_time'}\"/> a <span t-field=\"object.attendance_session_id.end_time\" t-options=\"{'widget': 'float_time'}\"/></li>                                \n"
"                                <li><strong>Sesión:</strong> <span t-field=\"object.attendance_session_id.attendance_schedule_id.attendance_template_id\"/></li>\n"
"                                <li><strong>Estado:</strong> <span t-field=\"object.attendance_session_line\"/></li>\n"
"                                <t t-if=\"object.notes\">\n"
"                                    <li><strong>Detalles:</strong> <span t-field=\"object.notes\"/></li>\n"
"                                </t>\n"
"                            </ul>                        \n"
"                        \n"
"                        <p>Si necesita más información, puede contactar con <t t-out=\"object.attendance_issue_student_id.attendance_issue_tutor_id.tutor_id.display_name\"/> contestando a este correo.</p>                                                \n"
"                        <p>\n"
"                            Saludos cordiales,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.mail_attendance_issue_rectification
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Dear family,\n"
"                        </p>\n"
"                        <p>\n"
"                            We're sorry, but you recently received an email containing mistakes about some attendance statuses.\n"
"                        </p>\n"
"                        <p>\n"
"                            Again, we apologize, this is the correct attendance status:\n"
"                            </p><ul>\n"
"                                <li><strong>Student:</strong> <span t-field=\"object.attendance_issue_student_id.student_id\"/></li>\n"
"                                <li><strong>Date:</strong> <span t-field=\"object.attendance_session_id.weekday\"/>, <t t-out=\"object.attendance_session_id.date\"/> from <span t-field=\"object.attendance_session_id.start_time\" t-options=\"{'widget': 'float_time'}\"/> to <span t-field=\"object.attendance_session_id.end_time\" t-options=\"{'widget': 'float_time'}\"/></li>                                \n"
"                                <li><strong>Session:</strong> <span t-field=\"object.attendance_session_id.attendance_schedule_id.attendance_template_id\"/></li>\n"
"                                <li><strong>Status:</strong> <span t-field=\"object.attendance_session_line\"/></li>\n"
"                                <t t-if=\"object.notes\">\n"
"                                    <li><strong>Details:</strong> <span t-field=\"object.notes\"/></li>\n"
"                                </t>\n"
"                            </ul>                        \n"
"                        \n"
"                        <p>If you need further information, you can contact with <t t-out=\"object.attendance_issue_student_id.attendance_issue_tutor_id.tutor_id.display_name\"/> just replaying to this email.</p>                                                \n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Estimada família,\n"
"                        </p>\n"
"                        <p>\n"
"                            Les pedimos disculpas, pues recientmente han recibido un correo electrónico que contenía datos incorrectos sobre el estado de una asistencia.\n"
"                        </p>\n"
"                        <p>\n"
"                            De nuevo, nuestras disculpas; esta es la información correcta de la asistencia:\n"
"                            </p><ul>\n"
"                                <li><strong>Estudiante:</strong> <span t-field=\"object.attendance_issue_student_id.student_id\"/></li>\n"
"                                <li><strong>Fecha:</strong> <span t-field=\"object.attendance_session_id.weekday\"/>, <t t-out=\"object.attendance_session_id.date\"/> de <span t-field=\"object.attendance_session_id.start_time\" t-options=\"{'widget': 'float_time'}\"/> a <span t-field=\"object.attendance_session_id.end_time\" t-options=\"{'widget': 'float_time'}\"/></li>                                \n"
"                                <li><strong>Sesión:</strong> <span t-field=\"object.attendance_session_id.attendance_schedule_id.attendance_template_id\"/></li>\n"
"                                <li><strong>Estado:</strong> <span t-field=\"object.attendance_session_line\"/></li>\n"
"                                <t t-if=\"object.notes\">\n"
"                                    <li><strong>Detalles:</strong> <span t-field=\"object.notes\"/></li>\n"
"                                </t>\n"
"                            </ul>                        \n"
"                        \n"
"                        <p>Si necesita más información, puede contactar con <t t-out=\"object.attendance_issue_student_id.attendance_issue_tutor_id.tutor_id.display_name\"/> contestando a este correo.</p>                                                \n"
"                        <p>\n"
"                            Saludos cordiales,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.mail_attendance_issue_tutor
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Dear tutor,\n"
"                        </p>\n"
"                        <p>\n"
"                            This is your students daily report, in order to inform you about today's attendance statuses:\n"
"                            </p><ul>\n"
"                                <li>\n"
"                                    <strong>Date: </strong><span t-field=\"object.issue_date\"/>\n"
"                                    <ul>\n"
"                                        <t t-foreach=\"object.attendance_issue_student_ids\" t-as=\"student\">\n"
"                                            <li>\n"
"                                                <strong>Student: </strong><span t-field=\"student.student_id\"/>\n"
"                                                <ul>\n"
"                                                    <t t-foreach=\"student.attendance_issue_status_ids\" t-as=\"status\">\n"
"                                                        <li t-att-style=\"'text-decoration: line-through;' if status.rectified_by.id != False else ''\">\n"
"                                                            <span t-field=\"status.attendance_session_id.attendance_schedule_id.attendance_template_id\"/> | from <span t-field=\"status.attendance_session_id.start_time\" t-options=\"{'widget': 'float_time'}\"/> to <span t-field=\"status.attendance_session_id.end_time\" t-options=\"{'widget': 'float_time'}\"/> | <span t-field=\"status.attendance_session_line\"/>\n"
"                                                            <t t-if=\"status.notes\">\n"
"                                                                | <span t-field=\"status.notes\"/>\n"
"                                                            </t>\n"
"                                                        </li>                                                        \n"
"                                                    </t>\n"
"                                                </ul>\n"
"                                            </li>                                                                               \n"
"                                        </t>\n"
"                                    </ul>\n"
"                                </li>\n"
"                            </ul>\n"
"                                                \n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Estimado/a tutor/a,\n"
"                        </p>\n"
"                        <p>\n"
"                            Este es el reporte diario de sus alumnos, donde podrá consultar el estado de las asistencias de hoy:\n"
"                            </p><ul>\n"
"                                <li>\n"
"                                    <strong>Fecha: </strong><span t-field=\"object.issue_date\"/>\n"
"                                    <ul>\n"
"                                        <t t-foreach=\"object.attendance_issue_student_ids\" t-as=\"student\">\n"
"                                            <li>\n"
"                                                <strong>Estudiante: </strong><span t-field=\"student.student_id\"/>\n"
"                                                <ul>\n"
"                                                    <t t-foreach=\"student.attendance_issue_status_ids\" t-as=\"status\">\n"
"                                                        <li t-att-style=\"'text-decoration: line-through;' if status.rectified_by.id != False else ''\"> \n"
"                                                            <span t-field=\"status.attendance_session_id.attendance_schedule_id.attendance_template_id\"/> | de <span t-field=\"status.attendance_session_id.start_time\" t-options=\"{'widget': 'float_time'}\"/> a <span t-field=\"status.attendance_session_id.end_time\" t-options=\"{'widget': 'float_time'}\"/> | <span t-field=\"status.attendance_session_line\"/>\n"
"                                                            <t t-if=\"status.notes\">\n"
"                                                                | <span t-field=\"status.notes\"/>\n"
"                                                            </t>\n"
"                                                        </li>                                                        \n"
"                                                    </t>\n"
"                                                </ul>\n"
"                                            </li>                                                                               \n"
"                                        </t>\n"
"                                    </ul>\n"
"                                </li>\n"
"                            </ul>\n"
"                                                \n"
"                        <p>\n"
"                            Saludos cordiales,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

