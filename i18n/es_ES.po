#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_group_result
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <t t-if=\"object.result == 'selected'\">\n"
"                            <p>\n"
"                                You have been <strong>selected</strong> for the Erasmus+ group mobility\n"
"                                <strong t-out=\"object.group_mobility_id.name\"/>.\n"
"                            </p>\n"
"                            <p>\n"
"                                On the school portal (<a t-attf-href=\"{{ object.get_base_url() }}/my/erasmus\">Erasmus+</a>)\n"
"                                you will find the documents to hand in and their deadlines. If you cannot go, say so\n"
"                                there as soon as possible, so that the next person on the reserve list can take the place.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p t-elif=\"object.result == 'reserve'\">\n"
"                            You are on the <strong>reserve list</strong> of the Erasmus+ group mobility\n"
"                            <strong t-out=\"object.group_mobility_id.name\"/>, number <strong t-out=\"object.reserve_position\"/>.\n"
"                            If a place becomes free, we will contact you.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Your enrolment in the Erasmus+ group mobility <strong t-out=\"object.group_mobility_id.name\"/>\n"
"                            does not meet the requirements of the selection criteria published with the enrolment.\n"
"                            If you think this is a mistake, talk to the Erasmus team.\n"
"                        </p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <t t-if=\"object.result == 'selected'\">\n"
"                            <p>\n"
"                                Tienes <strong>plaza</strong> en la movilidad de grupo Erasmus+\n"
"                                <strong t-out=\"object.group_mobility_id.name\"/>.\n"
"                            </p>\n"
"                            <p>\n"
"                                En el portal del centro (<a t-attf-href=\"{{ object.get_base_url() }}/my/erasmus\">Erasmus+</a>)\n"
"                                encontrarás los documentos que tienes que entregar y los plazos. Si no puedes ir, indícalo\n"
"                                allí cuanto antes, para que la siguiente persona de la lista de reserva pueda ocupar la plaza.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p t-elif=\"object.result == 'reserve'\">\n"
"                            Estás en la <strong>lista de reserva</strong> de la movilidad de grupo Erasmus+\n"
"                            <strong t-out=\"object.group_mobility_id.name\"/>, con el número <strong t-out=\"object.reserve_position\"/>.\n"
"                            Si queda una plaza libre, nos pondremos en contacto contigo.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Tu inscripción en la movilidad de grupo Erasmus+ <strong t-out=\"object.group_mobility_id.name\"/>\n"
"                            no cumple los requisitos de los criterios de selección publicados con la inscripción.\n"
"                            Si crees que es un error, habla con el equipo Erasmus.\n"
"                        </p>\n"
"                        <p>\n"
"                            Un saludo,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

