"            "

#. module: ems
#: model:mail.template,body_html:ems.mail_attendance_issue_tutor
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Dear tutor,\n"
"                        </p>\n"
"                        <p>\n"
"                            This is your students daily report, in order to inform you about today's attendance statuses:\n"
"                            </p><ul>\n"
"                                <li>\n"
"                                    <strong>Date: </strong><span t-field=\"object.issue_date\"/>\n"
"                                    <ul>\n"
"                                        <t t-foreach=\"object.attendance_issue_student_ids\" t-as=\"student\">\n"
"                                            <li>\n"
"                                                <strong>Student: </strong><span t-field=\"student.student_id\"/>\n"
"                                                <ul>\n"
"                                                    <t t-foreach=\"student.attendance_issue_status_ids\" t-as=\"status\">\n"
"                                                        <li t-att-style=\"'text-decoration: line-through;' if status.rectified_by.id != False else ''\">\n"
"                                                            <span t-field=\"status.attendance_session_id.attendance_schedule_id.attendance_template_id\"/> | from <span t-field=\"status.attendance_session_id.start_time\" t-options=\"{'widget': 'float_time'}\"/> to <span t-field=\"status.attendance_session_id.end_time\" t-options=\"{'widget': 'float_time'}\"/> | <span t-field=\"status.attendance_status\"/>\n"
"                                                            <t t-if=\"status.notes\">\n"
"                                                                | <span t-field=\"status.notes\"/>\n"
"                                                            </t>\n"
"                                                        </li>                                                        \n"
"                                                    </t>\n"
"                                                </ul>\n"
"                                            </li>                                                                               \n"
"                                        </t>\n"
"                                    </ul>\n"
"                                </li>\n"
"                            </ul>\n"
"                                                \n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Estimado/a tutor/a,\n"
"                        </p>\n"
"                        <p>\n"
"                            Este es el reporte diario de sus alumnos, donde podrá consultar el estado de las asistencias de hoy:\n"
"                            </p><ul>\n"
"                                <li>\n"
"                                    <strong>Fecha: </strong><span t-field=\"object.issue_date\"/>\n"
"                                    <ul>\n"
"                                        <t t-foreach=\"object.attendance_issue_student_ids\" t-as=\"student\">\n"
"                                            <li>\n"
"                                                <strong>Estudiante: </strong><span t-field=\"student.student_id\"/>\n"
"                                                <ul>\n"
"                                                    <t t-foreach=\"student.attendance_issue_status_ids\" t-as=\"status\">\n"
"                                                        <li t-att-style=\"'text-decoration: line-through;' if status.rectified_by.id != False else ''\"> \n"
"                                                            <span t-field=\"status.attendance_session_id.attendance_schedule_id.attendance_template_id\"/> | de <span t-field=\"status.attendance_session_id.start_time\" t-options=\"{'widget': 'float_time'}\"/> a <span t-field=\"status.attendance_session_id.end_time\" t-options=\"{'widget': 'float_time'}\"/> | <span t-field=\"status.attendance_status\"/>\n"
"                                                            <t t-if=\"status.notes\">\n"
"                                                                | <span t-field=\"status.notes\"/>\n"
"                                                            </t>\n"
"                                                        </li>                                                        \n"
"                                                    </t>\n"
"                                                </ul>\n"
"                                            </li>                                                                               \n"
"                                        </t>\n"
"                                    </ul>\n"
"                                </li>\n"
"                            </ul>\n"
"                                                \n"
"                        <p>\n"
"                            Saludos cordiales,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

