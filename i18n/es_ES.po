#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_proposal_validated
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <p>\n"
"                            The Direction has validated your Erasmus+ mobility (<strong t-out=\"object.call_id.name\"/>):\n"
"                            <strong t-out=\"object.proposal_host\"/>,\n"
"                            <t t-out=\"', '.join(filter(None, [object.city, object.country_id.name]))\"/>,\n"
"                            from <t t-out=\"format_date(object.date_start)\"/> to <t t-out=\"format_date(object.date_end)\"/>.\n"
"                            EMS has requested your absence for training for those dates.\n"
"                        </p>\n"
"                        <p t-if=\"object.decision_note\">\n"
"                            Comment from the Direction: <span style=\"white-space: pre-line;\" t-out=\"object.decision_note\"/>\n"
"                        </p>\n"
"                        <p>\n"
"                            Now you can prepare it: <t t-out=\"object._ems_mail_place()\"/>\n"
"                            (<a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>) you will find the\n"
"                            documents to hand in, who signs each one, the deadlines and the steps to follow.\n"
"                        </p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <p>\n"
"                            La dirección ha validado tu movilidad Erasmus+ (<strong t-out=\"object.call_id.name\"/>):\n"
"                            <strong t-out=\"object.proposal_host\"/>,\n"
"                            <t t-out=\"', '.join(filter(None, [object.city, object.country_id.name]))\"/>,\n"
"                            del <t t-out=\"format_date(object.date_start)\"/> al <t t-out=\"format_date(object.date_end)\"/>.\n"
"                            EMS ha solicitado tu ausencia por formación para esos días.\n"
"                        </p>\n"
"                        <p t-if=\"object.decision_note\">\n"
"                            Comentario de la dirección: <span style=\"white-space: pre-line;\" t-out=\"object.decision_note\"/>\n"
"                        </p>\n"
"                        <p>\n"
"                            Ahora ya la puedes preparar: <t t-out=\"object._ems_mail_place()\"/>\n"
"                            (<a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>) encontrarás los\n"
"                            documentos que hay que entregar, quién firma cada uno, los plazos y los pasos a seguir.\n"
"                        </p>\n"
"                        <p>\n"
"                            Un saludo,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_proposal_rejected
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
