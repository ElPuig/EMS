"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;border:1px solid #e1e5eb;border-radius:9px;margin:0 0 20px 0;\"><tr><td style=\"padding:21px 21px 18px 21px;border-bottom:1px solid #e8ebf0;background-color:#fafbfc;border-radius:9px 9px 0 0;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Cuenta corporativa</p><p style=\"margin:0;font-size:20px;line-height:26px;font-weight:bold;color:#1a324f;\"><t t-out=\"ctx.get('gw_email') or ''\"/></p></td></tr><tr><td style=\"padding:18px 21px 20px 21px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td valign=\"top\" style=\"padding-right:12px;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Contraseña temporal</p><p style=\"margin:0;font-size:15px;line-height:22px;font-weight:bold;color:#243044;\"><span style=\"font-family:Consolas,Menlo,monospace;font-size:17px;letter-spacing:1px;\"><t t-out=\"ctx.get('gw_password') or ''\"/></span></p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;margin-top:16px;background-color:#fff7e8;border-left:3px solid #e0a526;border-radius:4px;\"><tr><td style=\"padding:13px 15px 15px 15px;font-size:14px;line-height:22px;color:#5c4510;\">Por motivos de seguridad, deberás cambiar esta contraseña la primera vez que inicies sesión.</td></tr></table></td></tr></table>\n"
"    <p style=\"margin:0 0 6px 0;font-size:14px;line-height:22px;color:#596679;\">Si no esperabas este cambio, avisa al centro.</p>\n"

#. module: ems
#: model:mail.template,body_html:ems.mail_template_google_password_reset_employee
msgid ""
"\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"background-color:#eef4fb;border:1px solid #c9dcf3;border-radius:5px;padding:6px 10px;font-size:11px;line-height:15px;font-weight:bold;letter-spacing:.5px;color:#2c5d99;\">PASSWORD RESET</td></tr></table>\n"
"    <h1 style=\"margin:15px 0 8px 0;font-size:25px;line-height:31px;font-weight:700;letter-spacing:-.5px;color:#1c2939;\">Your password has been reset</h1>\n"
"    <p style=\"margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;\">Hello <t t-out=\"object.name or ''\"/>, the password of your school corporate account has been reset. Use this temporary password to sign in.</p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;border:1px solid #e1e5eb;border-radius:9px;margin:0 0 20px 0;\"><tr><td style=\"padding:21px 21px 18px 21px;border-bottom:1px solid #e8ebf0;background-color:#fafbfc;border-radius:9px 9px 0 0;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Corporate account</p><p style=\"margin:0;font-size:20px;line-height:26px;font-weight:bold;color:#1a324f;\"><t t-out=\"ctx.get('gw_email') or ''\"/></p></td></tr><tr><td style=\"padding:18px 21px 20px 21px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td valign=\"top\" style=\"padding-right:12px;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Temporary password</p><p style=\"margin:0;font-size:15px;line-height:22px;font-weight:bold;color:#243044;\"><span style=\"font-family:Consolas,Menlo,monospace;font-size:17px;letter-spacing:1px;\"><t t-out=\"ctx.get('gw_password') or ''\"/></span></p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;margin-top:16px;background-color:#fff7e8;border-left:3px solid #e0a526;border-radius:4px;\"><tr><td style=\"padding:13px 15px 15px 15px;font-size:14px;line-height:22px;color:#5c4510;\">For security reasons, you will be asked to change this password the first time you sign in.</td></tr></table></td></tr></table>\n"
"    <p style=\"margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;\">You can also access the school management platform (EMS) at <a t-att-href=\"object.get_base_url()\"><t t-out=\"object.get_base_url()\"/></a>: use the <strong>Sign in with Google</strong> button with this same corporate account.</p>\n"
"    <p style=\"margin:0 0 6px 0;font-size:14px;line-height:22px;color:#596679;\">If you were not expecting this change, please let the school know.</p>\n"
msgstr ""
"\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"background-color:#eef4fb;border:1px solid #c9dcf3;border-radius:5px;padding:6px 10px;font-size:11px;line-height:15px;font-weight:bold;letter-spacing:.5px;color:#2c5d99;\">CONTRASEÑA RESTABLECIDA</td></tr></table>\n"
"    <h1 style=\"margin:15px 0 8px 0;font-size:25px;line-height:31px;font-weight:700;letter-spacing:-.5px;color:#1c2939;\">Se ha restablecido tu contraseña</h1>\n"
"    <p style=\"margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;\">Hola, <t t-out=\"object.name or ''\"/>. Se ha restablecido la contraseña de tu cuenta corporativa del centro. Usa esta contraseña temporal para iniciar sesión.</p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;border:1px solid #e1e5eb;border-radius:9px;margin:0 0 20px 0;\"><tr><td style=\"padding:21px 21px 18px 21px;border-bottom:1px solid #e8ebf0;background-color:#fafbfc;border-radius:9px 9px 0 0;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Cuenta corporativa</p><p style=\"margin:0;font-size:20px;line-height:26px;font-weight:bold;color:#1a324f;\"><t t-out=\"ctx.get('gw_email') or ''\"/></p></td></tr><tr><td style=\"padding:18px 21px 20px 21px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td valign=\"top\" style=\"padding-right:12px;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Contraseña temporal</p><p style=\"margin:0;font-size:15px;line-height:22px;font-weight:bold;color:#243044;\"><span style=\"font-family:Consolas,Menlo,monospace;font-size:17px;letter-spacing:1px;\"><t t-out=\"ctx.get('gw_password') or ''\"/></span></p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;margin-top:16px;background-color:#fff7e8;border-left:3px solid #e0a526;border-radius:4px;\"><tr><td style=\"padding:13px 15px 15px 15px;font-size:14px;line-height:22px;color:#5c4510;\">Por motivos de seguridad, deberás cambiar esta contraseña la primera vez que inicies sesión.</td></tr></table></td></tr></table>\n"
"    <p style=\"margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;\">También puedes acceder a la plataforma de gestión del centro (EMS) en <a t-att-href=\"object.get_base_url()\"><t t-out=\"object.get_base_url()\"/></a>: usa el botón <strong>Iniciar sesión con Google</strong> con esta misma cuenta corporativa.</p>\n"
"    <p style=\"margin:0 0 6px 0;font-size:14px;line-height:22px;color:#596679;\">Si no esperabas este cambio, avisa al centro.</p>\n"

#. module: ems
#: model:mail.template,body_html:ems.mail_template_google_deactivation_student
msgid ""
"\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"background-color:#fff0ee;border:1px solid #f5cbc6;border-radius:5px;padding:6px 10px;font-size:11px;line-height:15px;font-weight:bold;letter-spacing:.5px;color:#b33126;\">SCHEDULED DEACTIVATION</td></tr></table>\n"
"    <h1 style=\"margin:15px 0 8px 0;font-size:25px;line-height:31px;font-weight:700;letter-spacing:-.5px;color:#1c2939;\">Your account will be deactivated</h1>\n"
"    <p style=\"margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;\">Hello <t t-out=\"object.firstname or object.name or ''\"/>, now that you are no longer enrolled at the school, your corporate Google Workspace account will be deactivated and then deleted.</p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;border:1px solid #e1e5eb;border-radius:9px;margin:0 0 20px 0;\"><tr><td style=\"padding:21px 21px 18px 21px;border-bottom:1px solid #e8ebf0;background-color:#fafbfc;border-radius:9px 9px 0 0;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Corporate account</p><p style=\"margin:0;font-size:20px;line-height:26px;font-weight:bold;color:#1a324f;\"><t t-out=\"object.student_email or ''\"/></p></td></tr><tr><td style=\"padding:18px 21px 20px 21px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td valign=\"top\" style=\"padding-right:12px;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Deactivation</p><p style=\"margin:0;font-size:15px;line-height:22px;font-weight:bold;color:#243044;\"><t t-out=\"format_date(object.google_ws_deactivation_date)\"/></p></td><td valign=\"top\" style=\"padding-right:12px;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Permanent deletion</p><p style=\"margin:0;font-size:15px;line-height:22px;font-weight:bold;color:#243044;\"><t t-out=\"format_date(ctx.get('gw_deletion_date'))\"/></p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;margin-top:16px;background-color:#fff0ee;border-left:3px solid #d9534f;border-radius:4px;\"><tr><td style=\"padding:13px 15px 15px 15px;font-size:14px;line-height:22px;color:#6b2620;\">You can use your account as usual until the day before <t t-out=\"format_date(object.google_ws_deactivation_date)\"/>. From <t t-out=\"format_date(object.google_ws_deactivation_date)\"/> you will no longer be able to access it, and on <t t-out=\"format_date(ctx.get('gw_deletion_date'))\"/> it will be deleted for good: after that date your email and your Drive files <strong>cannot be recovered</strong>. Download everything you want to keep before then, and move any personal service using this address to another one.</td></tr></table></td></tr></table>\n"
"    <p style=\"margin:0 0 6px 0;font-size:14px;line-height:22px;color:#596679;\">If you enrol again at the school before those dates, the account is kept and nothing is lost.</p>\n"
msgstr ""
"\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"background-color:#fff0ee;border:1px solid #f5cbc6;border-radius:5px;padding:6px 10px;font-size:11px;line-height:15px;font-weight:bold;letter-spacing:.5px;color:#b33126;\">DESACTIVACIÓN PROGRAMADA</td></tr></table>\n"
"    <h1 style=\"margin:15px 0 8px 0;font-size:25px;line-height:31px;font-weight:700;letter-spacing:-.5px;color:#1c2939;\">Tu cuenta se desactivará</h1>\n"
"    <p style=\"margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;\">Hola, <t t-out=\"object.firstname or object.name or ''\"/>. Ahora que ya no estás matriculado en el centro, tu cuenta corporativa de Google Workspace se desactivará y después se eliminará.</p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;border:1px solid #e1e5eb;border-radius:9px;margin:0 0 20px 0;\"><tr><td style=\"padding:21px 21px 18px 21px;border-bottom:1px solid #e8ebf0;background-color:#fafbfc;border-radius:9px 9px 0 0;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Cuenta corporativa</p><p style=\"margin:0;font-size:20px;line-height:26px;font-weight:bold;color:#1a324f;\"><t t-out=\"object.student_email or ''\"/></p></td></tr><tr><td style=\"padding:18px 21px 20px 21px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td valign=\"top\" style=\"padding-right:12px;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Desactivación</p><p style=\"margin:0;font-size:15px;line-height:22px;font-weight:bold;color:#243044;\"><t t-out=\"format_date(object.google_ws_deactivation_date)\"/></p></td><td valign=\"top\" style=\"padding-right:12px;\"><p style=\"margin:0 0 5px 0;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:.7px;text-transform:uppercase;color:#7b8798;\">Eliminación definitiva</p><p style=\"margin:0;font-size:15px;line-height:22px;font-weight:bold;color:#243044;\"><t t-out=\"format_date(ctx.get('gw_deletion_date'))\"/></p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:separate;margin-top:16px;background-color:#fff0ee;border-left:3px solid #d9534f;border-radius:4px;\"><tr><td style=\"padding:13px 15px 15px 15px;font-size:14px;line-height:22px;color:#6b2620;\">Puedes usar la cuenta con normalidad hasta el día antes del <t t-out=\"format_date(object.google_ws_deactivation_date)\"/>. A partir del <t t-out=\"format_date(object.google_ws_deactivation_date)\"/> ya no podrás acceder a ella, y el <t t-out=\"format_date(ctx.get('gw_deletion_date'))\"/> se eliminará definitivamente: a partir de esa fecha tu correo y tus archivos de Drive <strong>no se podrán recuperar</strong>. Descarga antes todo lo que quieras conservar y traslada a otra dirección cualquier servicio personal que use esta.</td></tr></table></td></tr></table>\n"
"    <p style=\"margin:0 0 6px 0;font-size:14px;line-height:22px;color:#596679;\">Si vuelves a matricularte en el centro antes de esas fechas, la cuenta se conserva y no se pierde nada.</p>\n"

#. module: ems
#: model:mail.template,body_html:ems.mail_template_google_deactivation_employee
msgid ""
"\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"background-color:#fff0ee;border:1px solid #f5cbc6;border-radius:5px;padding:6px 10px;font-size:11px;line-height:15px;font-weight:bold;letter-spacing:.5px;color:#b33126;\">SCHEDULED DEACTIVATION</td></tr></table>\n"
