#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_claim_received
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <p t-if=\"object.kind == 'appeal'\">\n"
"                            We have received your appeal<t t-if=\"object.resolution_id\"> against <strong t-out=\"object.resolution_id.name\"/></t>\n"
"                            on <strong t-out=\"object.call_id._ems_local_format(object.create_date)\"/>.\n"
"                            The Head of Studies will answer it.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            We have received your claim<t t-if=\"object.resolution_id\"> against <strong t-out=\"object.resolution_id.name\"/></t>\n"
"                            on <strong t-out=\"object.call_id._ems_local_format(object.create_date)\"/>.\n"
"                            The Erasmus team will answer it.\n"
"                        </p>\n"
"                        <p>You will receive the answer by email. Keep this email as proof that you sent it.</p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <p t-if=\"object.kind == 'appeal'\">\n"
"                            Hemos recibido tu recurso de alzada<t t-if=\"object.resolution_id\"> contra <strong t-out=\"object.resolution_id.name\"/></t>\n"
"                            el <strong t-out=\"object.call_id._ems_local_format(object.create_date)\"/>.\n"
"                            Lo responderá el jefe de estudios.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Hemos recibido tu reclamación<t t-if=\"object.resolution_id\"> contra <strong t-out=\"object.resolution_id.name\"/></t>\n"
"                            el <strong t-out=\"object.call_id._ems_local_format(object.create_date)\"/>.\n"
"                            La responderá el equipo Erasmus.\n"
"                        </p>\n"
"                        <p>Recibirás la respuesta por correo electrónico. Guarda este correo como justificante de su presentación.</p>\n"
"                        <p>\n"
"                            Un saludo,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_claim_resolved
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <p t-if=\"object.kind == 'appeal'\">Your appeal has been answered:</p>\n"
"                        <p t-else=\"\">Your claim has been answered:</p>\n"
"                        <p style=\"white-space: pre-line; border-left: 3px solid #dadce0; padding-left: 8px;\" t-out=\"object.response\"/>\n"
"                        <p>\n"
"                            You can also see it <t t-out=\"object._ems_mail_place()\"/>:\n"
"                            <a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>.\n"
"                        </p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <p t-if=\"object.kind == 'appeal'\">Se ha resuelto tu recurso de alzada:</p>\n"
"                        <p t-else=\"\">Se ha resuelto tu reclamación:</p>\n"
"                        <p style=\"white-space: pre-line; border-left: 3px solid #dadce0; padding-left: 8px;\" t-out=\"object.response\"/>\n"
"                        <p>\n"
"                            También puedes consultarlo <t t-out=\"object._ems_mail_place()\"/>:\n"
"                            <a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>.\n"
"                        </p>\n"
"                        <p>\n"
"                            Un saludo,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_application_excluded
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <p>Your application to <strong t-out=\"object.call_id.name\"/> has been excluded from the selection.</p>\n"
"                        <p>Reason: <t t-out=\"object.exclusion_reason\"/></p>\n"
"                        <p t-if=\"'provisional' in object.call_id._ems_published_resolutions().mapped('kind')\">\n"
"                            The exclusion will appear in the next published list. If you think it is a mistake, talk to the Erasmus team.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            The exclusion will appear in the next published list. If you disagree, you will be able\n"
"                            to claim against the provisional resolution <t t-out=\"object._ems_mail_place()\"/> (<a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>).\n"
"                        </p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <p>Tu solicitud a <strong t-out=\"object.call_id.name\"/> ha quedado excluida del proceso de selección.</p>\n"
"                        <p>Motivo: <t t-out=\"object.exclusion_reason\"/></p>\n"
"                        <p t-if=\"'provisional' in object.call_id._ems_published_resolutions().mapped('kind')\">\n"
"                            La exclusión aparecerá en la próxima lista que se publique. Si crees que es un error, habla con el equipo Erasmus.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            La exclusión aparecerá en la próxima lista que se publique. Si no estás de acuerdo, podrás\n"
"                            reclamar contra la resolución provisional <t t-out=\"object._ems_mail_place()\"/> (<a t-attf-href=\"{{ object._ems_mail_url() }}\">Erasmus+</a>).\n"
"                        </p>\n"
"                        <p>\n"
"                            Un saludo,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_erasmus_group_result
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                        <t t-if=\"object.result == 'selected'\">\n"
"                            <p>\n"
"                                You have been <strong>selected</strong> for the Erasmus+ group mobility\n"
"                                <strong t-out=\"object.group_mobility_id.name\"/>.\n"
"                            </p>\n"
"                            <p>\n"
"                                On the school portal (<a t-attf-href=\"{{ object.get_base_url() }}/my/erasmus\">Erasmus+</a>)\n"
"                                you will find the documents to hand in and their deadlines. If you cannot go, say so\n"
"                                there as soon as possible, so that the next person on the reserve list can take the place.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p t-elif=\"object.result == 'reserve'\">\n"
"                            You are on the <strong>reserve list</strong> of the Erasmus+ group mobility\n"
"                            <strong t-out=\"object.group_mobility_id.name\"/>, number <strong t-out=\"object.reserve_position\"/>.\n"
"                            If a place becomes free, we will contact you.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Your enrolment in the Erasmus+ group mobility <strong t-out=\"object.group_mobility_id.name\"/>\n"
"                            does not meet the requirements of the selection criteria published with the enrolment.\n"
"                            If you think this is a mistake, talk to the Erasmus team.\n"
"                        </p>\n"
"                        <p t-out=\"object.env['ems.erasmus.resolution']._ems_appeal_notice()\"/>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.partner_id.name\"/>:</p>\n"
"                        <t t-if=\"object.result == 'selected'\">\n"
"                            <p>\n"
"                                Tienes <strong>plaza</strong> en la movilidad de grupo Erasmus+\n"
"                                <strong t-out=\"object.group_mobility_id.name\"/>.\n"
"                            </p>\n"
"                            <p>\n"
"                                En el portal del centro (<a t-attf-href=\"{{ object.get_base_url() }}/my/erasmus\">Erasmus+</a>)\n"
"                                encontrarás los documentos que tienes que entregar y los plazos. Si no puedes ir, indícalo\n"
"                                allí cuanto antes, para que la siguiente persona de la lista de reserva pueda ocupar la plaza.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p t-elif=\"object.result == 'reserve'\">\n"
"                            Estás en la <strong>lista de reserva</strong> de la movilidad de grupo Erasmus+\n"
