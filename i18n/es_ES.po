#. module: ems
#: model:mail.template,body_html:ems.mail_strike_escalation
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Dear coexistence coordinator,\n"
"                        </p>\n"
"                        <p>\n"
"                            This is an automated email: a student has reached a strike count that requires your attention:\n"
"                            </p><ul>\n"
"                                <li><strong>Student:</strong> <span t-field=\"object.student_id\"/></li>\n"
"                                <li><strong>Total strikes:</strong> <span t-field=\"object.strike_count\"/></li>\n"
"                                <li><strong>Latest strike date and time:</strong> <span t-field=\"object.date\"/></li>\n"
"                                <li><strong>Issued by:</strong> <span t-field=\"object.teacher_id\"/></li>\n"
"                                <li><strong>Latest reason:</strong> <span t-field=\"object.reason_id\"/></li>\n"
"                            </ul>\n"
"                        \n"
"                        <p>You can review the full history under Coexistence &gt; Strikes.</p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Estimado/a coordinador/a de convivencia,\n"
"                        </p>\n"
"                        <p>\n"
"                            Este es un correo automático: un alumno ha alcanzado un recuento de strikes que requiere su atención:\n"
"                            </p><ul>\n"
"                                <li><strong>Alumno:</strong> <span t-field=\"object.student_id\"/></li>\n"
"                                <li><strong>Total de strikes:</strong> <span t-field=\"object.strike_count\"/></li>\n"
"                                <li><strong>Fecha y hora del último strike:</strong> <span t-field=\"object.date\"/></li>\n"
"                                <li><strong>Puesto por:</strong> <span t-field=\"object.teacher_id\"/></li>\n"
"                                <li><strong>Último motivo:</strong> <span t-field=\"object.reason_id\"/></li>\n"
"                            </ul>\n"
"                        \n"
"                        <p>Puede consultar el historial completo en Convivencia &gt; Strikes.</p>\n"
"                        <p>\n"
"                            Saludos cordiales,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.mail_strike_notification_family
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>\n"
"                            Dear family,\n"
"                        </p>\n"
"                        <p>\n"
"                            This is an automated email, in order to inform you about a strike issued to a student:\n"
"                            </p><ul>\n"
"                                <li><strong>Student:</strong> <span t-field=\"object.student_id\"/></li>\n"
"                                <li><strong>Date and time:</strong> <span t-field=\"object.date\"/></li>\n"
"                                <li><strong>Teacher:</strong> <span t-field=\"object.teacher_id\"/></li>\n"
"                                <li><strong>Reason:</strong> <span t-field=\"object.reason_id\"/></li>\n"
"                                <t t-if=\"object.kicked_out\">\n"
"                                    <li><strong>Kicked out of class:</strong> Yes</li>\n"
"                                </t>\n"
"                                <t t-else=\"\">\n"
"                                    <li><strong>Kicked out of class:</strong> No</li>\n"
"                                </t>\n"
"                                <t t-if=\"object.notes\">\n"
"                                    <li><strong>Details:</strong> <span t-field=\"object.notes\"/></li>\n"
"                                </t>\n"
"                            </ul>\n"
"                        \n"
"                        <p>If you need further information, you can contact with <t t-out=\"object.teacher_id.display_name\"/> just replying to this email.</p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.create_uid.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
