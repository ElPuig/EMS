#. odoo-python
#: code:addons/ems/models/erasmus/group_mobility.py:0
msgid ""
"Enrolled within the period and in the eligible group. Ordered by the score, "
"from highest to lowest: the record average (0 to 10), plus 1 point for fewer"
" opportunities accredited by the Erasmus team, minus 0.5 points per conduct "
"warning this course (at most 1.5). Tie-break: the fewer opportunities "
"accredited. If the tie persists, it is resolved by a draw."
msgstr ""
"Inscrito dentro del plazo y del grupo que puede inscribirse. Ordenado por la"
" puntuación, de más alta a más baja: la nota media del expediente (de 0 a "
"10), más 1 punto por menos oportunidades acreditadas por el equipo Erasmus, "
"menos 0,5 puntos por cada amonestación de este curso (como máximo 1,5). "
"Desempate: las menos oportunidades acreditadas. Si el empate continúa, se "
"resuelve por sorteo."

#. module: ems
#: model:ir.model.fields,field_description:ems.field_ems_erasmus_group_mobility__rank_by_score
msgid "Ranked by the score"
msgstr "Clasificada por puntuación"

#. module: ems
#: model_terms:ir.ui.view,arch_db:ems.erasmus_resolution_list
msgid ""
"Students with the same score are ordered by the fewer opportunities "
"accredited and, if still tied, by a draw."
msgstr ""
"Los alumnos con la misma puntuación se ordenan por las menores oportunidades"
" acreditadas y, si siguen empatados, por sorteo."

#. module: ems
#: model:ir.model.fields,help:ems.field_ems_erasmus_group_registration__score
msgid ""
"The record average, +1 for fewer opportunities accredited by the Erasmus "
"team, -0.5 per conduct warning this course (at most -1.5)."
msgstr ""
"La media del expediente, +1 por menos oportunidades acreditadas por el "
"equipo Erasmus, -0,5 por cada amonestación de este curso (como máximo -1,5)."

#. module: ems
#: model_terms:ir.ui.view,arch_db:ems.view_erasmus_group_mobility_form
msgid "Tied on the score"
msgstr "Empatados con la puntuación"

