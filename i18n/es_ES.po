#. module: ems
#: model:mail.template,body_html:ems.email_template_student_walkout_family
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Dear family,</p>\n"
"                        <p>\n"
"                            <strong t-out=\"object.student_id.name\"/> has said that they join the student walkout\n"
"                            called by a students' union for <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>.\n"
"                        </p>\n"
"                        <p>\n"
"                            Their group, <t t-out=\"object.walkout_id.group_id.name\"/>, has voted to support it and the\n"
"                            Head of Studies has validated the proposal, so the school justifies their absence that day.\n"
"                        </p>\n"
"                        <p>If you have any question, talk to the group's tutor.</p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.walkout_id.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Estimada familia:</p>\n"
"                        <p>\n"
"                            <strong t-out=\"object.student_id.name\"/> ha dicho que se suma a la huelga\n"
"                            convocada por un sindicato de estudiantes para el <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>.\n"
"                        </p>\n"
"                        <p>\n"
"                            Su grupo, <t t-out=\"object.walkout_id.group_id.name\"/>, ha votado apoyarla y\n"
"                            jefatura de estudios ha validado la propuesta, así que el centro justifica la falta de ese día.\n"
"                        </p>\n"
"                        <p>Si tienen cualquier duda, hablen con el tutor del grupo.</p>\n"
"                        <p>\n"
"                            Un cordial saludo,<br/>\n"
"                            <t t-out=\"object.walkout_id.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_student_walkout_rejected
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.student_id.name\"/>,</p>\n"
"                        <p t-if=\"object.walkout_id.rejected_from_state in ('voting', 'joining')\">\n"
"                            <t t-out=\"object.walkout_id.rejected_by_id.name\"/> has aborted the student walkout proposal of\n"
"                            your group for <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>:\n"
"                            <strong t-out=\"object.walkout_id.rejection_reason_id.name\"/>.\n"
"                            Absences that day will not be justified.\n"
"                        </p>\n"
"                        <p t-elif=\"object.walkout_id.rejected_from_state == 'justified'\">\n"
"                            The Head of Studies has withdrawn the validation of the student walkout of your group on\n"
"                            <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>:\n"
"                            <strong t-out=\"object.walkout_id.rejection_reason_id.name\"/>.\n"
"                            Absences that day are no longer justified.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            The Head of Studies has not validated the student walkout of your group on\n"
"                            <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>:\n"
"                            <strong t-out=\"object.walkout_id.rejection_reason_id.name\"/>.\n"
"                            Absences that day will not be justified.\n"
"                        </p>\n"
"                        <p t-if=\"object.walkout_id.rejection_details\" t-out=\"object.walkout_id.rejection_details\"/>\n"
"                        <p>If you have any question, talk to your tutor.</p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.walkout_id.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.student_id.name\"/>:</p>\n"
"                        <p t-if=\"object.walkout_id.rejected_from_state in ('voting', 'joining')\">\n"
"                            <t t-out=\"object.walkout_id.rejected_by_id.name\"/> ha abortado la propuesta de apoyo a la huelga de\n"
"                            tu grupo para el <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>:\n"
"                            <strong t-out=\"object.walkout_id.rejection_reason_id.name\"/>.\n"
"                            Las faltas de ese día no se justificarán.\n"
"                        </p>\n"
"                        <p t-elif=\"object.walkout_id.rejected_from_state == 'justified'\">\n"
"                            Jefatura de estudios ha retirado la validación de la huelga de tu grupo del\n"
"                            <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>:\n"
"                            <strong t-out=\"object.walkout_id.rejection_reason_id.name\"/>.\n"
"                            Las faltas de ese día ya no están justificadas.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Jefatura de estudios no ha validado la huelga de tu grupo del\n"
"                            <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>:\n"
"                            <strong t-out=\"object.walkout_id.rejection_reason_id.name\"/>.\n"
"                            Las faltas de ese día no se justificarán.\n"
"                        </p>\n"
"                        <p t-if=\"object.walkout_id.rejection_details\" t-out=\"object.walkout_id.rejection_details\"/>\n"
"                        <p>Si tienes cualquier duda, habla con tu tutor.</p>\n"
"                        <p>\n"
"                            Un cordial saludo,<br/>\n"
"                            <t t-out=\"object.walkout_id.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_student_walkout_validated
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello <t t-out=\"object.student_id.name\"/>,</p>\n"
"                        <p>\n"
"                            The Head of Studies has validated the student walkout of your group on\n"
"                            <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>.\n"
"                        </p>\n"
"                        <p t-if=\"object.joins\">You said you join it: your absence that day is justified.</p>\n"
"                        <p t-else=\"\">You did not say you join it: you are expected in class that day.</p>\n"
"                        <p>\n"
"                            Kind regards,<br/>\n"
"                            <t t-out=\"object.walkout_id.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola, <t t-out=\"object.student_id.name\"/>:</p>\n"
"                        <p>\n"
"                            Jefatura de estudios ha validado la huelga de tu grupo del\n"
"                            <strong t-out=\"format_date(object.walkout_id.walkout_date)\"/>.\n"
"                        </p>\n"
"                        <p t-if=\"object.joins\">Dijiste que te sumabas: tu falta de ese día está justificada.</p>\n"
"                        <p t-else=\"\">No dijiste que te sumabas: ese día te esperamos en clase.</p>\n"
"                        <p>\n"
"                            Un cordial saludo,<br/>\n"
"                            <t t-out=\"object.walkout_id.company_id.name\"/>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model:mail.template,body_html:ems.email_template_student_walkout_tutor
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hello,</p>\n"
"                        <t t-set=\"event\" t-value=\"ctx.get('walkout_event')\"/>\n"
"                        <t t-if=\"event == 'call'\">\n"
"                            <p>\n"
"                                <t t-out=\"object.opener_id.name\"/>, the delegate of <strong t-out=\"object.group_id.name\"/>,\n"
"                                has proposed that the group supports a student walkout called by a students' union for <strong t-out=\"format_date(object.walkout_date)\"/>.\n"
"                                The group votes until <strong t-out=\"object.format_local_datetime(object.vote_until)\"/>.\n"
"                            </p>\n"
"                            <p>\n"
"                                As the group's tutor, check the union's call: you can abort the proposal while it is voted\n"
"                                or joined, only for a formal defect (no valid call of a students' union for that day,\n"
"                                one that does not cover the group...), never because of its cause.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p t-elif=\"event == 'join'\">\n"
"                            <strong t-out=\"object.group_id.name\"/> supports the student walkout of\n"
"                            <strong t-out=\"format_date(object.walkout_date)\"/>\n"
"                            (<t t-out=\"object.group_yes_count\"/> yes, <t t-out=\"object.group_no_count\"/> no,\n"
"                            <t t-out=\"object.group_abstain_count\"/> abstentions). Each student says whether they join\n"
"                            it until <strong t-out=\"object.format_local_datetime(object.join_until)\"/>; you can still\n"
"                            abort the proposal until then.\n"
"                        </p>\n"
"                        <p t-elif=\"event == 'closed'\">\n"
"                            The proposal to support the student walkout of <strong t-out=\"format_date(object.walkout_date)\"/> in\n"
"                            <strong t-out=\"object.group_id.name\"/> has closed:\n"
"                            <t t-if=\"object.group_supports\">the group supports it and\n"
"                                <t t-out=\"object.joining_count\"/> of <t t-out=\"len(object.line_ids)\"/> students join it.\n"
"                                The Head of Studies has the minute and decides whether to validate it.</t>\n"
"                            <t t-else=\"\">the group does not support it, so nobody's absence will be justified.</t>\n"
"                        </p>\n"
"                        <p t-elif=\"event == 'validated'\">\n"
"                            The Head of Studies has validated the student walkout of <strong t-out=\"object.group_id.name\"/>\n"
"                            on <strong t-out=\"format_date(object.walkout_date)\"/>: the absences of the\n"
"                            <t t-out=\"object.joining_count\"/> students who join it are justified.\n"
"                        </p>\n"
"                        <t t-elif=\"event == 'rejected'\">\n"
"                            <p>\n"
"                                <t t-out=\"object.rejected_by_id.name\"/>\n"
"                                <t t-if=\"object.rejected_from_state in ('voting', 'joining')\">has aborted the proposal of</t>\n"
"                                <t t-elif=\"object.rejected_from_state == 'justified'\">has withdrawn the validation of</t>\n"
"                                <t t-else=\"\">has not validated</t>\n"
"                                the student walkout of <strong t-out=\"object.group_id.name\"/> on\n"
"                                <strong t-out=\"format_date(object.walkout_date)\"/>:\n"
"                                <strong t-out=\"object.rejection_reason_id.name\"/>.\n"
"                            </p>\n"
"                            <p t-if=\"object.rejection_details\" t-out=\"object.rejection_details\"/>\n"
"                        </t>\n"
"                        <p>\n"
"                            <a t-attf-href=\"{{ object.get_base_url() }}/odoo/action-ems.action_student_walkout/{{ object.id }}\">Open the proposal in EMS</a>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"                        <p>Hola:</p>\n"
"                        <t t-set=\"event\" t-value=\"ctx.get('walkout_event')\"/>\n"
"                        <t t-if=\"event == 'call'\">\n"
"                            <p>\n"
"                                <t t-out=\"object.opener_id.name\"/>, delegado de <strong t-out=\"object.group_id.name\"/>,\n"
"                                ha propuesto que el grupo apoye una huelga convocada por un sindicato de estudiantes para el <strong t-out=\"format_date(object.walkout_date)\"/>.\n"
"                                El grupo vota hasta el <strong t-out=\"object.format_local_datetime(object.vote_until)\"/>.\n"
"                            </p>\n"
"                            <p>\n"
"                                Como tutor del grupo, revisa la convocatoria del sindicato: puedes abortar la propuesta mientras se vota\n"
"                                o se suman, solo por un defecto de forma (no hay ninguna convocatoria válida de un sindicato de estudiantes para ese día,\n"
"                                no incluye al grupo...), nunca por su causa.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p t-elif=\"event == 'join'\">\n"
"                            <strong t-out=\"object.group_id.name\"/> apoya la huelga del\n"
"                            <strong t-out=\"format_date(object.walkout_date)\"/>\n"
"                            (<t t-out=\"object.group_yes_count\"/> sí, <t t-out=\"object.group_no_count\"/> no,\n"
"                            <t t-out=\"object.group_abstain_count\"/> abstenciones). Cada alumno dice si se suma\n"
"                            hasta el <strong t-out=\"object.format_local_datetime(object.join_until)\"/>; hasta entonces aún\n"
"                            puedes abortar la propuesta.\n"
"                        </p>\n"
"                        <p t-elif=\"event == 'closed'\">\n"
"                            La propuesta de apoyo a la huelga del <strong t-out=\"format_date(object.walkout_date)\"/> en\n"
"                            <strong t-out=\"object.group_id.name\"/> se ha cerrado:\n"
"                            <t t-if=\"object.group_supports\">el grupo la apoya y\n"
"                                <t t-out=\"object.joining_count\"/> de <t t-out=\"len(object.line_ids)\"/> alumnos se suman.\n"
"                                Jefatura de estudios tiene el acta y decide si la valida.</t>\n"
"                            <t t-else=\"\">el grupo no la apoya, así que no se justificará la falta de nadie.</t>\n"
"                        </p>\n"
"                        <p t-elif=\"event == 'validated'\">\n"
"                            Jefatura de estudios ha validado la huelga de <strong t-out=\"object.group_id.name\"/>\n"
"                            del <strong t-out=\"format_date(object.walkout_date)\"/>: las faltas de los\n"
"                            <t t-out=\"object.joining_count\"/> alumnos que se suman están justificadas.\n"
"                        </p>\n"
"                        <t t-elif=\"event == 'rejected'\">\n"
"                            <p>\n"
"                                <t t-out=\"object.rejected_by_id.name\"/>\n"
"                                <t t-if=\"object.rejected_from_state in ('voting', 'joining')\">ha abortado la propuesta de</t>\n"
"                                <t t-elif=\"object.rejected_from_state == 'justified'\">ha retirado la validación de</t>\n"
"                                <t t-else=\"\">no ha validado</t>\n"
"                                la huelga de <strong t-out=\"object.group_id.name\"/> del\n"
"                                <strong t-out=\"format_date(object.walkout_date)\"/>:\n"
"                                <strong t-out=\"object.rejection_reason_id.name\"/>.\n"
"                            </p>\n"
"                            <p t-if=\"object.rejection_details\" t-out=\"object.rejection_details\"/>\n"
"                        </t>\n"
"                        <p>\n"
"                            <a t-attf-href=\"{{ object.get_base_url() }}/odoo/action-ems.action_student_walkout/{{ object.id }}\">Abre la propuesta en EMS</a>\n"
"                        </p>\n"
"                    </div>\n"
"                \n"
"            "

#. module: ems
#: model_terms:ir.ui.view,arch_db:ems.view_student_walkout_reject_wizard_form
msgid "<strong>Abort a proposal only for a formal defect:</strong>"
msgstr "<strong>Solo se puede abortar una propuesta por un defecto de forma:</strong>"

#. module: ems
#: model_terms:ir.ui.view,arch_db:ems.view_student_walkout_reject_wizard_form
msgid ""
"<strong>Never because</strong> you disagree with its cause, it coincides with an exam, an outing or a\n"
"                            deadline, you think the group cannot afford to miss class, few students would join, or to put pressure\n"
"                            on the group. The Head of Studies is told of every aborted proposal and its reason."
msgstr ""
"<strong>Nunca porque</strong> no estés de acuerdo con su causa, coincida con un examen, una salida o una\n"
"                            entrega, creas que el grupo no puede permitirse perder clase, vayan a sumarse pocos alumnos, o para presionar\n"
"                            al grupo. Jefatura de estudios recibe un aviso de cada propuesta abortada y de su motivo."

