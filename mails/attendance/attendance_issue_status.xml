<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="mail.template" id="mail_attendance_issue_status_family" >
            <field name="name">Email notification for families: student attendance status</field>
            <field name="model_id" ref="ems.model_ems_attendance_issue_status"/>
            <field name="subject">Student attendance notification: {{object.attendance_issue_student_id.student_id.display_name}}</field>
            <field name="auto_delete" eval="True"/>             
            <!-- NOTE: there's no BCC field to add a private direction list, so this is being setup within session code (send_mail call within _send_notifications method)  -->
            <!-- <field name="email_to">{{object.send_to}}</field>  -->
            <field name="email_from">ems@elpuig.xeill.net</field>
            <field name="reply_to">{{object.attendance_issue_student_id.attendance_issue_tutor_id.tutor_id.email}}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;">
                        <p>
                            Dear family,
                        </p>
                        <p>
                            This is an automated email, in order to inform you about an attendance status:
                            <ul>
                                <li><strong>Student:</strong> <span t-field="object.attendance_issue_student_id.student_id"/></li>
                                <li><strong>Date:</strong> <span t-field="object.attendance_session_id.weekday"/>, <t t-out="object.attendance_session_id.date"/> from <span t-field="object.attendance_session_id.start_time" t-options="{'widget': 'float_time'}"/> to <span t-field="object.attendance_session_id.end_time" t-options="{'widget': 'float_time'}"/></li>                                
                                <li><strong>Session:</strong> <span t-field="object.attendance_session_id.attendance_schedule_id.attendance_template_id"/></li>
                                <li><strong>Status:</strong> <span t-field="object.attendance_status_id"/></li>
                                <t t-if="object.notes">
                                    <li><strong>Details:</strong> <span t-field="object.notes"/></li>
                                </t>
                            </ul>                        
                        </p>
                        <p>If you need further information, you can contact with <t t-out="object.attendance_issue_student_id.attendance_issue_tutor_id.tutor_id.display_name"/> just replaying to this email.</p>
                        <p>
                            Kind regards,<br>
                            <t t-out="object.create_uid.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Same notification as mail_attendance_issue_status_family above, but addressed to the
             student themselves rather than the family — kept in the same file since it's the
             same underlying notification, just worded for a different recipient. -->
        <record model="mail.template" id="mail_attendance_issue_status_student" >
            <field name="name">Email notification for students: student attendance status</field>
            <field name="model_id" ref="ems.model_ems_attendance_issue_status"/>
            <field name="subject">Student attendance notification: {{object.attendance_issue_student_id.student_id.display_name}}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_from">ems@elpuig.xeill.net</field>
            <field name="reply_to">{{object.attendance_issue_student_id.attendance_issue_tutor_id.tutor_id.email}}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;">
                        <p>
                            Dear <t t-out="object.attendance_issue_student_id.student_id.name"/>,
                        </p>
                        <p>
                            This is an automated email, to inform you about your attendance status:
                            <ul>
                                <li><strong>Date:</strong> <span t-field="object.attendance_session_id.weekday"/>, <t t-out="object.attendance_session_id.date"/> from <span t-field="object.attendance_session_id.start_time" t-options="{'widget': 'float_time'}"/> to <span t-field="object.attendance_session_id.end_time" t-options="{'widget': 'float_time'}"/></li>
                                <li><strong>Session:</strong> <span t-field="object.attendance_session_id.attendance_schedule_id.attendance_template_id"/></li>
                                <li><strong>Status:</strong> <span t-field="object.attendance_status_id"/></li>
                                <t t-if="object.notes">
                                    <li><strong>Details:</strong> <span t-field="object.notes"/></li>
                                </t>
                            </ul>
                        </p>
                        <p>If you need further information, you can contact with <t t-out="object.attendance_issue_student_id.attendance_issue_tutor_id.tutor_id.display_name"/> just replaying to this email.</p>
                        <p>
                            Kind regards,<br>
                            <t t-out="object.create_uid.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

    </data>
</odoo>