<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="mail.template" id="mail_attendance_issue_tutor" >
            <field name="name">Email notification for tutors: student attendances</field>
            <field name="model_id" ref="ems.model_ems_attendance_issue_tutor"/>
            <field name="subject">Attendance notification: daily summary</field>
            <field name="auto_delete" eval="True"/>             
            <field name="email_to">{{object.tutor_id.email}}</field> 
            <field name="email_from">ems@elpuig.xeill.net</field>
            <!-- TODO: setup reply / bounce email on settings for this purpouses? -->
            <!-- <field name="reply_to">{{object.tutor_id.email}}</field> -->

            <field name="body_html">
                <![CDATA[
                    <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;">
                        <p>
                            Dear tutor,
                        </p>
                        <p>
                            This is your students daily report, in order to inform you about today's attendance statuses:
                            <ul>
                                <li>
                                    <strong>Date: </strong><span t-field="object.issue_date"/>
                                    <ul>
                                        <t t-foreach="object.attendance_issue_student_ids" t-as="student">
                                            <li>
                                                <strong>Student: </strong><span t-field="student.student_id"/>
                                                <ul>
                                                    <t t-foreach="student.attendance_issue_status_ids" t-as="status">
                                                        <li>                                                            
                                                            <span t-field="status.attendance_session_id.attendance_schedule_id.attendance_template_id"/> | from <span t-field="status.attendance_session_id.start_time" t-options="{'widget': 'float_time'}"/> to <span t-field="status.attendance_session_id.end_time" t-options="{'widget': 'float_time'}"/>
                                                            <t t-if="status.notes">
                                                                | <span t-field="status.notes"/>
                                                            </t>
                                                        </li>                                                        
                                                    </t>
                                                </ul>
                                            </li>                                                                               
                                        </t>
                                    </ul>
                                </li>
                            </ul>
                        </p>                        
                        <p>
                            Kind regards,<br>
                            <t t-out="object.create_uid.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>