<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="mail.template" id="mail_attendance_issue_tutor" >
            <field name="name">Email notification for tutors: student attendances</field>
            <field name="model_id" ref="ems.model_ems_attendance_issue_tutor"/>
            <field name="subject">Attendance notification: daily summary</field>
            <field name="auto_delete" eval="True"/>             
            <field name="email_to">{{object.tutor_id.work_email}}</field> 
            <field name="lang">{{object.tutor_id.lang}}</field>
            <field name="email_from">ems@elpuig.xeill.net</field>
            <!-- TODO: setup reply / bounce email on settings for this purpouses? -->
            <!-- <field name="reply_to">{{object.tutor_id.email}}</field> -->

            <field name="body_html">
                <![CDATA[
                    <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;">
                        <p>
                            Dear tutor,
                        </p>
                        <p>
                            These are your students' attendance issues recorded since your previous report:
                            <ul>
                                <t t-foreach="object._tutor_report_days()" t-as="day">
                                    <li>
                                        <strong>Date: </strong><span t-field="day['issue'].issue_date"/>
                                        <ul>
                                            <t t-foreach="day['students']" t-as="student">
                                                <li>
                                                    <strong>Student: </strong><span t-out="student['student'].display_name"/>
                                                    <ul>
                                                        <t t-foreach="student['statuses']" t-as="status">
                                                            <li t-att-style="'text-decoration: line-through;' if status.rectified_by.id != False else ''">
                                                                <span t-field="status.attendance_session_id.attendance_schedule_id.attendance_template_id"/> | from <span t-field="status.attendance_session_id.start_time" t-options="{'widget': 'float_time'}"/> to <span t-field="status.attendance_session_id.end_time" t-options="{'widget': 'float_time'}"/> | <span t-if="status.attendance_status_id" t-field="status.attendance_status_id"/><t t-else="">Not required to attend (removed from the roll-call)</t>
                                                                <t t-if="status.notes">
                                                                    | <span t-field="status.notes"/>
                                                                </t>
                                                            </li>
                                                        </t>
                                                    </ul>
                                                </li>
                                            </t>
                                        </ul>
                                    </li>
                                </t>
                            </ul>
                        </p>
                        <p>
                            You can choose when you receive this report from your profile (My Profile, Preferences tab).
                        </p>
                        <p>
                            Kind regards,<br>
                            <t t-out="object.create_uid.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>