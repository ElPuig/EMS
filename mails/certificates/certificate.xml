<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Issue #835 - the emails of a certificate request, sent by ems.certificate._ems_send() to
             the applicant: the email the secretariat wrote down for a former student, else the
             student and whoever is kept informed about them. No <field name="lang">: the sender
             sets the recipient's language. The link carries the request's access token
             (portal.mixin), so it opens without logging in. -->
        <record id="email_template_certificate_form" model="mail.template">
            <field name="name">EMS: Certificate, request form</field>
            <field name="model_id" ref="ems.model_ems_certificate"/>
            <field name="subject">Your certificate request: fill in the form - {{ object.type_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            We have registered your request for a certificate: <strong t-out="object.type_id.name"/>.
                            To process it, fill in your details in this form (you do not need to log in):
                        </p>
                        <p><a t-att-href="object._ems_form_url()">Fill in the certificate request</a></p>
                        <p>If you keep a copy of the training agreement, you can attach it in the same form.</p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_certificate_info_request" model="mail.template">
            <field name="name">EMS: Certificate, documentation requested</field>
            <field name="model_id" ref="ems.model_ems_certificate"/>
            <field name="subject">Documentation needed for your certificate request - {{ object.type_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            To issue the certificate <strong t-out="object.type_id.name"/> requested for
                            <strong t-out="object.student_name or object.student_id.name"/> we need some more information:
                        </p>
                        <p style="white-space: pre-line;" t-out="object.info_request"/>
                        <p>
                            You can answer and attach the documents here:
                            <a t-att-href="object._ems_form_url()">Your certificate request</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Sent with the certificate's PDF attached (ems.certificate._ems_finish). -->
        <record id="email_template_certificate_issued" model="mail.template">
            <field name="name">EMS: Certificate, issued</field>
            <field name="model_id" ref="ems.model_ems_certificate"/>
            <field name="subject">Your certificate {{ object.name }} - {{ object.type_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            The certificate you requested, <strong t-out="object.type_id.name"/>, has been issued with
                            number <strong t-out="object.name"/>. You will find it attached to this email, and you can
                            also download it here: <a t-att-href="object._ems_form_url()">Your certificate request</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_certificate_rejected" model="mail.template">
            <field name="name">EMS: Certificate, rejected</field>
            <field name="model_id" ref="ems.model_ems_certificate"/>
            <field name="subject">Your certificate request - {{ object.type_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            The centre cannot issue the certificate <strong t-out="object.type_id.name"/> you requested,
                            for this reason:
                        </p>
                        <p style="white-space: pre-line;" t-out="object.reject_reason"/>
                        <p>If you have any questions, answer this email.</p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
