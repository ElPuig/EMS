<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Issue #507: asks a student - or, for a minor, the family - to review their contact
             data from the portal (ems.contact.data.request._ems_send_request_email). The same
             template covers the first request, the reminders (ctx subject_prefix) and a request
             returned for corrections (ctx rejection_reason).

             Modelled on res.partner (the student). Deliberately no <field name="lang">: the
             sender sets it from the ACTUAL recipient, same reason as
             mails/enrollment/authorization_send.xml. -->
        <record id="email_template_contact_data_request" model="mail.template">
            <field name="name">EMS: Contact data update request</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">{{ ctx.get('subject_prefix', '') }}Please review the contact details of {{ object.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            To keep in touch with you without problems during the academic year
                            <strong t-out="ctx.get('course_name')"/>, please review and complete the
                            contact details of <strong t-out="object.name"/> and of their family.
                        </p>
                        <t t-if="ctx.get('rejection_reason')">
                            <p>The details you sent need a correction:</p>
                            <p style="background:#eef4fb; border-left:4px solid #4a86e8; padding:8px;" t-out="ctx.get('rejection_reason')"/>
                        </t>
                        <t t-if="ctx.get('missing_fields')">
                            <p>These details are still missing:</p>
                            <ul>
                                <li t-foreach="ctx.get('missing_fields')" t-as="missing"><t t-out="missing"/></li>
                            </ul>
                        </t>
                        <p>
                            You can do it from the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/dades-contacte">Contact details</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_contact_data_request" model="mail.template" context="{'lang': 'ca_ES'}">
            <field name="subject">{{ ctx.get('subject_prefix', '') }}Reviseu les dades de contacte de {{ object.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hola,</p>
                        <p>
                            Per poder estar en contacte sense problemes durant el curs
                            <strong t-out="ctx.get('course_name')"/>, us demanem que reviseu i completeu
                            les dades de contacte de <strong t-out="object.name"/> i de la seva família.
                        </p>
                        <t t-if="ctx.get('rejection_reason')">
                            <p>Les dades que vau enviar necessiten una correcció:</p>
                            <p style="background:#eef4fb; border-left:4px solid #4a86e8; padding:8px;" t-out="ctx.get('rejection_reason')"/>
                        </t>
                        <t t-if="ctx.get('missing_fields')">
                            <p>Encara falten aquestes dades:</p>
                            <ul>
                                <li t-foreach="ctx.get('missing_fields')" t-as="missing"><t t-out="missing"/></li>
                            </ul>
                        </t>
                        <p>
                            Ho podeu fer des del portal del centre:
                            <a t-attf-href="{{ object.get_base_url() }}/ca/my/dades-contacte">Dades de contacte</a>.
                        </p>
                        <p>
                            Ben cordialment,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_contact_data_request" model="mail.template" context="{'lang': 'es_ES'}">
            <field name="subject">{{ ctx.get('subject_prefix', '') }}Revisad los datos de contacto de {{ object.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hola:</p>
                        <p>
                            Para poder estar en contacto sin problemas durante el curso
                            <strong t-out="ctx.get('course_name')"/>, os pedimos que reviséis y completéis
                            los datos de contacto de <strong t-out="object.name"/> y de su familia.
                        </p>
                        <t t-if="ctx.get('rejection_reason')">
                            <p>Los datos que enviasteis necesitan una corrección:</p>
                            <p style="background:#eef4fb; border-left:4px solid #4a86e8; padding:8px;" t-out="ctx.get('rejection_reason')"/>
                        </t>
                        <t t-if="ctx.get('missing_fields')">
                            <p>Todavía faltan estos datos:</p>
                            <ul>
                                <li t-foreach="ctx.get('missing_fields')" t-as="missing"><t t-out="missing"/></li>
                            </ul>
                        </t>
                        <p>
                            Podéis hacerlo desde el portal del centro:
                            <a t-attf-href="{{ object.get_base_url() }}/es/my/dades-contacte">Datos de contacto</a>.
                        </p>
                        <p>
                            Un cordial saludo,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

    </data>
</odoo>
