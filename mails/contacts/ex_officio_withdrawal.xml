<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Issue #726: the ex officio withdrawal's emails to the student and the family
             (res.partner._ems_student_and_family_recipients). Never sent on their own: the step's
             responsible opens them from the case file (ems.ex_officio_withdrawal.email_wizard),
             can edit the text and sends it. No <field name="lang">: the wizard renders the text in
             the recipients' language. Texts still to be agreed with Direction (drafts). -->

        <!-- Post-compulsory, tutor's step: the family was reached by phone. -->
        <record id="email_template_ex_officio_withdrawal_tutor_confirmation" model="mail.template">
            <field name="name">EMS: Ex officio withdrawal, phone call confirmed</field>
            <field name="model_id" ref="ems.model_ems_ex_officio_withdrawal"/>
            <field name="subject">Absences of {{ object.student_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>As we have just discussed by phone, we confirm that <strong t-out="object.student_id.name"/> has not been attending classes since <t t-out="format_date(object.first_absence_date)"/>.</p>
                        <p>We remind you that, under the regulations, a student who misses class for fifteen school days without justification loses their place and is withdrawn ex officio. If <strong t-out="object.student_id.name"/> does not come back to class, the centre will start this procedure.</p>
                        <p>If the student does not intend to continue their studies, please request a voluntary withdrawal at the centre's secretariat.</p>
                        <p>Kind regards,<br/><t t-out="user.name"/><br/><t t-out="user.company_id.name"/></p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Post-compulsory, tutor's step: the family could not be reached by phone. -->
        <record id="email_template_ex_officio_withdrawal_tutor_unreachable" model="mail.template">
            <field name="name">EMS: Ex officio withdrawal, family not reached by phone</field>
            <field name="model_id" ref="ems.model_ems_ex_officio_withdrawal"/>
            <field name="subject">Absences of {{ object.student_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>We are writing because we could not reach you by phone. <strong t-out="object.student_id.name"/> has not been attending classes since <t t-out="format_date(object.first_absence_date)"/>.</p>
                        <p>We remind you that, under the regulations, a student who misses class for fifteen school days without justification loses their place and is withdrawn ex officio. If <strong t-out="object.student_id.name"/> does not come back to class, the centre will start this procedure.</p>
                        <p>Please contact the tutor as soon as you can.</p>
                        <p>Kind regards,<br/><t t-out="user.name"/><br/><t t-out="user.company_id.name"/></p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Compulsory, Secretariat's notice at one month. -->
        <record id="email_template_ex_officio_withdrawal_family_notice" model="mail.template">
            <field name="name">EMS: Ex officio withdrawal, notice to the family</field>
            <field name="model_id" ref="ems.model_ems_ex_officio_withdrawal"/>
            <field name="subject">Absences of {{ object.student_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p><strong t-out="object.student_id.name"/> has not been attending the centre since <t t-out="format_date(object.first_absence_date)"/>.</p>
                        <p>We remind you that schooling is compulsory, and we ask you to contact the centre.</p>
                        <p>Kind regards,<br/><t t-out="user.company_id.name"/></p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Secretariat's ex officio withdrawal warning, both circuits. -->
        <record id="email_template_ex_officio_withdrawal_family_warning" model="mail.template">
            <field name="name">EMS: Ex officio withdrawal, warning to the family</field>
            <field name="model_id" ref="ems.model_ems_ex_officio_withdrawal"/>
            <field name="subject">Ex officio withdrawal of {{ object.student_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p><strong t-out="object.student_id.name"/> has not been attending the centre since <t t-out="format_date(object.first_absence_date)"/>.</p>
                        <p t-if="object.circuit == 'compulsory'">If the student does not come back to the centre, their ex officio withdrawal will be processed in fifteen days.</p>
                        <p t-else="">If the student does not come back to the centre, the centre will process their ex officio withdrawal. If they do not intend to continue their studies, please request a voluntary withdrawal at the secretariat.</p>
                        <p>Kind regards,<br/><t t-out="user.company_id.name"/></p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Texts the responsible copies and sends themselves (EMS never emails these bodies):
             always in the centre language (res.company.ems_lang), like the convalidation
             resolution. -->

        <!-- Compulsory, Coexistence's notice to Social Services at one month. -->
        <record id="email_template_ex_officio_withdrawal_social_services" model="mail.template">
            <field name="name">EMS: Ex officio withdrawal, text for Social Services</field>
            <field name="model_id" ref="ems.model_ems_ex_officio_withdrawal"/>
            <field name="subject">Absenteeism of {{ object.student_id.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <div>
                        <p>Hello,</p>
                        <p>We inform you that the student <t t-out="object.student_id.name"/>, of the group <t t-out="object.group_id.name"/>, has not been attending the centre since <t t-out="format_date(object.first_absence_date)"/>.</p>
                        <p>The centre has taken these actions:</p>
                        <ul><li t-foreach="object._ems_done_step_lines()" t-as="line" t-out="line"/></ul>
                        <p>Kind regards,<br/><t t-out="user.name"/><br/><t t-out="user.company_id.name"/></p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Compulsory, Direction's notice to the Inspection, with the case file PDF. -->
        <record id="email_template_ex_officio_withdrawal_inspection" model="mail.template">
            <field name="name">EMS: Ex officio withdrawal, text for the Inspection</field>
            <field name="model_id" ref="ems.model_ems_ex_officio_withdrawal"/>
            <field name="subject">Ex officio withdrawal of {{ object.student_id.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <div>
                        <p>Hello,</p>
                        <p>We inform you of the procedure followed with the student <t t-out="object.student_id.name"/>, of the group <t t-out="object.group_id.name"/>, who has not been attending the centre since <t t-out="format_date(object.first_absence_date)"/>, and that their ex officio withdrawal is being processed.</p>
                        <p>Actions taken by the centre:</p>
                        <ul><li t-foreach="object._ems_done_step_lines()" t-as="line" t-out="line"/></ul>
                        <p>The case file is attached.</p>
                        <p>Kind regards,<br/><t t-out="user.name"/><br/><t t-out="user.company_id.name"/></p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
