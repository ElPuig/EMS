<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- One email per student per batch, listing every authorization just sent to them
             (ems.authorization.send.wizard._send_notification) - not one email per
             authorization, which is how families start ignoring the channel.

             Modelled on res.partner (the student), not on ems.authorization, for the same
             reason. The list itself travels in the render context, not on the record.

             Deliberately no <field name="lang">: it would be re-resolved per record - the
             student - and override the with_context(lang=...) the wizard sets from the
             ACTUAL recipient, who for a minor is a family member with a language of their
             own. Same reason mails/coexistence/strike_notification.xml omits it. -->
        <record id="email_template_authorization_send" model="mail.template">
            <field name="name">EMS: Send Authorizations</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">New authorizations to answer - {{ ctx.get('course_name') }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            There are new authorizations to answer for
                            <strong t-out="object.name"/>, academic year
                            <strong t-out="ctx.get('course_name')"/>:
                        </p>
                        <ul>
                            <li t-foreach="ctx.get('authorization_names', [])" t-as="authorization_name">
                                <t t-out="authorization_name"/>
                            </li>
                        </ul>
                        <p>
                            You can answer them from the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/gestion-matriculas">Enrollment and authorizations</a>.
                        </p>
                        <p>A more detailed manual is available: <a t-attf-href="https://docs.ems.elpuig.xeill.net/en/families/manual-portal-alumne.html">Student portal guide.</a></p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_authorization_send" model="mail.template" context="{'lang': 'ca_ES'}">
            <field name="subject">Noves autoritzacions per respondre - {{ ctx.get('course_name') }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hola,</p>
                        <p>
                            Hi ha noves autoritzacions per respondre per a
                            <strong t-out="object.name"/>, curs
                            <strong t-out="ctx.get('course_name')"/>:
                        </p>
                        <ul>
                            <li t-foreach="ctx.get('authorization_names', [])" t-as="authorization_name">
                                <t t-out="authorization_name"/>
                            </li>
                        </ul>
                        <p>
                            Les podeu respondre des del portal del centre:
                            <a t-attf-href="{{ object.get_base_url() }}/ca/my/gestion-matriculas">Matrícula i autoritzacions</a>.
                        </p>
                        <p>Teniu disponible un manual més detallat: <a t-attf-href="https://docs.ems.elpuig.xeill.net/ca/families/manual-portal-alumne.html">Guia del portal de l'alumnat.</a></p>
                        <p>
                            Ben cordialment,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_authorization_send" model="mail.template" context="{'lang': 'es_ES'}">
            <field name="subject">Nuevas autorizaciones para responder - {{ ctx.get('course_name') }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hola:</p>
                        <p>
                            Hay nuevas autorizaciones para responder para
                            <strong t-out="object.name"/>, curso
                            <strong t-out="ctx.get('course_name')"/>:
                        </p>
                        <ul>
                            <li t-foreach="ctx.get('authorization_names', [])" t-as="authorization_name">
                                <t t-out="authorization_name"/>
                            </li>
                        </ul>
                        <p>
                            Podéis responderlas desde el portal del centro:
                            <a t-attf-href="{{ object.get_base_url() }}/es/my/gestion-matriculas">Matrícula y autorizaciones</a>.
                        </p>
                        <p>Tenéis disponible un manual más detallado: <a t-attf-href="https://docs.ems.elpuig.xeill.net/es/families/manual-portal-alumne.html">Guía del portal del alumnado.</a></p>
                        <p>
                            Un cordial saludo,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

    </data>
</odoo>
