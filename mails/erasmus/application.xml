<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Issue #683: the receipt sent to the applicant each time they submit (art. 7 of the
             call), listing the files received. Sent to the applicant's own address only, in
             their language (ems.erasmus.application._ems_send). -->
        <record id="email_template_erasmus_application_submitted" model="mail.template">
            <field name="name">EMS: Erasmus+, application submitted</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application"/>
            <field name="reply_to">{{ object.env.company.erasmus_contact_email or '' }}</field>
            <field name="subject">Erasmus+: application received - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            We have received your application to <strong t-out="object.call_id.name"/>.
                            These are the documents you sent:
                        </p>
                        <t t-out="object._ems_mail_document_list(object.document_ids.filtered('attachment_ids'))"/>
                        <p>
                            You can follow your application on the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Issue #683: the Erasmus team asks for corrections (art. 9 of the call). -->
        <record id="email_template_erasmus_application_subsanation" model="mail.template">
            <field name="name">EMS: Erasmus+, corrections requested</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application"/>
            <field name="subject">Erasmus+: your application needs corrections - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            Your application to <strong t-out="object.call_id.name"/> is incomplete.
                            Please correct or add these documents:
                        </p>
                        <ul>
                            <t t-foreach="object.document_ids.filtered('correction_requested')" t-as="line">
                                <li><t t-out="line.name"/><t t-if="line.review_comment">: <t t-out="line.review_comment"/></t></li>
                            </t>
                        </ul>
                        <p t-if="object.call_id.subsanation_deadline">
                            You have until <strong t-out="object.call_id._ems_local_deadline()"/>.
                            If the application is not corrected in time, it will be excluded.
                        </p>
                        <p>
                            Upload them on the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Issue #684: the call to the personal interview, at least 24 hours ahead (art. 11). -->
        <record id="email_template_erasmus_interview_call" model="mail.template">
            <field name="name">EMS: Erasmus+, interview call</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application"/>
            <field name="subject">Erasmus+: your interview - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            You are called to the personal interview of <strong t-out="object.call_id.name"/>:
                        </p>
                        <ul>
                            <li>Date and time: <strong t-out="object.call_id._ems_local_format(object.interview_date)"/></li>
                            <li t-if="object.interview_place">Place: <strong t-out="object.interview_place"/></li>
                        </ul>
                        <p>
                            Part of the interview is in English. Please arrive 15 minutes early.
                            Not attending excludes you from the selection, unless for a justified reason
                            of force majeure.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
        <!-- The 2026-11-03 review: excluded once the admission list is published (e.g. not
             attending the interview, art. 11): the reason now, not at the next list. -->
        <record id="email_template_erasmus_application_excluded" model="mail.template">
            <field name="name">EMS: Erasmus+, application excluded</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application"/>
            <field name="subject">Erasmus+: your application has been excluded - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>Your application to <strong t-out="object.call_id.name"/> has been excluded from the selection.</p>
                        <p>Reason: <t t-out="object.exclusion_reason"/></p>
                        <p t-if="'provisional' in object.call_id._ems_published_resolutions().mapped('kind')">
                            The exclusion will appear in the next published list. If you think it is a mistake, talk to the Erasmus team.
                        </p>
                        <p t-else="">
                            The exclusion will appear in the next published list. If you disagree, you will be able
                            to claim against the provisional resolution, from the Erasmus+ page of the school portal.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
