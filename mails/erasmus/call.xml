<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- The issue-#682 review: the notice of the open call, sent by the Erasmus team (Actions >
             Notify who can apply) to each person who can apply, at their own address and in their
             language (ems.erasmus.call._ems_announce). Rendered on the call. -->
        <record id="email_template_erasmus_call_open" model="mail.template">
            <field name="name">EMS: Erasmus+, call open</field>
            <field name="model_id" ref="ems.model_ems_erasmus_call"/>
            <field name="reply_to">{{ object.env.company.erasmus_contact_email or '' }}</field>
            <field name="subject">Erasmus+: the call {{ object.name }} is open</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p t-if="object.audience == 'staff'">
                            The call <strong t-out="object.name"/> for the vocational training staff is open:
                            job shadowing, structured courses and teaching assignments abroad.
                        </p>
                        <p t-else="">
                            The call <strong t-out="object.name"/> is open: Erasmus+ internships abroad for the
                            students of your studies.
                        </p>
                        <p>
                            You can apply on the school portal from <strong t-out="object._ems_local_format(object.date_open)"/>
                            until <strong t-out="object._ems_local_format(object.date_close)"/>:
                            <a t-attf-href="{{ object.get_base_url() }}/my/erasmus/call/{{ object.id }}">Erasmus+</a>.
                            You will also find the rules of the call there.
                        </p>
                        <p>If you have any question, reply to this email.</p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- The issue-#682 review: the reminder before the closing date, to whoever can apply and has
             not submitted (ems.erasmus.call._cron_remind_closing). -->
        <record id="email_template_erasmus_call_reminder" model="mail.template">
            <field name="name">EMS: Erasmus+, call about to close</field>
            <field name="model_id" ref="ems.model_ems_erasmus_call"/>
            <field name="reply_to">{{ object.env.company.erasmus_contact_email or '' }}</field>
            <field name="subject">Erasmus+: the call {{ object.name }} closes soon</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            The call <strong t-out="object.name"/> closes on
                            <strong t-out="object._ems_local_format(object.date_close)"/>, and you have not
                            submitted an application. If you started one, remember to send it: a draft does not count.
                        </p>
                        <p>
                            If you want to take part, apply on the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/erasmus/call/{{ object.id }}">Erasmus+</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
