<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Issue #702 - each student's own result of a group mobility's selection, when the
             coordinator approves it (and when a substitution makes a reserve selected). Never the
             classmates' grades nor anyone's conduct warnings. -->
        <record id="email_template_erasmus_group_result" model="mail.template">
            <field name="name">EMS: Erasmus+, group mobility result</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_registration"/>
            <field name="subject">Erasmus+: result of your enrolment - {{ object.group_mobility_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <t t-if="object.result == 'selected'">
                            <p>
                                You have been <strong>selected</strong> for the Erasmus+ group mobility
                                <strong t-out="object.group_mobility_id.name"/>.
                            </p>
                            <p>
                                On the school portal (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>)
                                you will find the documents to hand in and their deadlines. If you cannot go, say so
                                there as soon as possible, so that the next person on the reserve list can take the place.
                            </p>
                        </t>
                        <p t-elif="object.result == 'reserve'">
                            You are on the <strong>reserve list</strong> of the Erasmus+ group mobility
                            <strong t-out="object.group_mobility_id.name"/>, number <strong t-out="object.reserve_position"/>.
                            If a place becomes free, we will contact you.
                        </p>
                        <p t-else="">
                            Your enrolment in the Erasmus+ group mobility <strong t-out="object.group_mobility_id.name"/>
                            does not meet the requirements of the selection criteria published with the enrolment.
                            If you think this is a mistake, talk to the Erasmus team.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
        <!-- Issue #703 - the family of a selected minor, when the file opens: it accepts the
             commitment letter on its own portal. -->
        <record id="email_template_erasmus_group_commitment_guardian" model="mail.template">
            <field name="name">EMS: Erasmus+, group mobility commitment letter for the family to sign</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_participant"/>
            <field name="subject">Erasmus+: commitment letter to sign - {{ object.partner_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            <t t-out="object.partner_id.name"/> has been selected for the Erasmus+ group mobility
                            <strong t-out="object.group_mobility_id.name"/>. As they are a minor, the family has to
                            read and accept the commitment letter of the mobility.
                        </p>
                        <p>
                            You will find it on the school portal
                            (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>).
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
