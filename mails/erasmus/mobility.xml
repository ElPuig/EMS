<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Issue #687 - Erasmus+ mobility preparation. See docs/en/developers/erasmus/erasmus.md. -->
        <record id="email_template_erasmus_choice_turn" model="mail.template">
            <field name="name">EMS: Erasmus+, your turn to choose the destination</field>
            <field name="model_id" ref="ems.model_ems_erasmus_mobility"/>
            <field name="subject">Erasmus+: choose your destination - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            It is your turn to choose the destination of your Erasmus+ mobility
                            (<strong t-out="object.call_id.name"/>), among the destinations that still have places.
                        </p>
                        <p t-if="object.turn_deadline">
                            Choose it on the school portal
                            (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>)
                            before <strong t-out="object._ems_local_format(object.turn_deadline)"/>.
                            Without an answer by then, the turn passes to the next person and you will choose among
                            the destinations left at the end.
                        </p>
                        <p t-else="">
                            Everyone else has already chosen: choose it on the school portal
                            (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>) as soon as you can.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_erasmus_mobility_assigned" model="mail.template">
            <field name="name">EMS: Erasmus+, destination assigned</field>
            <field name="model_id" ref="ems.model_ems_erasmus_mobility"/>
            <field name="subject">Erasmus+: your destination - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            The destination of your Erasmus+ mobility is
                            <strong t-out="object.destination_id.name or ', '.join(filter(None, [object.city, object.country_id.name]))"/>.
                        </p>
                        <p>
                            Now you can prepare it: on the school portal
                            (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>) you will find the
                            documents to hand in, who signs each one, the deadlines and the steps to follow.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_erasmus_proposal_rejected" model="mail.template">
            <field name="name">EMS: Erasmus+, proposal not validated</field>
            <field name="model_id" ref="ems.model_ems_erasmus_mobility"/>
            <field name="subject">Erasmus+: your proposal was not validated - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            Your proposal for the Erasmus+ mobility (<strong t-out="object.call_id.name"/>) has not
                            been validated, for this reason:
                        </p>
                        <p style="white-space: pre-line;" t-out="object.decision_note"/>
                        <p t-if="object.audience == 'staff'">
                            You can propose another activity on the school portal
                            (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>).
                        </p>
                        <p t-else="">
                            You can choose one of the centre's destinations on the school portal
                            (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>) when your turn comes.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_erasmus_mobility_documents" model="mail.template">
            <field name="name">EMS: Erasmus+, mobility documents pending</field>
            <field name="model_id" ref="ems.model_ems_erasmus_mobility"/>
            <field name="subject">Erasmus+: documents pending - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            Your Erasmus+ mobility (<strong t-out="object.call_id.name"/>) still has things pending.
                        </p>
                        <t t-if="object._ems_documents_to_correct()">
                            <p>These documents are missing or need changes:</p>
                            <t t-out="object._ems_mail_document_list()"/>
                        </t>
                        <p t-if="object.commitment_pending">
                            You have to accept and sign the commitment letter on the portal.
                        </p>
                        <p>
                            You will find everything on the school portal
                            (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>), with the team's
                            comments and the deadlines.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
