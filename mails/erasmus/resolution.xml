<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Issue #685: each applicant's result when a resolution is published (art. 14), sent to
             their own address (ems.erasmus.application._ems_mail), with a copy to a minor's family
             when it offers them a place. Replies reach whoever published it. The list of who goes
             says how to appeal it. -->
        <record id="email_template_erasmus_resolution_published" model="mail.template">
            <field name="name">EMS: Erasmus+, resolution published</field>
            <field name="model_id" ref="ems.model_ems_erasmus_resolution_line"/>
            <field name="subject">Erasmus+: {{ object.resolution_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <t t-set="call" t-value="object.resolution_id.call_id"/>
                        <t t-set="claims_deadline" t-value="call.claims_deadline or object.resolution_id.group_mobility_id.claims_deadline"/>
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            A new list has been published: <strong t-out="object.resolution_id.name"/>.
                        </p>
                        <p t-if="object.resolution_id.notes" t-out="object.resolution_id.notes"/>
                        <t t-if="object.result == 'excluded'">
                            <p>Your application has been excluded.</p>
                            <p t-if="object.exclusion_reason">Reason: <t t-out="object.exclusion_reason"/></p>
                        </t>
                        <p t-elif="object.result == 'admitted' and object.audience == 'staff'">
                            Your application has been admitted. The panel will now rate your mobility plan.
                        </p>
                        <p t-elif="object.result == 'admitted'">
                            Your application has been admitted. The Erasmus team will call you to the personal interview.
                        </p>
                        <t t-else="">
                            <p t-if="object.audience == 'staff'">
                                Position <strong t-out="object.rank"/>, <strong t-out="object._ems_format_score()"/> points.
                            </p>
                            <p t-elif="object.group_registration_id">
                                Position <strong t-out="object.rank"/>, record average <strong t-out="object._ems_format_score()"/>.
                            </p>
                            <p t-else="">
                                Modality <strong t-out="object.modality_id.name"/>: position <strong t-out="object.rank"/>,
                                <strong t-out="object._ems_format_score()"/> points.
                            </p>
                            <t t-if="object.resolution_id.kind == 'provisional'">
                                <p t-if="object.result == 'selected'">With this provisional result you would get a place.</p>
                                <p t-elif="object.result == 'reserve'">With this provisional result you would be on the reserve list.</p>
                                <p t-else="">With this provisional result you do not reach the minimum score.</p>
                                <p>
                                    If you disagree, you can claim from the Erasmus+ page of the EMS portal
                                    <t t-if="claims_deadline">until <strong t-out="object.env['ems.erasmus.call']._ems_local_format(claims_deadline)"/></t>.
                                </p>
                            </t>
                            <t t-else="">
                                <p t-if="object.application_id.state == 'accepted'">
                                    You keep the place you have already accepted.
                                </p>
                                <p t-elif="object.application_id._ems_offer_expired()">
                                    You did not answer the place offer in time earlier: this list does not change it.
                                </p>
                                <p t-elif="object.application_id.state == 'renounced'">
                                    You renounced the place earlier: this list does not change it.
                                </p>
                                <p t-elif="object.result == 'selected'">
                                    You have been <strong>selected</strong>. Accept or renounce the place on the school portal
                                    before <strong t-out="call._ems_local_format(call.acceptance_deadline)"/>:
                                    without an answer by then, the place is considered renounced.
                                </p>
                                <p t-elif="object.result == 'reserve'">
                                    You are on the <strong>reserve list</strong>, number <strong t-out="object._ems_reserve_number()"/><t t-if="object.audience == 'student'"> of <t t-out="object.modality_id.name"/></t>.
                                    If a place becomes free, we will offer it to you by email.
                                </p>
                                <p t-else="">You have not been selected: you do not reach the minimum score.</p>
                            </t>
                        </t>
                        <p t-if="object.resolution_id.kind in ('definitive', 'rectification')" t-out="object.resolution_id._ems_appeal_notice()"/>
                        <p t-if="object.result in ('excluded', 'admitted')">
                            You can see the published list on the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>.
                        </p>
                        <p t-else="">
                            You can see the detail of your score and the published list on the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- Issue #685: a place left free, offered to the next reserve once the team confirms it. -->
        <record id="email_template_erasmus_offer" model="mail.template">
            <field name="name">EMS: Erasmus+, place offered</field>
            <field name="model_id" ref="ems.model_ems_erasmus_offer"/>
            <field name="subject">Erasmus+: a place is offered to you - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p t-if="object.modality_id and object.call_id.audience == 'student'">
                            A place of the modality <strong t-out="object.modality_id.name"/> of
                            <strong t-out="object.call_id.name"/> has become free and it is offered to you.
                        </p>
                        <p t-else="">
                            A place of <strong t-out="object.call_id.name"/> has become free and it is offered to you.
                        </p>
                        <p>
                            Accept or renounce it on the school portal
                            (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>)
                            before <strong t-out="object.call_id._ems_local_format(object.deadline)"/>.
                            Without an answer by then, the place is considered renounced.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
        <!-- The 2026-11-03 review: proof that a claim or an appeal arrived, and when (art. 14),
             whether it was sent from the portal or recorded by the Erasmus team. -->
        <record id="email_template_erasmus_claim_received" model="mail.template">
            <field name="name">EMS: Erasmus+, claim received</field>
            <field name="model_id" ref="ems.model_ems_erasmus_claim"/>
            <field name="subject">Erasmus+: we have received your claim - {{ (object.call_id or object.group_mobility_id).name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p t-if="object.kind == 'appeal'">
                            We have received your appeal<t t-if="object.resolution_id"> against <strong t-out="object.resolution_id.name"/></t>
                            on <strong t-out="object.env['ems.erasmus.call']._ems_local_format(object.create_date)"/>.
                            The Head of Studies will answer it.
                        </p>
                        <p t-else="">
                            We have received your claim<t t-if="object.resolution_id"> against <strong t-out="object.resolution_id.name"/></t>
                            on <strong t-out="object.env['ems.erasmus.call']._ems_local_format(object.create_date)"/>.
                            The Erasmus team will answer it.
                        </p>
                        <p>You will receive the answer by email. Keep this email as proof that you sent it.</p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- The 2026-11-03 review: the answer to a claim or an appeal, so the applicant does not
             have to look for it on the portal. -->
        <record id="email_template_erasmus_claim_resolved" model="mail.template">
            <field name="name">EMS: Erasmus+, claim answered</field>
            <field name="model_id" ref="ems.model_ems_erasmus_claim"/>
            <field name="subject">Erasmus+: your claim has been answered - {{ (object.call_id or object.group_mobility_id).name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p t-if="object.kind == 'appeal'">Your appeal has been answered:</p>
                        <p t-else="">Your claim has been answered:</p>
                        <p style="white-space: pre-line; border-left: 3px solid #dadce0; padding-left: 8px;" t-out="object.response"/>
                        <p>
                            You can also see it on the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <!-- The 2026-11-03 review: proof of the answer to a place offer (art. 15: accepted in
             writing), or that the deadline passed without one, with a copy to a minor's family. -->
        <record id="email_template_erasmus_offer_answer" model="mail.template">
            <field name="name">EMS: Erasmus+, answer to the place offer</field>
            <field name="model_id" ref="ems.model_ems_erasmus_offer"/>
            <field name="subject">Erasmus+: your place - {{ object.call_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ user.partner_id._ems_reply_to() or object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <t t-set="call" t-value="object.call_id"/>
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <t t-if="object.state == 'accepted'">
                            <p>
                                We have received your acceptance of the place<t t-if="object.modality_id and call.audience == 'student'"> of
                                <strong t-out="object.modality_id.name"/></t> of <strong t-out="call.name"/>
                                on <strong t-out="call._ems_local_format(object.answer_date)"/>.
                            </p>
                            <p>
                                On the school portal (<a t-attf-href="{{ object.get_base_url() }}/my/erasmus">Erasmus+</a>)
                                you will find the next steps. We will email you whenever you have to do something.
                            </p>
                        </t>
                        <p t-elif="object.state == 'renounced'">
                            We have received your renunciation of the place<t t-if="object.modality_id and call.audience == 'student'"> of
                            <strong t-out="object.modality_id.name"/></t> of <strong t-out="call.name"/>
                            on <strong t-out="call._ems_local_format(object.answer_date)"/>.
                            The place will be offered to the next person on the reserve list.
                        </p>
                        <p t-else="">
                            The deadline to answer the place offered to you in <strong t-out="call.name"/>
                            (<t t-out="call._ems_local_format(object.deadline)"/>) has passed without an answer.
                            As the call says, the place is considered renounced and will be offered to the next
                            person on the reserve list.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
