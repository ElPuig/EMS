<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- The satisfaction survey of a student's Erasmus+ stay: when it opens and as a reminder at 3
             and 7 days (staff get a to-do instead). See docs/en/developers/erasmus/quality.md. -->
        <record id="email_template_erasmus_satisfaction" model="mail.template">
            <field name="name">EMS: Erasmus+, satisfaction survey</field>
            <field name="model_id" ref="ems.model_ems_erasmus_satisfaction"/>
            <field name="subject">Erasmus+: how was your stay?</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.erasmus_contact_email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">ems.mail_notification_erasmus</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello <t t-out="object.partner_id.name"/>,</p>
                        <p>
                            Your Erasmus+ stay is over. Please tell us how satisfied you are with the experience: it
                            is a single question, and it helps us improve the mobilities of the students who come
                            after you.
                        </p>
                        <p>
                            <a t-att-href="object._ems_portal_url()"
                               style="background-color: #970A2C; color: #ffffff; padding: 8px 16px; text-decoration: none; border-radius: 4px;">Answer the survey</a>
                        </p>
                        <p>Your mobility is not closed until the survey is answered.</p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
