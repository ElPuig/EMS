<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Sent when the Head of Studies asks the applicant for more documentation
             (ems.convalidation.info_wizard), to the student when adult and to the family when a
             minor. The text itself travels in the context ('ems_info_request'), written by
             whoever asks: the template only wraps it. No <field name="lang">, for the same
             reason as mails/grades/convalidation_resolved.xml: the sender sets the recipient's
             language. -->
        <record id="email_template_convalidation_info_request" model="mail.template">
            <field name="name">EMS: Convalidation, documentation requested</field>
            <field name="model_id" ref="ems.model_ems_convalidation"/>
            <field name="subject">Documentation needed for your convalidation request - {{ object.student_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            To resolve the convalidation request of <strong t-out="object.student_id.name"/>
                            for <strong t-out="object.study_id.name"/> we need some more information:
                        </p>
                        <p style="white-space: pre-line;" t-out="ctx.get('ems_info_request')"/>
                        <p>
                            You can answer and attach the documents on the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/convalidaciones">Convalidations</a>.
                        </p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_convalidation_info_request" model="mail.template" context="{'lang': 'ca_ES'}">
            <field name="subject">Cal documentació per a la sol·licitud de convalidació - {{ object.student_id.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hola,</p>
                        <p>
                            Per resoldre la sol·licitud de convalidació de <strong t-out="object.student_id.name"/>
                            per a <strong t-out="object.study_id.name"/> ens cal més informació:
                        </p>
                        <p style="white-space: pre-line;" t-out="ctx.get('ems_info_request')"/>
                        <p>
                            Podeu respondre i adjuntar la documentació al portal del centre:
                            <a t-attf-href="{{ object.get_base_url() }}/ca/my/convalidaciones">Convalidacions</a>.
                        </p>
                        <p>
                            Ben cordialment,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_convalidation_info_request" model="mail.template" context="{'lang': 'es_ES'}">
            <field name="subject">Falta documentación para la solicitud de convalidación - {{ object.student_id.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hola:</p>
                        <p>
                            Para resolver la solicitud de convalidación de <strong t-out="object.student_id.name"/>
                            para <strong t-out="object.study_id.name"/> necesitamos algo más de información:
                        </p>
                        <p style="white-space: pre-line;" t-out="ctx.get('ems_info_request')"/>
                        <p>
                            Podéis responder y adjuntar la documentación desde el portal del centro:
                            <a t-attf-href="{{ object.get_base_url() }}/es/my/convalidaciones">Convalidaciones</a>.
                        </p>
                        <p>
                            Un cordial saludo,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

    </data>
</odoo>
