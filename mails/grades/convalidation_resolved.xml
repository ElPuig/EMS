<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Sent once a convalidation request is fully resolved
             (ems.convalidation._ems_send_resolution), to the student when adult and to the
             family when a minor. No <field name="lang">, for the same reason as
             mails/enrollment/authorization_send.xml: the sender sets the recipient's language.
             The resolution labels are written in each translation instead of read from the
             selection, so each block stays in a single language. -->
        <record id="email_template_convalidation_resolved" model="mail.template">
            <field name="name">EMS: Convalidation resolved</field>
            <field name="model_id" ref="ems.model_ems_convalidation"/>
            <field name="subject">Convalidation request resolved - {{ object.student_id.name }}</field>
            <field name="email_from">{{ user.company_id.name }} &lt;{{ user.company_id.email }}&gt;</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hello,</p>
                        <p>
                            The convalidation request <strong t-out="object.name"/> of <strong t-out="object.student_id.name"/>
                            for <strong t-out="object.study_id.name"/> has been resolved:
                        </p>
                        <ul>
                            <li t-foreach="object.line_ids" t-as="line">
                                <t t-out="line.subject_id.display_name"/>:
                                <strong t-if="line.state == 'granted'">convalidated</strong>
                                <t t-if="line.state == 'granted'"> (grade <t t-out="line.grade"/>)</t>
                                <strong t-if="line.state != 'granted'">rejected</strong>
                                <t t-if="line.resolution_notes"> (<t t-out="line.resolution_notes"/>)</t>
                            </li>
                        </ul>
                        <p t-if="object.resolution_notes" t-out="object.resolution_notes"/>
                        <p>
                            You can check it on the school portal:
                            <a t-attf-href="{{ object.get_base_url() }}/my/convalidaciones">Convalidations</a>.
                        </p>
                        <p>A more detailed manual is available: <a t-attf-href="https://docs.ems.elpuig.xeill.net/en/families/manual-convalidacions.html">Requesting convalidations from the portal.</a></p>
                        <p>
                            Kind regards,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_convalidation_resolved" model="mail.template" context="{'lang': 'ca_ES'}">
            <field name="subject">Sol·licitud de convalidació resolta - {{ object.student_id.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hola,</p>
                        <p>
                            S'ha resolt la sol·licitud de convalidació <strong t-out="object.name"/> de <strong t-out="object.student_id.name"/>
                            per a <strong t-out="object.study_id.name"/>:
                        </p>
                        <ul>
                            <li t-foreach="object.line_ids" t-as="line">
                                <t t-out="line.subject_id.display_name"/>:
                                <strong t-if="line.state == 'granted'">convalidat</strong>
                                <t t-if="line.state == 'granted'"> (nota <t t-out="line.grade"/>)</t>
                                <strong t-if="line.state != 'granted'">denegat</strong>
                                <t t-if="line.resolution_notes"> (<t t-out="line.resolution_notes"/>)</t>
                            </li>
                        </ul>
                        <p t-if="object.resolution_notes" t-out="object.resolution_notes"/>
                        <p>
                            La podeu consultar al portal del centre:
                            <a t-attf-href="{{ object.get_base_url() }}/ca/my/convalidaciones">Convalidacions</a>.
                        </p>
                        <p>Teniu disponible un manual més detallat: <a t-attf-href="https://docs.ems.elpuig.xeill.net/ca/families/manual-convalidacions.html">Sol·licitar convalidacions des del portal.</a></p>
                        <p>
                            Ben cordialment,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

        <record id="email_template_convalidation_resolved" model="mail.template" context="{'lang': 'es_ES'}">
            <field name="subject">Solicitud de convalidación resuelta - {{ object.student_id.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; font-size: 14px;">
                        <p>Hola:</p>
                        <p>
                            Se ha resuelto la solicitud de convalidación <strong t-out="object.name"/> de <strong t-out="object.student_id.name"/>
                            para <strong t-out="object.study_id.name"/>:
                        </p>
                        <ul>
                            <li t-foreach="object.line_ids" t-as="line">
                                <t t-out="line.subject_id.display_name"/>:
                                <strong t-if="line.state == 'granted'">convalidado</strong>
                                <t t-if="line.state == 'granted'"> (nota <t t-out="line.grade"/>)</t>
                                <strong t-if="line.state != 'granted'">denegado</strong>
                                <t t-if="line.resolution_notes"> (<t t-out="line.resolution_notes"/>)</t>
                            </li>
                        </ul>
                        <p t-if="object.resolution_notes" t-out="object.resolution_notes"/>
                        <p>
                            Podéis consultarla desde el portal del centro:
                            <a t-attf-href="{{ object.get_base_url() }}/es/my/convalidaciones">Convalidaciones</a>.
                        </p>
                        <p>Tenéis disponible un manual más detallado: <a t-attf-href="https://docs.ems.elpuig.xeill.net/es/families/manual-convalidacions.html">Solicitar convalidaciones desde el portal.</a></p>
                        <p>
                            Un cordial saludo,<br/>
                            <t t-out="user.company_id.name"/>
                            <t t-if="user.company_id.phone"><br/>📞 <t t-out="user.company_id.phone"/></t>
                            <t t-if="user.company_id.email"><br/>✉️ <t t-out="user.company_id.email"/></t>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

    </data>
</odoo>
