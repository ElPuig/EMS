<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Reusable A3 landscape paperformat - same margins/dpi/css_margins as base Odoo's own
             default 'paperformat_euro' (base/data/report_paperformat_data.xml), only format/
             orientation differ. Not guard-duty-specific by name: this is the first EMS report
             wide enough to need it, but any future one (a school-wide timetable, say) can
             reference this same record instead of each defining its own. A3 (420x297mm usable),
             not A4 (297x210mm) - developer feedback (2026-09-01): even landscape A4 still felt
             too cramped for a real school's full column count. -->
        <record id="paperformat_a3_landscape" model="report.paperformat">
            <field name="name">A3 Landscape</field>
            <field name="format">A3</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">52</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">52</field>
            <field name="dpi">90</field>
            <field name="css_margins" eval="True"/>
        </record>

        <record id="action_report_guard_duty_board" model="ir.actions.report">
            <field name="name">Guard Duty Schedule</field>
            <field name="model">ems.course</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ems.report_guard_duty_board</field>
            <field name="report_file">ems.report_guard_duty_board</field>
            <field name="print_report_name">'Guard Duty Schedule - %s' % (object.name)</field>
            <!-- Landscape A3: this board is wide (one column per group, easily a dozen+) - the
                 site default (portrait A4, base.paperformat_euro) left far too little usable
                 width, and even landscape A4 alone still felt cramped in practice. -->
            <field name="paperformat_id" ref="paperformat_a3_landscape"/>
        </record>

        <template id="report_guard_duty_board">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="course">
                    <!-- One PDF is always for a single day AND a single shift (see
                         guard_duty_board.js's own 'guard_duty_weekday'/'guard_duty_shift'
                         context keys, set from whichever day tab / shift dropdown was active
                         when "PDF" was clicked) - the full-week/both-shifts fallback below is
                         only defensive, this report has no other caller that would omit them. -->
                    <t t-set="requested_weekday" t-value="course.env.context.get('guard_duty_weekday')"/>
                    <t t-set="weekdays" t-value="[requested_weekday] if requested_weekday else ['0', '1', '2', '3', '4']"/>
                    <t t-set="requested_shift" t-value="course.env.context.get('guard_duty_shift')"/>
                    <t t-set="shifts" t-value="[requested_shift] if requested_shift else ['morning', 'afternoon']"/>
                    <!-- The area filter (issue #637): forwarded the same way as
                         'guard_duty_weekday'/'guard_duty_shift' above - falsy/absent means "All
                         areas". -->
                    <t t-set="requested_area_ids" t-value="course.env.context.get('guard_duty_area_ids')"/>
                    <!-- The concrete date that weekday stands for, set from the screen's own date
                         picker. Absences happen on dates, so without one the printed board is the
                         plain timetable it always was - which is also what any other caller that
                         omits it keeps getting. -->
                    <t t-set="requested_date" t-value="course.env.context.get('guard_duty_date')"/>
                    <!-- Which of the board's two tabs is being printed (found 2026-09-11): the
                         schedule (timetable-shaped) or the "Absences table" (who's missing / who's
                         covering) - falsy/absent means the original, still-default schedule view,
                         same fallback convention as every other 'guard_duty_*' context key above. -->
                    <t t-set="requested_view" t-value="course.env.context.get('guard_duty_view') or 'schedule'"/>
                    <t t-foreach="weekdays" t-as="weekday">
                        <t t-call="web.external_layout">
                            <div class="page">
                                <style>
                                    .gdb-title { font-size: 20px; margin-bottom: 10px; }
                                    .gdb-shift-title { font-size: 13px; font-weight: 600; margin: 12px 0 4px 0; }
                                    .gdb-table { font-size: 10px; table-layout: fixed; margin-bottom: 6px; }
                                    .gdb-table th, .gdb-table td { padding: 4px 6px !important; text-align: center; vertical-align: middle; overflow: hidden; }
                                    .gdb-table td.gdb-time { white-space: nowrap; font-weight: bold; }
                                    /* Every group column shares this exact width - same reasoning
                                       as the live screen's .o_guard_board_col_group (see
                                       guard_duty_board.css): fixed, predictable, identical across
                                       every table, not auto-sized from each cell's own content.
                                       Time block (first) and Guard duty (last) carry denser
                                       content (a full time range; one badge per teacher on duty),
                                       so they get more room than a single group's own column.
                                       Sized for A3 landscape's ~420mm (~1490px @ 90dpi) usable
                                       width, not just carried over unchanged from the earlier A4
                                       attempt - a bigger page alone doesn't widen a table with
                                       fixed pixel columns, it only adds blank margin around the
                                       same-sized one (found the hard way, 2026-09-01: switching
                                       the paperformat to A3 first with the old A4-sized widths
                                       still in place changed nothing about how cramped it looked).
                                       10 group columns at this width use ~1150px of the ~1490px
                                       available - comfortable for a real school's own column
                                       count, though an unusually large centre with many more
                                       groups in one shift may still need these trimmed back down. */
                                    .gdb-col-time { width: 85px; }
                                    .gdb-col-group { width: 115px; }
                                    .gdb-col-guard { width: 160px; }
                                    /* The "Absences table" tab has only 3 columns (no per-group
                                       ones) - the absences column gets whatever width the fixed
                                       time/guard columns leave, rather than a fixed size of its
                                       own, since one row can list several classes left uncovered. */
                                    .gdb-col-absences { width: auto; }
                                    .gdb-absence-row { text-align: left; }
                                    .gdb-absence-row + .gdb-absence-row { margin-top: 4px; }
                                    .gdb-absence-class { display: block; font-size: 8px; color: #555; }
                                    /* overflow-wrap/word-break: table-layout:fixed only holds a
                                       column to its declared width if content CAN break - an
                                       unbroken run of text (e.g. an unlinked "Pending teacher
                                       (email@...)" placeholder) otherwise still forces that one
                                       column (and, via border-collapse, every row's column)
                                       wider than the rest, defeating the fixed/uniform widths
                                       above (found in a real generated PDF, 2026-08-31). */
                                    .gdb-cell-subject { display: block; font-weight: 600; overflow-wrap: break-word; word-break: break-word; }
                                    .gdb-cell-teacher, .gdb-cell-room { display: block; font-size: 8px; overflow-wrap: break-word; word-break: break-word; }
                                    /* No background colour anywhere in the table at all now
                                       (developer feedback, 2026-09-01, second pass: "quitar el
                                       color de fondo de los nombres de las personas que están de
                                       guardia" - the first pass had deliberately kept this one).
                                       A thin border replaces the colour fill, purely to keep
                                       several names in the same cell visually separated. */
                                    .gdb-guard-badge { display: inline-block; border: 1px solid #ccc; border-radius: 3px; padding: 1px 4px; margin: 1px; font-weight: 600; overflow-wrap: break-word; word-break: break-word; }
                                    /* The one colour on the page, same reasoning as the live
                                       screen's own .o_guard_board_absent: an approved absence is
                                       a fact to plan around, a request still awaiting its
                                       approver is only a warning. */
                                    .gdb-absent { color: #b52a37; font-weight: 700; }
                                    .gdb-absent-pending { color: #b52a37; font-style: italic; }
                                    /* Same as the screen's .o_guard_board_absence_covered: a co-taught
                                       class whose other teacher is in needs no guard. */
                                    .gdb-absence-covered > .gdb-absent, .gdb-absence-covered > .gdb-absent-pending { text-decoration: line-through; opacity: 0.6; }
                                    .gdb-absence-tag { display: inline-block; margin-left: 4px; padding: 0 3px; border: 1px solid #999; border-radius: 2px; }
                                    /* Same as the screen's .o_guard_board_guard_busy: a guard who is with a
                                       group through an internal arrangement (issue #605) cannot cover. */
                                    .gdb-guard-busy { text-decoration: line-through; opacity: 0.6; }
                                    /* Same pairing colours as the screen's o_guard_board_cover_N
                                       (static/src/css/backend/guard_duty_board.css). */
                                    .gdb-cover-0 { background-color: #dbeafe; border-left: 3px solid #2563eb; }
                                    .gdb-cover-1 { background-color: #dcfce7; border-left: 3px solid #16a34a; }
                                    .gdb-cover-2 { background-color: #fef3c7; border-left: 3px solid #d97706; }
                                    .gdb-cover-3 { background-color: #f3e8ff; border-left: 3px solid #9333ea; }
                                    .gdb-cover-4 { background-color: #ffe4e6; border-left: 3px solid #e11d48; }
                                    .gdb-cover-5 { background-color: #ccfbf1; border-left: 3px solid #0d9488; }
                                    .gdb-cover-6 { background-color: #ffedd5; border-left: 3px solid #ea580c; }
                                    .gdb-cover-7 { background-color: #e0e7ff; border-left: 3px solid #4f46e5; }
                                    /* Issue #637: one header band per area, each block's own time, and the
                                       screen's brown accent on every break block. */
                                    .gdb-area { text-transform: uppercase; font-size: 9px; }
                                    .gdb-block-time { display: block; font-size: 7px; color: #777; }
                                    .gdb-break { border-left: 3px solid #8a6240 !important; }
                                    .gdb-break-label { display: block; font-size: 8px; font-style: italic; }
                                    .gdb-missing-tag { border-style: dashed; border-color: #b52a37; color: #b52a37; }
                                    .gdb-cover-partial { border-left-style: dotted !important; border-left-width: 2px !important; }
                                    .gdb-guard-badge.gdb-cover-partial { border-style: dotted; }
                                </style>

                                <h1 class="gdb-title">
                                    <t t-if="requested_view == 'table'">Absences Table -</t>
                                    <t t-else="">Guard Duty Schedule -</t>
                                    <t t-if="weekday == '0'">Monday</t>
                                    <t t-elif="weekday == '1'">Tuesday</t>
                                    <t t-elif="weekday == '2'">Wednesday</t>
                                    <t t-elif="weekday == '3'">Thursday</t>
                                    <t t-elif="weekday == '4'">Friday</t>
                                    (<span t-esc="course.name"/>)
                                </h1>

                                <t t-foreach="shifts" t-as="shift">
                                    <t t-set="data" t-value="course.get_guard_duty_board_lines(weekday, shift, area_ids=requested_area_ids, day=requested_date)"/>
                                    <h2 class="gdb-shift-title">
                                        <t t-if="shift == 'morning'">Morning</t>
                                        <t t-else="">Afternoon</t>
                                    </h2>
                                    <!-- Both views on the board's real time axis (issue #637): laid out once by
                                         BoardTimeGrid, the same grid the screen renders - a slot refers
                                         to its line by index. -->
                                    <t t-if="data['lines'] and requested_view == 'table'">
                                        <t t-set="grid" t-value="data['absence_grid']"/>
                                        <table class="table table-bordered gdb-table gdb-duty-table">
                                            <colgroup>
                                                <col class="gdb-col-time"/>
                                                <t t-foreach="grid['areas']" t-as="area">
                                                    <t t-foreach="range(area['colspan'])" t-as="lane">
                                                        <col class="gdb-col-absences"/>
                                                    </t>
                                                </t>
                                                <t t-foreach="range(grid['lane_count'])" t-as="lane">
                                                    <col class="gdb-col-guard"/>
                                                </t>
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th/>
                                                    <t t-foreach="grid['areas']" t-as="area">
                                                        <th class="gdb-area" t-att-colspan="area['colspan']" t-esc="area['name']"/>
                                                    </t>
                                                    <th t-att-colspan="grid['lane_count']">Guard duty</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="grid['rows']" t-as="row">
                                                    <tr>
                                                        <td class="gdb-time" t-esc="row['label']"/>
                                                        <t t-foreach="row['cells']" t-as="slot">
                                                            <td t-if="slot.get('empty')"/>
                                                            <t t-elif="'line' not in slot" t-call="ems.report_guard_duty_board_break"/>
                                                            <td t-else="" t-att-rowspan="slot['rowspan']" class="gdb-absence-cell">
                                                                <t t-set="line" t-value="data['lines'][slot['line']]"/>
                                                                <span class="gdb-block-time" t-esc="slot['label']"/>
                                                                <t t-foreach="slot['absences']" t-as="absence_index">
                                                                    <t t-call="ems.report_guard_duty_board_absence"/>
                                                                </t>
                                                            </td>
                                                        </t>
                                                        <t t-foreach="row['guards']" t-as="slot">
                                                            <td t-if="slot.get('empty')"/>
                                                            <td t-else="" t-att-rowspan="slot['rowspan']" t-att-class="'gdb-break' if slot['is_break'] else ''">
                                                                <t t-set="line" t-value="data['lines'][slot['line']]"/>
                                                                <t t-call="ems.report_guard_duty_board_guards"/>
                                                                <t t-foreach="slot['posts']" t-as="absence_index">
                                                                    <t t-call="ems.report_guard_duty_board_absence"/>
                                                                </t>
                                                            </td>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                    <t t-elif="data['lines']">
                                        <t t-set="grid" t-value="data['schedule_grid']"/>
                                        <table class="table table-bordered gdb-table">
                                            <colgroup>
                                                <col class="gdb-col-time"/>
                                                <t t-foreach="data['groups']" t-as="group">
                                                    <col class="gdb-col-group"/>
                                                </t>
                                                <t t-foreach="range(grid['lane_count'])" t-as="lane">
                                                    <col class="gdb-col-guard"/>
                                                </t>
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th rowspan="2"/>
                                                    <t t-foreach="grid['areas']" t-as="area">
                                                        <th class="gdb-area" t-att-colspan="area['colspan']" t-esc="area['name']"/>
                                                    </t>
                                                    <th rowspan="2" t-att-colspan="grid['lane_count']">Guard duty</th>
                                                </tr>
                                                <tr>
                                                    <t t-foreach="data['groups']" t-as="group">
                                                        <th t-esc="group.name"/>
                                                    </t>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="grid['rows']" t-as="row">
                                                    <tr>
                                                        <td class="gdb-time" t-esc="row['label']"/>
                                                        <t t-foreach="row['cells']" t-as="slot">
                                                            <td t-if="slot.get('empty')"/>
                                                            <t t-elif="'line' not in slot" t-call="ems.report_guard_duty_board_break"/>
                                                            <td t-else="" t-att-rowspan="slot['rowspan']">
                                                                <t t-set="cell" t-value="data['lines'][slot['line']]['cells'][slot['column']]"/>
                                                                <span class="gdb-block-time" t-esc="slot['label']"/>
                                                                <span class="gdb-cell-subject" t-esc="cell['entries'][:1].subject_id.acronym"/>
                                                                <span class="gdb-cell-teacher">
                                                                    <t t-foreach="cell['teachers']" t-as="teacher">
                                                                        <span t-att-class="('gdb-absent' if cell['absences'].get(teacher.id) == 'approved' else ('gdb-absent-pending' if cell['absences'].get(teacher.id) else '')) + (' gdb-guard-busy' if teacher in cell['moved'] else '')" t-esc="teacher.name"/><t t-if="not teacher_last">, </t>
                                                                    </t>
                                                                </span>
                                                                <!-- Issue #605: who teaches it instead, after an internal arrangement. -->
                                                                <span t-if="cell['substitutes']" class="gdb-cell-teacher">⇄ <t t-esc="', '.join(cell['substitutes'].mapped('name'))"/></span>
                                                                <span t-if="cell['entries'][:1].space_id" class="gdb-cell-room" t-esc="cell['entries'][:1].space_id.display_name"/>
                                                            </td>
                                                        </t>
                                                        <t t-foreach="row['guards']" t-as="slot">
                                                            <td t-if="slot.get('empty')"/>
                                                            <td t-else="" t-att-rowspan="slot['rowspan']" t-att-class="'gdb-break' if slot['is_break'] else ''">
                                                                <t t-set="line" t-value="data['lines'][slot['line']]"/>
                                                                <t t-call="ems.report_guard_duty_board_guards"/>
                                                            </td>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                    <p t-else="">No schedule available.</p>
                                </t>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </template>
        <!-- A break block of a group's or an area's column (issue #637): its own time, "Break". -->
        <template id="report_guard_duty_board_break">
            <td t-att-rowspan="slot['rowspan']" class="gdb-break">
                <div class="gdb-block-time" t-esc="slot['label']"/>
                <div class="gdb-break-label">Break</div>
            </td>
        </template>

        <!-- One absence line, struck out and paired with its guard's colour exactly like the screen
             (issues #571/#581): a co-teacher, a guard sent, a timetable change already told to the
             families, or an internal arrangement in effect (#605). Expects 'line' and 'absence_index'. -->
        <template id="report_guard_duty_board_absence">
            <t t-set="absence" t-value="line['absences'][absence_index]"/>
            <!-- Several guards can each cover part of the class (issue #637): struck out only once
                 nothing is missing. -->
            <t t-set="covers" t-value="absence['covers']"/>
            <div t-att-class="'gdb-absence-row' + (' gdb-absence-covered' if absence['covered'] or (covers and not absence['missing']) or absence['authorized'] or (absence['arrangement'] and absence['arrangement'].is_effective) else '') + (' gdb-cover-%s' % line['guard_colors'].get(covers[:1].guard_employee_id.id, 0) if covers else '') + (' gdb-cover-partial' if covers and absence['missing'] else '')">
                <span t-att-class="'gdb-absent' if absence['state'] == 'approved' else 'gdb-absent-pending'" t-esc="absence['teacher'].name"/>
                <span class="gdb-absence-class">
                    <t t-esc="absence['label']"/><t t-if="absence['subject']"> · <t t-esc="absence['subject'].acronym"/></t><t t-if="absence['room']"> · <t t-esc="absence['room'].display_name"/></t>
                    <t t-foreach="covers" t-as="cover">
                        <span class="gdb-absence-tag">→ <t t-esc="cover.guard_employee_id.name"/><t t-if="absence['missing'] or len(covers) > 1"> <t t-esc="cover._time_label()"/></t></span>
                    </t>
                    <t t-foreach="absence['missing']" t-as="period">
                        <span class="gdb-absence-tag gdb-missing-tag" t-esc="course._missing_label(period)"/>
                    </t>
                    <span t-if="absence['arrangement'] and absence['arrangement'].is_effective" class="gdb-absence-tag">⇄ <t t-esc="absence['arrangement']._arrangement_label()"/></span>
                    <span t-if="absence['arrangement_change']" class="gdb-absence-tag" t-esc="course._absence_change_label(absence['arrangement_change'])"/>
                    <span t-if="absence['authorized']" class="gdb-absence-tag" t-esc="course._absence_change_label(absence['authorized'])"/>
                </span>
            </div>
        </template>

        <!-- The guards of one block. The PDF reads the raw resource.calendar.attendance rows, so the
             WC tag checks the same 'GWC' code get_guard_duty_board_data() turns into 'is_wc'. -->
        <template id="report_guard_duty_board_guards">
            <span class="gdb-block-time" t-esc="slot['label']"/>
            <span t-if="slot['is_break']" class="gdb-break-label">Break</span>
            <t t-foreach="line['guards']" t-as="guard">
                <span t-att-class="'gdb-guard-badge' + (' gdb-absent' if line['guard_absences'].get(guard.employee_id.id) == 'approved' else (' gdb-absent-pending' if line['guard_absences'].get(guard.employee_id.id) else '')) + (' gdb-cover-%s' % line['guard_colors'][guard.employee_id.id] if guard.employee_id.id in line['guard_colors'] else '') + (' gdb-cover-partial' if guard.employee_id.id in line['partial_guard_ids'] else '') + (' gdb-guard-busy' if guard.employee_id.id in line['guard_busy'] else '')">
                    <t t-esc="guard.employee_id.name"/>
                    <t t-if="guard.non_teaching.code == 'GWC'"> (WC)</t>
                </span>
            </t>
        </template>
    </data>
</odoo>
