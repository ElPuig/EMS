<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #800: the minute of a student walkout vote, rendered when the vote closes
             (ems.student_walkout._ems_render_minute) and always in the centre language
             (models/shared/ir_actions_report.py). The group vote shows only its counts. -->
        <record id="action_report_student_walkout" model="ir.actions.report">
            <field name="name">Student walkout minute</field>
            <field name="model">ems.student_walkout</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ems.report_student_walkout</field>
            <field name="report_file">ems.report_student_walkout</field>
            <field name="print_report_name">'%s' % object.name</field>
        </record>

        <template id="report_student_walkout">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="ems.report_student_walkout_document"/>
                </t>
            </t>
        </template>

        <template id="report_student_walkout_document">
            <t t-call="web.external_layout">
                <div class="page o_ems_student_walkout_report">
                    <style>
                        .o_ems_student_walkout_report { font-size: 12px; }
                        .o_ems_student_walkout_report h2 { font-size: 18px; margin-bottom: 12px; }
                        .o_ems_student_walkout_report h3 { font-size: 13px; margin-top: 16px; margin-bottom: 4px; }
                        .o_ems_student_walkout_report table td, .o_ems_student_walkout_report table th { padding: 3px 6px !important; vertical-align: top; }
                    </style>

                    <h2>Minute of a student walkout vote</h2>

                    <table class="table table-sm table-borderless">
                        <tbody>
                            <tr><td class="fw-bold w-25">Group</td><td t-out="', '.join(doc.group_ids.mapped('name'))"/></tr>
                            <tr><td class="fw-bold">Walkout day</td><td><span t-field="doc.walkout_date"/></td></tr>
                            <tr><td class="fw-bold">Opened by</td><td t-out="doc.opener_id.name"/></tr>
                            <tr><td class="fw-bold">Opened on</td><td><span t-field="doc.create_date" t-options="{'widget': 'date'}"/></td></tr>
                            <!-- Formatted in the centre's timezone: the minute is rendered by the cron too. -->
                            <tr><td class="fw-bold">Group vote</td><td><t t-esc="doc.format_local_datetime(doc.vote_start)"/> - <t t-esc="doc.format_local_datetime(doc.vote_until)"/></td></tr>
                            <tr t-if="doc.join_start"><td class="fw-bold">Joining</td><td><t t-esc="doc.format_local_datetime(doc.join_start)"/> - <t t-esc="doc.format_local_datetime(doc.join_until)"/></td></tr>
                            <tr><td class="fw-bold">Closed on</td><td><t t-esc="doc.format_local_datetime(doc.closed_datetime)"/></td></tr>
                            <!-- Issue #837: each document links to its download (the minute reaches only staff, who log in). -->
                            <tr><td class="fw-bold">Supporting document</td><td>
                                <t t-foreach="doc.attachment_ids" t-as="attachment">
                                    <a t-att-href="'%s/web/content/%s?download=true' % (doc.get_base_url(), attachment.id)" t-out="attachment.name"/><t t-if="not attachment_last">, </t>
                                </t>
                            </td></tr>
                            <tr t-if="doc.notes"><td class="fw-bold">Reason</td><td t-out="doc.notes"/></tr>
                        </tbody>
                    </table>

                    <h3>Does the group walk out? (anonymous vote)</h3>
                    <table class="table table-sm table-bordered w-50">
                        <tbody>
                            <tr><td class="fw-bold">Yes</td><td t-out="doc.group_yes_count"/></tr>
                            <tr><td class="fw-bold">No</td><td t-out="doc.group_no_count"/></tr>
                            <tr><td class="fw-bold">Abstentions</td><td t-out="doc.group_abstain_count"/></tr>
                            <tr><td class="fw-bold">Students who did not vote</td><td t-out="doc.voter_count - doc.voted_count"/></tr>
                            <tr><td class="fw-bold">Students without access to the portal</td><td t-out="len(doc.line_ids) - doc.voter_count"/></tr>
                        </tbody>
                    </table>
                    <p>
                        <strong t-if="doc.group_supports">Result: the group has voted in favour of the walkout.</strong>
                        <strong t-else="">Result: the group has not voted in favour of the walkout, so everybody is expected in class that day.</strong>
                    </p>

                    <h3 t-if="doc.group_supports">Who joins the walkout</h3>
                    <table t-if="doc.group_supports" class="table table-sm table-bordered">
                        <thead>
                            <tr><th>Student</th><th>Joins the walkout</th><th>Family answer (minors)</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.line_ids.sorted(lambda line: line.student_id.name or '')" t-as="line">
                                <td t-out="line.student_id.name"/>
                                <td>
                                    <t t-if="line.joins">Yes</t>
                                    <t t-elif="line.join_answered">No</t>
                                    <t t-elif="not line.has_portal">No access to the portal</t>
                                    <t t-else="">Did not answer</t>
                                </td>
                                <td>
                                    <t t-if="line.joins and line.needs_ratification">
                                        <span t-field="line.ratification"/>
                                        <t t-if="line.ratification != 'ratified'">(the family is told of each class, for information)</t>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>
    </data>
</odoo>
