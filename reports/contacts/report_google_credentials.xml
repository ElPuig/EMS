<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_report_google_credentials" model="ir.actions.report">
            <field name="name">Google Workspace credentials</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ems.report_google_credentials</field>
            <field name="report_file">ems.report_google_credentials</field>
        </record>

        <template id="report_google_credentials">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="student">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <style>
                                .gw-title { font-size: 22px; margin-bottom: 6px; }
                                .gw-section { font-size: 13px; margin-top: 14px; margin-bottom: 4px; }
                                .gw-table th, .gw-table td { padding: 6px 8px !important; line-height: 1.4; }
                                .gw-note { margin-top: 18px; font-size: 11px; color: #555; }
                            </style>

                            <h1 class="gw-title">Corporate account credentials</h1>
                            <p>Access details for the school's Google Workspace account.</p>

                            <h3 class="gw-section">Student</h3>
                            <table class="table gw-table">
                                <tbody>
                                    <tr>
                                        <td style="width: 35%;"><strong>Name</strong></td>
                                        <td><span t-field="student.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>IDALU</strong></td>
                                        <td><span t-field="student.student_id"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <h3 class="gw-section">Credentials</h3>
                            <table class="table gw-table">
                                <tbody>
                                    <tr>
                                        <td style="width: 35%;"><strong>Username (email)</strong></td>
                                        <td><span t-esc="gw_email"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Temporary password</strong></td>
                                        <td><span t-esc="gw_password"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <p class="gw-note">
                                <strong>Important:</strong> for security reasons, you will be required to
                                change the password on your first login. Keep these details in a safe place.
                            </p>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
