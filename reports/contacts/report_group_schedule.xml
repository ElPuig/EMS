<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_report_group_schedule" model="ir.actions.report">
            <field name="name">Group Schedule</field>
            <field name="model">ems.group</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ems.report_group_schedule</field>
            <field name="report_file">ems.report_group_schedule</field>
            <field name="print_report_name">'Group Schedule - %s - %s' % (object.name, object.env.company.current_course_id.name)</field>
            <field name="binding_model_id" ref="model_ems_group"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_group_schedule">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="group">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <style>
                                .gs-group-title { font-size: 22px; margin-bottom: 2px; }
                                .gs-header-subtitle-block { margin: 0 0 14px 0; }
                                .gs-tutor-title { font-size: 14px; font-weight: 500; color: #444; margin: 0 0 2px 0; }
                                .gs-tutor-title:last-child { margin-bottom: 0; }
                            </style>

                            <h1 class="gs-group-title"><span t-field="group.name"/> (<span t-field="group.env.company.current_course_id.name"/>)</h1>
                            <div t-if="group.tutor_id or group.space_id" class="gs-header-subtitle-block">
                                <h2 t-if="group.tutor_id" class="gs-tutor-title">Tutor: <span t-field="group.tutor_id.name"/></h2>
                                <h2 t-if="group.space_id" class="gs-tutor-title">Reference classroom: <span t-field="group.space_id.name"/></h2>
                            </div>

                            <t t-set="lines" t-value="group.get_schedule_report_lines()"/>
                            <t t-if="lines">
                                <t t-call="ems.schedule_report_grid">
                                    <t t-set="summary" t-value="group.get_subject_teachers_summary()"/>
                                </t>
                            </t>
                            <p t-else="">No schedule available for this group.</p>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
