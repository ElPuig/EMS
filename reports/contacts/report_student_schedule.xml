<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_report_student_schedule" model="ir.actions.report">
            <field name="name">Student Schedule</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ems.report_student_schedule</field>
            <field name="report_file">ems.report_student_schedule</field>
            <field name="print_report_name">'Student Schedule - %s - %s' % (object.name, object.env.company.current_course_id.name)</field>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_student_schedule">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="student">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <style>
                                .gs-group-title { font-size: 22px; margin-bottom: 2px; }
                                .gs-tutor-title { font-size: 14px; font-weight: 500; color: #444; margin: 0 0 14px 0; }
                            </style>

                            <h1 class="gs-group-title"><span t-field="student.name"/> (<span t-field="student.env.company.current_course_id.name"/>)</h1>
                            <h2 t-if="student.main_group_id" class="gs-tutor-title">Group: <span t-field="student.main_group_id.name"/></h2>

                            <t t-set="lines" t-value="student.get_schedule_report_lines()"/>
                            <t t-if="lines">
                                <t t-call="ems.schedule_report_grid">
                                    <t t-set="summary" t-value="student.get_subject_teachers_summary()"/>
                                </t>
                            </t>
                            <p t-else="">No schedule available for this student.</p>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
