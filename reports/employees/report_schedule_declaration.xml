<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #723: the teacher's page ("Horari professor/a") of the Departament d'Educació i FP's
             official form "Annexos Dades anuals". An official Catalan form: always printed in
             Catalan (t-lang below), so its own text is written in Catalan, as on the form. -->
        <!-- A4 with small margins and no letterhead: the form carries its own header, and the
             whole declaration has to fit on one page. -->
        <record id="paperformat_schedule_declaration" model="report.paperformat">
            <field name="name">A4 (schedule declaration)</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">8</field>
            <field name="margin_bottom">8</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_schedule_declaration" model="ir.actions.report">
            <field name="name">Schedule declaration</field>
            <field name="model">hr.employee</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ems.report_schedule_declaration</field>
            <field name="report_file">ems.report_schedule_declaration</field>
            <field name="print_report_name">'Declaracio horaria - %s - %s' % (object.name, object.company_id.current_course_id.name)</field>
            <field name="binding_model_id" ref="model_hr_employee"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_schedule_declaration"/>
            <!-- The form offers it from its Actions dropdown (action_print_schedule_declaration). -->
            <field name="binding_view_types">list</field>
            <!-- Same groups as the scoped NIF it prints (hr.employee.scoped_identification_id). -->
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system'), ref('hr.group_hr_user'), ref('ems.group_teacher')])]"/>
        </record>

        <template id="report_schedule_declaration">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="employee">
                    <t t-call="ems.report_schedule_declaration_document" t-lang="'ca_ES'"/>
                </t>
            </t>
        </template>

        <template id="report_schedule_declaration_document">
            <t t-set="employee" t-value="employee.with_context(lang='ca_ES')"/>
            <t t-set="company" t-value="employee.company_id"/>
            <t t-set="calendar" t-value="employee.resource_calendar_id"/>
            <t t-set="summary" t-value="calendar.get_schedule_declaration_summary() if calendar else {'lective': {}, 'fixed': {}, 'reduction': 0, 'lective_total': 0, 'fixed_total': 0}"/>
            <t t-set="left_rows" t-value="[('ESO', 'ESO', 'eso'), ('BATXILLERAT', 'BAT', 'bat'), ('C. FORM. G. BÀSIC', 'CFGB', 'cfgb'), ('C. FORM. G. MITJÀ', 'CFGM', 'cfgm'), ('C. FORM. G. SUPERIOR', 'CFGS', 'cfgs'), ('TUTORIA ESO', 'T-ESO', 't_eso'), ('TUTORIA Batxillerat', 'T-BAT', 't_bat'), ('TUTORIA FP', 'T-FP', 't_fp'), ('FCT - FP', 'FCT', 'fct'), ('Suport tècnic profes. (PSI)', 'PSI', 'psi'), ('Suport inten. Ed inclusiva', 'SIEI', 'siei')]"/>
            <t t-set="right_rows" t-value="[('Prog. de formació i inserció', 'PFI', 'pfi'), ('Curs accés CFGM', 'CAM', 'cam'), ('Curs preparació inc. CFGS', 'CPIGS', 'cpigs'), ('Preparació proves accés', 'PPAS', 'ppas'), ('IOC – suport', 'IOC', 'ioc'), ('Curs d’especialització', 'CEFP', 'cefp'), ('Càrrec directiu', 'CD', 'cd'), ('Càrrec coordinació', 'CC', 'cc'), ('Reunions (depart., coord.)', 'RD/RC', 'rd_rc'), ('Guàrdies', 'G', 'g'), ('Altres:', '', 'other')]"/>
            <t t-call="web.basic_layout">
                <div class="page sd-page">
                    <style>
                        .sd-page { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #000; }
                        .sd-page .ws-table { font-size: 10px; margin-bottom: 0; }
                        .sd-page .ws-table th, .sd-page .ws-table td { padding: 1px 3px !important; }
                        .sd-page .ws-cell-content { padding: 1px 2px; }
                        .sd-page .ws-cell-room { font-size: 8px; }
                        .sd-header { width: 100%; margin-bottom: 8px; }
                        .sd-header td { vertical-align: top; }
                        .sd-entity { font-size: 13px; line-height: 1.2; }
                        .sd-entity b { font-size: 14px; }
                        .sd-annual { text-align: right; font-size: 11px; }
                        .sd-box { width: 100%; border-collapse: collapse; margin-bottom: 5px; }
                        .sd-box td { border: 1px solid #000; padding: 2px 4px; }
                        .sd-box td.sd-label { background: #e6e6e6; white-space: nowrap; width: 1%; }
                        .sd-title { font-size: 13px; font-weight: bold; margin: 4px 0 3px 0; }
                        .sd-title span, .sd-blue { color: #0070c0; font-weight: bold; }
                        .sd-summary { width: 100%; border-collapse: collapse; margin-top: 6px; }
                        .sd-summary td, .sd-summary th { border: 1px solid #000; padding: 1px 3px; }
                        .sd-summary th { background: #e6e6e6; font-weight: normal; text-align: center; }
                        .sd-summary td.sd-code { text-align: center; width: 6%; }
                        .sd-summary td.sd-hours { text-align: center; width: 8%; }
                        .sd-signatures { width: 100%; margin-top: 10px; }
                        .sd-signatures td { width: 50%; vertical-align: top; padding-right: 20px; height: 70px; border: none; }
                        .sd-footer { margin-top: 4px; font-size: 9px; }
                    </style>

                    <table class="sd-header">
                        <tr>
                            <td class="sd-entity">Generalitat de Catalunya<br/><b>Departament d’Educació<br/>i Formació Professional</b></td>
                            <td class="sd-annual">DADES ANUALS DEL CENTRE<br/>CURS <span t-esc="company.current_course_id.name"/></td>
                        </tr>
                    </table>

                    <table class="sd-box">
                        <tr>
                            <td class="sd-label">Codi</td><td t-esc="company.center_code"/>
                            <td class="sd-label">Centre</td><td t-esc="company.name"/>
                        </tr>
                        <tr>
                            <td class="sd-label">Municipi</td><td colspan="3" t-esc="company.partner_id.city"/>
                        </tr>
                    </table>

                    <p class="sd-title">Horari professor/a <span>(L’horari del professorat pot omplir-se en qualsevol altre format sempre que contingui la mateixa informació, incloent la declaració de l’encapçalament i els peus de signatura).</span></p>

                    <table class="sd-box">
                        <tr>
                            <td class="sd-label">Cognoms i nom</td><td t-esc="employee.name"/>
                            <td class="sd-label">NIF</td><td t-esc="employee.scoped_identification_id"/>
                        </tr>
                        <tr>
                            <td class="sd-label">Càrrec que desenvolupa</td>
                            <td colspan="3" t-esc="', '.join(employee.get_report_role_lines())"/>
                        </tr>
                    </table>

                    <p class="sd-blue">DECLARO QUE LES DADES SEGÜENTS I L’HORARI QUE TINC ASSIGNAT SÓN AUTÈNTICS I EXACTES. ME’N FAIG RESPONSABLE.</p>

                    <table class="sd-box">
                        <tr>
                            <td class="sd-label">Lloc de treball / Especialitat</td><td/>
                            <td class="sd-label">Situació administrativa</td>
                            <td>☐ Definitiu ☐ Provisional ☐ Comissió serveis ☐ Interí</td>
                            <td class="sd-label">Anys a l’ensenyament</td><td/>
                        </tr>
                        <tr>
                            <td class="sd-label">Acreditació per impartir l’ensenyament en català</td><td colspan="5"/>
                        </tr>
                    </table>

                    <p class="sd-blue">EN AQUEST APARTAT FEU SERVIR EL VOSTRE FORMAT D’HORARIS:</p>
                    <t t-if="calendar" t-call="ems.report_working_schedule_grid"/>

                    <table class="sd-summary">
                        <thead>
                            <tr><th colspan="8"><b>QUADRE RESUM D’HORES</b></th></tr>
                            <tr>
                                <th/><th>CODI</th><th>H. LECTIVES SETMANALS</th><th>Altres hores d’horari FIX</th>
                                <th/><th>CODI</th><th>H. LECTIVES SETMANALS</th><th>Altres hores d’horari FIX</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="range(len(left_rows))" t-as="i">
                                <tr>
                                    <t t-foreach="(left_rows[i], right_rows[i])" t-as="row">
                                        <td t-esc="row[0]"/>
                                        <td class="sd-code" t-esc="row[1]"/>
                                        <td class="sd-hours" t-esc="summary['lective'].get(row[2]) or ''"/>
                                        <td class="sd-hours" t-esc="summary['fixed'].get(row[2]) or ''"/>
                                    </t>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2">Si disposeu de reducció de jornada, indiqueu quina:</td>
                                <td colspan="2" class="sd-hours"><t t-if="summary['reduction']"><t t-esc="summary['reduction']"/> h</t></td>
                                <td colspan="2" class="sd-code">TOTAL</td>
                                <td class="sd-hours" t-esc="summary['lective_total']"/>
                                <td class="sd-hours" t-esc="summary['fixed_total']"/>
                            </tr>
                        </tbody>
                    </table>

                    <table class="sd-signatures">
                        <tr>
                            <td>Lloc*: ______________________ Data*: ______________<br/>(*en cas de signatura manual)</td>
                            <td/>
                        </tr>
                        <tr>
                            <td><b>El/la director/a</b> (signar digitalment o signar a mà i posar segell en cas que el/la docent no tingui signatura digital)</td>
                            <td><b>El/la sotasignat/da declara que imparteix les matèries en la llengua que consta al Projecte Lingüístic de Centre</b> (signatura del/la docent)</td>
                        </tr>
                    </table>

                    <p class="sd-footer">Aquestes declaracions horàries restaran arxivades al centre a disposició de la Inspecció d’Educació, preferentment compartides per mitjans telemàtics, amb les possibles modificacions que calgui fer al llarg del curs.</p>
                </div>
            </t>
        </template>
    </data>
</odoo>
