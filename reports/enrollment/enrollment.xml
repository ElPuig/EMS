<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Remove default sale quotation reports from the print menu -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- Custom enrollment print action -->
    <record id="action_report_enrollment" model="ir.actions.report">
        <field name="name">Print enrollment</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ems.report_enrollment</field>
        <field name="report_file">ems.report_enrollment</field>
        <field name="print_report_name">'Matricula - %s' % object.name</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
