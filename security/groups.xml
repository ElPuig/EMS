<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">  
          <!-- TODO: this is just temporal, remove after v18.0.0.0.3 -->
         <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'ems'), ('name', 'in', ['category_main', 'group_teacher', 'group_secretary', 'group_academic_admin'])]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>         
        <!-- To get all the groups available, export the list from user/groups including the "name" and the "external ID" fields -->
 
        <!-- Pure top-level label: holds no groups directly. Odoo's group-category selector widget
             (base.user_groups_view) only shows a category's name as the visible section title when
             that category is used as another category's *parent* - a category with groups assigned
             to it directly but no parent falls into an unlabelled "Other" bucket. -->
        <record model="ir.module.category" id="category_main">
            <field name="name">EMS</field>
            <field name="description">Educational Management System</field>
            <field name="sequence">1</field>
            <field name="visible">True</field>
        </record>

        <!-- Holds the Teacher/Tutor/Department Chief/Head of Studies/Director/Administrator role hierarchy. -->
        <record model="ir.module.category" id="category_roles">
            <field name="name">Academic</field>
            <field name="description">Educational Management System - Academic roles</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">1</field>
            <field name="visible">True</field>
        </record>

        <!-- Kept separate from category_roles: it is not part of the Teacher/Tutor/Head of Studies/
             Director/Administrator hierarchy, so mixing it in would break the strict implication chain
             that Odoo requires to render a group category as a visible role selector outside of debug
             mode. Sharing the same parent as category_roles still groups both selectors under one "EMS"
             section. -->
        <record model="ir.module.category" id="category_secretary">
            <field name="name">Secretary</field>
            <field name="description">Educational Management System - Secretary</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">2</field>
            <field name="visible">True</field>
        </record>

        <!-- Kept separate for the same reason as category_secretary: its own independent
             Manager/Administrator chain, sharing category_main as parent so it still groups
             under the "EMS" section. -->
        <record model="ir.module.category" id="category_quality">
            <field name="name">Quality</field>
            <field name="description">Educational Management System - Quality</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">3</field>
            <field name="visible">True</field>
        </record>

        <!-- Kept separate for the same reason as category_secretary/category_quality: coexistence
             is transversal to the teacher/tutor/HoS hierarchy (it doesn't sit "under" a department),
             so it gets its own independent Manager/Administrator chain. -->
        <record model="ir.module.category" id="category_coexistence">
            <field name="name">Coexistence</field>
            <field name="description">Educational Management System - Coexistence</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">4</field>
            <field name="visible">True</field>
        </record>

        <!-- Kept separate for the same reason as category_secretary/category_quality/
             category_coexistence: the TAC (Learning and Knowledge Technologies) coordinator is
             transversal to the teacher/tutor/HoS hierarchy - the post is held by a teacher, but it
             doesn't sit anywhere on that chain, so it gets its own independent Manager/Administrator
             chain instead of being wired into it. -->
        <!-- Issue #683: the Erasmus team (coordination and mobility technician) is transversal to
             the teacher/tutor/HoS hierarchy, like the blocks above. -->
        <record model="ir.module.category" id="category_erasmus">
            <field name="name">Erasmus+</field>
            <field name="description">Educational Management System - Erasmus+ calls and mobilities</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">7</field>
            <field name="visible">True</field>
        </record>

        <record model="ir.module.category" id="category_tac">
            <field name="name">TAC</field>
            <field name="description">Educational Management System - Learning and Knowledge Technologies</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">5</field>
            <field name="visible">True</field>
        </record>

        <!-- Kept separate for the same reason as category_secretary/category_quality/
             category_coexistence/category_tac: the guidance team (Orientació) is transversal to
             the teacher/tutor/HoS hierarchy - the post is held by teachers, but it doesn't sit
             anywhere on that chain, so it gets its own independent Manager/Administrator chain. -->
        <record model="ir.module.category" id="category_orientation">
            <field name="name">Guidance</field>
            <field name="description">Educational Management System - Guidance (Orientació)</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">6</field>
            <field name="visible">True</field>
        </record>

        <!-- Consolidates Odoo's native Administration (Access Rights/Settings), Canned Responses
             and Job Queue permissions - previously scattered technical selectors - into one clean
             EMS selector. Kept separate for the same reason as category_secretary/category_quality. -->
        <record model="ir.module.category" id="category_settings">
            <field name="name">Settings</field>
            <field name="description">Educational Management System - Settings</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">7</field>
            <field name="visible">True</field>
        </record>

        <!-- Technical group, deliberately with no category_id: it never appears as a pickable
             role selector on the user form, and is granted only by implication (group_orientation,
             group_coexistence and group_head_of_studies below). It owns the whole read-only surface
             over the student dataset - record rules (security/rules/student_data_reader.xml), ACL
             lines and menu visibility - so the posts that need it share one set of rules instead
             of duplicating ~17 of them each. It carries its own ACL lines rather than leaning on
             group_teacher's, because group_coexistence does not imply group_teacher: a coexistence
             coordinator who is not a teacher still gets the full read access issue #393 asks for.
             See docs/en/developers/employees/role_hierarchy.md, "Transversal read-only access to
             student data". -->
        <record model="res.groups" id="group_student_data_reader">
            <field name="name">Student data reader</field>
            <field name="comment">Read-only access to every student's academic, attendance and coexistence data, centre-wide. Technical group: granted by implication only, never assigned by hand.</field>
        </record>

        <record model="res.groups" id="group_teacher">
            <field name="name">Teacher</field>
            <field name="comment">Teacher's access rights.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <!-- group_allow_export: grants CSV export on any list view the teacher can already
                 read (e.g. the Students list) - Odoo's own export permission is all-or-nothing
                 per user, with no per-model/per-view scoping, so this also covers other models
                 teachers can read (attendance, grades, enrollments...), a deliberate trade-off
                 confirmed with the developer 2026-09-07 in exchange for zero custom code. -->
            <field name="implied_ids" eval="[
                (4, ref('hr_attendance.group_hr_attendance_own_reader')),
                (4, ref('base.group_allow_export')),
            ]"/>
        </record>

        <record model="res.groups" id="group_tutor">
            <field name="name">Tutor</field>
            <field name="comment">Access rights for tutors (teachers in charge of a group).</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_teacher'))]"/>
        </record>

        <record model="res.groups" id="group_department_chief">
            <field name="name">Department Chief</field>
            <field name="comment">Access rights for department heads. Currently identical to Tutor.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_tutor'))]"/>
        </record>

        <!-- group_student_data_reader (issue #448): HoS/DHoS/Director must see every student's
             academic, attendance and coexistence data centre-wide, not just their own tutees' -
             same reasoning as group_coexistence/group_orientation above. base.group_partner_manager
             (issue #448): full CRUD on res.partner.relation/.all (the family-contact relation
             models, owned by the OCA partner_multi_relation module) - without it, HoS/DHoS/Director
             get read-only access on those models and hit an AccessError deleting a family contact,
             even after _get_read_only_user() (models/contacts/contact.py) recognizes them for the
             student's own personal-data block. Mirrors group_secretary, which already implies it. -->
        <record model="res.groups" id="group_head_of_studies">
            <field name="name">Head of Studies</field>
            <field name="comment">Access rights for Head of Studies / Deputy Head of Studies. Grants read/write access to the attendance records of the employees in their own branch of the hierarchy or area, the right to create and edit teachers, and full read/write access to every student's data centre-wide.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <!-- Issue #543: hr_attendance's Officer, no longer its Administrator. The Administrator
                 group's own native rule opens every employee's attendance centre-wide, which no
                 rule can narrow back (group rules add up); as an Officer, a Head of Studies gets
                 the employees whose attendance they approve (the native officer rule: the area
                 they manage) plus their own chain of command (security/rules/attendance.xml).
                 (3, ...) and not just a missing (4, ...): an implication already stored in the
                 database survives its line being deleted from this file. -->
            <field name="implied_ids" eval="[
                (4, ref('ems.group_department_chief')),
                (3, ref('hr_attendance.group_hr_attendance_manager')),
                (4, ref('hr_attendance.group_hr_attendance_officer')),
                (4, ref('hr_holidays.group_hr_holidays_user')),
                (4, ref('hr.group_hr_user')),
                (4, ref('ems.group_student_data_reader')),
                (4, ref('base.group_partner_manager')),
            ]"/>
        </record>

        <!-- Head of Studies plus every employee's attendance centre-wide (issue #543): the
             Director is above every branch, so they keep hr_attendance's Administrator group,
             which the Head of Studies no longer has. -->
        <record model="res.groups" id="group_director">
            <field name="name">Director</field>
            <field name="comment">Access rights for the Director: those of the Head of Studies, plus every employee's attendance records centre-wide.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[
                (4, ref('ems.group_head_of_studies')),
                (4, ref('hr_attendance.group_hr_attendance_manager')),
            ]"/>
        </record>

        <!-- TODO: this group has not been yet setup in ir.modal.access.  -->
        <record model="res.groups" id="group_secretary">
            <field name="name">Manager</field>
            <field name="comment">Secretary's access rights.</field>
            <field name="category_id" ref="ems.category_secretary"/>
            <!-- (3, ...) not just a missing (4, ...): Odoo's implied_ids writes are additive,
                 so an implication already stored in the database survives its line being
                 deleted from this file. This one was wrong - approving absences is not
                 something the secretariat does as a body, only the ASP area's own manager
                 does, and that is granted from the approval relation itself (see
                 res.users._ems_sync_time_off_groups). -->
            <field name="implied_ids" eval="[
                (3, ref('hr_holidays.group_hr_holidays_responsible')),
                (4, ref('sales_team.group_sale_salesman_all_leads')),
                (4, ref('account.group_account_invoice')),
                (4, ref('account.group_account_readonly')),
                (4, ref('account.group_validate_bank_account')),
                (4, ref('base.group_partner_manager')),
                (4, ref('hr.group_hr_user')),
            ]"/>
        </record>

        <!-- hr.group_hr_user above: the secretariat keeps the staff's personal data (identity
             document, social security number...), so it gets Odoo's HR officer group, exactly
             like the Head of Studies and TAC (issue #391). security/rules/employees.xml narrows
             it back: write/create on every staff member, never delete. -->

        <!-- Same privileges as Manager for now; kept as its own group so it can be
             differentiated later without another migration. root/admin are added directly
             (not via group_academic_admin's implied_ids) so the blocks stay independent:
             see group_academic_admin below. -->
        <record model="res.groups" id="group_secretary_admin">
            <field name="name">Administrator</field>
            <field name="comment">Access rights for the Secretary department's administrator. Currently identical to Manager.</field>
            <field name="category_id" ref="ems.category_secretary"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_secretary')), (4, ref('hr.group_hr_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- The quality committee: the Quality menu and the Surveys section (EMS's own LimeSurvey
             integration, not to be confused with Odoo's native "Surveys" app, hidden - see
             group.py). Given by hand in the user form, or by being a member of the committee
             workgroup (ems.quality), see ems.workgroup._ems_sync_quality_committee(). -->
        <record model="res.groups" id="group_quality">
            <field name="name">Committee member</field>
            <field name="comment">Access rights for the quality committee: the Quality menu and the Surveys section.</field>
            <field name="category_id" ref="ems.category_quality"/>
        </record>

        <!-- Quality coordination: what a committee member has, plus maintaining the quality
             structure and its links, the minute catalogue and notices. root/admin are added directly
             (not via group_academic_admin's implied_ids) so the blocks stay independent:
             see group_academic_admin below. -->
        <record model="res.groups" id="group_quality_admin">
            <field name="name">Administrator</field>
            <field name="comment">Access rights for the Quality coordinator: those of a committee member, plus maintaining the quality structure, its links and the minute catalogue.</field>
            <field name="category_id" ref="ems.category_quality"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_quality'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Transversal to the teacher/tutor/HoS hierarchy: a coexistence coordinator can read every
             strike centre-wide, regardless of which HoS/DHoS branch issued it (that branch-matching
             logic is only used to route the escalation email, not to gate read access). -->
        <record model="res.groups" id="group_coexistence">
            <field name="name">Manager</field>
            <field name="comment">Access rights for the Coexistence team: can read all strikes centre-wide, plus every student's academic, attendance and coexistence data (issue #393).</field>
            <field name="category_id" ref="ems.category_coexistence"/>
            <!-- Implies group_teacher for the same reason group_tac and group_orientation do:
                 role_coexistence is employee_type='teacher', so the post is always held by a
                 teacher. It is also a hard requirement rather than a courtesy: the Students
                 screen runs through an ir.actions.server, and Odoo requires write access on the
                 action's own model (res.partner) to execute one at all - without group_teacher a
                 coexistence coordinator gets an AccessError opening the screen, however complete
                 their read permissions are. -->
            <field name="implied_ids" eval="[
                (4, ref('ems.group_teacher')),
                (4, ref('ems.group_student_data_reader')),
            ]"/>
        </record>

        <!-- Same privileges as Manager for now; kept as its own group so it can be
             differentiated later without another migration. root/admin are added directly
             (not via group_academic_admin's implied_ids) so the blocks stay independent:
             see group_academic_admin below. -->
        <record model="res.groups" id="group_coexistence_admin">
            <field name="name">Administrator</field>
            <field name="comment">Access rights for the Coexistence coordinator. Currently identical to Manager.</field>
            <field name="category_id" ref="ems.category_coexistence"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_coexistence'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Implies group_teacher because the TAC coordinator is always a teacher (role_tac is
             employee_type='teacher'), and hr.group_hr_user because the post manages teachers'
             own records - see the same implied_ids on group_head_of_studies above, and
             "Staff management" in docs/en/developers/employees/role_hierarchy.md for why the
             native HR officer group is what grants this rather than a hand-rolled set of ACL
             lines. Odoo's own Employees app stays out of the way regardless: EMS deactivates
             hr.menu_hr_root in views/menu.xml. -->
        <record model="res.groups" id="group_tac">
            <field name="name">Manager</field>
            <field name="comment">Access rights for the TAC team: can create and edit teachers.</field>
            <field name="category_id" ref="ems.category_tac"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_teacher')), (4, ref('hr.group_hr_user'))]"/>
        </record>

        <!-- Same privileges as Manager for now; kept as its own group so it can be
             differentiated later without another migration. root/admin are added directly
             (not via group_academic_admin's implied_ids) so the blocks stay independent:
             see group_academic_admin below. -->
        <record model="res.groups" id="group_tac_admin">
            <field name="name">Administrator</field>
            <field name="comment">Access rights for the TAC coordinator. Currently identical to Manager.</field>
            <field name="category_id" ref="ems.category_tac"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_tac'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Implies group_teacher because the guidance post is always held by a teacher
             (role_orientation is employee_type='teacher'), same as group_tac above, and
             group_student_data_reader for the centre-wide read access issue #393 asks for.
             Read-only by design: it adds no write/create/unlink anywhere. -->
        <record model="res.groups" id="group_orientation">
            <field name="name">Manager</field>
            <field name="comment">Access rights for the Guidance team (Orientació): reads every student's academic, attendance and coexistence data.</field>
            <field name="category_id" ref="ems.category_orientation"/>
            <field name="implied_ids" eval="[
                (4, ref('ems.group_teacher')),
                (4, ref('ems.group_student_data_reader')),
            ]"/>
        </record>

        <!-- Same privileges as Manager for now; kept as its own group so it can be
             differentiated later without another migration. root/admin are added directly
             (not via group_academic_admin's implied_ids) so the blocks stay independent:
             see group_academic_admin below. -->
        <record model="res.groups" id="group_orientation_admin">
            <field name="name">Administrator</field>
            <field name="comment">Access rights for the Guidance coordinator. Currently identical to Manager.</field>
            <field name="category_id" ref="ems.category_orientation"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_orientation'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Administration/Access Rights level, plus Canned Responses and Job Queue management
             granted explicitly (not only via Settings) so Manager keeps them even without Settings. -->
        <record model="res.groups" id="group_settings">
            <field name="name">Manager</field>
            <field name="comment">Access Rights level of Odoo's Administration, plus Canned Responses and Job Queue management.</field>
            <field name="category_id" ref="ems.category_settings"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_erp_manager')),
                (4, ref('mail.group_mail_canned_response_admin')),
                (4, ref('queue_job.group_queue_job_manager')),
            ]"/>
        </record>

        <!-- Only difference from Manager: Settings level of Odoo's Administration (which also
             implies Access Rights) instead of Access Rights alone. root/admin are added
             directly (not via group_academic_admin's implied_ids) so the blocks stay
             independent: see group_academic_admin below. -->
        <record model="res.groups" id="group_settings_admin">
            <field name="name">Administrator</field>
            <field name="comment">Settings level of Odoo's Administration, plus Canned Responses and Job Queue management.</field>
            <field name="category_id" ref="ems.category_settings"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_settings')), (4, ref('base.group_system'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Academic block's own admin: only implies group_director (its own hierarchy).
             Does NOT imply group_secretary_admin/group_quality_admin/group_coexistence_admin/
             group_settings_admin - each block's "Administrator" is independent, so granting
             Administrator here must not silently grant it in another block. root/admin are
             kept with full access to every block through explicit membership on each of
             those groups instead (see their 'users' field above). -->
        <!-- Issue #683: full access to every Erasmus+ call and application, confidential evidence
             included. Given through the roles "Erasmus coordinator" and "Erasmus mobility
             technician" (data/cat/ems.role.csv). No teacher group implied: the technician may not
             be a teacher. It implies Sign's "All Documents" (sign_oca): the team prepares, sends and
             follows the documents signed electronically (security/ir.model.access.csv adds editing
             the signature templates). -->
        <record model="res.groups" id="group_erasmus">
            <field name="name">Manager</field>
            <field name="comment">Erasmus team: manages the Erasmus+ calls and applications.</field>
            <field name="category_id" ref="ems.category_erasmus"/>
            <field name="implied_ids" eval="[(4, ref('sign_oca.sign_oca_group_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Issue #686: the Erasmus coordinator alone approves and publishes the resolutions. Given
             through the role "Erasmus coordinator"; the mobility technician keeps only Manager. -->
        <record model="res.groups" id="group_erasmus_coordinator">
            <field name="name">Coordinator</field>
            <field name="comment">Erasmus coordinator: also approves and publishes the resolutions.</field>
            <field name="category_id" ref="ems.category_erasmus"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_erasmus'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Issue #684: whoever has an Erasmus+ interview to score (ems.erasmus.interview). Managed by
             EMS itself when interviews are assigned or removed (res.users._ems_sync_erasmus_evaluator_group),
             never by hand, hence hidden. Its record rule shows each evaluator only their own interviews. -->
        <record model="res.groups" id="group_erasmus_evaluator">
            <field name="name">Erasmus+ evaluator</field>
            <field name="comment">Has Erasmus+ interviews to score.</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <!-- Issue #701: whoever leads or accompanies an Erasmus+ group mobility. Managed by EMS itself
             when the mobility's teachers change (res.users._ems_sync_erasmus_group_teacher_group),
             never by hand, hence hidden. Its record rules open only their own mobilities. -->
        <record model="res.groups" id="group_erasmus_group_teacher">
            <field name="name">Erasmus+ group mobility teacher</field>
            <field name="comment">Leads or accompanies an Erasmus+ group mobility.</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record model="res.groups" id="group_academic_admin">
            <field name="name">Administrator</field>
            <field name="comment">All access rights for the Academic block.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(6, 0, [
                ref('ems.group_director'),
            ])]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record model="res.groups" id="project.group_project_manager">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>   

        <record model="res.groups" id="project.group_project_user">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>  

        <record model="res.groups" id="mass_mailing.group_mass_mailing_user">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>   

        <record model="res.groups" id="survey.group_survey_manager">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>   

        <record model="res.groups" id="survey.group_survey_user">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>   

        <record model="ir.ui.menu" id="utm.menu_link_tracker_root">
            <field name="active">false</field>
        </record>

        <record id="base.menu_apps" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('ems.group_academic_admin')])]"/>
        </record>
<!-- 
        <delete id="utm.menu_link_tracker_root" model="ir.ui.menu" ></delete>
        <delete id="link_tracker.link_tracker_menu_main" model="ir.ui.menu" ></delete>        
        <delete id="utm.marketing_utm" model="ir.ui.menu" ></delete>         -->
        
    </data>
</odoo>