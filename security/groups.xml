<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">  
          <!-- TODO: this is just temporal, remove after v18.0.0.0.3 -->
         <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'ems'), ('name', 'in', ['category_main', 'group_teacher', 'group_secretary', 'group_academic_admin'])]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>         
        <!-- To get all the groups available, export the list from user/groups including the "name" and the "external ID" fields -->
 
        <!-- Pure top-level label: holds no groups directly. Odoo's group-category selector widget
             (base.user_groups_view) only shows a category's name as the visible section title when
             that category is used as another category's *parent* - a category with groups assigned
             to it directly but no parent falls into an unlabelled "Other" bucket. -->
        <record model="ir.module.category" id="category_main">
            <field name="name">EMS</field>
            <field name="description">Educational Management System</field>
            <field name="sequence">1</field>
            <field name="visible">True</field>
        </record>

        <!-- Holds the Teacher/Tutor/Head of Department/Head of Studies/Director/Administrator role hierarchy. -->
        <record model="ir.module.category" id="category_roles">
            <field name="name">Academic</field>
            <field name="description">Educational Management System - Academic roles</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">1</field>
            <field name="visible">True</field>
        </record>

        <!-- Kept separate from category_roles: it is not part of the Teacher/Tutor/Head of Studies/
             Director/Administrator hierarchy, so mixing it in would break the strict implication chain
             that Odoo requires to render a group category as a visible role selector outside of debug
             mode. Sharing the same parent as category_roles still groups both selectors under one "EMS"
             section. -->
        <record model="ir.module.category" id="category_secretary">
            <field name="name">Secretary</field>
            <field name="description">Educational Management System - Secretary</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">2</field>
            <field name="visible">True</field>
        </record>

        <!-- Kept separate for the same reason as category_secretary: its own independent
             Manager/Administrator chain, sharing category_main as parent so it still groups
             under the "EMS" section. -->
        <record model="ir.module.category" id="category_quality">
            <field name="name">Quality</field>
            <field name="description">Educational Management System - Quality</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">3</field>
            <field name="visible">True</field>
        </record>

        <!-- Consolidates Odoo's native Administration (Access Rights/Settings), Canned Responses
             and Job Queue permissions - previously scattered technical selectors - into one clean
             EMS selector. Kept separate for the same reason as category_secretary/category_quality. -->
        <record model="ir.module.category" id="category_settings">
            <field name="name">Settings</field>
            <field name="description">Educational Management System - Settings</field>
            <field name="parent_id" ref="ems.category_main"/>
            <field name="sequence">4</field>
            <field name="visible">True</field>
        </record>

        <record model="res.groups" id="group_teacher">
            <field name="name">Teacher</field>
            <field name="comment">Teacher's access rights.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_own_reader'))]"/>
        </record>

        <record model="res.groups" id="group_tutor">
            <field name="name">Tutor</field>
            <field name="comment">Access rights for tutors (teachers in charge of a group).</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_teacher'))]"/>
        </record>

        <record model="res.groups" id="group_head_of_department">
            <field name="name">Head of Department</field>
            <field name="comment">Access rights for department heads. Currently identical to Tutor.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_tutor'))]"/>
        </record>

        <record model="res.groups" id="group_head_of_studies">
            <field name="name">Head of Studies</field>
            <field name="comment">Access rights for Head of Studies / Deputy Head of Studies. Grants full read/write access to all employees' attendance records.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_head_of_department')), (4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        </record>

        <!-- Same privileges as Head of Studies for now; kept as its own group so it can be
             differentiated later without another migration. -->
        <record model="res.groups" id="group_director">
            <field name="name">Director</field>
            <field name="comment">Access rights for the Director. Currently identical to Head of Studies.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_head_of_studies'))]"/>
        </record>

        <!-- TODO: this group has not been yet setup in ir.modal.access.  -->
        <record model="res.groups" id="group_secretary">
            <field name="name">Manager</field>
            <field name="comment">Secretary's access rights.</field>
            <field name="category_id" ref="ems.category_secretary"/>
            <field name="implied_ids" eval="[
                (4, ref('sales_team.group_sale_salesman_all_leads')),
                (4, ref('account.group_account_invoice')),
                (4, ref('account.group_account_readonly')),
                (4, ref('account.group_validate_bank_account')),
                (4, ref('base.group_partner_manager')),
            ]"/>
        </record>

        <!-- Same privileges as Manager for now; kept as its own group so it can be
             differentiated later without another migration. -->
        <record model="res.groups" id="group_secretary_admin">
            <field name="name">Administrator</field>
            <field name="comment">Access rights for the Secretary department's administrator. Currently identical to Manager.</field>
            <field name="category_id" ref="ems.category_secretary"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_secretary')), (4, ref('hr.group_hr_manager'))]"/>
        </record>

        <!-- The Surveys section (EMS's own LimeSurvey integration), not to be confused with
             Odoo's native "Surveys" app (hidden - see group.py). -->
        <record model="res.groups" id="group_quality">
            <field name="name">Manager</field>
            <field name="comment">Access rights for the Quality team (EMS Surveys section).</field>
            <field name="category_id" ref="ems.category_quality"/>
        </record>

        <!-- Same privileges as Manager for now; kept as its own group so it can be
             differentiated later without another migration. -->
        <record model="res.groups" id="group_quality_admin">
            <field name="name">Administrator</field>
            <field name="comment">Access rights for the Quality coordinator. Currently identical to Manager.</field>
            <field name="category_id" ref="ems.category_quality"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_quality'))]"/>
        </record>

        <!-- Administration/Access Rights level, plus Canned Responses and Job Queue management
             granted explicitly (not only via Settings) so Manager keeps them even without Settings. -->
        <record model="res.groups" id="group_settings">
            <field name="name">Manager</field>
            <field name="comment">Access Rights level of Odoo's Administration, plus Canned Responses and Job Queue management.</field>
            <field name="category_id" ref="ems.category_settings"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_erp_manager')),
                (4, ref('mail.group_mail_canned_response_admin')),
                (4, ref('queue_job.group_queue_job_manager')),
            ]"/>
        </record>

        <!-- Only difference from Manager: Settings level of Odoo's Administration (which also
             implies Access Rights) instead of Access Rights alone. -->
        <record model="res.groups" id="group_settings_admin">
            <field name="name">Administrator</field>
            <field name="comment">Settings level of Odoo's Administration, plus Canned Responses and Job Queue management.</field>
            <field name="category_id" ref="ems.category_settings"/>
            <field name="implied_ids" eval="[(4, ref('ems.group_settings')), (4, ref('base.group_system'))]"/>
        </record>

        <record model="res.groups" id="group_academic_admin">
            <field name="name">Administrator</field>
            <field name="comment">All access rights.</field>
            <field name="category_id" ref="ems.category_roles"/>
            <field name="implied_ids" eval="[(6, 0, [
                ref('ems.group_director'),
                ref('ems.group_secretary_admin'),
                ref('ems.group_quality_admin'),
                ref('ems.group_settings_admin'),
            ])]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record model="res.groups" id="project.group_project_manager">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>   

        <record model="res.groups" id="project.group_project_user">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>  

        <record model="res.groups" id="mass_mailing.group_mass_mailing_user">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>   

        <record model="res.groups" id="survey.group_survey_manager">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>   

        <record model="res.groups" id="survey.group_survey_user">
            <field name="users" eval="[(3,ref('base.user_root')), (3,ref('base.user_admin'))]"/>
        </record>   

        <record model="ir.ui.menu" id="utm.menu_link_tracker_root">
            <field name="active">false</field>
        </record>

        <record id="base.menu_apps" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('ems.group_academic_admin')])]"/>
        </record>
<!-- 
        <delete id="utm.menu_link_tracker_root" model="ir.ui.menu" ></delete>
        <delete id="link_tracker.link_tracker_menu_main" model="ir.ui.menu" ></delete>        
        <delete id="utm.marketing_utm" model="ir.ui.menu" ></delete>         -->
        
    </data>
</odoo>