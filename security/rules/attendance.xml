    <record id="rule_attendance_session_teacher_own" model="ir.rule">
        <field name="name">Attendance session: own data</field>
        <field name="model_id" ref="ems.model_ems_attendance_session"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">
            [
                '|', 
                '|',                  
                ('create_uid', '=', user.id),                 
                ('template_teacher_id.user_id.id', '=', user.id), 
                ('session_teacher_id.user_id.id', '=', user.id)
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>   

