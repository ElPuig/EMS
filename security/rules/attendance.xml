    <record id="rule_attendance_status_teacher_tutor" model="ir.rule">
        <!-- Must be available for tutors in order to justify. -->
        <field name="name">Attendance status: tutors</field>
        <field name="model_id" ref="ems.model_ems_attendance_status"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('student_id.tutor_id.user_id.id', '=', user.id)]</field>
