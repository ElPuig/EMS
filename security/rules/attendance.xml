<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ems.attendance_template -->
    <record id="rule_attendance_template_admin" model="ir.rule">
        <field name="name">Attendance template: all data</field>
        <field name="model_id" ref="ems.model_ems_attendance_template"/>
        <field name="groups" eval="[(4, ref('ems.group_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_attendance_template_teacher_own" model="ir.rule">
        <field name="name">Attendance template: own data</field>
        <field name="model_id" ref="ems.model_ems_attendance_template"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('teacher_id.user_id.id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>  

