<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- ems.notice -->

        <!-- Admins and the Director see every notice, regardless of who created it. Director is
             listed explicitly (not just inherited through group_academic_admin's implied_ids,
             which only goes the other way: admin implies director, not the reverse) since a
             Director-only user needs their own matching group here. -->
        <record model="ir.rule" id="rule_notice_admin">
            <field name="name">Notice: admin/director see all</field>
            <field name="model_id" ref="ems.model_ems_notice"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_academic_admin'), ref('ems.group_director')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Head of Studies/Deputy Head of Studies (the same res.groups - see the comment on
             group_head_of_studies in security/groups.xml) and the Quality coordinator only see
             the notices they created themselves. Scoped to these two groups explicitly - a
             global (no-groups) rule would AND against rule_notice_admin above and wrongly
             restrict admins/director to their own notices too, since Odoo combines a rule with
             no group as a global AND across every other rule rather than an OR alternative
             (verified against odoo/addons/base/models/ir_rule.py's _compute_domain). -->
        <record model="ir.rule" id="rule_notice_own">
            <field name="name">Notice: user sees own</field>
            <field name="model_id" ref="ems.model_ems_notice"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_head_of_studies'), ref('ems.group_quality_admin')])]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ems.notice.line: notice lines are only ever edited inline from their parent notice's
             own form (no standalone menu), so visibility mirrors the parent notice's creator -
             same reasoning as the limesurvey header/block/recipient/enrollment rules below. -->
        <record model="ir.rule" id="rule_notice_line_admin">
            <field name="name">Notice line: admin/director see all</field>
            <field name="model_id" ref="ems.model_ems_notice_line"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_academic_admin'), ref('ems.group_director')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="rule_notice_line_own">
            <field name="name">Notice line: user sees own (via parent notice)</field>
            <field name="model_id" ref="ems.model_ems_notice_line"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_head_of_studies'), ref('ems.group_quality_admin')])]"/>
            <field name="domain_force">[('notice_id.create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ems.limesurvey_header / .block / .recipient / .enrollment

             Admins see everything: this also fixes a pre-existing gap where group_academic_admin
             had no ir.model.access.csv row at all for these 4 models, despite the "Surveys" menu
             already listing group_academic_admin as one of its visible groups.

             The Quality coordinator (group_quality_admin) reads every survey centre-wide but only
             creates/edits/deletes the ones they created themselves - two rules per model (read-all,
             write/create/unlink-own), the same idiom already used for ems.strike's coexistence
             rules in security/rules/coexistence.xml. Every header/block/recipient/enrollment
             record is created directly by whichever coordinator is operating that survey (no
             sudo()/cron/queue_job path creates or writes these on someone else's behalf - see
             docs/en/developers/communications/limesurvey.md), so create_uid reliably identifies
             the owning coordinator across all 4 models. -->

        <record model="ir.rule" id="rule_limesurvey_header_admin">
            <field name="name">Survey: admin sees all</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_header"/>
            <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_header_quality_admin_read">
            <field name="name">Survey: quality coordinator sees all (read only)</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_header"/>
            <field name="groups" eval="[(4, ref('ems.group_quality_admin'))]"/>
            <field name="domain_force">[]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_header_quality_admin_own">
            <field name="name">Survey: quality coordinator edits own</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_header"/>
            <field name="groups" eval="[(4, ref('ems.group_quality_admin'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_block_admin">
            <field name="name">Survey block: admin sees all</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_block"/>
            <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_block_quality_admin_read">
            <field name="name">Survey block: quality coordinator sees all (read only)</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_block"/>
            <field name="groups" eval="[(4, ref('ems.group_quality_admin'))]"/>
            <field name="domain_force">[]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_block_quality_admin_own">
            <field name="name">Survey block: quality coordinator edits own</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_block"/>
            <field name="groups" eval="[(4, ref('ems.group_quality_admin'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_recipient_admin">
            <field name="name">Survey recipient: admin sees all</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_recipient"/>
            <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_recipient_quality_admin_read">
            <field name="name">Survey recipient: quality coordinator sees all (read only)</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_recipient"/>
            <field name="groups" eval="[(4, ref('ems.group_quality_admin'))]"/>
            <field name="domain_force">[]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_recipient_quality_admin_own">
            <field name="name">Survey recipient: quality coordinator edits own</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_recipient"/>
            <field name="groups" eval="[(4, ref('ems.group_quality_admin'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_enrollment_admin">
            <field name="name">Survey enrollment: admin sees all</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_enrollment"/>
            <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="rule_limesurvey_enrollment_quality_admin_read">
            <field name="name">Survey enrollment: quality coordinator sees all (read only)</field>
            <field name="model_id" ref="ems.model_ems_limesurvey_enrollment"/>
