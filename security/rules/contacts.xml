<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <record id="rule_contact_admin" model="ir.rule">
        <field name="name">Contact: admin</field>
        <field name="model_id" ref="ems.model_res_partner"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_contact_secretary" model="ir.rule">
        <field name="name">Contact: secretary (full access)</field>
        <field name="model_id" ref="ems.model_res_partner"/>
        <field name="groups" eval="[(4, ref('ems.group_secretary'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_contact_head_of_studies" model="ir.rule">
        <field name="name">Contact: head of studies (full access, issue #448)</field>
        <field name="model_id" ref="ems.model_res_partner"/>
        <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_contact_teacher" model="ir.rule">
        <field name="name">Contact: teacher (read only)</field>
        <field name="model_id" ref="ems.model_res_partner"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_contact_tutor" model="ir.rule">
        <field name="name">Contact: tutor (edit its tutorands and their family)</field>
        <field name="model_id" ref="ems.model_res_partner"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">['|', ('tutor_id.user_id', '=', user.id), ('relation_all_ids.other_partner_id.tutor_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_contact_orientation_special_needs" model="ir.rule">
        <!-- Guidance edits the special educational needs of every student and applicant (issue
             #465). An ir.rule cannot name fields, so res.partner._ems_check_orientation_write()
             narrows this back down to special_needs. -->
        <field name="name">Contact: guidance (special educational needs of any student)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('ems.group_orientation'))]"/>
        <field name="domain_force">[('contact_type', 'in', ('student', 'applicant'))]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- res.partner.relation (issue #470): the student form's trash button deletes a family
         contact through res.partner.relation.all, which partner_multi_relation delegates to
         res.partner.relation with the user's own rights. access_res_partner_relation_teacher
         opens write/create/unlink to teachers; these two rules narrow it back down. -->
    <record id="rule_partner_relation_tutor" model="ir.rule">
        <field name="name">Partner relation: tutor (relations of its tutorands)</field>
        <field name="model_id" ref="partner_multi_relation.model_res_partner_relation"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">['|', ('left_partner_id.tutor_id.user_id', '=', user.id), ('right_partner_id.tutor_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_partner_relation_contact_manager" model="ir.rule">
        <!-- Secretary, Head of Studies and academic admin hold base.group_partner_manager, but
             Head of Studies and academic admin are also teachers: rules of a user's groups are
             OR-ed, so without this one the tutor rule above would narrow them to their tutees. -->
        <field name="name">Partner relation: contact managers (all relations)</field>
        <field name="model_id" ref="partner_multi_relation.model_res_partner_relation"/>
        <field name="groups" eval="[(4, ref('base.group_partner_manager'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_enrollment_admin" model="ir.rule">
        <field name="name">Enrollment: admin</field>
        <field name="model_id" ref="ems.model_ems_enrollment"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_enrollment_secretary" model="ir.rule">
        <field name="name">Enrollment: secretary (full access)</field>
        <field name="model_id" ref="ems.model_ems_enrollment"/>
        <field name="groups" eval="[(4, ref('ems.group_secretary'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_enrollment_teacher" model="ir.rule">
        <field name="name">enrollment: teacher (read only)</field>
        <field name="model_id" ref="ems.model_ems_enrollment"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_enrollment_tutor" model="ir.rule">
        <field name="name">enrollment: tutor (edit its tutorands)</field>
        <field name="model_id" ref="ems.model_ems_enrollment"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('student_id.tutor_id.user_id', '=' , user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Without this, Head/Deputy Head of Studies and Director only inherit group_teacher's
         two rules above (read-only everywhere; write/create/unlink limited to their own
         tutorands) - the same OR-combination gap already fixed for res.partner (issue #448,
         rule_contact_head_of_studies) and ems.attendance_template/ems.attendance_schedule
         (issue #444). Director/academic_admin already have full access via their own rules,
         but also match this one (group_academic_admin implies group_director implies
         group_head_of_studies) - harmless, since ir.rule domains for different groups are
         OR-ed together. -->
    <record id="rule_enrollment_head_of_studies" model="ir.rule">
        <field name="name">enrollment: Head of Studies (all data)</field>
        <field name="model_id" ref="ems.model_ems_enrollment"/>
        <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sale_order_admin" model="ir.rule">
        <field name="name">Enrollment (sale.order): admin</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sale_order_secretary" model="ir.rule">
        <field name="name">Enrollment (sale.order): secretary</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('ems.group_secretary'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sale_order_teacher" model="ir.rule">
        <field name="name">Enrollment (sale.order): teacher (read only)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('partner_id.tutor_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sale_order_tutor" model="ir.rule">
        <field name="name">Enrollment (sale.order): tutor (create/edit for own students, draft/sent only)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('partner_id.tutor_id.user_id', '=', user.id), ('state', '=', 'draft')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sale_order_line_admin" model="ir.rule">
        <field name="name">Enrollment line: admin</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sale_order_line_secretary" model="ir.rule">
        <field name="name">Enrollment line: secretary</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('ems.group_secretary'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sale_order_line_teacher" model="ir.rule">
        <field name="name">Enrollment line: teacher (read only)</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('order_id.partner_id.tutor_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sale_order_line_tutor_write" model="ir.rule">
        <field name="name">Enrollment line: tutor (edit/delete on draft only)</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('order_id.partner_id.tutor_id.user_id', '=', user.id), ('order_id.state', '=', 'draft')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_ems_authorization_admin" model="ir.rule">
        <field name="name">Authorization: admin</field>
        <field name="model_id" ref="ems.model_ems_authorization"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_ems_authorization_secretary" model="ir.rule">
        <field name="name">Authorization: secretary (full access)</field>
        <field name="model_id" ref="ems.model_ems_authorization"/>
        <field name="groups" eval="[(4, ref('ems.group_secretary'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_ems_authorization_teacher" model="ir.rule">
        <field name="name">Authorization: teacher (read only)</field>
        <field name="model_id" ref="ems.model_ems_authorization"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Without a rule of its own, the head of studies would inherit only the teacher's
         read-only rule and the tutor's own-students-only one (rules of different groups are
         ANDed), so they could not send an authorization to a student they do not tutor -
         which is precisely their job here (issue #443). -->
    <record id="rule_ems_authorization_head_of_studies" model="ir.rule">
        <field name="name">Authorization: head of studies</field>
        <field name="model_id" ref="ems.model_ems_authorization"/>
        <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_ems_authorization_tutor" model="ir.rule">
        <field name="name">Authorization: tutor (create/edit for own students)</field>
        <field name="model_id" ref="ems.model_ems_authorization"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('partner_id.tutor_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ems.student.document: tutors read only their own students' Google credentials PDF, and
         the TAC team every student's, since they reset those passwords (issue #478); DNI, IBAN,
         medical card... stay with secretary and admin. The academic
         admin inherits group_tutor through the Head of Studies chain, and a secretary may also
         tutor a group, so both need an unrestricted rule of their own - otherwise the tutor
         rule would narrow them too. -->
    <record id="rule_ems_student_document_admin" model="ir.rule">
        <field name="name">Student document: admin (full access)</field>
        <field name="model_id" ref="ems.model_ems_student_document"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
    </record>

    <record id="rule_ems_student_document_secretary" model="ir.rule">
        <field name="name">Student document: secretary (full access)</field>
        <field name="model_id" ref="ems.model_ems_student_document"/>
        <field name="groups" eval="[(4, ref('ems.group_secretary'))]"/>
        <field name="domain_force">[]</field>
    </record>

    <record id="rule_ems_student_document_tutor" model="ir.rule">
        <field name="name">Student document: tutor (own students' Google credentials, read only)</field>
        <field name="model_id" ref="ems.model_ems_student_document"/>
        <field name="groups" eval="[(4, ref('ems.group_tutor'))]"/>
        <field name="domain_force">[('doc_type', '=', 'google_credentials'), ('partner_id.tutor_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_ems_student_document_tac" model="ir.rule">
        <field name="name">Student document: TAC (every student's Google credentials, read only)</field>
        <field name="model_id" ref="ems.model_ems_student_document"/>
        <field name="groups" eval="[(4, ref('ems.group_tac'))]"/>
        <field name="domain_force">[('doc_type', '=', 'google_credentials')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
