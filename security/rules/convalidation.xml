<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ems.convalidation (issue #864). The model had no rules: every group with access read all of
             it. A tutor reads the requests of their tutees only (the tutor scope of the whole of EMS,
             as rule_strike_tutor). group_head_of_studies implies group_department_chief, which implies
             group_tutor, so the Heads of Studies, the Director, the secretariat and the administrator
             would be cut down to that scope too: each gets an explicit rule with no restriction. -->
        <record id="rule_convalidation_tutor" model="ir.rule">
            <field name="name">Convalidation: tutees</field>
            <field name="model_id" ref="ems.model_ems_convalidation"/>
            <field name="groups" eval="[(4, ref('ems.group_tutor'))]"/>
            <field name="domain_force">[('student_id.tutor_id.tutor_scope_user_ids', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_convalidation_head_of_studies" model="ir.rule">
            <field name="name">Convalidation: Heads of Studies and Director, all</field>
            <field name="model_id" ref="ems.model_ems_convalidation"/>
            <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_convalidation_secretary" model="ir.rule">
            <field name="name">Convalidation: secretariat, all</field>
            <field name="model_id" ref="ems.model_ems_convalidation"/>
            <field name="groups" eval="[(4, ref('ems.group_secretary'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_convalidation_admin" model="ir.rule">
            <field name="name">Convalidation: administrator, all</field>
            <field name="model_id" ref="ems.model_ems_convalidation"/>
            <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
