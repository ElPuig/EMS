<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #683: confidential documents (e.g. evidence of fewer opportunities) are only for
             the Erasmus team and the administrator. A Head of Studies reads the applications
             but never sees those files. -->
        <record id="rule_erasmus_application_document_all" model="ir.rule">
            <field name="name">Erasmus application document: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application_document"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus')), (4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_erasmus_application_document_not_confidential" model="ir.rule">
            <field name="name">Erasmus application document: not confidential (Head of Studies)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application_document"/>
            <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[('confidential', '=', False)]</field>
        </record>

        <!-- Issue #684: an evaluator sees only the interviews assigned to them, never the other
             evaluator's score; the Erasmus team and the administrator see them all. -->
        <record id="rule_erasmus_interview_all" model="ir.rule">
            <field name="name">Erasmus interview: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_interview"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus')), (4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_erasmus_interview_evaluator" model="ir.rule">
            <field name="name">Erasmus interview: own (evaluator)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_interview"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_evaluator'))]"/>
            <field name="domain_force">[('evaluator_id', '=', user.id)]</field>
        </record>

        <!-- Issue #686: a panel member sees only the mobility plan ratings assigned to them, and of
             each application only the documents the call shows to the panel (the mobility plan),
             so they can open its files; never the rest of the file. -->
        <record id="rule_erasmus_plan_rating_all" model="ir.rule">
            <field name="name">Erasmus plan rating: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_plan_rating"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus')), (4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_erasmus_plan_rating_evaluator" model="ir.rule">
            <field name="name">Erasmus plan rating: own (panel member)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_plan_rating"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_evaluator'))]"/>
            <field name="domain_force">[('evaluator_id', '=', user.id)]</field>
        </record>

        <record id="rule_erasmus_application_document_panel" model="ir.rule">
            <field name="name">Erasmus application document: mobility plan to rate (panel member)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application_document"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_evaluator'))]"/>
            <field name="domain_force">[('call_document_id.panel_visible', '=', True), ('confidential', '=', False),
                                        ('application_id.plan_rating_ids.evaluator_id', '=', user.id)]</field>
        </record>

        <!-- Issue #697: the Erasmus team reads every contact (the participants, their families) and
             creates and edits only the host entities and their contacts (the tutors at destination). -->
        <record id="rule_contact_erasmus_read" model="ir.rule">
            <field name="name">Contact: Erasmus team (read)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus'))]"/>
            <field name="domain_force">[]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_contact_erasmus_host" model="ir.rule">
            <field name="name">Contact: Erasmus team (host entities and their contacts)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus'))]"/>
            <field name="domain_force">['|', ('is_erasmus_host', '=', True), ('parent_id.is_erasmus_host', '=', True)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
