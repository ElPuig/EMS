<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #683: confidential documents (e.g. evidence of fewer opportunities) are only for
             the Erasmus team and the administrator. A Head of Studies reads the applications
             but never sees those files. Every rule of the Head of Studies is read only: rules add
             up across a user's groups, so a write-all rule would let a Head of Studies who also
             teaches in a group mobility (whose group writes documents) change any record (audit
             2026-10-25). -->
        <record id="rule_erasmus_application_document_all" model="ir.rule">
            <field name="name">Erasmus application document: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application_document"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus')), (4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_erasmus_application_document_not_confidential" model="ir.rule">
            <field name="name">Erasmus application document: not confidential (Head of Studies)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application_document"/>
            <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[('confidential', '=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Issue #684: an evaluator sees only the interviews assigned to them, never the other
             evaluator's score; the Erasmus team and the administrator see them all. -->
        <record id="rule_erasmus_interview_all" model="ir.rule">
            <field name="name">Erasmus interview: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_interview"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus')), (4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_erasmus_interview_evaluator" model="ir.rule">
            <field name="name">Erasmus interview: own (evaluator)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_interview"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_evaluator'))]"/>
            <field name="domain_force">[('evaluator_id', '=', user.id)]</field>
        </record>

        <!-- Issue #686: a panel member sees only the mobility plan ratings assigned to them, and of
             each application only the documents the call shows to the panel (the mobility plan),
             so they can open its files; never the rest of the file. -->
        <record id="rule_erasmus_plan_rating_all" model="ir.rule">
            <field name="name">Erasmus plan rating: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_plan_rating"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus')), (4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_erasmus_plan_rating_evaluator" model="ir.rule">
            <field name="name">Erasmus plan rating: own (panel member)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_plan_rating"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_evaluator'))]"/>
            <field name="domain_force">[('evaluator_id', '=', user.id)]</field>
        </record>

        <record id="rule_erasmus_application_document_panel" model="ir.rule">
            <field name="name">Erasmus application document: mobility plan to rate (panel member)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application_document"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_evaluator'))]"/>
            <field name="domain_force">[('call_document_id.panel_visible', '=', True), ('confidential', '=', False),
                                        ('application_id.plan_rating_ids.evaluator_id', '=', user.id)]</field>
        </record>

        <!-- Issue #697: the Erasmus team reads every contact (the participants, their families) and
             creates and edits only the host entities and their contacts (the tutors at destination). -->
        <record id="rule_contact_erasmus_read" model="ir.rule">
            <field name="name">Contact: Erasmus team (read)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus'))]"/>
            <field name="domain_force">[]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_contact_erasmus_host" model="ir.rule">
            <field name="name">Contact: Erasmus team (host entities and their contacts)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus'))]"/>
            <field name="domain_force">['|', ('is_erasmus_host', '=', True), ('parent_id.is_erasmus_host', '=', True)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Document records: a confidential project document (health, inclusion or bank data) is
             only for the Erasmus team and the administrator; the Secretary and the Heads of
             Studies see the rest. -->
        <record id="rule_erasmus_project_document_all" model="ir.rule">
            <field name="name">Erasmus project document: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_project_document"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus')), (4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_erasmus_project_document_not_confidential" model="ir.rule">
            <field name="name">Erasmus project document: not confidential (Secretary, Head of Studies)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_project_document"/>
            <field name="groups" eval="[(4, ref('ems.group_secretary')), (4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[('confidential', '=', False)]</field>
        </record>

        <!-- The exports log: the Erasmus team and the administrator see every export; the
             Secretary, their own. -->
        <record id="rule_erasmus_export_all" model="ir.rule">
            <field name="name">Erasmus export: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_export"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus')), (4, ref('ems.group_academic_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_erasmus_export_own" model="ir.rule">
            <field name="name">Erasmus export: own (Secretary)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_export"/>
            <field name="groups" eval="[(4, ref('ems.group_secretary'))]"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
        </record>

        <!-- Issue #701: group mobilities. The Erasmus team, the administrator and the Head of Studies
             see them all (the Head of Studies only reads); a leader or accompanying teacher
             (ems.group_erasmus_group_teacher) only their own mobilities. The enrolments, with the
             ranking, only the leader; never a confidential document. What each one may change is
             checked again in the models (EmsErasmusGroupMobility._ems_role). -->
        <record id="rule_erasmus_group_mobility_all" model="ir.rule">
            <field name="name">Erasmus group mobility: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_mobility"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_erasmus'), ref('ems.group_academic_admin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_erasmus_group_mobility_head_of_studies" model="ir.rule">
            <field name="name">Erasmus group mobility: all, read only (Head of Studies)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_mobility"/>
            <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erasmus_group_mobility_teacher" model="ir.rule">
            <field name="name">Erasmus group mobility: own (leader, accompanying teacher)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_mobility"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_group_teacher'))]"/>
            <field name="domain_force">['|', ('leader_id.user_id', '=', user.id), ('companion_ids.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_erasmus_group_participant_all" model="ir.rule">
            <field name="name">Erasmus group participant: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_participant"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_erasmus'), ref('ems.group_academic_admin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_erasmus_group_participant_head_of_studies" model="ir.rule">
            <field name="name">Erasmus group participant: all, read only (Head of Studies)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_participant"/>
            <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erasmus_group_participant_teacher" model="ir.rule">
            <field name="name">Erasmus group participant: own mobilities (leader, accompanying teacher)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_participant"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_group_teacher'))]"/>
            <field name="domain_force">['|', ('group_mobility_id.leader_id.user_id', '=', user.id), ('group_mobility_id.companion_ids.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_erasmus_group_follow_up_all" model="ir.rule">
            <field name="name">Erasmus group follow-up: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_log"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_erasmus'), ref('ems.group_academic_admin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_erasmus_group_follow_up_head_of_studies" model="ir.rule">
            <field name="name">Erasmus group follow-up: all, read only (Head of Studies)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_log"/>
            <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erasmus_group_follow_up_teacher" model="ir.rule">
            <field name="name">Erasmus group follow-up: own mobilities (leader, accompanying teacher)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_log"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_group_teacher'))]"/>
            <field name="domain_force">['|', ('group_mobility_id.leader_id.user_id', '=', user.id), ('group_mobility_id.companion_ids.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_erasmus_group_registration_all" model="ir.rule">
            <field name="name">Erasmus group enrolment: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_registration"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_erasmus'), ref('ems.group_academic_admin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_erasmus_group_registration_head_of_studies" model="ir.rule">
            <field name="name">Erasmus group enrolment: all, read only (Head of Studies)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_registration"/>
            <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erasmus_group_registration_leader" model="ir.rule">
            <field name="name">Erasmus group enrolment: own mobilities (leader)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_group_registration"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_group_teacher'))]"/>
            <field name="domain_force">[('group_mobility_id.leader_id.user_id', '=', user.id)]</field>
        </record>
        <!-- With a rule for the group teachers on call documents, the groups that read every call's
             documents need theirs, or a team member who also leads a group would lose them. -->
        <record id="rule_erasmus_call_document_all" model="ir.rule">
            <field name="name">Erasmus call document: all (team, admin)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_call_document"/>
            <field name="groups" eval="[(6, 0, [ref('ems.group_erasmus'), ref('ems.group_academic_admin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_erasmus_call_document_head_of_studies" model="ir.rule">
            <field name="name">Erasmus call document: all, read only (Head of Studies)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_call_document"/>
            <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erasmus_call_document_group_teacher" model="ir.rule">
            <field name="name">Erasmus call document: own group mobilities (leader, accompanying teacher)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_call_document"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_group_teacher'))]"/>
            <field name="domain_force">[('group_mobility_id', '!=', False), '|', ('group_mobility_id.leader_id.user_id', '=', user.id), ('group_mobility_id.companion_ids.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_erasmus_application_document_group_teacher" model="ir.rule">
            <field name="name">Erasmus application document: own group mobilities, not confidential (leader, accompanying teacher)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application_document"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_group_teacher'))]"/>
            <field name="domain_force">[('group_mobility_id', '!=', False), ('confidential', '=', False), '|', ('group_mobility_id.leader_id.user_id', '=', user.id), ('group_mobility_id.companion_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erasmus_application_document_group_teacher_write" model="ir.rule">
            <field name="name">Erasmus application document: change, own (accompanying teacher) or the group's (leader)</field>
            <field name="model_id" ref="ems.model_ems_erasmus_application_document"/>
            <field name="groups" eval="[(4, ref('ems.group_erasmus_group_teacher'))]"/>
            <field name="domain_force">[('group_mobility_id', '!=', False), ('confidential', '=', False), '|', ('group_mobility_id.leader_id.user_id', '=', user.id), ('group_participant_id.employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
