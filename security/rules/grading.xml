    <!-- ems.student.year_record (and its subject/outcome children): the academic
         history is readable by the tutor of the student's current group, by Head of
         Studies / Director (read all) and fully manageable by the admin. Secretary
         needs its own all-data rule (not just the ACL): a secretary who is also a
         teacher would otherwise be restricted by the tutor rule (group rules only
         OR across groups that define one). -->
    <record id="rule_year_record_admin" model="ir.rule">
        <field name="name">Year record: all data</field>
        <field name="model_id" ref="ems.model_ems_student_year_record"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

