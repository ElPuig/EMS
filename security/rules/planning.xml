<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ems.planning -->
    <record id="rule_planning_admin" model="ir.rule">
        <field name="name">Planning: all data</field>
        <field name="model_id" ref="ems.model_ems_planning"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_planning_teacher_own_subjects" model="ir.rule">
        <!-- Teachers can only READ the plannings of the subjects they teach (via ems.teaching). -->
        <field name="name">Planning: taught subjects (read only)</field>
        <field name="model_id" ref="ems.model_ems_planning"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('subject_id', 'in', user.employee_ids.teaching_ids.subject_id.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_planning_hos_all" model="ir.rule">
        <!-- Issue #503: Head of Studies/Deputy need to see and adjust every planning, not just
             the ones tied to subjects they personally teach - group_head_of_studies also implies
             group_teacher, so without this rule they'd only get rule_planning_teacher_own_subjects
             above. Unlink stays out (see ir.model.access.csv, unlink=0 for this group). -->
        <field name="name">Planning: all data (Head of Studies, no unlink)</field>
        <field name="model_id" ref="ems.model_ems_planning"/>
        <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ems.planning_outcome -->
    <record id="rule_planning_outcome_admin" model="ir.rule">
        <field name="name">Planning outcome: all data</field>
        <field name="model_id" ref="ems.model_ems_planning_outcome"/>
        <field name="groups" eval="[(4, ref('ems.group_academic_admin'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_planning_outcome_teacher_own_subjects" model="ir.rule">
        <field name="name">Planning outcome: taught subjects (read only)</field>
        <field name="model_id" ref="ems.model_ems_planning_outcome"/>
        <field name="groups" eval="[(4, ref('ems.group_teacher'))]"/>
        <field name="domain_force">[('planning_id.subject_id', 'in', user.employee_ids.teaching_ids.subject_id.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_planning_outcome_hos_all" model="ir.rule">
        <!-- Same as rule_planning_hos_all, for the outcome ponderation lines. -->
        <field name="name">Planning outcome: all data (Head of Studies, no unlink)</field>
        <field name="model_id" ref="ems.model_ems_planning_outcome"/>
        <field name="groups" eval="[(4, ref('ems.group_head_of_studies'))]"/>
        <field name="domain_force">[]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
