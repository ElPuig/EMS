<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #393: the guidance (Orientació) and coexistence posts read every student's
             file centre-wide, not just their own tutees'. One technical group owns the whole
             surface (see security/groups.xml's group_student_data_reader) so both posts share a
             single set of rules; Odoo ORs rules across a user's groups, so a domain of [] here
             widens whatever group_teacher's own tutor_id-filtered rules already allow rather
             than fighting them. Read only throughout: write/create/unlink stay with the groups
             that already own them.

             Issue #448: group_head_of_studies (Head/Deputy Head of Studies and, transitively,
             Director) also implies this technical group now, for the same centre-wide read
             reason - they additionally get real write access on res.partner via their own
             rule_contact_head_of_studies (security/rules/contacts.xml), which this file does
             not grant (read only, as above).

             ems.strike.reason (the strike-reason catalog) deliberately has no rule here: no
             group row-filters it in the first place, so the ACL read line alone is the whole
             permission and a rule would only add noise. -->

        <record id="rule_res_partner_student_data_reader" model="ir.rule">
            <field name="name">Contact: student data reader (all data, read only)</field>
            <field name="model_id" ref="ems.model_res_partner"/>
            <field name="groups" eval="[(4, ref('ems.group_student_data_reader'))]"/>
            <field name="domain_force">[]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

