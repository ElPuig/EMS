<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ems.ActionsDropdown">
        <Dropdown t-if="visibleSlotNames.length" menuClass="'o_ems_actions_menu'">
            <button class="btn btn-secondary o_ems_actions_toggle">
                <t t-esc="props.string"/>
                <i class="fa fa-caret-down ms-1"/>
            </button>
            <t t-set-slot="content">
                <t t-foreach="visibleSlotNames" t-as="slot" t-key="slot">
                    <DropdownItem class="'o-dropdown-item-unstyled-button o_ems_actions_item'">
                        <t t-slot="{{ slot }}"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>

</templates>
