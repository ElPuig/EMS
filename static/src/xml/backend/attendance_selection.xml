<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ems.AttendanceSelection" owl="1">
        <div class="d-flex flex-nowrap gap-1 w-100 h-100 align-items-center">
            <t t-foreach="options" t-as="opt" t-key="opt.value">
                <button type="button"
                    class="btn btn-sm d-flex align-items-center justify-content-center flex-grow-1 p-1"
                    t-att-class="getButtonClass(opt)"
                    t-att-title="opt.label"
                    t-on-click="(ev) => this.updateStatus(opt.value, ev)">
                    
                    <i t-attf-class="fa {{opt.icon}} fa-lg"/>
                    
                    <span t-esc="opt.label" class="d-none d-md-inline ms-1 small"/>
                </button>
            </t>
        </div>
    </t>

</templates>