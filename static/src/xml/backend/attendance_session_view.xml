<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ems.AttendanceSessionView">
        <div class="ems-av-root">

            <!-- ── Header ──────────────────────────────────────────── -->
            <div class="ems-av-header">

                <!-- Date navigation -->
                <div class="ems-av-date-nav">
                    <button class="ems-av-nav-btn" t-on-click="prevDay">&#8249;</button>
                    <input class="ems-av-date-input"
                           type="date"
                           t-att-value="state.date"
                           t-on-change="onDateInput"/>
                    <button class="ems-av-nav-btn" t-on-click="nextDay">&#8250;</button>
                </div>

                <!-- Group filter (only shown when >1 group present) -->
                <div class="ems-av-group-wrap" t-if="state.groups.length > 1">
                    <select class="ems-av-session-select" t-on-change="onGroupChange">
                        <option value="">Tots els grups</option>
                        <t t-foreach="state.groups" t-as="g" t-key="g">
                            <option t-att-value="g"
                                    t-att-selected="state.selectedGroup === g">
                                <t t-esc="g"/>
                            </option>
                        </t>
                    </select>
                </div>

                <!-- Session / schedule selector -->
                <div class="ems-av-session-wrap"
                     t-if="filteredSessions.length or filteredPlanned.length">
                    <select class="ems-av-session-select" t-on-change="onSelectorChange">
                        <optgroup t-if="filteredSessions.length" label="Sessions">
                            <t t-foreach="filteredSessions" t-as="s" t-key="'session_' + s.id">
                                <option t-att-value="'session_' + s.id"
                                        t-att-selected="state.selected === 'session_' + s.id">
                                    <t t-esc="sessionLabel(s)"/>
                                </option>
                            </t>
                        </optgroup>
                        <optgroup t-if="filteredPlanned.length" label="Planificades (sense sessió)">
                            <t t-foreach="filteredPlanned" t-as="s" t-key="'schedule_' + s.id">
                                <option t-att-value="'schedule_' + s.id"
                                        t-att-selected="state.selected === 'schedule_' + s.id">
                                    ○  <t t-esc="scheduleLabel(s)"/>
                                </option>
                            </t>
                        </optgroup>
                    </select>
                </div>

            </div>

            <!-- ── Body ────────────────────────────────────────────── -->
            <div class="ems-av-body" t-if="!state.loading">

                <!-- No items at all -->
                <t t-if="!filteredSessions.length and !filteredPlanned.length">
                    <div class="ems-av-empty">No hi ha sessions ni horaris planificats per a aquest dia.</div>
                </t>

                <!-- Planned schedule selected → show start button -->
                <t t-elif="selectedSchedule">
                    <div class="ems-av-planned-card">
                        <div class="ems-av-planned-icon">📋</div>
                        <div class="ems-av-planned-title">
                            <t t-esc="scheduleLabel(selectedSchedule)"/>
                        </div>
                        <p class="ems-av-planned-hint">
                            This session has not been started for the selected day.
                        </p>
                        <button class="ems-av-start-btn"
                                t-on-click="() => this.onStartSession(selectedSchedule.id)">
                            ▶  Start session
                        </button>
                    </div>
                </t>

                <!-- Existing session selected → show student lines -->
                <t t-else="">
                    <t t-if="!state.lines.length">
                        <div class="ems-av-empty">Aquesta sessió no té alumnes.</div>
                    </t>
                    <t t-else="">
                        <!-- Column headers aligned with student rows -->
                        <div class="ems-av-col-headers">
                            <div class="ems-av-col-header-avatar"/>
                            <div class="ems-av-col-header-name"/>
                            <div class="ems-av-btns">
                                <t t-foreach="statuses" t-as="s" t-key="s.key">
                                    <div class="ems-av-col-header-label"
                                         t-att-title="s.title">
                                        <t t-esc="s.title"/>
                                    </div>
                                </t>
                            </div>
                            <div class="ems-av-col-header-notes"/>
                        </div>
                        <t t-foreach="state.lines" t-as="line" t-key="line.id">
                            <div class="ems-av-line">
                                <img class="ems-av-avatar" t-att-src="avatarUrl(line)" alt=""/>
                                <span class="ems-av-name"
                                      t-att-title="line.student_id ? line.student_id[1] : ''"
                                      t-esc="line.student_id ? line.student_id[1] : '—'"/>
                                <div class="ems-av-btns">
                                    <t t-foreach="statuses" t-as="s" t-key="s.key">
                                        <button class="ems-av-status-btn"
                                                t-att-class="line.status === s.key ? 'ems-av-status-btn--active' : ''"
                                                t-att-title="s.title"
                                                t-att-disabled="state.saving[line.id]"
                                                t-on-click="() => this.onStatusClick(line.id, s.key)">
                                            <t t-esc="s.label"/>
                                        </button>
                                    </t>
                                </div>
                                <button class="ems-av-notes-btn"
                                        t-att-class="line.notes ? 'ems-av-notes-btn--has-notes' : ''"
                                        t-att-title="line.notes || 'Add notes'"
                                        t-on-click="() => this.onNotesClick(line.id, line.student_id ? line.student_id[1] : '', line.notes)">
                                    <i class="fa fa-pencil"/>
                                </button>
                            </div>
                        </t>
                    </t>
                </t>

            </div>

            <!-- ── Loading spinner ──────────────────────────────────── -->
            <div class="ems-av-loading" t-if="state.loading">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>

            <!-- ── Notes dialog ─────────────────────────────────────── -->
            <dialog t-ref="notesDialog" class="ems-av-notes-dialog">
                <div class="ems-av-notes-dialog-header">
                    <i class="fa fa-pencil me-2"/>
                    <span t-esc="state.editingStudentName"/>
                </div>
                <textarea t-ref="notesTextarea"
                          class="ems-av-notes-textarea"
                          rows="5"
                          placeholder="Notes for this student..."/>
                <div class="ems-av-notes-dialog-footer">
                    <button class="ems-av-notes-cancel-btn" t-on-click="onNotesCancel">Cancel</button>
                    <button class="ems-av-notes-save-btn" t-on-click="onNotesSave">Save</button>
                </div>
            </dialog>

        </div>
    </t>
</templates>
