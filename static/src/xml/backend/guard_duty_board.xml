<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- One absence line of the absences table: whoever is missing and what has to be covered,
         struck out once nobody needs to be sent. Expects 'line' and 'absence'. -->
    <t t-name="ems.GuardBoardAbsenceRow">
        <!-- Struck out once nobody needs to be sent: a co-teacher is in the
             class, a guard has been assigned (sharing that guard's colour), or
             the families were told the students can stay at home for it. -->
        <div class="o_guard_board_absence_row"
             t-att-class="absenceRowClass(absence)"
             t-att-data-tooltip="absenceRowTooltip(absence)"
             t-on-click="(ev) => this.onAbsenceClick(ev, line, absence)">
            <!-- The whole line answers hover and click, the icon only shows
                 there is something to ask. -->
            <i t-if="struckReason(absence)" class="fa fa-info-circle o_guard_board_absence_info"
               role="img" t-att-aria-label="struckReason(absence)"/>
            <span class="o_guard_board_absence_text">
                <span t-att-class="absenceClass(absence.state)" t-esc="absence.teacher"/>
                <span class="o_guard_board_absence_class">
                    <t t-esc="absence.group"/><t t-if="absence.subject"> · <t t-esc="absence.subject"/></t><t t-if="absence.room"> · <t t-esc="absence.room"/></t>
                </span>
            </span>
            <!-- One tag per guard, with the part they cover when it is not the whole class, and one
                 per part still missing (issue #637). -->
            <t t-foreach="absence.covers" t-as="cover" t-key="cover.id">
                <span class="o_guard_board_absence_tag o_guard_board_cover_tag"
                      t-att-class="'o_guard_board_cover_' + cover.color + (cover.partial ? ' o_guard_board_cover_partial' : '')">
                    <i class="fa fa-user-circle me-1"/><t t-esc="cover.guard"/><t t-if="cover.partial"> <t t-esc="cover.label"/></t>
                </span>
            </t>
            <t t-foreach="absence.missing" t-as="missing" t-key="missing_index">
                <span class="o_guard_board_absence_tag o_guard_board_missing_tag" t-esc="missing"/>
            </t>
            <span t-if="absence.arrangement" class="o_guard_board_absence_tag o_guard_board_arrangement_tag"
                  t-att-class="{ o_guard_board_arrangement_pending: absence.arrangement.pending }">
                <i class="fa fa-exchange me-1"/><t t-esc="absence.arrangement.teacher"/>
            </span>
            <!-- Issue #623: the lesson moved here is one the group no longer
                 has, so it comes in later or leaves earlier: say both. -->
            <span t-if="absence.arrangement and absence.arrangement.change"
                  class="o_guard_board_absence_tag o_guard_board_authorized_tag o_guard_board_arrangement_change_tag"
                  t-esc="absence.arrangement.change"/>
            <span t-if="absence.authorized" class="o_guard_board_absence_tag o_guard_board_authorized_tag" t-esc="absence.authorized"/>
            <!-- Issue #659: what the families were told can still be changed, with one correction. -->
            <button t-if="absence.authorized and absence.change_side and absence.can_manage" type="button"
                    class="btn btn-sm btn-link p-0 o_guard_board_change_proposal"
                    t-on-click.stop="() => this.openChangeProposalDialog(absence)">
                <i class="fa fa-pencil-square-o me-1"/><t t-esc="actionLabels.changeProposal"/>
            </button>
            <span t-elif="absence.proposed" class="o_guard_board_absence_tag o_guard_board_proposed_tag" t-esc="absence.proposed"/>
            <!-- Issue #645: a lesson an arrangement moved elsewhere leaves the group without anybody. -->
            <span t-if="absence.moved" class="o_guard_board_absence_tag o_guard_board_moved_tag">
                <i class="fa fa-arrows-v me-1"/><t t-esc="absence.moved"/>
            </span>
            <span t-if="absence.arrangement_plans.length" class="o_guard_board_absence_tag o_guard_board_options_tag">
                <i class="fa fa-exchange me-1"/><t t-esc="arrangementCountLabel(absence)"/>
            </span>
        </div>
    </t>

    <!-- One of the day's pending actions that is not an arrangement plan: a timetable change to
         propose (with the selector of how much of it to tell the families), a correction, or an
         arrangement or a change waiting for its draft notice. Expects 'action'. -->
    <t t-name="ems.GuardBoardActionRow">
        <div class="o_guard_board_action" t-att-class="'o_guard_board_action_' + action.type">
            <i t-att-class="actionIcon(action)"/>
            <span class="o_guard_board_action_label" t-esc="action.label"/>
            <t t-if="action.draft_id">
                <span class="o_guard_board_absence_tag" t-esc="action.draft_label"/>
            </t>
            <select t-elif="action.options.length" class="form-select form-select-sm o_guard_board_action_option"
                    t-on-change="(ev) => this.onActionOptionChange(action, ev)">
                <t t-foreach="action.options" t-as="option" t-key="option_index">
                    <option t-att-value="option_index" t-att-selected="option_index === action.default" t-esc="option.label"/>
                </t>
            </select>
            <button type="button" class="btn btn-sm btn-outline-primary o_guard_board_action_button"
                    t-on-click="() => this.onAction(action)" t-esc="actionButtonLabel(action)"/>
        </div>
    </t>

    <!-- A box of proposals for the day's absences, one section per group (with the groups sharing
         lessons with it): first what is waiting (an arrangement waiting for its notice), then the
         arrangement plans, the best first, and last the timetable change alone, telling the
         families without rearranging anything. Expects 'boxSections', 'boxClass', 'boxTitle' and
         'boxHelp'. -->
    <t t-name="ems.GuardBoardProposalsBox">
        <div t-if="boxSections.length" class="o_guard_board_actions o_guard_board_arrangements" t-att-class="boxClass">
            <div class="o_guard_board_actions_title" t-esc="boxTitle"/>
            <div class="o_guard_board_actions_help text-muted" t-esc="boxHelp"/>
            <t t-foreach="boxSections" t-as="section" t-key="section.key">
                <div class="o_guard_board_section">
                    <div class="o_guard_board_section_title" t-esc="section.title"/>
                    <t t-foreach="section.waiting" t-as="action" t-key="action_index">
                        <t t-call="ems.GuardBoardActionRow"/>
                    </t>
                    <t t-foreach="section.plans" t-as="action" t-key="action.plan.key">
                        <GuardArrangementPlan plan="action.plan" selection="planSelection(action.plan)" showGroups="false"
                                              onToggle="(index, checked) => this.togglePlanStep(action.plan, index, checked)">
                            <!-- On the right, lined up with the buttons of the
                                 proposal rows (issue #647). -->
                            <div class="o_guard_board_plan_actions">
                                <button type="button" class="btn btn-sm btn-outline-primary o_guard_board_action_button o_guard_board_plan_apply"
                                        t-att-disabled="!hasSelectedSteps(action.plan)"
                                        t-on-click="() => this.applyPlan(action.plan, this.planSelection(action.plan))"
                                        t-esc="actionLabels.applyPlan"/>
                            </div>
                        </GuardArrangementPlan>
                    </t>
                    <!-- The timetable change alone: sending the notice strikes those
                         lessons off the table. The planner may choose a shorter change
                         and send a guard to the rest. -->
                    <div t-if="section.notices.length" class="o_guard_board_plan o_guard_board_notice_plan">
                        <div class="o_guard_board_plan_title">
                            <strong t-esc="noticePlanTitle(section)"/>
                            <span class="ms-1" t-esc="actionLabels.noticeOnly"/>
                        </div>
                        <!-- With a correction pending (issue #659), the notices and the
                             corrections are steps to check and apply together: one
                             email per group. -->
                        <div t-if="section.urgent" class="o_guard_board_plan_steps">
                            <t t-foreach="section.notices" t-as="action" t-key="action_index">
                                <t t-call="ems.GuardBoardNoticeStep"/>
                            </t>
                            <div class="o_guard_board_plan_actions">
                                <button type="button" class="btn btn-sm btn-outline-primary o_guard_board_action_button o_guard_board_notices_apply"
                                        t-att-disabled="!section.notices.some((action, index) => this.isNoticeChecked(section, index))"
                                        t-on-click="() => this.applyNotices(section)"
                                        t-esc="actionLabels.applyPlan"/>
                            </div>
                        </div>
                        <div t-else="" class="o_guard_board_plan_steps">
                            <t t-foreach="section.notices" t-as="action" t-key="action_index">
                                <t t-call="ems.GuardBoardActionRow"/>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
                </div>
    </t>

    <!-- Issue #659: a timetable change or a correction as a step of "Only tell the families", with
         its checkbox and the selector of how much of it to tell. Expects 'section' and 'action'. -->
    <t t-name="ems.GuardBoardNoticeStep">
        <div class="o_guard_board_action o_guard_board_notice_step" t-att-class="'o_guard_board_action_' + action.type">
            <input type="checkbox" class="form-check-input o_guard_board_plan_check"
                   t-att-checked="isNoticeChecked(section, action_index)"
                   t-on-change="(ev) => this.toggleNotice(section, action_index, ev.target.checked)"/>
            <i t-att-class="actionIcon(action)"/>
            <span class="o_guard_board_action_label" t-esc="action.label"/>
            <!-- A single option is already in the sentence: nothing to choose. -->
            <select t-if="action.options.length > 1" class="form-select form-select-sm o_guard_board_action_option"
                    t-on-change="(ev) => this.onActionOptionChange(action, ev)">
                <t t-foreach="action.options" t-as="option" t-key="option_index">
                    <option t-att-value="option_index" t-att-selected="option_index === action.default" t-esc="option.label"/>
                </t>
            </select>
        </div>
    </t>

    <t t-name="ems.GuardDutyBoard">
        <div class="o_guard_board">
            <div class="o_guard_board_header">
                <h1 class="o_guard_board_title" t-esc="title"/>

                <!-- Weekday tabs, each carrying its own real date: absences happen on dates, the
                     timetable repeats by weekday, and this strip is where the two meet. -->
                <ul class="nav nav-tabs o_guard_board_tabs">
                    <t t-foreach="days" t-as="day" t-key="day.index">
                        <li class="nav-item">
                            <a href="#" class="nav-link" t-att-class="{ active: state.activeDay === day.index }"
                               t-on-click.prevent="() => this.setActiveDay(day.index)">
                                <span t-esc="day.label"/>
                                <span class="o_guard_board_tab_date" t-esc="day.dayOfMonth"/>
                            </a>
                        </li>
                    </t>
                </ul>

                <!-- Per-day toolbar: week navigation + date picker (which week the tabs above
                     stand for), shift picker (morning/afternoon are separate shifts, never shown
                     stacked together), the area filter, the two readings of the same day, and
                     one PDF per day. -->
                <div class="o_guard_board_toolbar">
                    <div class="btn-group btn-group-sm o_guard_board_week_nav">
                        <button type="button" class="btn btn-secondary" t-on-click="() => this.shiftWeek(-1)">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <button type="button" class="btn btn-secondary" t-on-click="() => this.shiftWeek(1)">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>
                    <input type="date" class="form-control form-control-sm o_guard_board_date_input"
                           t-att-value="activeDate" t-on-change="(ev) => this.onDateChange(ev)"/>
                    <select class="form-select form-select-sm o_guard_board_shift_select" t-on-change="(ev) => this.onShiftChange(ev)">
                        <t t-foreach="shifts" t-as="shift" t-key="shift.key">
                            <option t-att-value="shift.key" t-att-selected="shift.key === state.activeShift" t-esc="shift.label"/>
                        </t>
                    </select>
                    <!-- Area filter (issue #637): a checkbox per area,
                         not a native multi-<select> (that needs a ctrl/cmd-click, not discoverable) -
                         empty selection means "All areas". -->
                    <div class="dropdown o_guard_board_area_dropdown">
                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle o_guard_board_area_toggle"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" t-esc="areaFilterLabel"/>
                        <ul class="dropdown-menu o_guard_board_area_menu">
                            <t t-foreach="state.areas" t-as="area" t-key="area.id">
                                <li>
                                    <label class="dropdown-item o_guard_board_area_item">
                                        <input type="checkbox" class="form-check-input me-1"
                                               t-att-checked="state.activeAreaIds.includes(area.id)"
                                               t-on-change="() => this.toggleArea(area.id)"/>
                                        <span t-esc="area.name"/>
                                    </label>
                                </li>
                            </t>
                        </ul>
                    </div>
                    <ul class="nav nav-pills o_guard_board_view_tabs">
                        <t t-foreach="views" t-as="view" t-key="view.key">
                            <li class="nav-item">
                                <a href="#" class="nav-link" t-att-class="{ active: state.activeView === view.key }"
                                   t-on-click.prevent="() => this.setActiveView(view.key)" t-esc="view.label"/>
                            </li>
                        </t>
                    </ul>
                    <button type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.onPdfClick()">
                        <i class="fa fa-file-pdf-o me-1"/>PDF
                    </button>
                </div>
            </div>

            <div class="o_guard_board_content" t-ref="content">
                <t t-if="state.loading">
                    <div class="o_guard_board_loading text-muted" t-esc="emptyLabels.loading"/>
                </t>
                <t t-else="">
                    <div t-if="!state.board.lines.length" class="text-muted o_guard_board_empty" t-esc="emptyLabels.schedule"/>

                    <!-- Tab 1: the timetable itself, with whoever is away marked in place. -->
                    <div t-elif="state.activeView === 'schedule'" class="o_guard_board_table_wrap">
                        <!-- The current time, across the whole table (issue #647): placed by
                             placeNowLine() in guard_duty_board.js, hidden when the board shows
                             another day or a range that does not include it. -->
                        <div class="o_guard_board_now_line" aria-hidden="true"/>
                        <t t-set="grid" t-value="state.board.schedule_grid"/>
                        <table class="table table-bordered o_guard_board_table o_guard_board_timeline">
                            <colgroup>
                                <col class="o_guard_board_col_time"/>
                                <t t-foreach="state.board.groups" t-as="group" t-key="group.id">
                                    <col class="o_guard_board_col_group"/>
                                </t>
                                <t t-foreach="Array.from({ length: grid.lane_count })" t-as="lane" t-key="lane_index">
                                    <col class="o_guard_board_col_lane"/>
                                </t>
                            </colgroup>
                            <thead>
                                <!-- One band per area: its groups share a time framework (issue #637). -->
                                <tr class="o_guard_board_area_row">
                                    <th rowspan="2" class="align-middle" t-esc="columnLabels.time"/>
                                    <t t-foreach="grid.areas" t-as="area" t-key="area_index">
                                        <th t-att-colspan="area.colspan" class="o_guard_board_area" t-esc="area.name or noAreaLabel"/>
                                    </t>
                                    <th rowspan="2" class="align-middle" t-att-colspan="grid.lane_count" t-esc="columnLabels.guard"/>
                                </tr>
                                <tr>
                                    <t t-foreach="state.board.groups" t-as="group" t-key="group.id">
                                        <th t-att-class="{ o_guard_board_area_start: group_first or state.board.groups[group_index - 1].area_id !== group.area_id }" t-esc="group.name"/>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="grid.rows" t-as="row" t-key="row_index">
                                    <tr t-att-style="rowStyle(row)">
                                        <td class="o_guard_board_time"><span t-esc="row.label"/></td>
                                        <t t-foreach="row.cells" t-as="slot" t-key="slot_index">
                                            <td t-if="slot.empty"/>
                                            <td t-elif="slot.is_break and !slot.guards and slot.line === undefined" t-att-rowspan="slot.rowspan" class="o_guard_board_block o_guard_board_cell_break">
                                                <span class="o_guard_board_block_time" t-esc="slot.label"/>
                                                <span class="o_guard_board_break_label" t-esc="breakLabel"/>
                                            </td>
                                            <td t-else="" t-att-rowspan="slot.rowspan" class="o_guard_board_block">
                                                <t t-set="cell" t-value="state.board.lines[slot.line].cells[slot.column]"/>
                                                <span class="o_guard_board_block_time" t-esc="slot.label"/>
                                                <span class="o_guard_board_cell_subject" t-esc="cell.subject"/>
                                                <span t-if="cell.teachers.length" class="o_guard_board_cell_teacher">
                                                    <t t-foreach="cell.teachers" t-as="teacher" t-key="teacher.name">
                                                        <span t-att-class="absenceClass(teacher.absence) + (teacher.moved ? ' o_guard_board_guard_busy' : '')" t-esc="teacher.name"/><t t-if="!teacher_last">, </t>
                                                    </t>
                                                </span>
                                                <!-- Issue #605: who teaches it instead after an internal arrangement. -->
                                                <span t-if="cell.substitutes.length" class="o_guard_board_cell_teacher o_guard_board_cell_substitute">
                                                    <i class="fa fa-exchange me-1"/><t t-esc="cell.substitutes.join(', ')"/>
                                                </span>
                                                <span t-if="cell.room" class="o_guard_board_cell_room" t-esc="cell.room"/>
                                            </td>
                                        </t>
                                        <t t-foreach="row.guards" t-as="slot" t-key="slot_index">
                                            <td t-if="slot.empty" class="o_guard_board_guard_cell"/>
                                            <td t-else="" t-att-rowspan="slot.rowspan" class="o_guard_board_guard_cell o_guard_board_block" t-att-class="{ o_guard_board_cell_break: slot.is_break }">
                                                <span class="o_guard_board_block_time" t-esc="slot.label"/>
                                                <span t-if="slot.is_break" class="o_guard_board_break_label" t-esc="breakLabel"/>
                                                <t t-foreach="state.board.lines[slot.line].guards" t-as="guard" t-key="guard.name">
                                                    <span class="o_guard_board_guard_badge"
                                                          t-att-class="absenceClass(guard.absence) + (guard.busy ? ' o_guard_board_guard_busy' : '')" t-att-data-tooltip="guard.busy">
                                                        <t t-esc="guard.name"/>
                                                        <span t-if="guard.is_wc" class="o_guard_board_guard_wc_tag"> <t t-esc="wcSuffix"/></span>
                                                        <span class="o_guard_board_guard_count" t-att-title="coverCountTitle" t-esc="guard.cover_count"/>
                                                    </span>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Tab 2: the same shift read the other way round - one row per time block,
                         what has to be covered against who is available to cover it. -->
                    <div t-else="" class="o_guard_board_table_wrap">
                        <!-- The current time, across the whole table (issue #647): placed by
                             placeNowLine() in guard_duty_board.js, hidden when the board shows
                             another day or a range that does not include it. -->
                        <div class="o_guard_board_now_line" aria-hidden="true"/>
                        <!-- The boxes above the table take the table's own width (issue #645). -->
                        <div class="o_guard_board_duty_block">
                        <!-- Issues #539, #581, #605, #645: everything proposed to organise the day's
                         absences, only for whoever may act on it (the server sends nothing to anyone
                         else), and nothing happens on its own: each one waits for its button. Issue
                         #659: the groups whose families have to be told a correction come first, in
                         a red box of their own - it is urgent, and every proposal there carries it. -->
                        <t t-set="sections" t-value="proposalSections"/>
                        <t t-call="ems.GuardBoardProposalsBox">
                            <t t-set="boxSections" t-value="sections.filter((section) => section.urgent)"/>
                            <t t-set="boxClass" t-value="'o_guard_board_corrections'"/>
                            <t t-set="boxTitle" t-value="actionLabels.correctionsTitle"/>
                            <t t-set="boxHelp" t-value="actionLabels.correctionsHelp"/>
                        </t>
                        <t t-call="ems.GuardBoardProposalsBox">
                            <t t-set="boxSections" t-value="sections.filter((section) => !section.urgent)"/>
                            <t t-set="boxClass" t-value="''"/>
                            <t t-set="boxTitle" t-value="actionLabels.arrangementsTitle"/>
                            <t t-set="boxHelp" t-value="actionLabels.arrangementsHelp"/>
                        </t>
                        <!-- Guards whose class no longer needs them (the absence changed after
                             they were sent): releasing one tells them. -->
                        <div t-if="releaseActions.length" class="o_guard_board_actions o_guard_board_releases">
                            <div class="o_guard_board_actions_title" t-esc="actionLabels.releasesTitle"/>
                            <t t-foreach="releaseActions" t-as="action" t-key="action_index">
                                <div class="o_guard_board_action o_guard_board_action_obsolete_cover">
                                    <i t-att-class="actionIcon(action)"/>
                                    <span class="o_guard_board_action_label" t-esc="action.label"/>
                                    <button type="button" class="btn btn-sm btn-outline-primary o_guard_board_action_button"
                                            t-on-click="() => this.onAction(action)" t-esc="actionButtonLabel(action)"/>
                                </div>
                            </t>
                        </div>
                        <t t-set="grid" t-value="state.board.absence_grid"/>
                        <table class="table table-bordered o_guard_board_table o_guard_board_duty_table o_guard_board_timeline">
                            <colgroup>
                                <col class="o_guard_board_col_time"/>
                                <t t-foreach="grid.areas" t-as="area" t-key="area_index">
                                    <t t-foreach="Array.from({ length: area.colspan })" t-as="lane" t-key="lane_index">
                                        <col class="o_guard_board_col_absences"/>
                                    </t>
                                </t>
                                <t t-foreach="Array.from({ length: grid.lane_count })" t-as="lane" t-key="lane_index">
                                    <col class="o_guard_board_col_lane"/>
                                </t>
                            </colgroup>
                            <thead>
                                <!-- One absences column per area: its groups share a time framework (issue #637). -->
                                <tr>
                                    <th t-esc="columnLabels.time"/>
                                    <t t-foreach="grid.areas" t-as="area" t-key="area_index">
                                        <th t-att-colspan="area.colspan" class="o_guard_board_area" t-esc="area.name or noAreaLabel"/>
                                    </t>
                                    <th t-att-colspan="grid.lane_count" t-esc="columnLabels.guard"/>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="grid.rows" t-as="row" t-key="row_index">
                                    <tr t-att-style="rowStyle(row)">
                                        <td class="o_guard_board_time"><span t-esc="row.label"/></td>
                                        <t t-foreach="row.cells" t-as="slot" t-key="slot_index">
                                            <td t-if="slot.empty"/>
                                            <td t-elif="slot.is_break and !slot.guards and slot.line === undefined" t-att-rowspan="slot.rowspan" class="o_guard_board_block o_guard_board_cell_break">
                                                <span class="o_guard_board_block_time" t-esc="slot.label"/>
                                                <span class="o_guard_board_break_label" t-esc="breakLabel"/>
                                            </td>
                                            <td t-else="" t-att-rowspan="slot.rowspan" class="o_guard_board_absence_cell o_guard_board_block">
                                                <t t-set="line" t-value="state.board.lines[slot.line]"/>
                                                <span class="o_guard_board_block_time" t-esc="slot.label"/>
                                                <t t-foreach="slotAbsences(slot, 'absences')" t-as="absence" t-key="absence.teacher + '-' + absence.group">
                                                    <t t-call="ems.GuardBoardAbsenceRow"/>
                                                </t>
                                            </td>
                                        </t>
                                        <t t-foreach="row.guards" t-as="slot" t-key="slot_index">
                                            <td t-if="slot.empty" class="o_guard_board_guard_cell"/>
                                            <td t-else="" t-att-rowspan="slot.rowspan" class="o_guard_board_guard_cell o_guard_board_block" t-att-class="{ o_guard_board_cell_break: slot.is_break }">
                                                <span class="o_guard_board_block_time" t-esc="slot.label"/>
                                                <span t-if="slot.is_break" class="o_guard_board_break_label" t-esc="breakLabel"/>
                                                <t t-foreach="state.board.lines[slot.line].guards" t-as="guard" t-key="guard.name">
                                                <span class="o_guard_board_guard_badge"
                                                      t-att-class="guardBadgeClass(guard)" t-att-data-tooltip="guard.busy">
                                                    <t t-esc="guard.name"/>
                                                    <span t-if="guard.is_wc" class="o_guard_board_guard_wc_tag"> <t t-esc="wcSuffix"/></span>
                                                    <span class="o_guard_board_guard_count" t-att-title="coverCountTitle" t-esc="guard.cover_count"/>
                                                </span>
                                            </t>
                                                <!-- A fixed guard post (WC, break) whose teacher is away: it belongs to no group, so it
                                                     is covered from here, under the guards of its own block (issue #637). -->
                                                <t t-set="line" t-value="state.board.lines[slot.line]"/>
                                                <t t-foreach="slotAbsences(slot, 'posts')" t-as="absence" t-key="absence.teacher + '-' + absence.group">
                                                    <t t-call="ems.GuardBoardAbsenceRow"/>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
    <!-- Issue #645: one detected arrangement plan - "Proposal N:" and, indented below it, one
         line per step with its checkbox on the left, the entry/exit changes it brings under it.
         The default slot holds whatever applies it (the box's own button; nothing in the dialog,
         whose footer does). -->
    <t t-name="ems.GuardArrangementPlan">
        <div class="o_guard_board_plan">
            <div class="o_guard_board_plan_title">
                <strong t-esc="props.plan.title"/>
                <span t-if="props.showGroups !== false" class="text-muted ms-1" t-esc="props.plan.groups"/>
            </div>
            <ul class="list-unstyled o_guard_board_plan_steps">
                <t t-foreach="props.plan.steps" t-as="step" t-key="step_index">
                    <li class="o_guard_board_plan_step">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input o_guard_board_plan_check"
                                   t-att-id="props.plan.key + '-' + step_index"
                                   t-att-checked="props.selection[step_index]" t-att-disabled="props.disabled"
                                   t-on-change="(ev) => props.onToggle(step_index, ev.target.checked)"/>
                            <label class="form-check-label" t-att-for="props.plan.key + '-' + step_index">
                                <i t-att-class="step.kind === 'notice' ? 'fa fa-envelope-o me-1' : step.kind === 'correction' ? 'fa fa-exclamation-triangle me-1' : step.kind === 'swap' ? 'fa fa-exchange me-1' : 'fa fa-arrows-v me-1'"/>
                                <t t-esc="step.label"/>
                            </label>
                            <t t-foreach="step.schedule_changes" t-as="change" t-key="change_index">
                                <div class="o_guard_board_plan_shift"><i class="fa fa-clock-o me-1"/><t t-esc="change"/></div>
                            </t>
                        </div>
                    </li>
                </t>
            </ul>
            <t t-slot="default"/>
        </div>
    </t>

    <!-- Why a struck-out line of the absences table needs no guard (its info icon, on click). -->
    <t t-name="ems.GuardBoardReasonPopover">
        <div class="o_guard_board_reason_popover p-2">
            <div t-esc="props.reason"/>
            <button t-if="props.onAction" type="button" class="btn btn-sm btn-link px-0 o_guard_board_reason_action"
                    t-on-click="() => this.onAction()" t-esc="props.actionLabel"/>
        </div>
    </t>

    <!-- Issue #571: send a guard teacher to one class of the absences table; issue #605: or
         resolve it with an internal arrangement, detected by the board or described by hand. -->
    <!-- Issue #659: a timetable change already told, changed with one correction. -->
    <t t-name="ems.GuardChangeProposalDialog">
        <Dialog title="labels.title" size="'md'">
            <div class="o_guard_change_proposal_dialog">
                <p>
                    <strong t-esc="labels.told"/>: <t t-esc="state.data.told"/>
                    <span class="text-muted"> - <t t-esc="state.data.group"/></span>
                </p>
                <div class="fw-bold mb-1" t-esc="labels.change"/>
                <t t-foreach="state.data.options" t-as="option" t-key="option_index">
                    <div class="form-check">
                        <input class="form-check-input o_guard_change_proposal_option" type="radio" name="o_guard_change_proposal_option"
                               t-att-id="'o_guard_change_proposal_option_' + option_index"
                               t-att-checked="state.choice === 'change-' + option_index" t-on-change="() => this.choose('change-' + option_index)"/>
                        <label class="form-check-label" t-att-for="'o_guard_change_proposal_option_' + option_index" t-esc="option.label"/>
                    </div>
                </t>
                <!-- Or an internal arrangement of the group's day, its correction among its steps. -->
                <t t-if="state.data.plans.length">
                    <div class="fw-bold mt-3 mb-1" t-esc="labels.plans"/>
                    <t t-foreach="state.data.plans" t-as="plan" t-key="plan.key">
                        <div class="form-check o_guard_change_proposal_plan">
                            <input class="form-check-input o_guard_change_proposal_plan_radio" type="radio" name="o_guard_change_proposal_option"
                                   t-att-id="'o_guard_change_proposal_plan_' + plan_index"
                                   t-att-checked="state.choice === 'plan-' + plan_index" t-on-change="() => this.choose('plan-' + plan_index)"/>
                            <GuardArrangementPlan plan="plan" selection="state.selections[plan_index]" showGroups="false"
                                                  disabled="state.choice !== 'plan-' + plan_index"
                                                  onToggle="(index, checked) => this.togglePlanStep(plan_index, index, checked)"/>
                        </div>
                    </t>
                </t>
                <p class="text-muted mt-3 mb-0" t-esc="labels.help"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o_guard_change_proposal_send" t-att-disabled="!canSend"
                        t-on-click="() => this.send()" t-esc="labels.send"/>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()" t-esc="labels.cancel"/>
            </t>
        </Dialog>
    </t>

    <t t-name="ems.GuardCoverDialog">
        <Dialog title="title" size="'md'">
            <div class="o_guard_cover_dialog">
                <p>
                    <strong t-esc="labels.absent"/>: <t t-esc="props.row.teacher"/>
                    <span class="text-muted"> - <t t-esc="props.row.group"/><t t-if="props.row.subject"> · <t t-esc="props.row.subject"/></t><t t-if="props.row.room"> · <t t-esc="props.row.room"/></t></span>
                </p>
                <!-- A guard duty left without its teacher (issue #606) is only ever covered by a guard:
                     arrangements are about a group's lessons. -->
                <div t-if="!props.row.duty_id" class="mb-3 o_guard_cover_mode">
                    <t t-if="props.row.arrangement and props.row.arrangement.type !== 'manual'">
                        <div class="form-check">
                            <input class="form-check-input o_guard_cover_mode_current" type="radio" name="o_guard_cover_mode" id="o_guard_cover_mode_current"
                                   t-att-checked="state.mode === 'current'" t-on-change="() => this.onModeChange('current')"/>
                            <label class="form-check-label" for="o_guard_cover_mode_current">
                                <strong t-esc="labels.current"/>: <t t-esc="props.row.arrangement.label"/>
                            </label>
                        </div>
                        <div t-if="props.row.arrangement.pending" class="alert alert-warning py-2 my-2 o_guard_cover_pending">
                            <t t-esc="labels.pending"/>
                            <button t-if="props.onOpenNotice" type="button" class="btn btn-sm btn-link o_guard_cover_open_notice"
                                    t-on-click="() => this.openNotice()" t-esc="labels.openNotice"/>
                        </div>
                    </t>
                    <!-- Issue #645: the detected plans that resolve this class, the best first. Choosing
                         one enables its steps' checkboxes: the planner may keep only some of them. -->
                    <t t-if="props.row.arrangement_plans.length">
                        <div class="fw-bold mb-1" t-esc="labels.options"/>
                        <t t-foreach="props.row.arrangement_plans" t-as="plan" t-key="plan.key">
                            <div class="form-check o_guard_cover_option">
                                <input class="form-check-input" type="radio" name="o_guard_cover_mode" t-att-id="'o_guard_cover_option_' + plan_index"
                                       t-att-checked="state.mode === 'plan-' + plan_index" t-on-change="() => this.onModeChange('plan-' + plan_index)"/>
                                <GuardArrangementPlan plan="plan" selection="state.selections[plan_index]"
                                                      disabled="state.mode !== 'plan-' + plan_index"
                                                      onToggle="(index, checked) => this.togglePlanStep(plan_index, index, checked)"/>
                            </div>
                        </t>
                    </t>
                    <div class="form-check">
                        <input class="form-check-input o_guard_cover_mode_guard" type="radio" name="o_guard_cover_mode" id="o_guard_cover_mode_guard"
                               t-att-checked="state.mode === 'guard'" t-on-change="() => this.onModeChange('guard')"/>
                        <label class="form-check-label" for="o_guard_cover_mode_guard" t-esc="labels.modeGuard"/>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input o_guard_cover_mode_manual" type="radio" name="o_guard_cover_mode" id="o_guard_cover_mode_manual"
                               t-att-checked="state.mode === 'manual'" t-on-change="() => this.onModeChange('manual')"/>
                        <label class="form-check-label" for="o_guard_cover_mode_manual" t-esc="labels.modeManual"/>
                    </div>
                </div>
                <t t-if="state.mode === 'guard'">
                    <!-- The guards already covering it, each removable on its own (issue #637). -->
                    <div t-if="props.row.covers.length" class="mb-3 o_guard_cover_current">
                        <div class="fw-bold mb-1" t-esc="labels.assigned"/>
                        <t t-foreach="props.row.covers" t-as="cover" t-key="cover.id">
                            <div class="d-flex align-items-center gap-2 mb-1 o_guard_cover_current_row">
                                <span><i class="fa fa-user-circle me-1"/><t t-esc="cover.guard"/> <span class="text-muted" t-esc="cover.label"/></span>
                                <button type="button" class="btn btn-sm btn-link text-danger o_guard_cover_remove" t-att-disabled="state.saving"
                                        t-on-click="() => this.release(cover.id)" t-esc="labels.removeCover"/>
                            </div>
                        </t>
                        <t t-foreach="props.row.missing" t-as="missing" t-key="missing_index">
                            <span class="o_guard_board_absence_tag o_guard_board_missing_tag" t-esc="missing"/>
                        </t>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="o_guard_cover_guard" t-esc="labels.guard"/>
                        <div t-if="!props.line.guard_candidates.length" class="text-muted" t-esc="labels.noCandidates"/>
                        <select t-else="" id="o_guard_cover_guard" class="form-select o_guard_cover_guard_select"
                                t-on-change="(ev) => this.onGuardChange(ev)">
                            <option value="" t-att-selected="!state.guardId" t-esc="labels.choose"/>
                            <t t-foreach="props.line.guard_candidates" t-as="candidate" t-key="candidate.id">
                                <option t-att-value="candidate.id" t-att-selected="candidate.id === state.guardId" t-esc="candidateLabel(candidate)"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label fw-bold" for="o_guard_cover_message" t-esc="labels.message"/>
                        <textarea id="o_guard_cover_message" class="form-control o_guard_cover_message" rows="5"
                                  t-att-placeholder="labels.placeholder" t-model="state.message"/>
                    </div>
                </t>
                <t t-elif="state.mode === 'manual'">
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="o_guard_cover_teacher" t-esc="labels.teacher"/>
                        <select id="o_guard_cover_teacher" class="form-select o_guard_cover_teacher_select"
                                t-on-change="(ev) => this.onTeacherChange(ev)">
                            <option value="" t-att-selected="!state.teacherId" t-esc="labels.noTeacher"/>
                            <t t-foreach="state.manualCandidates" t-as="candidate" t-key="candidate.id">
                                <option t-att-value="candidate.id" t-att-selected="candidate.id === state.teacherId" t-esc="candidate.name"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label fw-bold" for="o_guard_cover_note" t-esc="labels.note"/>
                        <textarea id="o_guard_cover_note" class="form-control o_guard_cover_note" rows="3"
                                  t-att-placeholder="labels.notePlaceholder" t-model="state.note"/>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o_guard_cover_assign" t-att-disabled="!canSave"
                        t-on-click="() => this.save()" t-esc="saveLabel"/>
                <button t-if="props.row.arrangement" class="btn btn-outline-danger o_guard_cover_release" t-att-disabled="state.saving"
                        t-on-click="() => this.release()" t-esc="labels.release"/>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()" t-esc="labels.cancel"/>
            </t>
        </Dialog>
    </t>
</templates>
