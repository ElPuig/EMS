<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ems.GuardDutyBoard">
        <div class="o_guard_board">
            <div class="o_guard_board_header">
                <h1 class="o_guard_board_title" t-esc="title"/>

                <!-- Weekday tabs, each carrying its own real date: absences happen on dates, the
                     timetable repeats by weekday, and this strip is where the two meet. -->
                <ul class="nav nav-tabs o_guard_board_tabs">
                    <t t-foreach="days" t-as="day" t-key="day.index">
                        <li class="nav-item">
                            <a href="#" class="nav-link" t-att-class="{ active: state.activeDay === day.index }"
                               t-on-click.prevent="() => this.setActiveDay(day.index)">
                                <span t-esc="day.label"/>
                                <span class="o_guard_board_tab_date" t-esc="day.dayOfMonth"/>
                            </a>
                        </li>
                    </t>
                </ul>

                <!-- Per-day toolbar: week navigation + date picker (which week the tabs above
                     stand for), shift picker (morning/afternoon are separate shifts, never shown
                     stacked together), the level filter, the two readings of the same day, and
                     one PDF per day. -->
                <div class="o_guard_board_toolbar">
                    <div class="btn-group btn-group-sm o_guard_board_week_nav">
                        <button type="button" class="btn btn-secondary" t-on-click="() => this.shiftWeek(-1)">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <button type="button" class="btn btn-secondary" t-on-click="() => this.shiftWeek(1)">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>
                    <input type="date" class="form-control form-control-sm o_guard_board_date_input"
                           t-att-value="activeDate" t-on-change="(ev) => this.onDateChange(ev)"/>
                    <select class="form-select form-select-sm o_guard_board_shift_select" t-on-change="(ev) => this.onShiftChange(ev)">
                        <t t-foreach="shifts" t-as="shift" t-key="shift.key">
                            <option t-att-value="shift.key" t-att-selected="shift.key === state.activeShift" t-esc="shift.label"/>
                        </t>
                    </select>
                    <!-- Level filter (issue #390): a checkbox-per-level dropdown, not a native
                         multi-<select> (that needs a ctrl/cmd-click, not discoverable) - empty
                         selection means "All levels", the previous, still-default behaviour. -->
                    <div class="dropdown o_guard_board_level_dropdown">
                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle o_guard_board_level_toggle"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" t-esc="levelFilterLabel"/>
                        <ul class="dropdown-menu o_guard_board_level_menu">
                            <t t-foreach="state.levels" t-as="level" t-key="level.id">
                                <li>
                                    <label class="dropdown-item o_guard_board_level_item">
                                        <input type="checkbox" class="form-check-input me-1"
                                               t-att-checked="state.activeLevelIds.includes(level.id)"
                                               t-on-change="() => this.toggleLevel(level.id)"/>
                                        <span t-esc="level.name"/>
                                    </label>
                                </li>
                            </t>
                        </ul>
                    </div>
                    <ul class="nav nav-pills o_guard_board_view_tabs">
                        <t t-foreach="views" t-as="view" t-key="view.key">
                            <li class="nav-item">
                                <a href="#" class="nav-link" t-att-class="{ active: state.activeView === view.key }"
                                   t-on-click.prevent="() => this.setActiveView(view.key)" t-esc="view.label"/>
                            </li>
                        </t>
                    </ul>
                    <button type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.onPdfClick()">
                        <i class="fa fa-file-pdf-o me-1"/>PDF
                    </button>
                </div>
            </div>

            <div class="o_guard_board_content">
                <t t-if="state.loading">
                    <div class="o_guard_board_loading text-muted" t-esc="emptyLabels.loading"/>
                </t>
                <t t-else="">
                    <div t-if="!state.board.lines.length" class="text-muted o_guard_board_empty" t-esc="emptyLabels.schedule"/>

                    <!-- Tab 1: the timetable itself, with whoever is away marked in place. -->
                    <div t-elif="state.activeView === 'schedule'" class="o_guard_board_table_wrap">
                        <table class="table table-bordered o_guard_board_table">
                            <colgroup>
                                <col class="o_guard_board_col_time"/>
                                <t t-foreach="state.board.groups" t-as="group" t-key="group.id">
                                    <col class="o_guard_board_col_group"/>
                                </t>
                                <col class="o_guard_board_col_guard"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th t-esc="columnLabels.time"/>
                                    <t t-foreach="state.board.groups" t-as="group" t-key="group.id">
                                        <th t-esc="group.name"/>
                                    </t>
                                    <th t-esc="columnLabels.guard"/>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.board.lines" t-as="line" t-key="line.time_label">
                                    <tr t-att-class="{ o_guard_board_row_break: line.is_break }">
                                        <td class="o_guard_board_time">
                                            <span t-esc="line.time_label"/>
                                            <span t-if="line.is_break" class="o_guard_board_break_label" t-esc="breakLabel"/>
                                        </td>
                                        <t t-foreach="line.cells" t-as="cell" t-key="cell.group_id">
                                            <td>
                                                <t t-if="cell.subject">
                                                    <span class="o_guard_board_cell_subject" t-esc="cell.subject"/>
                                                    <span t-if="cell.teachers.length" class="o_guard_board_cell_teacher">
                                                        <t t-foreach="cell.teachers" t-as="teacher" t-key="teacher.name">
                                                            <span t-att-class="absenceClass(teacher.absence)" t-esc="teacher.name"/><t t-if="!teacher_last">, </t>
                                                        </t>
                                                    </span>
                                                    <span t-if="cell.room" class="o_guard_board_cell_room" t-esc="cell.room"/>
                                                </t>
                                            </td>
                                        </t>
                                        <td class="o_guard_board_guard_cell">
                                            <t t-foreach="line.guards" t-as="guard" t-key="guard.name">
                                                <span class="o_guard_board_guard_badge"
                                                      t-att-class="absenceClass(guard.absence)">
                                                    <t t-esc="guard.name"/>
                                                    <span t-if="guard.is_wc" class="o_guard_board_guard_wc_tag"> <t t-esc="wcSuffix"/></span>
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Tab 2: the same shift read the other way round - one row per time block,
                         what has to be covered against who is available to cover it. -->
                    <div t-else="" class="o_guard_board_table_wrap">
                        <!-- The day's pending decisions that belong to no single row (issues #539,
                             #571, #581): a timetable change the absences allow, a notice already
                             sent that no longer matches them, a guard no longer needed. Nothing
                             here happens on its own: each one waits for its button. -->
                        <div t-if="state.board.actions.length" class="o_guard_board_actions">
                            <div class="o_guard_board_actions_title" t-esc="actionLabels.title"/>
                            <t t-foreach="state.board.actions" t-as="action" t-key="action_index">
                                <div class="o_guard_board_action" t-att-class="'o_guard_board_action_' + action.type">
                                    <i t-att-class="actionIcon(action)"/>
                                    <span class="o_guard_board_action_label" t-esc="action.label"/>
                                    <button t-if="action.can_manage" type="button"
                                            class="btn btn-sm btn-outline-primary o_guard_board_action_button"
                                            t-on-click="() => this.onAction(action)" t-esc="actionButtonLabel(action)"/>
                                </div>
                            </t>
                        </div>
                        <table class="table table-bordered o_guard_board_table o_guard_board_duty_table">
                            <colgroup>
                                <col class="o_guard_board_col_time"/>
                                <col class="o_guard_board_col_absences"/>
                                <col class="o_guard_board_col_guard"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th t-esc="columnLabels.time"/>
                                    <th t-esc="columnLabels.absences"/>
                                    <th t-esc="columnLabels.guard"/>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.board.lines" t-as="line" t-key="line.time_label">
                                    <tr t-att-class="{ o_guard_board_row_break: line.is_break }">
                                        <td class="o_guard_board_time">
                                            <span t-esc="line.time_label"/>
                                            <span t-if="line.is_break" class="o_guard_board_break_label" t-esc="breakLabel"/>
                                        </td>
                                        <td class="o_guard_board_absence_cell">
                                            <t t-foreach="line.absences" t-as="absence" t-key="absence.teacher + '-' + absence.group">
                                                <!-- Struck out once nobody needs to be sent: a co-teacher is in the
                                                     class, a guard has been assigned (sharing that guard's colour), or
                                                     the families were told the students can stay at home for it. -->
                                                <div class="o_guard_board_absence_row"
                                                     t-att-class="absenceRowClass(absence)"
                                                     t-att-title="absenceRowTitle(absence)"
                                                     t-on-click="() => this.onAbsenceClick(line, absence)">
                                                    <span class="o_guard_board_absence_text">
                                                        <span t-att-class="absenceClass(absence.state)" t-esc="absence.teacher"/>
                                                        <span class="o_guard_board_absence_class">
                                                            <t t-esc="absence.group"/><t t-if="absence.subject"> · <t t-esc="absence.subject"/></t><t t-if="absence.room"> · <t t-esc="absence.room"/></t>
                                                        </span>
                                                    </span>
                                                    <span t-if="absence.cover" class="o_guard_board_absence_tag o_guard_board_cover_tag">
                                                        <i class="fa fa-user-circle me-1"/><t t-esc="absence.cover.guard"/>
                                                    </span>
                                                    <span t-if="absence.authorized" class="o_guard_board_absence_tag o_guard_board_authorized_tag" t-esc="absence.authorized"/>
                                                    <span t-elif="absence.proposed" class="o_guard_board_absence_tag o_guard_board_proposed_tag" t-esc="absence.proposed"/>
                                                </div>
                                            </t>
                                        </td>
                                        <td class="o_guard_board_guard_cell">
                                            <t t-foreach="line.guards" t-as="guard" t-key="guard.name">
                                                <span class="o_guard_board_guard_badge"
                                                      t-att-class="guardBadgeClass(guard)">
                                                    <t t-esc="guard.name"/>
                                                    <span t-if="guard.is_wc" class="o_guard_board_guard_wc_tag"> <t t-esc="wcSuffix"/></span>
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </div>
    </t>
    <!-- Issue #571: send a guard teacher to one class of the absences table. -->
    <t t-name="ems.GuardCoverDialog">
        <Dialog title="title" size="'md'">
            <div class="o_guard_cover_dialog">
                <p>
                    <strong t-esc="labels.absent"/>: <t t-esc="props.row.teacher"/>
                    <span class="text-muted"> - <t t-esc="props.row.group"/><t t-if="props.row.subject"> · <t t-esc="props.row.subject"/></t><t t-if="props.row.room"> · <t t-esc="props.row.room"/></t></span>
                </p>
                <div class="mb-3">
                    <label class="form-label fw-bold" for="o_guard_cover_guard" t-esc="labels.guard"/>
                    <div t-if="!props.line.guard_candidates.length" class="text-muted" t-esc="labels.noCandidates"/>
                    <select t-else="" id="o_guard_cover_guard" class="form-select o_guard_cover_guard_select"
                            t-on-change="(ev) => this.onGuardChange(ev)">
                        <option value="" t-att-selected="!state.guardId" t-esc="labels.choose"/>
                        <t t-foreach="props.line.guard_candidates" t-as="candidate" t-key="candidate.id">
                            <option t-att-value="candidate.id" t-att-selected="candidate.id === state.guardId" t-esc="candidate.name"/>
                        </t>
                    </select>
                </div>
                <div>
                    <label class="form-label fw-bold" for="o_guard_cover_message" t-esc="labels.message"/>
                    <textarea id="o_guard_cover_message" class="form-control o_guard_cover_message" rows="5"
                              t-att-placeholder="labels.placeholder" t-model="state.message"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o_guard_cover_assign" t-att-disabled="!state.guardId or state.saving"
                        t-on-click="() => this.assign()" t-esc="labels.assign"/>
                <button t-if="props.row.cover" class="btn btn-outline-danger o_guard_cover_release" t-att-disabled="state.saving"
                        t-on-click="() => this.release()" t-esc="labels.release"/>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()" t-esc="labels.cancel"/>
            </t>
        </Dialog>
    </t>
</templates>
