<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ems.QualityProcessMap">
        <div class="o_quality_process_map d-flex flex-column h-100">
            <t t-if="state.url">
                <div class="d-flex justify-content-end px-3 py-2 border-bottom">
                    <a class="btn btn-secondary btn-sm" t-att-href="state.url" target="_blank" rel="noopener">
                        <i class="fa fa-external-link me-1"/>Open in a new tab
                    </a>
                </div>
                <iframe class="o_quality_process_map_frame flex-grow-1 w-100 border-0" style="min-height: 80vh;" t-att-src="state.url"/>
            </t>
            <div t-else="" class="o_quality_process_map_empty p-4">
                <p>The process map has not been configured yet.</p>
                <p class="text-muted">Publish the process map document to the web from Google Docs and paste its embed address in Settings > EMS Management > Quality Settings.</p>
            </div>
        </div>
    </t>
</templates>
