<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ems.ScheduleGridField">
        <div class="o_schedule_grid">
            <div t-if="!calendarId" class="alert alert-info mb-0" role="alert">
                No working schedule assigned to this employee yet. Assign one in the "Work Information" tab first.
            </div>
            <t t-else="">
                <div class="o_schedule_grid_toolbar">
                    <t t-if="!editing.value">
                        <t t-if="canEdit">
                            <button type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.startEdit()">
                                <i class="fa fa-pencil me-1"/>Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-secondary ms-2" t-on-click="() => this.openNewPanel()">
                                <i class="fa fa-plus me-1"/>New
                            </button>
                        </t>
                        <button type="button" class="btn btn-sm btn-secondary ms-2" t-on-click="() => this.onPdfClick()">
                            <i class="fa fa-file-pdf-o me-1"/>PDF
                        </button>
                        <div t-if="canEdit and newPanel.open" class="o_schedule_grid_new_panel mt-2">
                            <select class="o_schedule_grid_select_new" t-on-change="(ev) => this.onNewSourceChange(ev)">
                                <option value="">—</option>
                                <optgroup label="Schedule frameworks">
                                    <t t-foreach="newPanel.frameworks" t-as="framework" t-key="framework.id">
                                        <option t-att-value="'f_' + framework.id" t-esc="framework.display_name"/>
                                    </t>
                                </optgroup>
                                <optgroup label="Copy from teacher">
                                    <t t-foreach="newPanel.teachers" t-as="colleague" t-key="colleague.id">
                                        <option t-att-value="'c_' + colleague.resource_calendar_id[0]" t-esc="colleague.display_name"/>
                                    </t>
                                </optgroup>
                            </select>
                            <button type="button" class="btn btn-sm btn-primary ms-2" t-att-disabled="!newPanel.value"
                                    t-on-click="() => this.loadNewSource()">
                                Load
                            </button>
                            <button type="button" class="btn btn-sm btn-secondary ms-2" t-on-click="() => this.cancelNewPanel()">
                                Cancel
                            </button>
                        </div>
                    </t>
                    <t t-else="">
                        <button type="button" class="btn btn-sm btn-primary" t-on-click="() => this.save()">
                            <i class="fa fa-check me-1"/>Save
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary ms-2" t-on-click="() => this.cancelEdit()">
                            Cancel
                        </button>
                    </t>
                </div>

                <div t-if="!editing.value" class="o_schedule_grid_grid">
                    <div class="o_schedule_grid_header"/>
                    <t t-foreach="days" t-as="day" t-key="day.index">
                        <div class="o_schedule_grid_header" t-esc="day.label"/>
                    </t>

                    <div class="o_schedule_grid_axis" t-att-style="columnStyle()">
                        <t t-foreach="hours" t-as="hour" t-key="hour">
                            <div class="o_schedule_grid_hour" t-esc="formatHour(hour)"/>
                        </t>
                    </div>

                    <t t-foreach="days" t-as="day" t-key="day.index">
                        <div class="o_schedule_grid_column" t-att-style="columnStyle()">
                            <t t-foreach="entriesForDay(day.index)" t-as="entry" t-key="entry.id">
                                <div class="o_schedule_grid_entry"
                                     t-att-class="entry.data.non_teaching_is_break ? 'o_schedule_grid_entry_break' : (entry.data.non_teaching ? 'o_schedule_grid_entry_nonteaching' : '')"
                                     t-att-style="entryStyle(entry)"
                                     t-att-title="entryTime(entry) + ' ' + entryLabel(entry)">
                                    <t t-if="entry.data.non_teaching_is_break">
                                        <span class="o_schedule_grid_entry_compact" t-esc="entryTime(entry) + ' ' + entryLabel(entry)"/>
                                    </t>
                                    <t t-else="">
                                        <span class="o_schedule_grid_entry_time" t-esc="entryTime(entry)"/>
                                        <span class="o_schedule_grid_entry_label" t-esc="entryLabel(entry)"/>
                                        <span t-if="entryRoom(entry)" class="o_schedule_grid_entry_room" t-esc="entryRoom(entry)"/>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>

                <div t-else="" class="o_schedule_grid_cards_edit">
                    <t t-foreach="days" t-as="day" t-key="day.index">
                        <div class="o_schedule_grid_day_column" t-att-data-day="day.index">
                            <div class="o_schedule_grid_day_header" t-esc="day.label"/>
                            <t t-foreach="cardsForDay(day.index)" t-as="card" t-key="card.id">
                                <div class="o_schedule_grid_card" t-att-data-day="day.index" t-att-data-card="card.id">
                                    <button type="button" class="btn btn-sm o_schedule_grid_card_remove"
                                            title="Remove card" t-on-click="() => this.removeCard(day.index, card.id)">
                                        <i class="fa fa-trash-o"/>
                                    </button>
                                    <div class="o_schedule_grid_card_row">
                                        <input type="date" class="o_schedule_grid_card_date"
                                               title="Valid from (blank = whole course year)"
                                               t-att-value="card.startDate || ''"
                                               t-on-change="(ev) => this.onCardDateChange(day.index, card.id, 'startDate', ev)"/>
                                        <span class="mx-1">–</span>
                                        <input type="date" class="o_schedule_grid_card_date"
                                               title="Valid until (blank = whole course year)"
                                               t-att-value="card.endDate || ''"
                                               t-on-change="(ev) => this.onCardDateChange(day.index, card.id, 'endDate', ev)"/>
                                    </div>
                                    <div class="o_schedule_grid_card_row">
                                        <input type="time" class="o_schedule_grid_card_time"
                                               t-att-value="hourToTimeInput(card.hourFrom)"
                                               t-on-change="(ev) => this.onCardTimeChange(day.index, card.id, 'hourFrom', ev)"/>
                                        <span class="mx-1">–</span>
                                        <input type="time" class="o_schedule_grid_card_time"
                                               t-att-value="hourToTimeInput(card.hourTo)"
                                               t-on-change="(ev) => this.onCardTimeChange(day.index, card.id, 'hourTo', ev)"/>
                                    </div>
                                    <select class="o_schedule_grid_select o_schedule_grid_card_subject"
                                            t-on-change="(ev) => this.onCardSubjectChange(day.index, card.id, ev)">
                                        <option value="" t-att-selected="subjectSelectValue(card) === ''">—</option>
                                        <optgroup label="Non-teaching">
                                            <t t-foreach="catalog.nonTeaching" t-as="item" t-key="item[0]">
                                                <option t-att-value="'n_' + item[0]" t-esc="item[1]"
                                                        t-att-selected="subjectSelectValue(card) === 'n_' + item[0]"/>
                                            </t>
                                        </optgroup>
                                        <optgroup label="Subjects">
                                            <t t-foreach="catalog.subjects" t-as="subject" t-key="subject.id">
                                                <option t-att-value="'s_' + subject.id" t-esc="subject.display_name"
                                                        t-att-selected="subjectSelectValue(card) === 's_' + subject.id"/>
                                            </t>
                                        </optgroup>
                                    </select>
                                    <select class="o_schedule_grid_select o_schedule_grid_card_group"
                                            t-att-disabled="card.kind !== 'subject'"
                                            t-on-change="(ev) => this.onCardGroupChange(day.index, card.id, ev)">
                                        <option value="" t-att-selected="!card.groupId">—</option>
                                        <t t-foreach="catalog.groups" t-as="group" t-key="group.id">
                                            <option t-att-value="group.id" t-esc="group.display_name"
                                                    t-att-selected="card.groupId === group.id"/>
                                        </t>
                                    </select>
                                    <select class="o_schedule_grid_select o_schedule_grid_card_space"
                                            t-on-change="(ev) => this.onCardSpaceChange(day.index, card.id, ev)">
                                        <option value="" t-att-selected="!card.spaceId">—</option>
                                        <t t-foreach="catalog.spaces" t-as="space" t-key="space.id">
                                            <option t-att-value="space.id" t-esc="space.display_name"
                                                    t-att-selected="card.spaceId === space.id"/>
                                        </t>
                                    </select>
                                </div>
                            </t>
                            <button type="button" class="btn btn-sm btn-link o_schedule_grid_add_card"
                                    t-on-click="() => this.addCard(day.index)">
                                <i class="fa fa-plus me-1"/>Add
                            </button>
                        </div>
                    </t>
                </div>

                <div t-if="!editing.value and (summary.teaching.rows.length or summary.fixed.rows.length)" class="o_schedule_grid_summary mt-3">
                    <div class="o_schedule_grid_summary_columns">
                        <div class="o_schedule_grid_summary_column">
                            <div class="o_schedule_grid_summary_header">Weekly teaching hours</div>
                            <table class="o_schedule_grid_summary_table">
                                <tbody>
                                    <t t-foreach="summary.teaching.rows" t-as="row" t-key="row.label">
                                        <tr>
                                            <td t-esc="row.label"/>
                                            <td t-esc="row.hours + ' h'"/>
                                        </tr>
                                    </t>
                                    <tr class="o_schedule_grid_summary_total">
                                        <td>Total</td>
                                        <td t-esc="summary.teaching.total + ' h'"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="o_schedule_grid_summary_column">
                            <div class="o_schedule_grid_summary_header">Other fixed-schedule hours</div>
                            <table class="o_schedule_grid_summary_table">
                                <tbody>
                                    <t t-foreach="summary.fixed.rows" t-as="row" t-key="row.label">
                                        <tr>
                                            <td t-esc="row.label"/>
                                            <td t-esc="row.hours + ' h'"/>
                                        </tr>
                                    </t>
                                    <tr class="o_schedule_grid_summary_total">
                                        <td>Total</td>
                                        <td t-esc="summary.fixed.total + ' h'"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="o_schedule_grid_summary_grand_total">
                        <span>Overall total:</span> <t t-esc="summary.total + ' h'"/>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
