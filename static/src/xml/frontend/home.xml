<templates xml:space="preserve">
    <t t-name="ems.StudentCard">
        
        <div>
 
            <div t-if="state.loading" class="text-center p-3">
                <i class="fa fa-spinner fa-spin fa-2x text-primary"></i>
            </div>
 
            <div t-elif="state.student" class="card shadow-sm p-3">
                <div class="d-flex align-items-center">
                    
                    <img t-attf-src="/web/image?model=res.partner&amp;id={{state.student.id}}&amp;field=avatar_128" 
                         class="rounded-circle border me-3" 
                         style="width: 64px; height: 64px; object-fit: cover;"/>
                    
                    <div class="flex-grow-1">
                        <h4 class="m-0"><t t-esc="state.student.name"/></h4>
                        
                        <div class="text-muted small">
                            <i class="fa fa-envelope me-1"></i> <t t-esc="state.student.email"/>
                        </div>
                        <div t-if="state.student.phone" class="text-muted small">
                            <i class="fa fa-phone me-1"></i> <t t-esc="state.student.phone"/>
                        </div>
 
                        <div class="mt-1">
                            <div t-if="!state.isEditing" class="d-flex align-items-center">
                                <div class="text-muted small me-2">
                                    <i class="fa fa-car me-1"></i>
                                    <span t-if="state.student.car_plate" t-esc="state.student.car_plate" class="fw-bold"/>
                                    <span t-else="" class="text-warning fst-italic">Sin matrícula</span>
                                </div>
                                
                                <button class="btn btn-sm btn-link p-0 text-secondary" t-on-click="toggleEdit" title="Editar matrícula">
                                    <i class="fa fa-pencil"></i>
                                </button>
                            </div>
 
                            <div t-else="" class="d-flex gap-1 align-items-center">
                                <input type="text" class="form-control form-control-sm" 
                                       style="max-width: 150px;"
                                       t-model="state.student.car_plate" 
                                       placeholder="Ej: 1234 ABC"/>
                                
                                <button class="btn btn-sm btn-primary" t-on-click="saveCarPlate" t-att-disabled="state.saving">
                                    <i t-if="!state.saving" class="fa fa-check"></i>
                                    <i t-else="" class="fa fa-spinner fa-spin"></i>
                                </button>
                                
                                <button class="btn btn-sm btn-light border" t-on-click="toggleEdit" t-att-disabled="state.saving">
                                    <i class="fa fa-times"></i>
                                </button>
                            </div>
                            <div class="mt-3">
                             <button class="btn btn-secondary btn-sm" t-on-click="printAttendance">
                                 <i class="fa fa-print me-1"></i> Descargar Informe de Faltas
                             </button>
                         </div>
                        </div>
                    </div>
                </div>
            </div>
 
            <div t-else="" class="alert alert-warning">
                No se pudo cargar la información del estudiante.
            </div>
 
        </div>
    </t>
 </templates>