<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Authorizations, a single entry of Academic management like the other sections: it
             opens the responses list, whose "New" button opens the Send Authorizations
             assistant (issue #654). Tutors are in: they send forms from the catalogue to their
             own students and follow their answers (issue #443 testing). -->
        <menuitem id="menu_ems_authorization_root"
                  name="Authorizations"
                  parent="menu_ems_academic_management"
                  action="action_ems_authorizations_follow_up"
                  groups="ems.group_academic_admin,ems.group_secretary,ems.group_head_of_studies,ems.group_tutor"
                  sequence="20"/>

        <!-- The catalogue itself, in Academic management > Configuration, stays with the
             secretary's office, the academic administration and the Heads of Studies. Same
             xmlid it always had (it exists on released databases): only its parent changed,
             so no migration is needed. -->
        <menuitem id="menu_ems_authorization_forms"
                  name="Authorization Forms"
                  parent="menu_ems_configuration"
                  action="action_ems_authorization_template"
                  groups="ems.group_academic_admin,ems.group_secretary,ems.group_head_of_studies"
                  sequence="20"/>
    </data>
</odoo>
