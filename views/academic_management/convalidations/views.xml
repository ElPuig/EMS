<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_convalidation_list" model="ir.ui.view">
            <field name="name">ems.convalidation.list</field>
            <field name="model">ems.convalidation</field>
            <field name="arch" type="xml">
                <list string="Convalidations"
                      decoration-muted="state == 'cancelled'"
                      decoration-success="state == 'completed'">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="study_id"/>
                    <field name="course_id" optional="show"/>
                    <field name="submission_date"/>
                    <field name="basis" optional="hide"/>
                    <field name="pending_count"/>
                    <field name="granted_count" optional="show"/>
                    <field name="validation_date" optional="hide"/>
                    <field name="resolution_date" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-info="state in ('pending', 'ministry')"
                           decoration-warning="state in ('documentation', 'direction', 'in_progress')"
                           decoration-success="state == 'completed'"
                           decoration-danger="state == 'rejected'"/>
                </list>
            </field>
        </record>

        <record id="view_convalidation_form" model="ir.ui.view">
            <field name="name">ems.convalidation.form</field>
            <field name="model">ems.convalidation</field>
            <field name="arch" type="xml">
                <form string="Convalidation">
                    <header>
                        <div name="ems_actions" string="Actions">
                            <button name="action_grant_pending" type="object" string="Convalidate pending subjects"
                                    invisible="state not in ('pending', 'documentation', 'ministry') or pending_count == 0"
                                    groups="ems.group_head_of_studies,ems.group_academic_admin"/>
                            <button name="action_propose" type="object" string="Send proposal to the Director"
                                    class="btn-primary"
                                    invisible="state != 'pending'"
                                    groups="ems.group_head_of_studies,ems.group_academic_admin"
                                    help="The centre resolves it: the Director turns this proposal into the official resolution."/>
                            <button name="action_send_to_ministry" type="object" string="In process at the Ministry"
                                    invisible="state != 'pending'"
                                    groups="ems.group_head_of_studies,ems.group_academic_admin"
                                    confirm="Mark it once the request has been filed with the Ministry. The student will no longer be able to cancel it. Continue?"
                                    help="The Ministry resolves it: the request waits here for its answer."/>
                            <button name="action_ministry_resolved" type="object" string="Ministry resolution received"
                                    class="btn-primary"
                                    invisible="state != 'ministry'"
                                    groups="ems.group_head_of_studies,ems.group_academic_admin"
                                    help="Record the Ministry's outcome for every subject: the request goes straight to the secretariat."/>
                            <button name="action_resolve" type="object" string="Resolve"
                                    class="btn-primary"
                                    invisible="state != 'direction'"
                                    groups="ems.group_director,ems.group_academic_admin"
                                    confirm="The official resolution will be issued as proposed and sent to the secretariat. Continue?"
                                    help="Issue the official resolution (PDF) and send it to the secretariat."/>
                            <button name="action_return" type="object" string="Return to the Head of Studies"
                                    invisible="state != 'direction'"
                                    groups="ems.group_director,ems.group_academic_admin"/>
                            <button name="action_complete" type="object" string="Registered in Esfera"
                                    class="btn-primary"
                                    invisible="state != 'in_progress'"
                                    groups="ems.group_secretary,ems.group_academic_admin"
                                    confirm="The resolution will be sent to the student and the grades published. Continue?"
                                    help="Confirm the resolution is registered in the student's record: the request closes and the student is notified."/>
                            <button name="action_request_info" type="object" string="Request information"
                                    invisible="state not in ('pending', 'documentation', 'ministry')"
                                    groups="ems.group_head_of_studies,ems.group_secretary,ems.group_academic_admin"/>
                            <button name="action_documentation_received" type="object" string="Documentation received"
                                    invisible="state != 'documentation'"
                                    groups="ems.group_head_of_studies,ems.group_academic_admin"
                                    help="The documentation arrived some other way (on paper, by email): the request goes back under review."/>
                            <button name="action_cancel" type="object" string="Cancel request"
                                    invisible="state != 'pending' and (state != 'documentation' or resolved_by_ministry)"
                                    confirm="The request will be cancelled. Continue?"/>
                            <button name="action_reopen" type="object" string="Reopen"
                                    invisible="state != 'cancelled'"/>
                        </div>
                        <field name="state" widget="statusbar" statusbar_visible="pending,direction,in_progress,completed"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary"
                                invisible="state != 'cancelled'"/>
                        <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                                invisible="state != 'rejected'"/>
                        <div class="alert alert-warning" role="alert" invisible="state != 'pending' or not return_reason">
                            <strong>Returned by the Director:</strong> <field name="return_reason" class="d-inline"/>
                        </div>
                        <div class="oe_title">
                            <div class="text-muted" invisible="not name"><field name="name"/></div>
                            <h1><field name="student_id" placeholder="Student" options="{'no_create': True}" readonly="id"/></h1>
                            <field name="has_centre_title" invisible="1"/>
                            <div class="text-muted" invisible="not has_centre_title">
                                <i class="fa fa-graduation-cap me-1"/>Holds a title obtained at this centre
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="study_id" options="{'no_create': True}" readonly="id"/>
                                <field name="course_id" options="{'no_create': True}" readonly="id"/>
                                <field name="basis" readonly="id"/>
                            </group>
                            <group>
                                <field name="submission_date"/>
                                <field name="requester_id" readonly="1" invisible="not requester_id"/>
                                <field name="ministry_date" invisible="not resolved_by_ministry"/>
                                <field name="validation_date" invisible="not validation_date"/>
                                <field name="validated_by_id" invisible="not validated_by_id"/>
                                <field name="signature_date" invisible="not signature_date"/>
                                <field name="signed_by_id" invisible="not signed_by_id"/>
                                <field name="resolution_pdf_id" invisible="1"/>
                                <field name="resolution_pdf_link" invisible="not resolution_pdf_id"/>
                                <field name="resolved_by_ministry" invisible="1"/>
                                <field name="ministry_resolution" filename="ministry_resolution_filename"
                                       invisible="not resolved_by_ministry" readonly="state != 'ministry'"/>
                                <field name="ministry_resolution_filename" invisible="1"/>
                                <field name="resolution_date" invisible="not resolution_date"/>
                                <field name="resolved_by_id" invisible="not resolved_by_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="subjects" string="Subjects">
                                <field name="allowed_subject_ids" invisible="1"/>
                                <field name="line_ids">
                                    <list editable="bottom"
                                          decoration-success="state == 'granted'"
                                          decoration-danger="state == 'rejected'">
                                        <field name="request_state" column_invisible="1"/>
                                        <field name="subject_id"
                                               domain="[('id', 'in', parent.allowed_subject_ids)]"
                                               options="{'no_create': True}"
                                               readonly="state != 'pending' or request_state not in ('pending', 'documentation', 'ministry')"/>
                                        <field name="state" widget="badge" readonly="1"
                                               decoration-success="state == 'granted'"
                                               decoration-danger="state == 'rejected'"/>
                                        <field name="grade"
                                               invisible="state != 'granted'"
                                               readonly="request_state not in ('pending', 'documentation', 'ministry')"/>
                                        <field name="rejection_reason"
                                               invisible="state != 'rejected'"
                                               readonly="request_state not in ('pending', 'documentation', 'ministry')"/>
                                        <field name="resolution_notes" optional="hide"
                                               readonly="request_state not in ('pending', 'documentation', 'ministry')"/>
                                        <button name="action_grant" type="object" title="Convalidate"
                                                icon="fa-check" class="text-success"
                                                invisible="state == 'granted' or request_state not in ('pending', 'documentation', 'ministry')"
                                                groups="ems.group_head_of_studies,ems.group_academic_admin"/>
                                        <button name="action_reject" type="object" title="Reject"
                                                icon="fa-times" class="text-danger"
                                                invisible="state == 'rejected' or request_state not in ('pending', 'documentation', 'ministry')"
                                                groups="ems.group_head_of_studies,ems.group_academic_admin"/>
                                        <button name="action_reset" type="object" title="Back to pending"
                                                icon="fa-undo"
                                                invisible="state == 'pending' or request_state not in ('pending', 'documentation', 'ministry')"
                                                groups="ems.group_head_of_studies,ems.group_academic_admin"/>
                                    </list>
                                </field>
                                <div class="text-muted mt-2" invisible="state not in ('pending', 'documentation', 'ministry')">
                                    <i class="fa fa-info-circle me-1"/>The grade defaults to 5, which the resolution
                                    shows as "Convalidated". Write the one the previous studies hold when it is known.
                                    Every refused subject needs its reason, which the resolution states.
                                </div>
                            </page>
                            <page name="documents" string="Supporting documents">
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </page>
                            <page name="info_request" string="Documentation requested" invisible="not info_request_date">
                                <group>
                                    <field name="info_request_date"/>
                                    <field name="info_request_reason_id" invisible="not info_request_reason_id"/>
                                </group>
                                <field name="info_request"/>
                            </page>
                            <page name="applicant" string="Applicant's comments">
                                <field name="student_notes" placeholder="Comments from the student or the family..."
                                       readonly="id"/>
                            </page>
                            <page name="resolution" string="Resolution">
                                <field name="resolution_notes"
                                       placeholder="Comments for the student, sent with the resolution..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_convalidation_search" model="ir.ui.view">
            <field name="name">ems.convalidation.search</field>
            <field name="model">ems.convalidation</field>
            <field name="arch" type="xml">
                <search string="Convalidations">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="study_id"/>
                    <field name="course_id"/>
                    <field name="line_ids" string="Subject" filter_domain="[('line_ids.subject_id', 'ilike', self)]"/>
                    <filter name="to_resolve" string="Pending the Head of Studies" domain="[('state', '=', 'pending')]"/>
                    <filter name="documentation" string="Pending documentation" domain="[('state', '=', 'documentation')]"/>
                    <filter name="ministry" string="In process at the Ministry" domain="[('state', '=', 'ministry')]"/>
                    <filter name="pending_direction" string="Pending the Director" domain="[('state', '=', 'direction')]"/>
                    <filter name="pending_secretariat" string="Pending the secretariat"
                            domain="[('state', '=', 'in_progress')]"/>
                    <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                    <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                    <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                        <filter name="group_by_study" string="Study" context="{'group_by': 'study_id'}"/>
                        <filter name="group_by_course" string="Course" context="{'group_by': 'course_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_convalidation_info_wizard_form" model="ir.ui.view">
            <field name="name">ems.convalidation.info_wizard.form</field>
            <field name="model">ems.convalidation.info_wizard</field>
            <field name="arch" type="xml">
                <form string="Request information">
                    <field name="convalidation_id" invisible="1"/>
                    <group>
                        <field name="student_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="reason_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <field name="message" placeholder="Documents or clarifications the applicant must provide..."/>
                    <div class="text-muted">
                        <i class="fa fa-info-circle me-1"/>The applicant receives it by email and can answer,
                        attaching the documents, from the portal. The request waits as Pending documentation
                        until they answer.
                    </div>
                    <footer>
                        <button name="action_send" type="object" string="Send" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_convalidation_return_wizard_form" model="ir.ui.view">
            <field name="name">ems.convalidation.return_wizard.form</field>
            <field name="model">ems.convalidation.return_wizard</field>
            <field name="arch" type="xml">
                <form string="Return to the Head of Studies">
                    <field name="convalidation_id" invisible="1"/>
                    <group>
                        <field name="student_id" readonly="1"/>
                    </group>
                    <field name="reason" placeholder="What the Head of Studies has to review..."/>
                    <footer>
                        <button name="action_return" type="object" string="Return" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_convalidation" model="ir.actions.act_window">
            <field name="name">Convalidations</field>
            <field name="res_model">ems.convalidation</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_convalidation_search"/>
            <field name="context">{'search_default_to_resolve': 1, 'search_default_ministry': 1, 'search_default_pending_direction': 1, 'search_default_pending_secretariat': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No convalidation requests</p>
                <p>Students and families request convalidations from the portal. The secretariat can also register a request received on paper.</p>
            </field>
        </record>

    </data>
</odoo>
