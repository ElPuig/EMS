<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Search: filter/group applicants by study and pre-enrollment shift -->
        <record id="view_applicant_search" model="ir.ui.view">
            <field name="name">ems.applicant.search</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Applicant"/>
                    <field name="study_id" string="Study"/>
                    <filter name="morning" string="Morning" domain="[('preinscription_shift', '=', 'morning')]"/>
                    <filter name="afternoon" string="Afternoon" domain="[('preinscription_shift', '=', 'afternoon')]"/>
                    <separator/>
                    <filter name="nee" string="NEE" domain="[('special_needs', '!=', False)]"/>
                    <group expand="0" string="Group by">
                        <filter name="groupby_study" string="Study" context="{'group_by': 'study_id'}"/>
                        <filter name="groupby_shift" string="Shift" context="{'group_by': 'preinscription_shift'}"/>
                        <filter name="groupby_course" string="Course" context="{'group_by': 'preinscription_course'}"/>
                        <filter name="groupby_nee" string="NEE" context="{'group_by': 'special_needs'}"/>
                    </group>
                    <searchpanel>
                        <field name="study_id" string="Study" icon="fa-graduation-cap" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <!-- List: select applicants by study and launch the enrollment proposal -->
        <record id="view_applicant_list" model="ir.ui.view">
            <field name="name">ems.applicant.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Preinscription" default_order="study_id asc, name asc">
                    <header>
                        <button name="action_enrollment_proposal"
                                type="object"
                                string="Enrollment proposal"/>
                    </header>
                    <field name="name" string="Applicant"/>
                    <field name="study_id"/>
                    <field name="preinscription_shift"/>
                    <field name="preinscription_course"/>
                    <field name="special_needs" optional="show"
                           decoration-danger="special_needs == 'nee_a'"
                           decoration-warning="special_needs == 'nee_b'"/>
                    <field name="student_email" optional="hide"/>
                    <field name="phone" optional="hide"/>
                    <field name="mobile" optional="hide"/>
                    <field name="ems_enrollment_state" column_invisible="1"/>
                    <field name="ems_current_enrollment_id" optional="show" string="Enrollment"
                           decoration-warning="ems_enrollment_state == 'draft'"
                           decoration-info="ems_enrollment_state == 'sent'"
                           decoration-success="ems_enrollment_state == 'sale'"/>
                </list>
            </field>
        </record>

        <record id="action_ems_applicants" model="ir.actions.act_window">
            <field name="name">Preinscription</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('contact_type', '=', 'applicant')]</field>
            <!-- Default nested grouping to make the intake easy to launch proposals
                 from: first by shift, then by course. -->
            <field name="context">{'default_contact_type': 'applicant', 'search_default_groupby_shift': 1, 'search_default_groupby_course': 2}</field>
            <field name="search_view_id" ref="view_applicant_search"/>
            <field name="view_ids" eval="[(5,0,0),
                (0,0,{'view_mode': 'list', 'view_id': ref('view_applicant_list')}),
            ]"/>
        </record>

        <menuitem id="menu_ems_applicants"
                  name="Preinscription"
                  parent="menu_ems_enrollment"
                  action="action_ems_applicants"
                  groups="ems.group_academic_admin,ems.group_secretary"
                  sequence="10"/>
    </data>
</odoo>
