<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_order_form_inherit_ems_enrollment" model="ir.ui.view">
        <field name="name">sale.order.form.ems.enrollment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>        
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Student</attribute>
                <attribute name="context">{'res_partner_search_mode': 'customer'}</attribute>
                <attribute name="options">{'always_reload': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="before">
                 <field name="ems_study_id" required="1" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="attributes">
                <attribute name="string">Enrollment Template</attribute>
                <attribute name="groups"></attribute>
            </xpath>            
            <xpath expr="(//label[@for='date_order'])[1]" position="attributes">
                <attribute name="string">Pre-Enrollment Date</attribute>
            </xpath>
            <xpath expr="(//label[@for='date_order'])[2]" position="attributes">
                <attribute name="string">Enrollment Date</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field name="shift" required="1" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="ems_course_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                <field name="ems_group_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="after">
                <field name="ems_existing_product_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="default_order">product_id asc</attribute>
                <!-- A confirmed line can't be deleted: a module left behind (change of studies) stays at
                     quantity 0 and is hidden here, by this decoration and ems.css (a list has no per-row
                     invisible). The quantity column itself is hidden by default, so such a row would
                     read as a subject still enrolled. The portal hides the same lines (_ems_visible_order_lines). -->
                <attribute name="decoration-muted">not display_type and product_uom_qty == 0</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="class">o_ems_enrollment_lines</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="attributes">
                <attribute name="domain">
                    [
                        '&amp;',
                            '|',
                                ('ems_study_ids', '=', parent.ems_study_id),
                                '&amp;',
                                    ('is_generic', '=', True),
                                    '|',
                                        ('ems_level_ids', 'in', parent.ems_level_id),
                                        ('ems_study_ids', '=', parent.ems_study_id),
                            ('id', 'not in', parent.ems_existing_product_ids)
                    ]
                </attribute>
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                <attribute name="string">Enrollment Item</attribute>
                <attribute name="help">Select the subject or fee. Only items allowed for the selected Academic Study or generic fees will be displayed.</attribute>
                <attribute name="column_invisible">0</attribute>
                <attribute name="optional"></attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="string">Enrollment Item</attribute>
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='price_total']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>            
            <xpath expr="//field[@name='order_line']/list//field[@name='tax_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='customer_lead']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='qty_delivered']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='qty_invoiced']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Campo invisible para usar en la condición del botón eliminar -->
            <xpath expr="//field[@name='order_line']/list//field[@name='qty_invoiced']" position="after">
                <field name="ems_is_tutoria" column_invisible="1"/>
            </xpath>

            <!-- Ocultar el botón de eliminar en líneas de tutoría -->
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="delete">0</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='qty_invoiced']" position="after">
                <button name="unlink" string="" icon="fa-trash" type="object"
                        invisible="ems_is_tutoria == True"
                        confirm="Are you sure you want to remove this item?"/>
            </xpath>

            <xpath expr="//page[@name='order_lines']" position="attributes">
                <attribute name="string">Enrollment Items</attribute>
            </xpath>            
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Authorizations" name="ems_authorizations">
                    <field name="ems_authorization_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="template_id" options="{'no_open': True, 'no_create': True}" readonly="1" force_save="1"/>

                            <field name="acceptance_only" string="Accept only" widget="boolean" readonly="1"/>
                            
                            <field name="status" 
                                   decoration-danger="status == 'no'" 
                                   decoration-success="status == 'yes'" 
                                   decoration-warning="status == 'pending'"/>
                                   
                            <field name="signed_document" filename="signed_document_name" widget="binary"/>
                            <field name="signed_document_name" column_invisible="True"/>
                            <field name="response_date" readonly="1" force_save="1"/>
                            <field name="template_download_url" widget="url" text="Link" string="Plantilla" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="//page[@name='ems_authorizations']" position="after">
                <page string="Payment" name="ems_payment" groups="ems.group_secretary,ems.group_academic_admin">
                    <group>
                        <group string="Payment plan">
                            <field name="payment_term_id" options="{'no_create': True}"/>
                            <field name="ems_payment_method"/>
                        </group>
                        <group string="Payment breakdown" invisible="not ems_has_fees">
                            <field name="ems_has_fees" invisible="1"/>
                            <label for="amount_total" string="Total Amount" class="o_form_label fw-bold"/>
                            <field name="amount_total" readonly="1" nolabel="1"/>
                            <label for="ems_fee_amount" string="↳ Fee amount" class="o_form_label"/>
                            <field name="ems_fee_amount" readonly="1" nolabel="1"/>
                            <label for="ems_non_fee_amount" string="↳ Other enrollment concepts" class="o_form_label"/>
                            <field name="ems_non_fee_amount" readonly="1" nolabel="1"/>
                            <separator/>
                            <label for="ems_first_installment" string="First Payment" class="o_form_label fw-bold"/>
                            <field name="ems_first_installment" readonly="1" nolabel="1"/>
                            <label for="ems_second_installment" string="Second Payment" class="o_form_label fw-bold"/>
                            <field name="ems_second_installment" readonly="1" nolabel="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Ocultar botones de cambio de estado para tutores (solo visibles para admins y secretaría) -->
            <xpath expr="//header/button[@id='send_by_email_primary']" position="attributes">
                <attribute name="groups">ems.group_academic_admin,ems.group_secretary</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_by_email']" position="attributes">
                <attribute name="groups">ems.group_academic_admin,ems.group_secretary</attribute>
            </xpath>
            <xpath expr="//header/button[@id='action_confirm']" position="attributes">
                <attribute name="groups">ems.group_academic_admin,ems.group_secretary</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm' and not(@id)]" position="attributes">
                <attribute name="groups">ems.group_academic_admin,ems.group_secretary</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="groups">ems.group_academic_admin,ems.group_secretary</attribute>
            </xpath>
            <!-- Every action of the form goes in its Actions dropdown: EMS's here, the native ones
                 moved in by view_order_form_ems_native_actions, which has to run after them. -->
            <xpath expr="//header" position="inside">
                <div name="ems_actions" string="Actions">
                    <button name="action_ems_change_study" string="Change studies" type="object"
                            invisible="state != 'sale' or not ems_study_id"
                            groups="ems.group_academic_admin,ems.group_secretary"/>
                    <button name="action_ems_reapply_benefits" string="Re-apply Benefits" type="object"
                            invisible="state != 'sale' or not ems_study_id"
                            groups="ems.group_academic_admin,ems.group_secretary"
                            confirm="This will cancel the current invoice, recompute the enrollment amounts with the student's current benefit status and regenerate the invoice. Continue?"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Priority 130: after every view adding or targeting a native header button (they all match
         them by //header/button, which stops matching once moved). Buttons matched by id or name,
         never by their translated string nor their %(xmlid)d action. "Preview" stays where it is,
         hidden for good. -->
    <record id="view_order_form_ems_native_actions" model="ir.ui.view">
        <field name="name">sale.order.form.ems.native.actions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">130</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='ems_actions']" position="inside">
                <xpath expr="//header/button[@id='send_by_email_primary']" position="move"/>
                <xpath expr="//header/button[@id='action_confirm']" position="move"/>
                <xpath expr="//header/button[@name='action_confirm' and not(@id)]" position="move"/>
                <xpath expr="//header/button[@id='send_by_email']" position="move"/>
                <xpath expr="//header/button[@id='create_invoice']" position="move"/>
                <xpath expr="//header/button[@id='create_invoice_percentage']" position="move"/>
                <xpath expr="//header/button[@name='payment_action_capture']" position="move"/>
                <xpath expr="//header/button[@name='payment_action_void']" position="move"/>
                <xpath expr="//header/button[@name='action_cancel']" position="move"/>
                <xpath expr="//header/button[@name='action_draft']" position="move"/>
            </xpath>
        </field>
    </record>

</odoo>