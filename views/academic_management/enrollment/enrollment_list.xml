<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_tree_inherit_ems_enrollment" model="ir.ui.view">
            <field name="name">sale.order.tree.ems.enrollment</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">

                <!-- Enrollment lists: replace the native "Create Invoices" bulk
                     action with a one-click "Send Enrollment" (email the
                     proposal + mark the drafts as sent). Scoped by the
                     ems_enrollment context flag so native Sales lists keep
                     their "Create Invoices" button untouched. -->
                <xpath expr="//header/button[@type='action']" position="attributes">
                    <attribute name="invisible">context.get('ems_enrollment')</attribute>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_send_enrollment_proposal" type="object"
                            string="Send Enrollment" class="btn-primary"
                            invisible="not context.get('ems_enrollment')"
                            confirm="Email the enrollment proposal to the selected enrollments and mark the drafts as sent?"
                            groups="ems.group_academic_admin,ems.group_secretary"/>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="string">Student</attribute>
                </xpath>

                <xpath expr="//field[@name='date_order']" position="attributes">
                    <attribute name="string">Enrollment Date</attribute>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="ems_level_id" optional="show"/>
                    <field name="ems_study_id" optional="show"/>
                    <field name="shift" optional="show"/>
                    <field name="ems_course_id" optional="show"/>
                    <field name="ems_group_id" optional="show"/>
                </xpath>

                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="ems_enrollment_status_label" optional="show"
                        decoration-info="state == 'draft'"
                        decoration-warning="state == 'sent'"
                        decoration-success="state == 'sale'"
                        decoration-muted="state == 'cancel'"/>
                </xpath>
                <xpath expr="//field[@name='invoice_status']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//field[@name='activity_ids']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>

                <xpath expr="//field[@name='team_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>