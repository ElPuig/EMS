<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_tree_inherit_ems_enrollment" model="ir.ui.view">
            <field name="name">sale.order.tree.ems.enrollment</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="string">Student</attribute>
                </xpath>

                <xpath expr="//field[@name='date_order']" position="attributes">
                    <attribute name="string">Enrollment Date</attribute>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="ems_level_id" optional="show"/>
                    <field name="ems_study_id" optional="show"/>
                    <field name="ems_shift" optional="show"/>
                    <field name="ems_course_id" optional="show"/>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//field[@name='activity_ids']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>

                <xpath expr="//field[@name='team_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>