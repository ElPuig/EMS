<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ems_authorization_template_search" model="ir.ui.view">
            <field name="name">ems.authorization.template.search</field>
            <field name="model">ems.authorization.template</field>
            <field name="arch" type="xml">
                <search string="Search Authorization Templates">
                   
                    <field name="name" string="Name"/>

                    <filter string="Enrollment process" name="enrollment_process"
                            domain="[('apply_on', '=', 'enrollment')]"/>
                    <filter string="Sent during the course" name="standalone"
                            domain="[('apply_on', '=', 'standalone')]"/>

                    <group expand="0" string="Group By">
                        <filter string="Applies on" name="groupby_apply_on" context="{'group_by': 'apply_on'}"/>
                        <filter string="Level" name="groupby_ems_level" context="{'group_by': 'ems_level_ids'}"/>
                        <filter string="Study" name="groupby_ems_study" context="{'group_by': 'ems_study_ids'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>