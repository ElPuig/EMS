<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_ems_authorization_template" model="ir.actions.act_window">
            <field name="name">Authorization Forms</field>
            <field name="res_model">ems.authorization.template</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ems.view_ems_authorization_template_search"/>
            <field name="context">{'search_default_groupby_ems_level': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Authorization Template!
                </p>
                <p>
                    Define the legal texts, consents, and rules required for enrollments.
                </p>
            </field>
        </record>

        <record id="view_ems_authorization_template_list" model="ir.ui.view">
            <field name="name">ems.authorization.template.list</field>
            <field name="model">ems.authorization.template</field>
            <field name="arch" type="xml">
                <list string="Authorization Templates">
                    <field name="name"/>
                    <field name="is_required" widget="boolean_toggle"/>
                    <field name="ems_level_ids" widget="many2many_tags" placeholder="All Levels"/>
                    <field name="ems_study_ids" widget="many2many_tags" placeholder="All Studies"/>
                </list>
            </field>
        </record>
    </data>
</odoo>