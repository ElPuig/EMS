<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <menuitem name="Student Documents" id="menu_student_documents"
                  parent="menu_ems_academic_management"
                  action="action_student_document"
                  groups="ems.group_academic_admin,ems.group_secretary,ems.group_head_of_studies"
                  sequence="10"/>

        <!-- The Heads of Studies only reach the Authorizations section in here (issue #654):
             every other entry names its own groups, since a menu without them is open to
             whoever sees its folder. -->
        <menuitem id="menu_ems_configuration"
                  name="Configuration"
                  parent="menu_ems_academic_management"
                  groups="ems.group_academic_admin,ems.group_secretary,ems.group_head_of_studies"
                  sequence="100"/>

        <!-- Sections of Academic management > Configuration, rendered as headers inside its
             dropdown (issue #654): Enrollment here, Authorizations and Convalidations in their
             own menu files. -->
        <!-- Task Assignment (task_assignment/menu.xml) also sits in this section. -->
        <menuitem id="menu_ems_configuration_enrollment"
                  name="Enrollment"
                  parent="menu_ems_configuration"
                  groups="ems.group_academic_admin,ems.group_secretary"
                  sequence="10"/>

        <menuitem id="menu_ems_enrollment_items"
                  name="Enrollment Items"
                  parent="menu_ems_configuration_enrollment"
                  action="action_ems_enrollment_items"
                  groups="ems.group_academic_admin,ems.group_secretary"
                  sequence="10"/>

        <menuitem id="menu_ems_enrollment_templates"
                  name="Enrollment Templates"
                  parent="menu_ems_configuration_enrollment"
                  action="action_ems_enrollment_template"
                  groups="ems.group_academic_admin,ems.group_secretary"
                  sequence="30"/>

    </data>
</odoo>