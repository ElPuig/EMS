<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="action_ems_pre_enrolments" model="ir.actions.act_window">
            <field name="name">Pre-enrolments</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form,kanban</field>
            
            <field name="domain" eval="[('state', 'in', ('draft', 'sent', 'cancel')), ('team_id', '=', ref('ems.team_administration'))]"/>
            <field name="context" eval="{'default_team_id': ref('ems.team_administration')}"/>
        </record>

        <record id="action_ems_enrolments" model="ir.actions.act_window">
            <field name="name">Enrolments</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form,kanban</field>
            
            <field name="domain" eval="[('state', 'not in', ('draft', 'sent', 'cancel')), ('team_id', '=', ref('ems.team_administration'))]"/>
            <field name="context" eval="{'default_team_id': ref('ems.team_administration')}"/>
        </record>


        <menuitem id="menu_ems_enrolment"
                  name="Enrolment"
                  parent="menu_ems_academic_management"
                  sequence="10"/>

            <menuitem id="menu_ems_pre_enrolments"
                      name="Pre-enrolments"
                      parent="menu_ems_enrolment"
                      action="action_ems_pre_enrolments"
                      sequence="10"/>

            <menuitem id="menu_ems_enrolments"
                      name="Enrolments"
                      parent="menu_ems_enrolment"
                      action="action_ems_enrolments"
                      sequence="20"/>
    </data>
</odoo>
            <!-- para pre-enrolments action="sale.action_quotations" -->
            <!-- para Enrolments action="sale.action_orders" -->
