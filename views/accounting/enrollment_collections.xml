<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Read-only list of the receivable installments of enrollment
             invoices, grouped by due date (the July / September SEPA batches). -->
        <record id="view_enrollment_collection_list" model="ir.ui.view">
            <field name="name">ems.enrollment.collections.list</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <list string="Enrollment collections" create="0" edit="0" delete="0"
                      default_order="date_maturity, move_name">
                    <field name="date_maturity"/>
                    <field name="move_name"/>
                    <field name="partner_id" string="Student"/>
                    <field name="balance" sum="Total"/>
                </list>
            </field>
        </record>

        <record id="view_enrollment_collection_search" model="ir.ui.view">
            <field name="name">ems.enrollment.collections.search</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="partner_id"/>
                    <field name="move_id"/>
                    <filter name="group_due_date" string="Due Date"
                            context="{'group_by': 'date_maturity'}"/>
                </search>
            </field>
        </record>

        <record id="action_enrollment_collections" model="ir.actions.act_window">
            <field name="name">Enrollment collections</field>
            <field name="res_model">account.move.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_enrollment_collection_list"/>
            <field name="search_view_id" ref="view_enrollment_collection_search"/>
            <field name="domain">[
                ('display_type', '=', 'payment_term'),
                ('parent_state', '=', 'posted'),
                ('move_id.move_type', '=', 'out_invoice'),
                '|', ('move_id.ref', '=like', 'M/%'),
                     ('move_id.invoice_origin', '=like', 'M/%'),
            ]</field>
            <field name="context">{'search_default_group_due_date': 1}</field>
        </record>

        <menuitem id="menu_enrollment_collections"
                  name="Enrollment collections"
                  parent="account.menu_finance"
                  action="action_enrollment_collections"
                  groups="ems.group_secretary,ems.group_admin"
                  sequence="50"/>

    </data>
</odoo>
