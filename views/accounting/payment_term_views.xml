<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ems_payment_term_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.term.form.ems</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
        
            <xpath expr="//field[@name='early_discount']/.." position="after">
                <separator string="EMS Portal"/>
                <group>
                    <field name="ems_portal_visible" widget="boolean_toggle"/>
                </group>
            </xpath>            
        </field>
    </record>
</odoo>