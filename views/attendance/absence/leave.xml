<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- The centre's own absence fields, added to Odoo's native Time Off screens. Lives
             under views/attendance/ because that is where its menu resolves to: menu.xml here
             re-parents the whole Time Off menu under "Employee Attendances"
             (hr_attendance.menu_hr_attendance_root), the same root that
             views/attendance/guard_duty_board/ and views/attendance/attendance_correction/
             already hang from. -->

        <record id="hr_leave_view_form_ems" model="ir.ui.view">
            <field name="name">hr.leave.view.form.ems</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">

                <!-- Replaces Odoo's own two unit toggles: "Half Day", which the centre has no
                     use for, and "Custom Hours", which says the opposite of what the original
                     form asked and is now derived from this one. Sits where they sat, above the
                     dates, because it decides which dates are asked for. -->
                <xpath expr="//div[field[@name='request_unit_half']]" position="replace">
                    <div class="o_row o_row_readonly oe_edit_only" style="margin-left: -2px;">
                        <!-- Kept, invisible, rather than dropped: both are still referenced by
                             <label for="..."> and by invisible= expressions elsewhere in the
                             form, and Odoo refuses to validate a view whose label points at a
                             field that is not in it. -->
                        <field name="request_unit_half" invisible="1"/>
                        <field name="request_unit_hours" invisible="1"/>
                        <field name="ems_full_day" class="oe_inline" readonly="state != 'confirm'"/>
                        <label for="ems_full_day"/>
                    </div>
                </xpath>

                <xpath expr="//field[@name='duration_display']" position="after">
                    <field name="ems_health_allowance_exceeded" invisible="1"/>
                    <div class="alert alert-warning my-2" role="alert"
                         invisible="not ems_health_allowance_exceeded">
                        <span>This employee is over their self-declared health absence allowance for the course.</span>
                        <field name="ems_health_hours_used" class="ms-1" readonly="1"/>
                        <span class="ms-1">hours used.</span>
                    </div>
                </xpath>

                <!-- The employee picks the absence type, but they get it wrong often enough
                     that the manager has to be able to correct it after the fact - which the
                     native readonly, keyed on the approval state, would prevent.

                     Shown as a radio list rather than a dropdown, like the original Google
                     form: several of the nine options are the legal wording the employee is
                     declaring when they choose one, so they have to be readable in full at the
                     moment of choosing. colspan spans the group so the long lines have room. -->
                <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                    <attribute name="readonly">state in ['cancel', 'refuse', 'validate', 'validate1'] and not is_absence_manager</attribute>
                    <attribute name="widget">ems_absence_type_radio</attribute>
                </xpath>

                <!-- Out of the half-width left column and into a block of its own above it:
                     nine options, several of them a full sentence, wrapped into a column half
                     the screen wide meant scrolling past the question before reaching the
                     dates.

                     A plain div, not a <group>: a group lays its contents out in two columns,
                     so even at full sheet width the field would still only get half of it -
                     which is exactly what the first attempt at this produced. And the move is
                     its own top-level operation, because a position="move" nested inside a
                     subtree being added in the same step is copied verbatim instead of being
                     executed. -->
                <xpath expr="//div[hasclass('o_hr_leave_content')]" position="before">
                    <div name="ems_absence_type" class="mb-4">
                        <label for="holiday_status_id" class="o_form_label fw-bold d-block mb-2"/>
                    </div>
                </xpath>

                <xpath expr="//div[@name='ems_absence_type']" position="inside">
                    <xpath expr="//field[@name='holiday_status_id']" position="move"/>
                </xpath>

                <!-- An ATRI absence is recorded here but actually granted on the Generalitat's
                     own portal, so the employee needs to be sent there at the moment they pick
                     the type - not left to find out later. The flag is read from the absence
                     type; a second, invisible node is needed because the editable one further
                     down is restricted to the approver, and a field a reader cannot load cannot
                     drive a modifier. -->
                <xpath expr="//div[@name='ems_absence_type']" position="inside">
                    <field name="ems_needs_atri" invisible="1"/>
                    <div class="alert alert-info mt-2" role="alert" invisible="not ems_needs_atri">
                        <span>This absence also has to be requested on the Generalitat's ATRI portal:</span>
                        <a href="https://atriportal.gencat.cat/ATRI-ng/#/meves-sollicituds/permisos-absencies"
                           target="_blank" rel="noreferrer">My requests - leave and absences</a><span>.</span>
                        <span class="d-block">Reference manual:</span>
                        <a href="https://atriportal.gencat.cat/ATRI-web/gestor-continguts/2011.pdf"
                           target="_blank" rel="noreferrer">ATRI leave and absences manual (PDF)</a><span>.</span>
                    </div>
                </xpath>

                <!-- Everything below the absence type laid out in two columns instead of one.
                     The native form puts it all in a half-width column and leaves the other
                     half empty (on the manager form, to the leave-stats widget, which is fine
                     wrapped underneath), so the request needed scrolling for no reason.
                     col="4" gives a group two label/field pairs per row. -->
                <xpath expr="//div[hasclass('col_left')]" position="attributes">
                    <attribute name="class" remove="col-md-6" add="col-md-12" separator=" "/>
                </xpath>

                <xpath expr="//group[@name='col_left']" position="attributes">
                    <attribute name="col">4</attribute>
                </xpath>

                <!-- "Supporting Document" is called "Justificante" in the original form, and
                     carries an instruction the employee genuinely needs (a medical certificate
                     has to name the patient and the entry/exit times).

                     Both of the conditions Odoo puts on it are dropped, so the field is on every
                     request whatever its type and whatever its state:

                     - By type ('leave_type_support_document'). The flag says which types
                       *require* a document, not which ones accept one, and the centre takes a
                       justification for any absence somebody has one for - an employee who can
                       document a "Justified absence" had nowhere to attach it.
                     - By state. Direction's own check of the document
                       ('ems_direction_state') happens after the approval, and a medical
                       certificate is usually handed in days after the absence itself, so the
                       field disappearing the moment the request was approved made the "Missing
                       document" state impossible to ever clear.

                     The server has always allowed both: 'hr.leave.write()' exempts
                     'supported_attachment_ids' by name from every restriction it puts on an
                     approved, cancelled or already-started request. Only the view hid it. -->
                <xpath expr="//label[@for='supported_attachment_ids']" position="attributes">
                    <attribute name="string">Supporting document</attribute>
                    <attribute name="invisible">0</attribute>
                </xpath>
                <xpath expr="//field[@name='supported_attachment_ids']" position="before">
                    <div class="text-muted small"><span>Supporting document for the absence. For a medical appointment, it must expressly state the patient's first name and surname and the time of entry to and exit from the centre or medical practice.</span></div>
                </xpath>

                <!-- Deleting the justification is not something to do by accident: same widget,
                     with a confirmation in front of the removal. -->
                <xpath expr="//field[@name='supported_attachment_ids']" position="attributes">
                    <attribute name="widget">ems_attachment_confirm</attribute>
                    <attribute name="invisible">0</attribute>
                </xpath>

                <xpath expr="//field[@name='supported_attachment_ids']" position="after">
                    <field name="is_absence_manager" invisible="1"/>
                    <!-- The original form's own wording, verbatim: the intro naming the types
                         it covers, then the sentence the employee is actually signing. Required
                         for every absence, not just some: it is the employee asserting that the
                         reason they gave is true. -->
                    <separator string="Responsible declaration" colspan="2"/>
                    <div class="text-muted small" colspan="2"><span>Responsible declaration justifying an absence for health reasons, attendance at a medical appointment, an invasive medical test, recoverable flexible hours for menstruation or climacteric, training, or participation in the Erasmus+ programme</span></div>
                    <div class="o_row" colspan="2">
                        <field name="ems_responsible_declaration" class="oe_inline"
                               string="I declare, under my own responsibility, that the details and the reason for my absence that I have given are true."
                               required="1" readonly="state != 'confirm'"/>
                        <label for="ems_responsible_declaration"/>
                    </div>
                    <!-- Derived from the absence type, never picked by the employee - only the
                         manager or Direction corrects it when the type was chosen wrongly. -->
                    <field name="ems_needs_atri" groups="hr_holidays.group_hr_holidays_responsible"/>
                    <field name="ems_counts_hours" groups="hr_holidays.group_hr_holidays_responsible"/>
                    <!-- Each approver's own column, visible to everyone (an employee needs to
                         know their justification is still pending). Read-only here: the Head
                         decides with Approve/Refuse and Direction with its own buttons, both in
                         the header. hr.leave.write() rejects Direction's for anyone else, so the
                         buttons being hidden is only the UI half of that barrier.

                         Hidden while the request is being written: nobody can have decided on
                         something that does not exist yet. -->
                    <field name="is_absence_direction" invisible="1"/>
                    <field name="ems_head_state" invisible="not id" widget="badge"
                           decoration-muted="ems_head_state == 'pending'"
                           decoration-success="ems_head_state == 'approved'"
                           decoration-danger="ems_head_state == 'refused'"/>
                    <field name="ems_direction_state" invisible="not id" readonly="1" widget="badge"
                           decoration-muted="ems_direction_state == 'not_done'"
                           decoration-warning="ems_direction_state == 'missing_doc'"
                           decoration-success="ems_direction_state == 'done'"
                           decoration-danger="ems_direction_state == 'refused'"/>
                </xpath>

                <!-- Refusing is the one decision on this form that cannot be taken back.
                     'action_reset_confirm' does exist, but Odoo reserves resetting a *refused*
                     request to the Time Off Administrator group ("Only a Time Off Manager can
                     reset a refused leave", hr.leave._check_approval_update), which nobody at
                     the centre holds - deliberately, see res.users._ems_sync_time_off_groups.
                     So the employee has to file the whole request again, and the approver was
                     one stray click away from causing that, here and from the list and kanban
                     buttons below. Odoo's own 'confirm' attribute, not a wizard: it is the
                     mechanism for exactly this, and it needs no code at all. -->
                <xpath expr="//header/button[@name='action_refuse']" position="attributes">
                    <attribute name="confirm">A refused absence request cannot be reopened: the employee has to file a new one. Refuse it?</attribute>
                    <attribute name="confirm-title">Refuse this absence request</attribute>
                    <attribute name="confirm-label">Refuse</attribute>
                </xpath>

                <!-- Direction's own approval, next to the Head's: either can come first. The
                     bar shows where the request stands between the two instead of Odoo's own
                     state, which only knows the Head's half. The Refuse here is Direction's;
                     where Direction is also the approver it already has the Head's one, which
                     does the same thing. -->
                <xpath expr="//header/field[@name='state']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Taking either decision from here goes back to the list the request was
                     opened from (static/src/js/backend/absence_form.js). -->
                <xpath expr="//form" position="attributes">
                    <attribute name="js_class">ems_absence_form</attribute>
                </xpath>
                <xpath expr="//header/field[@name='state']" position="after">
                    <button string="Direction: done" name="action_ems_direction_done" type="object"
                            class="oe_highlight"
                            invisible="not id or not is_absence_direction or state in ('refuse', 'cancel') or ems_direction_state == 'done'"/>
                    <button string="Missing document" name="action_ems_direction_missing_doc" type="object"
                            invisible="not id or not is_absence_direction or state in ('refuse', 'cancel') or ems_direction_state == 'missing_doc'"/>
                    <button string="Direction: pending" name="action_ems_direction_reset" type="object"
                            invisible="not id or not is_absence_direction or state in ('refuse', 'cancel') or ems_direction_state == 'not_done'"/>
                    <button string="Refuse" name="action_ems_direction_refuse" type="object"
                            invisible="not id or not is_absence_direction or can_approve or state in ('refuse', 'cancel')"
                            confirm="A refused absence request cannot be reopened: the employee has to file a new one. Refuse it?"
                            confirm-title="Refuse this absence request" confirm-label="Refuse"/>
                    <field name="ems_status" widget="statusbar"
                           statusbar_visible="pending,approved"/>
                </xpath>

                <!-- Nothing is filed until the employee says so. Odoo would otherwise keep the
                     record the moment any field changes, which is the wrong contract for a
                     request that has legal wording attached to it. -->
                <xpath expr="//sheet" position="inside">
                    <field name="ems_submitted" invisible="1"/>
                    <div class="mt-4 text-end" invisible="state != 'confirm'">
                        <widget name="ems_absence_submit"/>
                    </div>
                </xpath>

            </field>
        </record>

        <record id="hr_leave_view_tree_ems" model="ir.ui.view">
            <field name="name">hr.leave.view.list.ems</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
            <field name="arch" type="xml">

                <!-- The full legal wording belongs in the form, not in a list column. -->
                <xpath expr="//field[@name='holiday_status_id']" position="replace">
                    <field name="ems_type_short_name" class="fw-bold"/>
                </xpath>

                <!-- Same confirmation as the form's own Refuse button, and this is the one
                     that is really clicked by accident: in the list it is a bare "x" icon at
                     the end of a row, one column away from Approve.

                     Only 'confirm' here, without the dialog's title and button label: unlike
                     form and kanban views, a list is validated against a RelaxNG schema
                     (base/rng/list_view.rng, there is no form_view.rng at all), and its
                     'button' definition allows 'confirm' but neither 'confirm-title' nor
                     'confirm-label'. Adding them turns the whole view invalid and the module
                     upgrade fails. -->
                <!-- can_approve keeps Direction from deciding on the Head's behalf (see
                     hr.leave._compute_can_approve). Icons only, their label as the tooltip:
                     sitting between columns instead of at the end of the row, a labelled button
                     gets squeezed into the badge beside it. -->
                <xpath expr="//button[@name='action_refuse']" position="attributes">
                    <attribute name="confirm">A refused absence request cannot be reopened: the employee has to file a new one. Refuse it?</attribute>
                    <attribute name="invisible">state not in ('confirm', 'validate1') or not can_approve</attribute>
                    <attribute name="string"/>
                    <attribute name="title">Refuse</attribute>
                </xpath>
                <xpath expr="//button[@name='action_approve']" position="attributes">
                    <attribute name="invisible">state != 'confirm' or not can_approve</attribute>
                    <attribute name="string"/>
                    <attribute name="title">Approve</attribute>
                </xpath>
                <xpath expr="//button[@name='action_validate']" position="attributes">
                    <attribute name="string"/>
                    <attribute name="title">Validate</attribute>
                </xpath>

                <xpath expr="//field[@name='duration_display']" position="after">
                    <field name="ems_counts_hours" optional="show"
                           groups="hr_holidays.group_hr_holidays_responsible"/>
                    <field name="ems_health_allowance_exceeded" string="Over allowance"
                           optional="hidden" groups="hr_holidays.group_hr_holidays_responsible"/>
                </xpath>

                <!-- The two approvals, each with its own buttons beside it, after the overall
                     status that combines them. Odoo's own state is only the Head's half, so it
                     stays loaded for the buttons' conditions but out of sight. Everyone sees
                     the three columns - an employee needs to know their justification is still
                     pending - but only Direction can set its own (guarded in the model, not
                     just by the buttons being Direction's). -->
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="can_approve" column_invisible="1"/>
                    <field name="ems_status" string="Status" widget="badge" width="150px"
                           decoration-muted="ems_status == 'cancel'"
                           decoration-warning="ems_status in ('pending', 'pending_head', 'pending_direction', 'pending_document')"
                           decoration-success="ems_status == 'approved'"
                           decoration-danger="ems_status == 'refused'"/>
                    <field name="ems_head_state" widget="badge"
                           decoration-muted="ems_head_state == 'pending'"
                           decoration-success="ems_head_state == 'approved'"
                           decoration-danger="ems_head_state == 'refused'"/>
                </xpath>
                <xpath expr="//field[@name='ems_head_state']" position="after">
                    <xpath expr="//button[@name='action_approve']" position="move"/>
                    <xpath expr="//button[@name='action_validate']" position="move"/>
                    <xpath expr="//button[@name='action_refuse']" position="move"/>
                </xpath>
                <xpath expr="//button[@name='action_refuse']" position="after">
                    <field name="ems_direction_state" widget="badge" width="140px"
                           decoration-muted="ems_direction_state == 'not_done'"
                           decoration-warning="ems_direction_state == 'missing_doc'"
                           decoration-success="ems_direction_state == 'done'"
                           decoration-danger="ems_direction_state == 'refused'"/>
                    <button title="Direction: done" name="action_ems_direction_done" type="object"
                            icon="fa-check-square-o" groups="ems.group_director"
                            invisible="state in ('refuse', 'cancel') or ems_direction_state == 'done'"/>
                    <button title="Missing document" name="action_ems_direction_missing_doc" type="object"
                            icon="fa-file-o" groups="ems.group_director"
                            invisible="state in ('refuse', 'cancel') or ems_direction_state == 'missing_doc'"/>
                    <button title="Direction: pending" name="action_ems_direction_reset" type="object"
                            icon="fa-undo" groups="ems.group_director"
                            invisible="state in ('refuse', 'cancel') or ems_direction_state == 'not_done'"/>
                    <button title="Refuse" name="action_ems_direction_refuse" type="object"
                            icon="fa-times" groups="ems.group_director"
                            invisible="state in ('refuse', 'cancel') or can_approve"
                            confirm="A refused absence request cannot be reopened: the employee has to file a new one. Refuse it?"/>
                </xpath>

            </field>
        </record>

        <!-- An employee's own list is not where anybody decides: Odoo already hides its
             Approve/Refuse there, and Direction's buttons go the same way. -->
        <record id="hr_leave_view_tree_my_ems" model="ir.ui.view">
            <field name="name">hr.leave.view.list.my.ems</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree_my"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_ems_direction_done']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_ems_direction_missing_doc']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_ems_direction_reset']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_ems_direction_refuse']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- The kanban is the third screen the same Refuse button appears on (Management > Time
             Off switches to it), so it gets the same confirmation. Inheriting the base kanban
             covers 'hr_leave_view_kanban_my' too, which is a primary view derived from it. -->
        <record id="hr_leave_view_kanban_ems" model="ir.ui.view">
            <field name="name">hr.leave.view.kanban.ems</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_refuse']" position="attributes">
                    <attribute name="confirm">A refused absence request cannot be reopened: the employee has to file a new one. Refuse it?</attribute>
                    <attribute name="confirm-title">Refuse this absence request</attribute>
                    <attribute name="confirm-label">Refuse</attribute>
                    <attribute name="t-if">['confirm', 'validate1'].includes(record.state.raw_value) and record.can_approve.raw_value</attribute>
                </xpath>
                <!-- Same as the list: Direction does not approve on the Head's behalf. -->
                <xpath expr="//button[@name='action_approve']" position="attributes">
                    <attribute name="t-if">record.state.raw_value === 'confirm' and record.can_approve.raw_value</attribute>
                </xpath>
                <xpath expr="//templates" position="before">
                    <field name="can_approve"/>
                </xpath>
            </field>
        </record>

        <!-- The dashboard's "New" button opens this calendar's own creation dialog, whose title
             comes from the view's string - natively the vague "Time Off Request". -->
        <record id="hr_leave_view_dashboard_ems" model="ir.ui.view">
            <field name="name">hr.leave.view.dashboard.ems</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_dashboard"/>
            <field name="arch" type="xml">
                <xpath expr="//calendar" position="attributes">
                    <attribute name="string">Absence request</attribute>
                </xpath>
            </field>
        </record>

        <!-- "Time Off Analysis", the per-employee report. The spreadsheet's own "Total per
             profe" tab: one line per employee with the hours that count against the health
             allowance, which is the figure the centre has to keep under the yearly limit. -->
        <record id="view_holiday_list_ems" model="ir.ui.view">
            <field name="name">hr.holidays.report_list.ems</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.view_holiday_list"/>
            <field name="arch" type="xml">

                <!-- A report is for reading. Filing an absence happens on the employee's own
                     screen, which is where the "Send request" button and its confirmation are. -->
                <xpath expr="//list" position="attributes">
                    <attribute name="create">0</attribute>
                </xpath>

                <!-- Employee, health hours, days, type, then whatever Odoo already had.
                     Explicit widths on the two columns whose headings are longest, so those are
                     the ones guaranteed their full title and the trailing columns give way
                     first. -->
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="ems_health_hours" sum="Health hours" width="150px"/>
                </xpath>

                <xpath expr="//field[@name='number_of_days']" position="after">
                    <field name="ems_type_short_name" string="Absence type" width="200px"/>
                    <field name="ems_course_id" optional="hidden"/>
                </xpath>

            </field>
        </record>

        <record id="view_hr_holidays_filter_ems" model="ir.ui.view">
            <field name="name">hr.leave.search.ems</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
            <field name="arch" type="xml">

                <!-- Odoo's "Current Year" filter is the calendar year, which cuts a school year
                     in half: an absence from September and one from February would never be
                     counted together. This one follows ems.course. -->
                <xpath expr="//filter[@name='filter_date_from']" position="before">
                    <filter name="ems_current_course" string="Current Course"
                            domain="[('ems_course_id.is_current', '=', True)]"/>
                </xpath>

                <!-- Direction's own "Waiting For Me": every live request it has not approved
                     yet (Direction status Pending or Missing document), whether or not the Head
                     has decided - either can go first - plus the Area Managers' own absences,
                     which Direction approves as their Head. Odoo's officer filter, which Direction would
                     otherwise get through Head of Studies, lists the Head's pending work
                     instead. -->
                <xpath expr="//filter[@name='waiting_for_me_manager']" position="attributes">
                    <attribute name="groups">hr_holidays.group_hr_holidays_user,!ems.group_director</attribute>
                </xpath>
                <xpath expr="//filter[@name='waiting_for_me_manager']" position="after">
                    <filter name="ems_waiting_for_direction" string="Waiting For Me"
                            groups="ems.group_director"
                            domain="['|', '&amp;', ('state', 'not in', ['refuse', 'cancel']),
                                          ('ems_direction_state', 'in', ['not_done', 'missing_doc']),
                                     '&amp;', ('state', '=', 'confirm'), ('employee_id.leave_manager_id', '=', uid)]"/>
                </xpath>

                <!-- The left panel filters on where a request stands between its two
                     approvals, not on Odoo's state, which only knows the Head's half. -->
                <xpath expr="//searchpanel/field[@name='state']" position="attributes">
                    <attribute name="name">ems_status</attribute>
                </xpath>

                <xpath expr="//filter[@name='group_date_from']" position="before">
                    <filter name="ems_group_month" string="Month"
                            context="{'group_by': 'request_date_from:month'}"/>
                </xpath>

            </field>
        </record>

        <!-- Management > Absences opens on each reader's own pending work: Odoo's two
             "Waiting For Me" filters for the approvers, EMS's own for Direction (see the search
             view above). A filter a reader's groups do not show is simply not applied. -->
        <record model="ir.actions.act_window" id="hr_holidays.hr_leave_action_action_approve_department">
            <field name="context">{
                'search_default_waiting_for_me': 1,
                'search_default_waiting_for_me_manager': 2,
                'search_default_ems_waiting_for_direction': 3,
                'search_default_current_year': 4,
                'hide_employee_name': 1,
            }</field>
        </record>

        <record model="ir.actions.act_window" id="hr_holidays.action_hr_available_holidays_report">
