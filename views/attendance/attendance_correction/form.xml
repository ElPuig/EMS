<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_correction_form">
            <field name="name">ems.attendance_correction.form</field>
            <field name="model">ems.attendance_correction</field>
            <field name="arch" type="xml">
                <form string="Attendance correction">
                    <header>
                        <button string="Accept" name="action_accept" type="object" class="btn-primary" invisible="not is_approver or state == 'accepted'"/>
                        <button string="Reject" name="action_reject" type="object" class="btn-secondary" invisible="not is_approver or state == 'rejected' or (state == 'accepted' and not original_check_in)"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,accepted,rejected"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <field name="is_check_out_requestable" invisible="1"/>
                        <group>
                            <group string="Employee">
                                <field name="employee_id" widget="many2one_avatar_employee" readonly="1"/>
                                <!-- Issue #735: from a detected absence the teacher picks one of that
                                     day's attendances, or none to have one recorded. -->
                                <field name="absence_pending_id" invisible="not absence_pending_id" options="{'no_open': True}"/>
                                <field name="allowed_attendance_ids" invisible="1"/>
                                <field name="attendance_id" readonly="id or not absence_pending_id"
                                       domain="[('id', 'in', allowed_attendance_ids)]"
                                       placeholder="None: record an attendance for that day"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group string="Requested correction">
                                <field name="original_check_in" readonly="1" invisible="not original_check_in"/>
                                <field name="requested_check_in" widget="ems_time_of_day" placeholder="HH:MM"/>
                                <field name="original_check_out" readonly="1" invisible="not original_check_in"/>
                                <field name="requested_check_out" widget="ems_time_of_day" placeholder="HH:MM"
                                       invisible="not is_check_out_requestable"/>
                            </group>
                        </group>
                        <group string="Reason">
                            <field name="reason" nolabel="1" readonly="id"/>
                        </group>
                        <group string="Decision">
                            <field name="approver_id" readonly="1" invisible="state == 'pending'"/>
                            <field name="decision_date" readonly="1" invisible="state == 'pending'"/>
                            <field name="decision_note" placeholder="Optional note for the requester..."/>
                        </group>
                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>
    </data>
</odoo>
