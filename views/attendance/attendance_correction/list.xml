<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_correction_list">
            <field name="name">ems.attendance_correction.list</field>
            <field name="model">ems.attendance_correction</field>
            <field name="arch" type="xml">
                <list>
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="attendance_id"/>
                    <field name="requested_check_in"/>
                    <field name="requested_check_out"/>
                    <field name="state" widget="badge" decoration-success="state == 'accepted'" decoration-danger="state == 'rejected'" decoration-info="state == 'pending'"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
