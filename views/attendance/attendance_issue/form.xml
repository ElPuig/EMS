<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_issue_tutor_form">
            <field name="name">ems.attendance_issue_tutor.form</field>
            <field name="model">ems.attendance_issue_tutor</field>
            <field name="arch" type="xml">
                <form string="notification">                    
                    <sheet>     
                         <group string="Daily report data" col="3">   
                            <group>
                                <field name="tutor_id"  widget="many2one_avatar" readonly="True" />
                            </group>  
                            <group colspan="2">
                                <field name="notification_id" string="Notification details" readonly="True" invisible="not user_is_admin" />
                            </group>  
                            
                            <group>
                                <field name="issue_date" readonly="True" />
                            </group>
                            <group>
                                <field name="schedule_date" readonly="True" />
                            </group> 
                            <group >
                                <field name="status" readonly="True" />
                            </group>                                         
                        </group>

                        <notebook>
                            <page string="Error details" invisible="not exception">
                                <field name="exception" readonly="True" />                                    
                            </page>     
                            <page string="Students">
                                <field name="attendance_issue_student_ids">
                                    <list default_order="student_id asc" create="False" edit="False" delete="False">
                                        <field name="student_id" widget="many2one_avatar"/>
                                    </list>
                                </field>
                            </page> 
                        </notebook>                      
                    </sheet>	
                </form>              
            </field>			
        </record>

         <record model="ir.ui.view" id="view_attendance_issue_student_form">
            <field name="name">ems.attendance_issue_student.form</field>
            <field name="model">ems.attendance_issue_student</field>
            <field name="arch" type="xml">
                <form string="notification">                    
                    <sheet>     
                         <group string="Student report data" col="3">   
                            <group colspan="2">
                                <field name="student_id" readonly="True" />
                            </group>         
                            <group>
                                <field name="date" readonly="True" />
                            </group>                                 
                        </group>

                        <notebook>
                            <page string="Sessions and statuses">
                                <field name="attendance_issue_status_ids">
                                    <list default_order="time_range asc" create="False" edit="False" delete="False" no_open="True">
                                        <field name="subject_id" />
                                        <field name="time_range" />
                                        <field name="group_id" />
                                        <field name="space_id" />
                                        <field name="teacher_id" widget="many2one_avatar"/>
                                        <field name="status" />
                                        <field name="notes" />
                                        <!-- TODO: develop a custom component to work as tags but using the email field (or beeing able to choose the field). Then, change the field to res.partner relation instead of Char. -->
                                        <field name="send_to" />
                                        <field name="sent_date" />
                                        <button class="oe_stat_button" title="Display notification" icon="fa-info-circle" name="display_notification" type="object" /> 
                                    </list>
                                </field>
                            </page>      
                        </notebook>                      
                    </sheet>	
                </form>              
            </field>			
        </record>
    </data>
</odoo>