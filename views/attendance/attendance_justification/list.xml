<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_justification_list">
            <field name="name">ems.attendance_justification.list</field>
            <field name="model">ems.attendance_justification</field>
            <field name="arch" type="xml">
                <list>
                    <field name="teacher_id" widget="many2one_avatar_employee"/>
                    <!-- Issue #795: one justification can cover a whole group: its name, or how many. -->
                    <field name="student_summary" string="Students"/>
                    <field name="session_teacher_ids" widget="many2many_tags"/>
                    <field name="start_date" width="125px"/>
                    <field name="end_date" width="125px"/>
                    <field name="reason_id"/>
                    <field name="details" optional="show"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
