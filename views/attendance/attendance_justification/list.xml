<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_justification_list">
            <field name="name">ems.attendance_justification.list</field>
            <field name="model">ems.attendance_justification</field>
            <field name="arch" type="xml">
                <list create="0">
                    <header>
                        <!-- Issue #656: "New" opens the assistant, which justifies several students
                             or whole groups at once (one justification per student). -->
                        <button name="%(ems.action_attendance_justification_wizard)d" type="action" string="New"
                                class="btn-primary o_list_button_add_justification" display="always"
                                groups="ems.group_teacher,ems.group_academic_admin"/>
                    </header>
                    <field name="teacher_id" widget="many2one_avatar_employee"/>
                    <field name="student_id" widget="many2one_avatar"/>
                    <field name="session_teacher_ids" widget="many2many_tags"/>
                    <field name="start_date" width="125px"/>
                    <field name="end_date" width="125px"/>
                </list>
            </field>
        </record>   
    </data>
</odoo>