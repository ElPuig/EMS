<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_justification_search">
            <field name="name">ems.attendance_justification.search</field>
            <field name="model">ems.attendance_justification</field>
            <field name="arch" type="xml">
                <search string="Only mine">
                    <field name="student_ids"/>
                    <field name="student_ids" string="Group" filter_domain="[('student_ids.main_group_id', 'ilike', self)]"/>
                    <filter string="Show only mine" name="only_mine" domain="[('teacher_id.user_id.id', '=', uid)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
