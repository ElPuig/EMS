<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_justification_reason_form">
            <field name="name">ems.attendance_justification_reason.form</field>
            <field name="model">ems.attendance_justification_reason</field>
            <field name="arch" type="xml">
                <form string="Justification reason">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="requires_details"/>
                            <field name="full_day"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
