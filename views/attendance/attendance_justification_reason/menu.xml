<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.actions.act_window" id="action_attendance_justification_reason_list">
            <field name="name">Justification reasons</field>
            <field name="res_model">ems.attendance_justification_reason</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Issue #795: the reasons a tutor picks from when justifying absences, in a section of
             their own; maintained by the EMS administrator and the Heads of Studies, like the
             convalidation refusal reasons. -->
        <menuitem name="Justifications" sequence="2" id="menu_attendance_config_justifications"
                  parent="menu_attendance_config" groups="ems.group_academic_admin,ems.group_head_of_studies"/>
        <menuitem name="Reasons" sequence="1" id="menu_attendance_justification_reasons"
                  parent="menu_attendance_config_justifications" action="action_attendance_justification_reason_list"
                  groups="ems.group_academic_admin,ems.group_head_of_studies"/>
    </data>
</odoo>
