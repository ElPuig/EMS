<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="mail.template" id="template_attendance_notification_line_email" >
            <field name="name">Email notification: student attendance</field>
            <field name="model_id" ref="ems.model_ems_attendance_notification_line"/>
            <field name="subject">Student attendance notification: {{object.student_id.display_name}}</field>
            <field name="auto_delete" eval="True"/>             
            <field name="email_bcc">{{object.send_to}}</field> 
            <field name="email_from">ems@elpuig.xeill.net</field>
            <field name="reply_to">{{object.tutor_id.email}}</field>

            <field name="body_html">
                <![CDATA[
                    <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;">
                        <p>
                            Dear family,
                        </p>
                        <p>
                            This is an automated email, in order to inform you about an attendance status:
                            <ul>
                                <li><strong>Student:</strong> <t t-out="object.student_id.display_name"/></li>
                                <li><strong>Session:</strong> <t t-out="object.attendance_notification_id.attendance_session_id.display_name"/></li>
                                <li><strong>Status:</strong> <t t-out="object.status"/></li>
                            </ul>                        
                        </p>

                        <p>If you need further information, you can contact with <t t-out="object.tutor_id.display_name"/> just replaying to this email.</p>                                                
                        
                        <br/>
                        <p>
                            Kind regards,<br>
                            <t t-out="object.create_uid.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>

    </data>
</odoo>