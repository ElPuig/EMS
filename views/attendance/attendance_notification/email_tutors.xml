<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="mail.template" id="template_attendance_notification_email" >
            <field name="name">Email notification for tutors: student attendance</field>
            <field name="model_id" ref="ems.model_ems_attendance_notification"/>
            <field name="subject">Session attendance notification: {{object.attendance_session_id.display_name}}</field>
            <field name="auto_delete" eval="True"/>             
            <field name="email_to">{{object.tutor_id.email}}</field> 
            <field name="email_from">ems@elpuig.xeill.net</field>
            <!-- TODO: setup reply / bounce email on settings for this purpouses? -->
            <!-- <field name="reply_to">{{object.tutor_id.email}}</field> -->

            <field name="body_html">
                <![CDATA[
                    <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;">
                        <p>
                            Dear tutor,
                        </p>
                        <p>
                            This is an automated email, in order to inform you about some attendance status:
                            <ul>
                                <li><strong>Date:</strong> <span t-field="object.attendance_session_id.weekday"/>, <t t-out="object.attendance_session_id.date"/> from <span t-field="object.attendance_session_id.start_time" t-options="{'widget': 'float_time'}"/> to <span t-field="object.attendance_session_id.end_time" t-options="{'widget': 'float_time'}"/></li>                                
                                <li><strong>Session:</strong> <span t-field="object.attendance_session_id.attendance_schedule_id.attendance_template_id"/></li>
                                <li>
                                    <strong>Students and statuses:</strong>
                                    <ul>
                                        <t t-foreach="object.attendance_notification_line_ids" t-as="line">
                                            <li>
                                                <span t-field="line.student_id"/> | <i><span t-field="line.status"/></i>
                                                <t t-if="line.notes">
                                                    | <span t-field="line.notes"/>
                                                </t>
                                            </li>
                                        </t>
                                    </ul>
                                </li>
                            </ul>
                        </p>                        
                        <p>
                            Kind regards,<br>
                            <t t-out="object.create_uid.company_id.name"/>
                        </p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>