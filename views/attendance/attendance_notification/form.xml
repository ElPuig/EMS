<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_notification_form">
            <field name="name">ems.attendance_notification.form</field>
            <field name="model">ems.attendance_notification</field>
            <field name="arch" type="xml">
                <form string="notification">                    
                    <sheet>     
                         <group string="Main data" col="4">                                                        
                            <group>
                                <field name="student_id"  widget="many2one_avatar" />
                            </group>                         
                            <group colspan="2">
                                <field name="attendance_session_id" />
                            </group>         
                            <group>
                                <field name="status"/>
                            </group>      
                            <group>
                                <field name="tutor_id"  widget="many2one_avatar" />
                            </group>                                         
                            <group colspan="2">
                                <field name="create_date" />
                            </group>
                            <group >
                                <field name="sent_date" readonly="True" />
                            </group>                             
                        </group>
                    </sheet>	
                </form>              
            </field>			
        </record>
    </data>
</odoo>