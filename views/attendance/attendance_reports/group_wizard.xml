<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_report_group_wizard">
            <field name="name">ems.attendance_report_group.wizard</field>
            <field name="model">ems.attendance_report_group_wizard</field>
            <field name="arch" type="xml">
                <form string="Session">
                    <group col="2">
                        <group>
                            <field name="group_id" domain="[('id','in', allowed_group_ids)]" />
                        </group>
                        <group>
                            <field name="tutor_id" />
                        </group>
                        <group>
                            <field name="from_date" />
                        </group>
                        <group>
                            <field name="to_date" />
                        </group>
                    </group>

                    <footer>
                        <button name="print" string="Print" type="object" class="btn-primary" icon="fa-print" />
                        <button name="cancel" string="Cancel" special="cancel"/>
                    </footer>
                </form>              
            </field>			
        </record>
    </data>
</odoo>