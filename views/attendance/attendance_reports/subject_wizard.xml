<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_report_subject_wizard">
            <field name="name">ems.attendance_report_subject.wizard</field>
            <field name="model">ems.attendance_report_subject_wizard</field>
            <field name="arch" type="xml">
                <form string="Session">
                    <group col="2">
                        <group colspan="2">
                            <field name="subject_id" domain="[('id','in', allowed_subject_ids)]" />
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags" domain="[('id','in', allowed_group_ids)]" />
                        </group>
                        <group>
                            <field name="tutor_ids" widget="many2many_tags" readonly="1" />
                        </group>
                        <group>
                            <field name="detail_status_ids" widget="many2many_tags" />
                        </group>
                        <group>
                            <field name="include_strikes" />
                        </group>
                        <group>
                            <field name="from_date" />
                        </group>
                        <group>
                            <field name="to_date" />
                        </group>
                    </group>

                    <footer>
                        <button name="print" string="Print" type="object" class="btn-primary" icon="fa-print" />
                        <button name="cancel" string="Cancel" special="cancel"/>
                    </footer>
                </form>              
            </field>			
        </record>
    </data>
</odoo>