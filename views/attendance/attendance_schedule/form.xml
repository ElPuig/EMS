<odoo>
    <data>    
        <record model="ir.ui.view" id="view_attendance_schedule_form">
            <field name="name">ems.attendance_schedule.form</field>
            <field name="model">ems.attendance_schedule</field>
            <field name="arch" type="xml">
                <form string="Schedule">
                    <header>
                        <!-- Admin-only repair tool (issue #534): the list always follows the students'
                             enrollments (custom schedules included), so rebuilding it from them can
                             only put it back in line. -->
                        <button string="Reload students"
                            name="reload_students"
                            type="object"
                            icon="fa-refresh"
                            confirm="The student list will be rebuilt from the students' current enrollments, custom schedules included. Do you wish to continue?"
                            invisible="not id"
                            groups="ems.group_academic_admin"
                        />
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <field name="read_only_user" invisible="1"/>
                        <group string="Main data" col="6">
                            <group colspan="4">
                                <field name="attendance_template_id" readonly="True"/>
                            </group>
                            <group colspan="2">
                                <field name="space_id" readonly="True"/>
                            </group>

                            <group colspan="2">
                                <field name="start_date" readonly="True"/>
                            </group>
                            <group colspan="2">
                                <field name="end_date" readonly="True"/>
                            </group>

                            <group colspan="2">
                                <field name="weekday" readonly="True"/>
                            </group>
                           
                        </group>

                        <notebook>
                            <page string="Students">
                                <!-- Read-only for everybody (issue #534): who attends a session comes from
                                     their enrollments - a custom schedule on the student's form for anything
                                     else. A one-off change for a single day is made on that day's roll-call. -->
                                <field name="student_ids" widget="many2many" readonly="1">
                                    <list default_order="name asc">
                                        <field name="image_1920" widget="image" />
                                        <field name="name" class="align-middle"/>
                                        <field name="student_email" class="align-middle"/>
                                        <field name="main_group_id" class="align-middle"/>
                                        <field name="tutor_id" class="align-middle"/>
                                        <!-- Needed to open as fullscreen form -->
                                        <field name="id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Sessions" invisible="1">
                                <field name="attendance_session_ids" string="" readonly="True"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record> 
    </data>
</odoo>