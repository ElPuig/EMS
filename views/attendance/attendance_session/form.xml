<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_session_form">
            <field name="name">ems.attendance_session_header.form</field>
            <field name="model">ems.attendance_session_header</field>
            <field name="arch" type="xml">
                <form string="Session" create="0" duplicate="0">
                    <sheet>
                        <group string="Main data" col="4">
                            <group>
                                <field name="mode" readonly="True"/>
                            </group>

                            <group colspan="3">
                                <field name="attendance_schedule_id" readonly="True"/>
                            </group>

                            <group>
                                <field name="date" readonly="True"/>
                            </group>

                            <group>
                                <field name="session_teacher_id" string="Teacher" readonly="True" widget="many2one_avatar_employee"/>
                            </group>

                            <group>
                                <field name="template_teacher_ids" string="Holder" readonly="True" invisible="mode != 'guard' and not user_is_admin" widget="many2many_avatar_employee"/>
                            </group>

                            <group>
                                <field name="space_id" readonly="True"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Statuses">
                                <field name="attendance_session_line_ids" widget="one2many_list">
                                    <list default_order="student_id asc" editable="bottom" create="0" delete="0">
                                        <field name="image_1920" widget="image" readonly="True"/>
                                        <field name="student_id" width="175px" class="align-middle" readonly="True"/>
                                        <field name="status_id" widget="radio" class="align-middle" options="{'horizontal': true}" readonly="True"/>
                                        <field name="notes" width="350px" class="align-middle" readonly="True"/>
                                        <field name="attendance_justification_id" readonly="True"/>
                                        <field name="strike_count" class="align-middle text-center" readonly="True"/>
                                        <button name="action_view_strikes" type="object" icon="fa-exclamation-triangle"
                                                title="View strikes" invisible="strike_count == 0"/>
                                        <field name="attendance_prevision_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" readonly="True"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
