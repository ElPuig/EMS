<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_session_list">
            <field name="name">ems.attendance_session_header.list</field>
            <field name="model">ems.attendance_session_header</field>
            <field name="arch" type="xml">
                <list default_order="date desc, start_time desc" duplicate="0">      
                    <field name="date" width="125px"/>                    
                    <field name="session_teacher_id" string="Teacher" widget="many2one_avatar_employee" width="250px" />
                    <field name="template_teacher_id" string="Holder" widget="many2one_avatar_employee" width="250px" />
                    <field name="group_ids" widget="many2many_tags" width="125px"/>
                    <field name="subject_id"/>
                    <field name="weekday" width="125px"/>
                    <field name="start_time" widget="float_time" width="125px"/>
                    <field name="end_time" widget="float_time" width="125px"/>
                </list>
            </field>
        </record>   
    </data>
</odoo>