<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.actions.act_window" id="action_attendance_session_tree">
            <field name="name">Attendance session</field>
            <field name="res_model">ems.attendance_session_header</field>
            <!-- <field name="view_mode">list,form,calendar</field> -->
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_only_mine': 0}</field>
        </record>

        <record id="action_attendance_passlist" model="ir.actions.client">
            <field name="name">Current</field>
            <field name="tag">ems_attendance_session_view</field>
        </record>

        <menuitem name="Current" sequence="0" id="menu_attendance_passlist" parent="menu_attendance" action="action_attendance_passlist"/>
        <menuitem name="History" sequence="1" id="menu_attendance_sessions" parent="menu_attendance" action="action_attendance_session_tree"/>
    </data>
</odoo>