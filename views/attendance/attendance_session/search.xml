<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_session_search">
            <field name="name">ems.attendance_session_header.search</field>
            <field name="model">ems.attendance_session_header</field>            
            <field name="arch" type="xml">                  
                <search string="Only mine">
                    <field name="session_teacher_id" string="Teacher"/>
                    <filter string="Show only mine" name="only_mine" domain="['|', ('template_teacher_ids.user_id.id', '=', uid), ('session_teacher_id.user_id.id', '=', uid)]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>		      
        </record>   
    </data>
</odoo>