<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_template_form">
            <field name="name">ima.attendance_template.form</field>
            <field name="model">ems.attendance_template</field>
            <field name="arch" type="xml">
                <form string="Template" duplicate="0" create="0">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <group string="Main data" col="6">
                            <!-- This is needed to automatically display the 'archive' option within the cogmenu. -->
                            <field name="active" invisible="1"/>
                            <!-- Referenced by the 'or has_sessions' locks below - must be declared in the
                                 arch (even invisible) or readonly='...' expressions can't resolve it. -->
                            <field name="has_sessions" invisible="1"/>
                            <!-- Referenced by subject_id's own field-level domain (Python side) - must be
                                 declared here or that domain can't resolve it client-side. -->
                            <field name="allowed_subject_ids" invisible="1"/>

                            <!-- Row 1: Color, Teacher(s) - only 2 fields since 'level_id' was dropped
                                 entirely (2026-08-05, see plans/attendance_template_multi_study.md); each
                                 takes half the row instead of leaving an empty third slot. -->
                            <group colspan="2">
                                <field name="color" widget="color" class="ems_color_swatch" readonly="read_only_user"/>
                            </group>
                            <group colspan="4">
                                <field name="teacher_ids" widget="many2many_avatar_employee" readonly="not user_is_admin or has_sessions"/>
                            </group>

                            <!-- Row 2: Studies, Start date, End date -->
                            <group colspan="2">
                                <field name="study_ids" widget="many2many_tags" readonly="read_only_user or has_sessions"/>
                            </group>
                            <group colspan="2">
                                <!-- TODO: not working, check how its solven at justification form. -->
                                <field name="start_date" widget="daterange" class="oe_inline" options="{'related_end_date': 'end_date'}" readonly="read_only_user"/>
                            </group>
                            <group colspan="2">
                                <field name="end_date" widget="daterange" class="oe_inline" options="{'related_start_date': 'start_date'}" readonly="read_only_user"/>
                            </group>

                            <!-- Row 3: Groups, Space, Subject (must be accessible to every selected study) -->
                            <group colspan="2">
                                <field name="group_ids" widget="many2many_tags" readonly="read_only_user or has_sessions" domain="[('study_id', 'in', study_ids)]"/>
                            </group>
                            <group colspan="2">
                                <field name="space_id" readonly="read_only_user"/>
                            </group>
                            <group colspan="2">
                                <field name="subject_id" readonly="read_only_user or has_sessions"/>
                            </group>
                        </group>
                                            
                        <notebook>
                            <page string="Sessions">
                                <!-- 'student_ids' (moved here from the template, 2026-08-11 - see
                                     plans/calendar_driven_attendance_templates.md, point 1) is NOT an
                                     inline column here - a full class roster (25-30 students) doesn't
                                     fit a list row; open each line's own form (action_open_form) to
                                     manage its 'Students' tab instead. -->
                                <field name="attendance_schedule_ids" string="" context="{'default_space_id' : space_id, 'default_weekday' : '0'}" readonly="read_only_user">
                                    <list editable="bottom" default_order="weekday asc, start_time asc">
                                        <!-- Referenced by the 'or has_sessions' locks below - must be
                                             declared (even invisible) or readonly='...' can't resolve it. -->
                                        <field name="has_sessions" column_invisible="True"/>
                                        <field name="weekday" width="175px" readonly="has_sessions"/>
                                        <field name="space_id" readonly="has_sessions"/>
                                        <field name="start_time" widget="float_time" width="120px" readonly="has_sessions"/>
                                        <field name="end_time" widget="float_time" width="120px" readonly="has_sessions"/>
                                        <!-- The following fields are needed for internal compute. -->
                                        <field name="start_date" widget="timepicker" width="120px" column_invisible="True" />
                                        <field name="end_date" widget="timepicker" width="120px" column_invisible="True" />
                                        <button name="action_open_form" type="object" class="oe_stat_button"
                                            icon="fa-users" title="Students"
                                        />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
    </data>
</odoo>