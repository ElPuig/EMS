<odoo>
    <data>
        <record model="ir.ui.view" id="view_attendance_template_search">
            <field name="name">ems.attendance_template.search</field>
            <field name="model">ems.attendance_template</field>            
            <field name="arch" type="xml">                  
                <search string="Only mine">
                    <field name="teacher_ids"/>
                    <field name="subject_id"/>
                    <filter string="Show only mine" name="only_mine" domain="[('teacher_ids.user_id.id', '=', uid)]"/>
                </search>
            </field>		      
        </record>   
    </data>
</odoo>