<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- A real, statically-declared action (unlike an earlier version's dynamic
             ir.actions.server) — this is what gives the screen a proper "action-<xmlid>" URL
             instead of a raw "model/id" one. See models/attendance/guard_duty_board.py's own
             class docstring for the full reasoning. -->
        <record id="action_guard_duty_board" model="ir.actions.client">
            <field name="name">Guard schedule</field>
            <field name="tag">ems_guard_duty_board</field>
        </record>

        <!-- Teachers (every role above them included) and the Secretary only: Quality and
             Settings don't organise guards and can't read ems.group, which the board needs. -->
        <menuitem name="Guard schedule" sequence="7" id="menu_guard_duty_board" parent="hr_attendance.menu_hr_attendance_root" action="action_guard_duty_board" groups="ems.group_teacher,ems.group_secretary"/>
    </data>
</odoo>
