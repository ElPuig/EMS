<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #800: student walkout calls, opened and voted from the portal; read here by the
             tutors of the groups and the chain above them, and justified by the Head of Studies.
             Never created nor edited by hand: create="0" edit="0". -->
        <record id="view_student_walkout_list" model="ir.ui.view">
            <field name="name">ems.student_walkout.list</field>
            <field name="model">ems.student_walkout</field>
            <field name="arch" type="xml">
                <list string="Student walkouts" create="0" edit="0" delete="0"
                      decoration-muted="state in ('cancelled', 'rejected')" decoration-info="state in ('voting', 'joining')">
                    <field name="walkout_date"/>
                    <field name="group_id"/>
                    <field name="opener_id"/>
                    <field name="join_until" options="{'show_seconds': False}"/>
                    <field name="group_supports" widget="boolean" optional="show"/>
                    <field name="joining_count" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-info="state in ('voting', 'joining')" decoration-warning="state == 'closed'"
                           decoration-success="state == 'justified'" decoration-danger="state == 'rejected'"/>
                </list>
            </field>
        </record>

        <record id="view_student_walkout_form" model="ir.ui.view">
            <field name="name">ems.student_walkout.form</field>
            <field name="model">ems.student_walkout</field>
            <field name="arch" type="xml">
                <form string="Student walkout" create="0" edit="0" delete="0">
                    <header>
                        <div name="ems_actions" string="Actions">
                            <button name="action_open_reject_wizard" type="object" string="Abort the proposal" icon="fa-ban"
                                    invisible="not can_abort"/>
                            <button name="action_generate_justification" type="object" string="Validate and justify"
                                    icon="fa-check" invisible="not can_generate_justification"/>
                            <button name="action_open_reject_wizard" type="object" string="Do not validate" icon="fa-times"
                                    invisible="not can_reject or state != 'closed'"/>
                            <button name="action_open_reject_wizard" type="object" string="Undo the validation" icon="fa-undo"
                                    invisible="not can_reject or state != 'justified'"/>
                            <button name="action_open_justification" type="object" string="Open the justification"
                                    icon="fa-external-link" invisible="not justification_id"/>
                        </div>
                        <field name="state" widget="statusbar" statusbar_visible="voting,joining,closed,justified"/>
                        <field name="can_generate_justification" invisible="1"/>
                        <field name="can_abort" invisible="1"/>
                        <field name="can_reject" invisible="1"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <div class="alert alert-info" role="alert" invisible="state not in ('voting', 'joining')">
                            The group's tutor watches over the proposal: check the union's call and, only if it has a formal
                            defect, abort it giving a reason. Once closed, the Head of Studies validates it or not.
                        </div>
                        <group invisible="state != 'rejected'">
                            <field name="rejection_reason_id"/>
                            <field name="rejected_from_state"/>
                            <field name="rejection_details" invisible="not rejection_details"/>
                        </group>
                        <group>
                            <group>
                                <field name="group_ids" widget="many2many_tags"/>
                                <field name="opener_id"/>
                                <field name="walkout_date"/>
                                <field name="walkout_start" options="{'show_seconds': False}"/>
                                <field name="vote_start" options="{'show_seconds': False}"/>
                                <field name="vote_until" options="{'show_seconds': False}"/>
                                <field name="join_start" invisible="not join_start" options="{'show_seconds': False}"/>
                                <field name="join_until" invisible="not join_until" options="{'show_seconds': False}"/>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </group>
                            <group>
                                <field name="group_yes_count"/>
                                <field name="group_no_count"/>
                                <field name="group_abstain_count"/>
                                <field name="group_supports"/>
                                <field name="voted_count"/>
                                <field name="joining_count"/>
                                <field name="pdf_attachment_id" invisible="not pdf_attachment_id"/>
                                <field name="head_of_studies_id" invisible="not head_of_studies_id"/>
                                <field name="rejected_by_id" invisible="not rejected_by_id"/>
                                <field name="rejected_datetime" invisible="not rejected_datetime" options="{'show_seconds': False}"/>
                                <field name="justification_id" invisible="not justification_id"/>
                            </group>
                        </group>
                        <field name="notes" invisible="not notes" nolabel="1"/>
                        <notebook>
                            <page string="Students" name="students">
                                <field name="line_ids">
                                    <list>
                                        <field name="student_id"/>
                                        <field name="has_portal"/>
                                        <field name="voted"/>
                                        <field name="join_answered"/>
                                        <field name="joins"/>
                                        <field name="ratification" optional="show"/>
                                        <field name="justifiable" optional="show"/>
                                        <field name="vote_date" optional="hide"/>
                                        <field name="join_date" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_student_walkout_search" model="ir.ui.view">
            <field name="name">ems.student_walkout.search</field>
            <field name="model">ems.student_walkout</field>
            <field name="arch" type="xml">
                <search>
                    <field name="group_id"/>
                    <field name="opener_id"/>
                    <filter name="to_justify" string="To justify" domain="[('state', '=', 'closed'), ('justification_id', '=', False)]"/>
                    <filter name="voting" string="Voting or joining" domain="[('state', 'in', ('voting', 'joining'))]"/>
                    <separator/>
                    <filter name="not_cancelled" string="Not cancelled" domain="[('state', '!=', 'cancelled')]"/>
                    <group>
                        <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_student_walkout" model="ir.actions.act_window">
            <field name="name">Student walkouts</field>
            <field name="res_model">ems.student_walkout</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_not_cancelled': 1}</field>
            <field name="help" type="html">
                <p>No student walkout proposal yet.</p>
                <p>A group's delegate or sub-delegate proposes one from the portal; the group votes there.</p>
            </field>
        </record>

        <menuitem name="Student walkouts" sequence="4" id="menu_student_walkout" parent="menu_attendance"
                  action="action_student_walkout"/>
    </data>
</odoo>
