<odoo>
    <data>
        <record model="ir.ui.view" id="view_strike_form">
            <field name="name">ems.strike.form</field>
            <field name="model">ems.strike</field>
            <field name="arch" type="xml">
                <form string="Strike" create="0">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <group col="2">
                            <group>
                                <field name="student_id"/>
                                <field name="reason_id"/>
                                <field name="kicked_out"/>
                            </group>
                            <group>
                                <field name="teacher_id"/>
                                <field name="date"/>
                                <field name="send_to"/>
                            </group>
                        </group>
                        <group string="Details">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
    </data>
</odoo>
