<odoo>
    <data>
        <record model="ir.ui.view" id="view_strike_reason_list">
            <field name="name">ems.strike.reason.list</field>
            <field name="model">ems.strike.reason</field>
            <field name="arch" type="xml">
                <list default_order="sequence, name">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
