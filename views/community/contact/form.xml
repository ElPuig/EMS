<odoo>
    <data>
        <record model="ir.ui.view" id="view_contact_form">
            <field name="name">ems.contact.form</field>
            <field name="model">res.partner</field>            
            <field name="inherit_id" ref="base.view_partner_form"/> 
            <field name="arch" type="xml">  
                <xpath expr="//form" position="attributes">                      
                    <attribute name="js_class">studentpopup_expand_button</attribute>                    
                </xpath>     

                <xpath expr="//field[@name='name'][last()]" position="attributes">       
                    <attribute name="readonly">read_only_user</attribute>
                </xpath>   

                <xpath expr="//field[@name='image_1920']" position="attributes">       
                    <attribute name="readonly">read_only_user</attribute>
                </xpath>   

                <field name="vat" position="after">     
                    <field name="contact_type" invisible="True" />
                    <field name="read_only_user" invisible="True" />     
                    <field name="tz" invisible="contact_type not in ['student', 'provider']" />
                </field>

                <field name="vat" position="attributes">                    
                    <attribute name="invisible">True</attribute>            
                </field>   

                <field name="type" position="attributes">                    
                    <attribute name="readonly">contact_type == 'student'</attribute>
                </field>   

                <field name="company_type" position="attributes">
                    <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>

                <field name="parent_id" position="attributes">
                    <attribute name="invisible">contact_type != 'provider' or (((is_company and not parent_id) or company_name) and company_name != '')</attribute>
                </field>

                <field name="function" position="attributes">     
                     <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>

                <field name="website" position="attributes">     
                     <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>

                <field name="category_id" position="attributes">     
                     <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>
                              
                <field name="title" position="attributes">     
                     <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>                       

                <xpath expr="//page[@name='sales_purchases']" position="attributes">                     
                    <attribute name="invisible">contact_type != 'provider'</attribute>
                </xpath>

                <xpath expr="//page[@name='contact_addresses']" position="attributes">
                    <attribute name="autofocus">contact_type != 'student</attribute>
                </xpath>

                <!-- Only admins and tutors are allowed to see personal data -->
                <xpath expr="//form/sheet/group" position="attributes">                      
                    <attribute name="invisible">read_only_user</attribute>
                </xpath>   

                <xpath expr="//page[@name='contact_addresses']" position="inside">
                    <button name="action_open_relation_wizard" type="object"
                            string="Add contact" class="btn-primary mb-2"
                            invisible="contact_type != 'student' or read_only_user"/>
                    <field name="relation_all_ids"
                           invisible="contact_type != 'student'"
                           create="False"
                           context="{'default_this_partner_id': id, 'default_contact_type': 'family'}">
                        <list no_open="True">
                            <field name="type_selection_id" column_invisible="True"/>
                            <field name="other_partner_relation" readonly="True" string="Relation"/>
                            <field name="other_partner_id" readonly="True" string="Name"/>
                            <field name="other_partner_phone" readonly="True"/>
                            <field name="other_partner_mobile" readonly="True"/>
                            <field name="other_partner_email" readonly="True"/>
                        </list>
                    </field>
                </xpath>
        
                <xpath expr="//page[@name='contact_addresses']" position="before">
                    <page name="student" string="Student data" invisible="contact_type != 'student'" autofocus="contact_type == 'student">
                        <group cols="2">
                            <separator name="data" string="Main Data"/>
                            <group>
                                <field name="vat" invisible="read_only_user" />
                                <field name="document_id" invisible="read_only_user" />
                                <field name="passport_id" invisible="read_only_user" />
                                <field name="student_id" readonly="read_only_user" />
                                <field name="medical_id" invisible="read_only_user"  />                                                            
                                <field name="student_email" readonly="read_only_user" widget="email" />                               
                                <field name="car_plate" invisible="read_only_user"  />
                            </group>
                            <group>
                                <field name="is_adult" readonly="True" />
                                <field name="birth_date" readonly="read_only_user" />
                                <field name="birth_country_id" invisible="read_only_user"  />    
                                <field name="citizenship_id" invisible="read_only_user"  />                                
                            </group>                            

                            <separator name="data" string="Authorizations"/>
                            <group>
                                <field name="auth_image" readonly="read_only_user" />
                                <field name="auth_trip" readonly="read_only_user" />
                            </group>    
                            <group>
                                <field name="auth_healt" readonly="read_only_user" />
                                <field name="auth_share" readonly="read_only_user" />
                            </group>  
                        </group>                        
                    </page>
                </xpath>

                <xpath expr="//page[@name='sales_purchases']" position="after">                                         
                    <page name="studies" string="Studies" invisible="contact_type != 'student'">
                        <group cols="2">
                            <separator name="group" string="Group Data"/>
                            <group>
                                <field name="level_id" readonly="read_only_user" />
                                <field name="main_group_id" readonly="study_id == False or read_only_user" domain="[('study_id','=', study_id)]" />
                            </group>
                            <group>
                                <field name="study_id" readonly="level_id == False or read_only_user" domain="[('level_id','=', level_id)]" />
                                <field name="tutor_id" />
                            </group>

                            <separator name="enrollment" string="Enrollment Data"/>
                            <!-- TODO: a WIC section in order to add a link to the QBid's student data?  -->
                            <group>
                                <field name="wpi_enrolled" />
                            </group>
                            <field name="enrollment_ids" string="" context="{'default_group_id': main_group_id}" readonly="main_group_id == False or read_only_user">                            
                                <list editable="top" default_order="subject_id asc, group_id asc">
                                    <field name="subject_id" domain="[('id','not in', inuse_subject_ids)]"/>
                                    <field name="group_id" domain="[('study_id','=', parent.study_id)]"/>
                                    <field name="inuse_subject_ids" column_invisible="True"/>
                                </list>
                            </field>
                        </group>
                    </page>
                </xpath> 

                <!-- Hiding or setting up fields when the "add contact" button is used (same form). -->
                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="invisible">contact_type == 'student'</attribute>
                </xpath>

                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="context">
                        {
                            'default_parent_id': id,
                            'default_street': street, 
                            'default_street2': street2, 
                            'default_city': city, 
                            'default_state_id': state_id, 
                            'default_zip': zip, 
                            'default_country_id': country_id, 
                            'default_lang': lang, 
                            'default_user_id': user_id, 
                            'default_type': 'contact',                            
                            'default_contact_type': 'family' if contact_type == 'student' else 'provider'
                        }
                    </attribute>
                </xpath>                                                  

                <xpath expr="/form//form//field[@name='function']" position="after">
                    <field name="contact_type" invisible="True" />
                    <field name="family_relation" placeholder="e.g. Parent" invisible="contact_type != 'family'" />                    
                </xpath>  

                <xpath expr="/form//form//field[@name='type']" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath> 

                <xpath expr="/form//form/sheet/div" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath>
              
                <xpath expr="/form//form/sheet/hr" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath> 

                <xpath expr="/form//form//field[@name='name']" position="attributes">
                    <attribute name="placeholder"></attribute>
                </xpath>  

                <xpath expr="/form//form//field[@name='title']" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath>    

                <xpath expr="/form//form//field[@name='function']" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath>   
              
                <xpath expr="/form//form//label[@for='street']" position="attributes">
                    <attribute name="invisible">type in ['contact'] or contact_type == 'family'</attribute>
                </xpath>  

                <xpath expr="/form//form//group/group/div" position="attributes">
                    <attribute name="invisible">type in ['contact'] or contact_type == 'family'</attribute>
                </xpath> 

                <!-- Adding data to the kanban card -->
                <xpath expr="//kanban/templates//field[@name='function']" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath> 

                <xpath expr="//kanban/templates//field[@name='function']" position="after">
                    <field name="family_relation" invisible="contact_type != 'family'" />
                </xpath> 
            </field>		      
        </record>   
    </data>
</odoo>