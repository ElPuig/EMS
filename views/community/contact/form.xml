<odoo>
    <data>
        <record model="ir.ui.view" id="view_contact_form">
            <field name="name">ems.contact.form</field>
            <field name="model">res.partner</field>            
            <field name="inherit_id" ref="base.view_partner_form"/> 
            <field name="arch" type="xml">  
                <xpath expr="//form" position="attributes">
                    <attribute name="js_class">studentpopup_expand_button</attribute>
                </xpath>

                <!-- The native ribbon (base.view_partner_form) always says "Archived"; for a
                student it's clearer to say WHY they left - Alumni/Withdrawal/Expelled - via the
                shared 'ems_archived_reason_ribbon' field widget (archived_reason_label/_color,
                computed in contact.py). Non-student archived partners (family, provider,
                applicant) - or a student somehow archived with no matching reason - keep the
                native generic ribbon, which is why its own condition is simply "is there a
                specific label to show instead", not an explicit contact_type enumeration. -->
                <xpath expr="//widget[@name='web_ribbon']" position="attributes">
                    <attribute name="invisible">active or archived_reason_label</attribute>
                </xpath>
                <xpath expr="//widget[@name='web_ribbon']" position="after">
                    <!-- archived_reason_color must be declared as its own field, not just
                    referenced via the widget's "color_field" option - confirmed empirically
                    (2026-08-01) that this field registry's relatedFields mechanism only auto-
                    fetches for x2many/many2one_reference field types (see field.js), not a
                    plain Char like this one; without this every ribbon silently fell back to
                    the widget's default red regardless of the intended color. -->
                    <field name="archived_reason_color" invisible="1"/>
                    <field name="archived_reason_label" widget="ems_archived_reason_ribbon"
                           options="{'color_field': 'archived_reason_color'}"
                           invisible="active or not archived_reason_label"/>
                </xpath>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_strikes" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                            invisible="contact_type != 'student' or strike_count == 0">
                        <field name="strike_count" widget="statinfo" string="Strikes"/>
                    </button>
                </xpath>

                <xpath expr="//sheet" position="before">
                    <header>
                        <field name="google_ws_state" invisible="1"/>
                        <button name="action_create_google_account" type="object"
                                string="Create Google account"
                                class="btn-secondary"
                                invisible="google_ws_state != 'none'"
                                groups="ems.group_secretary,ems.group_academic_admin"/>
                        <button name="action_suspend_google_account" type="object"
                                string="Suspend Google account"
                                class="btn-secondary"
                                invisible="google_ws_state != 'active'"
                                groups="ems.group_secretary,ems.group_academic_admin"/>
                        <button name="action_reactivate_google_account" type="object"
                                string="Reactivate Google account"
                                class="btn-secondary"
                                invisible="google_ws_state != 'suspended'"
                                groups="ems.group_secretary,ems.group_academic_admin"/>
                    </header>
                </xpath>

                <xpath expr="//field[@name='name'][last()]" position="attributes">
                    <attribute name="readonly">read_only_user or is_tutor_readonly</attribute>
                </xpath>

                <xpath expr="//field[@name='image_1920']" position="attributes">       
                    <attribute name="readonly">read_only_user</attribute>
                </xpath>   

                <xpath expr="//label[@for='vat']" position="replace"/>
                <xpath expr="//field[@name='vat']" position="replace"/>

                <field name="type" position="before">
                    <field name="contact_type" invisible="True" />
                    <field name="read_only_user" invisible="True" />
                    <field name="is_tutor_readonly" invisible="True" />
                </field>

                <field name="type" position="attributes">
                    <attribute name="readonly">contact_type == 'student'</attribute>
                </field>   

                <field name="company_type" position="attributes">
                    <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>

                <field name="parent_id" position="attributes">
                    <attribute name="invisible">contact_type != 'provider' or (((is_company and not parent_id) or company_name) and company_name != '')</attribute>
                </field>

                <!-- For a student, "Email" alone is ambiguous with the institutional address
                     shown in the "Student data" tab (student_email). Hide the generic email
                     row and show two clearly-labeled ones instead: an editable "Personal
                     email" (the same underlying field, just relabeled) and a read-only
                     "Corporate email" mirroring student_email. Other contact types (family,
                     applicant, provider...) keep the plain "Email" field untouched. Developer
                     feedback (2026-09-05). -->
                <xpath expr="//label[@for='email']" position="attributes">
                    <attribute name="invisible">contact_type == 'student'</attribute>
                </xpath>

                <xpath expr="//label[@for='email']/following-sibling::div[1]" position="attributes">
                    <attribute name="invisible">contact_type == 'student'</attribute>
                </xpath>

                <xpath expr="//label[@for='email']/following-sibling::div[1]" position="after">
                    <field name="email" string="Personal email" widget="email"
                           context="{'gravatar_image': True}" required="user_ids"
                           invisible="contact_type != 'student'"/>
                    <field name="student_email" string="Corporate email" widget="email"
                           readonly="1" invisible="contact_type != 'student'"/>
                </xpath>

                <field name="function" position="attributes">     
                     <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>

                <field name="website" position="attributes">     
                     <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>

                <field name="category_id" position="attributes">     
                     <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>
                              
                <field name="title" position="attributes">     
                     <attribute name="invisible">contact_type != 'provider'</attribute>
                </field>                       

                <xpath expr="//page[@name='sales_purchases']" position="attributes">                     
                    <attribute name="invisible">contact_type != 'provider'</attribute>
                </xpath>

                <xpath expr="//page[@name='contact_addresses']" position="attributes">
                    <attribute name="autofocus">contact_type != 'student</attribute>
                </xpath>

                <!-- Only admins and tutors are allowed to see personal data -->
                <xpath expr="//form/sheet/group" position="attributes">                      
                    <attribute name="invisible">read_only_user</attribute>
                </xpath>   

                <xpath expr="//page[@name='contact_addresses']" position="inside">
                    <button name="action_open_relation_wizard" type="object"
                            string="Add contact" class="btn-primary mb-2"
                            invisible="contact_type != 'student' or read_only_user" />
                    <field name="relation_all_ids"
                           class="relation_all_list"
                           invisible="contact_type != 'student'"
                           create="False"
                           context="{'default_this_partner_id': id, 'default_contact_type': 'family'}" >
                        <list no_open="True" create="False" delete="False">
                            <field name="type_selection_id" column_invisible="True"/>
                            <field name="other_partner_relation" readonly="True" string="Relation"/>
                            <field name="other_partner_id" readonly="True" string="Name"/>
                            <field name="other_partner_phone" readonly="True"/>
                            <field name="other_partner_mobile" readonly="True"/>
                            <field name="other_partner_email" readonly="True"/>
                            <button name="unlink" type="object" icon="fa-trash" title="Delete relation"
                                    confirm="Are you sure you want to delete this relation? This action cannot be undone."/>
                        </list>
                    </field>
                    <field name="relation_all_ids"
                           class="relation_all_list"
                           invisible="contact_type != 'family'"
                           create="False"
                           context="{'default_this_partner_id': id, 'default_contact_type': 'student'}">
                        <list no_open="True" create="False" delete="False">
                            <field name="type_selection_id" column_invisible="True"/>
                            <field name="other_partner_relation_inverse" readonly="True" string="Relation"/>
                            <field name="other_partner_id" readonly="True" string="Student"/>
                            <field name="other_partner_phone" readonly="True"/>
                            <field name="other_partner_mobile" readonly="True"/>
                            <field name="other_partner_email" readonly="True"/>
                        </list>
                    </field>
                </xpath>
        
                <xpath expr="//page[@name='contact_addresses']" position="before">
                    <page name="student" string="Student data" invisible="contact_type != 'student'" autofocus="contact_type == 'student">
                        <group cols="2">
                            <separator name="data" string="Main Data"/>
                            <group>
                                <field name="document_id" invisible="read_only_user" />
                                <field name="passport_id" invisible="read_only_user" />
                                <field name="student_id" readonly="read_only_user or is_tutor_readonly" />
                                <field name="medical_id" invisible="read_only_user" />
                                <field name="nuss" invisible="read_only_user" />
                                <field name="student_email" readonly="read_only_user or is_tutor_readonly" widget="email" />
                                <field name="car_plate" invisible="read_only_user" />
                            </group>
                            <group>
                                <field name="is_adult" readonly="True" />
                                <field name="birth_date" readonly="read_only_user" />
                                <field name="birth_country_id" invisible="read_only_user" />
                                <field name="citizenship_id" invisible="read_only_user" />
                                <span class="o_form_label">Benefits</span>
                                <div class="o_row">
                                    <field name="benefit_status" invisible="1"/>
                                    <span class="badge text-bg-success" invisible="benefit_status != 'exemption'">Exemption</span>
                                    <span class="badge text-bg-info" invisible="benefit_status != 'bonification'">Bonification</span>
                                    <span class="badge text-bg-secondary" invisible="benefit_status != 'none'">None</span>
                                </div>
                                <!-- Special educational needs (NEE): benefits-like display.
                                     Editable dropdown for tutor/secretary/admin (of this
                                     student); read-only badge otherwise. Restricted to
                                     tutor/secretary/admin, off the portal. -->
                                <span class="o_form_label" groups="ems.group_tutor,ems.group_secretary,ems.group_academic_admin">Special educational needs</span>
                                <div class="o_row" groups="ems.group_tutor,ems.group_secretary,ems.group_academic_admin">
                                    <field name="special_needs" nolabel="1" placeholder="None"
                                           invisible="read_only_user"/>
                                    <span class="badge text-bg-danger" invisible="special_needs != 'nee_a' or not read_only_user">NEE-A</span>
                                    <span class="badge text-bg-warning" invisible="special_needs != 'nee_b' or not read_only_user">NEE-B</span>
                                    <span class="badge text-bg-secondary" invisible="special_needs or not read_only_user">None</span>
                                </div>
                            </group>

                            <separator name="data" string="Authorizations"/>
                            <group>
                                <span class="o_form_label">Image Rights</span>
                                <div class="o_row">
                                    <field name="auth_image" invisible="1"/>
                                    <span class="badge text-bg-success" invisible="auth_image == False">Yes</span>
                                    <span class="badge text-bg-secondary" invisible="auth_image == True">No</span>
                                </div>     
                                <span class="o_form_label">Scholar Trips</span>
                                <div class="o_row">
                                    <field name="auth_trip" invisible="1"/>
                                    <span class="badge text-bg-success" invisible="auth_trip == False">Yes</span>
                                    <span class="badge text-bg-secondary" invisible="auth_trip == True">No</span>
                                </div>
                            </group>    
                            <group>
                                <span class="o_form_label">Health Data</span>
                                <div class="o_row">
                                    <field name="auth_healt" invisible="1"/>
                                    <span class="badge text-bg-success" invisible="auth_healt == False">Yes</span>
                                    <span class="badge text-bg-secondary" invisible="auth_healt == True">No</span>
                                </div>
                                <span class="o_form_label" title="If marked, the student (even if adult) allows to share its educational information with its family.">Share with family</span>
                                <div class="o_row">
                                    <field name="auth_share" invisible="1"/>
                                    <span class="badge text-bg-success" invisible="auth_share == False">Yes</span>
                                    <span class="badge text-bg-secondary" invisible="auth_share == True">No</span>
                                </div>
                            </group>


                        </group>                        
                    </page>
                </xpath>

                <xpath expr="//page[@name='sales_purchases']" position="after">                                         
                    <page name="studies" string="Studies" invisible="contact_type != 'student'">
                        <group cols="2">
                            <separator name="group" string="Group Data"/>
                            <group>
                                <field name="level_id" readonly="read_only_user or is_tutor_readonly" />
                                <!-- Issue #395: a tutor CAN change their tutorand's main group (e.g. moving the
                                     student from group A to group B) - the ORM already allows it
                                     (rule_contact_tutor); 'is_tutor_readonly' deliberately excluded here, unlike
                                     every other tutor-locked field on this page. study_id (still tutor-readonly)
                                     keeps the domain scoped to the student's own study, so a tutor can never move
                                     a student across studies, only between groups of the same one. Changing this
                                     field cascades the student's subject enrollments from the old group to the
                                     new one - see res.partner.write()/_migrate_enrollments_on_group_change and
                                     ems.enrollment._ems_move_group. -->
                                <field name="main_group_id" readonly="study_id == False or read_only_user" domain="[('study_id','=', study_id)]" />
                            </group>
                            <group>
                                <field name="study_id" readonly="level_id == False or read_only_user or is_tutor_readonly" domain="[('level_id','=', level_id)]" />
                                <!-- readonly="is_tutor_readonly" dropped 2026-09-06: the field itself is
                                     now readonly=True at the model level (see contact.py) - genuinely
                                     always read-only, not just conditionally for tutors. -->
                                <field name="tutor_id" />
                            </group>

                            <separator name="enrollment" string="Enrollment Data"/>
                            <!-- Issue #395: warns before the fact - main_group_id has already been changed
                                 on screen but not saved yet - that saving will move this student's subject
                                 enrollments from the old group to the new one (see
                                 res.partner._compute_main_group_pending_change). -->
                            <div class="alert alert-warning mb-2" role="alert" colspan="2"
                                 invisible="not main_group_pending_change">
                                Saving will move every subject this student is enrolled in through the current group to the new group. Subjects already enrolled through a different group will stay unchanged.
                            </div>
                            <!-- TODO: a WIC section in order to add a link to the QBid's student data?  -->
                            <group>
                                <!-- Bug found 2026-09-06: missing 'read_only_user' meant a teacher who is
                                     NOT this student's own tutor (is_tutor_readonly is False for them too -
                                     it only locks the field for the ACTUAL tutor-of-record) saw this field
                                     as editable, unlike every sibling field in this tab/page, all of which
                                     combine both conditions. The record rules already block the write
                                     server-side either way, but the field looked editable when it wasn't. -->
                                <field name="wpi_enrolled" readonly="read_only_user or is_tutor_readonly" />
                            </group>
                            <field name="enrollment_ids" string="" context="{'default_group_id': main_group_id}" readonly="main_group_id == False or read_only_user or is_tutor_readonly">                            
                                <list editable="top" default_order="subject_id asc, group_id asc">
                                    <field name="subject_id" domain="[('id','not in', inuse_subject_ids)]"/>
                                    <field name="group_id" domain="['|', ('study_id','=', parent.study_id), ('group_type','=','reinforcement')]"/>
                                    <field name="inuse_subject_ids" column_invisible="True"/>
                                </list>
                            </field>
                        </group>
                    </page>
                    <page name="secretary" string="Secretary" invisible="contact_type != 'student'">
                        <group>
                            <separator string="Bonifications &amp; Exemptions" colspan="2"/>
                            <field name="benefit_ids" nolabel="1" colspan="2" readonly="read_only_user or is_tutor_readonly">
                                <list editable="bottom" decoration-info="category == 'bonification'" decoration-success="category == 'exemption'">
                                    <field name="benefit_type"/>
                                    <field name="category" optional="show"/>
                                    <field name="document" filename="document_name" widget="binary"/>
                                    <field name="document_name" column_invisible="1"/>
                                    <field name="renewal_date" widget="remaining_days"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Enrollment Authorizations" colspan="2"/>
                            <field name="ems_authorization_ids" nolabel="1" colspan="2" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="template_id" string="Authorization"/>
                                    <field name="course_id" string="Enrollment / Year"/>
                                    <field name="status" 
                                            decoration-danger="status == 'no'" 
                                            decoration-success="status == 'yes'" 
                                            decoration-warning="status == 'pending'"/>
                                    <field name="response_date"/>
                                    <field name="signed_document" filename="signed_document_name" widget="binary"/>
                                    <field name="signed_document_name" column_invisible="1"/>
                                </list>
                            </field>
                        </group>
                    </page>
                    <page name="documentation" string="Documentation" invisible="contact_type != 'student'"
                          groups="ems.group_academic_admin,ems.group_secretary">
                        <field name="document_ids" nolabel="1"
                               context="{'default_partner_id': id}">
                            <list create="0" delete="0"
                                  decoration-warning="status == 'pending'"
                                  decoration-success="status == 'approved'"
                                  decoration-danger="status == 'rejected'"
                                  decoration-muted="status == 'cancelled'">
                                <field name="doc_type"/>
                                <field name="doc_file_link" string="File"/>
                                <field name="expiry_date" widget="remaining_days"/>
                                <field name="upload_date"/>
                                <field name="status"/>
                                <field name="review_uid" optional="hide"/>
                                <field name="rejection_reason" optional="hide"/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <!-- Applicant data (pre-enrollment intake). Placed first so it is the
                     default open page for applicants; for students it is invisible and the
                     notebook falls through to "Student data". -->
                <xpath expr="//page[@name='student']" position="before">
                    <page name="applicant" string="Applicant data"
                          invisible="contact_type != 'applicant'">
                        <group cols="2">
                            <group string="Pre-enrollment">
                                <field name="study_id" required="contact_type == 'applicant'"/>
                                <field name="preinscription_shift" required="contact_type == 'applicant'"/>
                                <field name="preinscription_course"/>
                                <field name="student_id" required="contact_type == 'applicant'"/>
                                <!-- Plain field so it matches its neighbours; ORM groups keep
                                     it staff-only and off the portal. -->
                                <field name="special_needs" readonly="read_only_user or is_tutor_readonly"/>
                            </group>
                            <group string="Personal data">
                                <field name="email" widget="email" required="contact_type == 'applicant'"/>
                                <field name="document_id"/>
                                <field name="birth_date"/>
                                <field name="phone"/>
                                <field name="mobile"/>
                            </group>
                        </group>
                    </page>
                </xpath>

                <!-- Former student data (alumni / withdrawals / expelled). The active-student
                     pages hide themselves via invisible="contact_type != 'student'". -->
                <xpath expr="//page[@name='documentation']" position="after">
                    <page name="former_student" string="Former student"
                          invisible="contact_type not in ['alumni', 'withdrawal', 'expelled']">
                        <group cols="2">
                            <group>
                                <field name="exit_type"/>
                                <field name="exit_course_id"/>
                                <field name="exit_date"/>
                            </group>
                            <group>
                                <!-- Readonly on purpose (D2): the mark is permanent and is
                                     only ever written by the graduation wizard, which checks
                                     the student really is in the last course of its study. -->
                                <field name="has_graduated" readonly="1"/>
                            </group>
                            <field name="exit_reason"/>
                        </group>
                    </page>
                    <!-- Frozen per-course academic history (ems.student.year_record):
                         unlike the operational pages above, it stays visible for
                         alumni/withdrawals/expelled — it is their permanent record. -->
                    <page name="academic_history" string="Academic history"
                          invisible="contact_type not in ['student', 'alumni', 'withdrawal', 'expelled']">
                        <field name="year_record_ids" readonly="1">
                            <list default_order="study_name asc, course_id asc">
                                <field name="course_id"/>
                                <field name="study_name"/>
                                <field name="group_name"/>
                                <field name="tutor_name" optional="hide"/>
                                <field name="academic_result" widget="badge"
                                       decoration-success="academic_result == 'full'"
                                       decoration-warning="academic_result in ['partial', 'repeating']"
                                       decoration-danger="academic_result == 'withdrawn'"/>
                                <field name="title_obtained"/>
                                <field name="subject_count"/>
                                <field name="attendance_rate" optional="show"/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <!-- Hiding or setting up fields when the "add contact" button is used (same form). -->
                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="invisible">contact_type in ['student', 'family']</attribute>
                </xpath>

                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="context">
                        {
                            'default_parent_id': id,
                            'default_street': street, 
                            'default_street2': street2, 
                            'default_city': city, 
                            'default_state_id': state_id, 
                            'default_zip': zip, 
                            'default_country_id': country_id, 
                            'default_lang': lang, 
                            'default_user_id': user_id, 
                            'default_type': 'contact',                            
                            'default_contact_type': 'family' if contact_type == 'student' else 'provider'
                        }
                    </attribute>
                </xpath>                                                  

                <xpath expr="/form//form//field[@name='function']" position="after">
                    <field name="contact_type" invisible="True" />
                    <field name="family_relation" placeholder="e.g. Parent" invisible="contact_type != 'family'" />                    
                </xpath>  

                <xpath expr="/form//form//field[@name='type']" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath> 

                <xpath expr="/form//form/sheet/div" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath>
              
                <xpath expr="/form//form/sheet/hr" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath> 

                <xpath expr="/form//form//field[@name='name']" position="attributes">
                    <attribute name="placeholder"></attribute>
                </xpath>  

                <xpath expr="/form//form//field[@name='title']" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath>    

                <xpath expr="/form//form//field[@name='function']" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath>   
              
                <xpath expr="/form//form//label[@for='street']" position="attributes">
                    <attribute name="invisible">type in ['contact'] or contact_type == 'family'</attribute>
                </xpath>  

                <xpath expr="/form//form//group/group/div" position="attributes">
                    <attribute name="invisible">type in ['contact'] or contact_type == 'family'</attribute>
                </xpath> 

                <!-- Adding data to the kanban card -->
                <xpath expr="//kanban/templates//field[@name='function']" position="attributes">
                    <attribute name="invisible">contact_type == 'family'</attribute>
                </xpath> 

                <xpath expr="//kanban/templates//field[@name='function']" position="after">
                    <field name="family_relation" invisible="contact_type != 'family'" />
                </xpath> 
            </field>		      
        </record>
        <record id="view_partner_form_ems_cleanup_final" model="ir.ui.view">
            <field name="name">res.partner.form.ems.cleanup.final</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority">100</field>
            <field name="arch" type="xml">

                <xpath expr="//button[@name='action_view_sale_order']" position="attributes">
                    <attribute name="groups">base.group_no_one</attribute>
                </xpath>

                <xpath expr="//button[@name='action_view_partner_invoices']" position="attributes">
                    <attribute name="groups">base.group_no_one</attribute>
                </xpath>

            </field>
        </record>
        <!-- Billing tab: hide unused groups, full-width bank accounts, secretary access -->
        <record model="ir.ui.view" id="view_partner_billing_tab_cleanup">
            <field name="name">ems.res.partner.property.form.billing_cleanup</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='accounting']" position="attributes">
                    <attribute name="groups">account.group_account_invoice,account.group_account_readonly,ems.group_academic_admin,ems.group_secretary</attribute>
                </xpath>
                <xpath expr="//group[@name='banks']" position="attributes">
                    <attribute name="colspan">2</attribute>
                    <attribute name="groups">account.group_account_invoice,account.group_account_readonly,ems.group_academic_admin,ems.group_secretary</attribute>
                </xpath>
                <xpath expr="//group[@id='invoice_send_settings']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='accounting_automation']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Show acc_holder_name, hide bank_id and allow_out_payment in billing tab -->
        <record model="ir.ui.view" id="view_partner_bank_acc_holder_visible">
            <field name="name">ems.res.partner.property.form.bank_acc_holder</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bank_ids']//field[@name='acc_holder_name']" position="attributes">
                    <attribute name="column_invisible">False</attribute>
                </xpath>
                <xpath expr="//field[@name='bank_ids']//field[@name='bank_id']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
                <xpath expr="//field[@name='bank_ids']//field[@name='allow_out_payment']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
            </field>
        </record>

        <!-- In the bank account form: show acc_holder_name instead of partner_id as main titular -->
        <record model="ir.ui.view" id="view_partner_bank_form_acc_holder">
            <field name="name">ems.res.partner.bank.form.acc_holder</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="base.view_partner_bank_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="replace">
                    <field name="acc_holder_name"/>
                    <field name="partner_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="view_contact_form_firstname">
            <field name="name">ems.contact.form.firstname</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="partner_firstname.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='firstname']" position="attributes">
                    <attribute name="readonly">read_only_user</attribute>
                </xpath>

                <!-- partner_firstname.view_partner_form renders "lastname" twice (order
                     depends on the partner_names_order system parameter, only one is
                     visible at a time) - both occurrences need the attribute, since an
                     xpath expr only ever matches the first node found. -->
                <xpath expr="//field[@name='lastname'][1]" position="attributes">
                    <attribute name="readonly">read_only_user</attribute>
                </xpath>

                <xpath expr="//field[@name='lastname'][2]" position="attributes">
                    <attribute name="readonly">read_only_user</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>