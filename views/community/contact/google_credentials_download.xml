<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Cog-wheel / "Actions" entry on both the students list and a student's own form
             (issue #478, extended to the form by #482): one ZIP with the selected students'
             Google credentials PDFs. Tutors and the chiefs above them only get those tutors'
             students' (rule_ems_student_document_tutor, via tutor_scope_user_ids), TAC
             everyone's (rule_ems_student_document_tac). -->
        <record id="action_google_credentials_download_bulk" model="ir.actions.server">
            <field name="name">Download Google credentials</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">list,form</field>
            <field name="groups_id" eval="[(4, ref('ems.group_academic_admin')), (4, ref('ems.group_secretary')), (4, ref('ems.group_tutor')), (4, ref('ems.group_tac'))]"/>
            <field name="state">code</field>
            <field name="code">
action = env['res.partner'].browse(env.context.get('active_ids', [])).action_download_google_credentials()
            </field>
        </record>
    </data>
</odoo>
