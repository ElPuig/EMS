<odoo>
    <data>
        <record model="ir.ui.view" id="view_contact_kanban">
            <field name="name">ems.contact.kanban</field>
            <field name="model">res.partner</field>           
            <field name="inherit_id" ref="base.res_partner_kanban_view"/> 
            <field name="arch" type="xml">  
                <xpath expr="//kanban" position="inside">
                    <!-- Required fields, must be loaded in order to use them. -->
                    <field name="main_group_id"/>
                    <field name="tutor_id"/>
                    <field name="student_email"/>
                </xpath>
                
                <xpath expr="//field[@name='email']" position="replace">
                    <field t-if="record.student_email.raw_value" name="student_email" class="text-truncate" />
                    <field t-else="" name="email" class="text-truncate" />
                </xpath>

                <xpath expr="//field[@name='category_id'][@widget='many2many_tags']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <!-- Same reason-aware ribbon as the form (see form.xml's own comment): the
                native ribbon (already declared by base.res_partner_kanban_view, 'active' field
                included) only covers "archived with no specific reason to show". -->
                <xpath expr="//widget[@name='web_ribbon']" position="attributes">
                    <attribute name="invisible">active or archived_reason_label</attribute>
                </xpath>
                <xpath expr="//widget[@name='web_ribbon']" position="after">
                    <!-- Must be its own declared field, not just referenced via the widget's
                    "color_field" option - see contact/form.xml's own comment on this. -->
                    <field name="archived_reason_color" invisible="1"/>
                    <field name="archived_reason_label" widget="ems_archived_reason_ribbon"
                           options="{'color_field': 'archived_reason_color'}"
                           invisible="active or not archived_reason_label"/>
                </xpath>

                <xpath expr="//kanban//main/footer" position="before">
                    <span class="text-truncate" t-if="record.main_group_id.raw_value > 0">
                        <div class="ems-kanban-label">
                            Group: <span><field name="main_group_id"/></span>
                        </div> 
                    </span>    
                    
                    <!-- <field name="main_group_id" invisible="context.get('default_contact_type') != 'student'" /> -->
                    <span class="text-truncate" t-if="record.tutor_id.raw_value > 0">
                        <div class="ems-kanban-label">
                            Tutor: <span><field name="tutor_id"/></span>
                        </div> 
                    </span>    
                </xpath>
            </field>
        </record>
        <record id="res_partner_kanban_view_ems_cleanup" model="ir.ui.view">
            <field name="name">res.partner.kanban.ems.cleanup</field>
            <field name="model">res.partner</field>
            
            <field name="inherit_id" ref="base.res_partner_kanban_view"/>
            
            <field name="priority">100</field> 
            
            <field name="arch" type="xml">
                <xpath expr="//*[@name='action_view_sale_order']" position="replace">
                    </xpath>
            </field>
        </record>
    </data>
</odoo>