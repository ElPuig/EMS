<odoo>
    <data>
        <record model="ir.ui.view" id="view_contact_list">
            <field name="name">ems.contact.list</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="js_class">student_list</attribute>
                </xpath>

                <!-- Not shown as a column, only read: StudentListController needs it per-record
                     to decide whether archiving can skip the generic confirmation dialog. -->
                <xpath expr="//field[@name='complete_name']" position="before">
                    <field name="contact_type" column_invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='complete_name']" position="after">
                    <field name="document_id" optional="show"/>
                    <field name="birth_date" optional="show" column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="is_adult" optional="show" widget="boolean_toggle" readonly="1"
                           column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="nuss" optional="show" column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="citizenship_id" optional="show" column_invisible="context.get('default_contact_type') != 'student'"/>
                </xpath>

                <xpath expr="//field[@name='email']" position="after">
                    <field name="student_email" optional="show" column_invisible="context.get('default_contact_type') != 'student'"/>
                    <!-- Google account lifecycle (#388): hidden by default and restricted
                         to the roles that manage those accounts. Shown on demand next to
                         the matching search filters, so a pending suspension/deletion can
                         be sorted by date. -->
                    <field name="google_ws_deactivation_date" optional="hide"
                           column_invisible="context.get('default_contact_type') != 'student'"
                           groups="ems.group_secretary,ems.group_academic_admin"/>
                    <field name="google_ws_deletion_date" optional="hide"
                           column_invisible="context.get('default_contact_type') != 'student'"
                           groups="ems.group_secretary,ems.group_academic_admin"/>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <xpath expr="//field[@name='email']" position="attributes">
                    <attribute name="column_invisible">context.get('default_contact_type') == 'student'</attribute>
                </xpath>

                <xpath expr="//field[@name='phone']" position="attributes">
                    <!-- TODO: tutors or admins should be able, why does not work even if I add the field? -->
                    <attribute name="optional">show</attribute>
                </xpath>

                <xpath expr="//field[@name='mobile']" position="attributes">
                    <attribute name="column_invisible">context.get('default_contact_type') == 'student'</attribute>
                </xpath>

                <xpath expr="//field[@name='street']" position="attributes">
                    <attribute name="optional">show</attribute>
                    <attribute name="column_invisible">context.get('default_contact_type') != 'student'</attribute>
                </xpath>

                <xpath expr="//field[@name='street']" position="after">
                    <field name="zip" optional="show" column_invisible="context.get('default_contact_type') != 'student'"/>
                </xpath>

                <xpath expr="//field[@name='city']" position="attributes">
                    <attribute name="column_invisible">context.get('default_contact_type') != 'student'</attribute>
                </xpath>

                <xpath expr="//field[@name='country_id']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <xpath expr="//field[@name='state_id']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_sending_method']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_edi_format']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <xpath expr="//field[@name='category_id']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <xpath expr="//field[@name='activity_ids']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>

                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="main_group_id" optional="show" column_invisible="context.get('default_contact_type') != 'student'"/>
                </xpath>

                <xpath expr="//field[@name='main_group_id']" position="after">
                    <field name="tutor_id" optional="show" column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="special_needs" optional="show"
                           decoration-danger="special_needs == 'nee_a'"
                           decoration-warning="special_needs == 'nee_b'"
                           column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="exit_type" optional="hide" column_invisible="1"/>
                    <field name="exit_course_id" optional="hide" column_invisible="1"/>
                    <field name="auth_image" optional="show" widget="boolean_toggle" readonly="1"
                           column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="auth_trip" optional="show" widget="boolean_toggle" readonly="1"
                           column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="auth_healt" optional="show" widget="boolean_toggle" readonly="1"
                           column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="auth_share" optional="show" widget="boolean_toggle" readonly="1"
                           column_invisible="context.get('default_contact_type') != 'student'"/>
                    <field name="auth_leave" optional="show" widget="boolean_toggle" readonly="1"
                           column_invisible="context.get('default_contact_type') != 'student'"/>
                </xpath>
            </field>
        </record>

        <!-- Educational Community > Students (issue #655): first name and last name as columns of
             their own, sorted by last name like the roll-call, the complete name hidden by default.
             Its own primary view because the contact list above is shared with Families and
             Providers (a provider has no first and last name); it still inherits every column
             above, since a primary child of base.view_partner_tree gets its extensions too. -->
        <record model="ir.ui.view" id="view_student_list">
            <field name="name">ems.student.list</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="mode">primary</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="default_order">lastname, firstname</attribute>
                </xpath>
                <xpath expr="//field[@name='complete_name']" position="before">
                    <field name="firstname"/>
                    <field name="lastname"/>
                </xpath>
                <xpath expr="//field[@name='complete_name']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
            </field>
        </record>

        <!-- Bound to the list mode only, after the kanban: the menu still opens on the kanban. -->
        <record model="ir.actions.act_window.view" id="action_student_kanban_view_kanban">
            <field name="act_window_id" ref="ems.action_student_kanban"/>
            <field name="view_mode">kanban</field>
            <field name="sequence">1</field>
        </record>
        <record model="ir.actions.act_window.view" id="action_student_kanban_view_list">
            <field name="act_window_id" ref="ems.action_student_kanban"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_student_list"/>
            <field name="sequence">2</field>
        </record>
    </data>
</odoo>
