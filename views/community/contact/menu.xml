<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>     
        <!-- Note: the student's one is in the main contact menu -->
                
        <record model="ir.actions.act_window" id="action_provider_kanban">
            <field name="name">Providers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,list,form</field>    
            <field name="search_view_id" ref="ems.view_provider_search"/>                        
            <field name="domain"> [('contact_type', '=', 'provider')] </field>
            <field name="context"> {'default_contact_type': 'provider'} </field>
        </record>   

        <record model="ir.actions.act_window" id="action_student_form">
            <field name="name">Student</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">form</field>    
            <field name="search_view_id" ref="ems.view_provider_search"/>                        
            <field name="domain"> [('contact_type', '=', 'student')] </field>
            <field name="context"> {'default_contact_type': 'student'} </field>
        </record>   
        
        <record model="ir.actions.act_window" id="action_family_list">
            <field name="name">Families</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <!-- <field name="view_id" ref="ems.view_family_list"/> -->
            <field name="search_view_id" ref="ems.view_family_search"/>
            <field name="domain">[('contact_type', '=', 'family')]</field>
            <field name="context">{'default_contact_type': 'family'}</field>
        </record>

        <menuitem name="Students"            sequence="1"  id="menu_students"          parent="menu_community" action="action_student_kanban"/>
        <menuitem name="Families"            sequence="3"  id="menu_families"          parent="menu_community" action="action_family_list"/>
        <menuitem name="Providers"           sequence="5"  id="menu_providers"         parent="menu_community" action="action_provider_kanban"/>

    </data>
</odoo>