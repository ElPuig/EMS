<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="view_portal_access_wizard_form">
            <field name="name">ems.portal.access.wizard.form</field>
            <field name="model">ems.portal.access.wizard</field>
            <field name="arch" type="xml">
                <form string="Portal access">
                    <group>
                        <field name="mode" widget="radio"/>
                    </group>
                    <separator string="Selected students"/>
                    <field name="student_ids" widget="many2many_tags" readonly="1"/>
                    <separator string="Recipients (preview)"/>
                    <field name="line_ids">
                        <list create="false" delete="false" editable="bottom">
                            <field name="selected" string="Apply"/>
                            <field name="student_id" string="Student" readonly="1" force_save="1"/>
                            <field name="recipient_id" string="Recipient" readonly="1" force_save="1"/>
                            <field name="recipient_email" string="Email" readonly="1"/>
                            <field name="has_portal" string="Current access" widget="boolean" readonly="1"/>
                            <field name="connected" string="Connected" widget="boolean" readonly="1"/>
                            <field name="note" string="Note" readonly="1" decoration-warning="note != False"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_portal_access_result_form">
            <field name="name">ems.portal.access.result.form</field>
            <field name="model">ems.portal.access.result</field>
            <field name="arch" type="xml">
                <form string="Portal access" create="false" edit="false">
                    <field name="summary" nolabel="1"/>
                    <separator string="Contacts that could not get access: their login is already in use"/>
                    <field name="conflict_ids" nolabel="1">
                        <list create="false" delete="false" edit="false">
                            <field name="contact_id"/>
                            <field name="login"/>
                            <field name="holder_id"/>
                            <field name="holder_type"/>
                            <field name="holder_active" widget="boolean"/>
                            <field name="related" widget="boolean"/>
                            <field name="advice"/>
                        </list>
                    </field>
                    <footer>
                        <button string="Close" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Cog-wheel entry on the students list. A student's own form has it in its "Actions"
             dropdown instead (views/community/contact/form.xml), so it is list-only here. -->
        <record id="action_portal_access_bulk" model="ir.actions.server">
            <field name="name">Portal access (students/families)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">list</field>
            <!-- The groups that can open the wizard (ir.model.access.csv): offering it to a teacher who is
                 not a tutor, or to a role implying teacher, ended in an access error (issue #842). -->
            <field name="groups_id" eval="[(6, 0, [ref('ems.group_academic_admin'), ref('ems.group_secretary'), ref('ems.group_tutor')])]"/>
            <field name="state">code</field>
            <!-- Keep this to a single call: safe_eval's context has no `_`, so any
                 translatable message has to come from real Python (res.partner). -->
            <field name="code">
action = env['res.partner'].browse(env.context.get('active_ids', [])).action_portal_access_bulk()
            </field>
        </record>

    </data>
</odoo>
