<odoo>
    <data>
        <record model="ir.ui.view" id="view_student_search">
            <field name="name">ems.student.search</field>
            <field name="model">res.partner</field>            
            <field name="arch" type="xml">
                <search>
                    <field name="display_name" string="Student" filter_domain="['|', ('display_name', 'ilike', self), ('student_email', 'ilike', self)]" />
                    <field name="exit_course_id"/>
                    <filter name="students_only" string="Students" domain="[('contact_type', '=', 'student')]"/>
                    <filter name="former_students" string="Former students" domain="[('contact_type', 'in', ['alumni', 'withdrawal', 'expelled'])]"/>
                    <!-- Its own filter group (hence the separators): adjacent filters are ORed,
                         and this one must narrow the result set on top of the facets above,
                         not widen it. Applied by default via action_student_kanban's
                         'search_default_my_students' - see issue #421. -->
                    <separator/>
                    <filter name="my_students" string="My students" domain="[('is_my_student', '=', True)]"/>
                    <separator/>
                    <!-- Issue #640: students EMS takes for minors for lack of a birth date. Its own
                         group too, so it narrows "My students" and the facets above. -->
                    <filter name="without_birth_date" string="Without birth date"
                            domain="[('contact_type', '=', 'student'), ('birth_date', '=', False)]"/>
                    <separator/>
                    <filter name="alumni" string="Alumni" domain="[('contact_type', '=', 'alumni')]"/>
                    <filter name="withdrawals" string="Withdrawals" domain="[('contact_type', '=', 'withdrawal')]"/>
                    <filter name="expelled" string="Expelled" domain="[('contact_type', '=', 'expelled')]"/>
                    <!-- Google account lifecycle (#388). Restricted to the roles that can
                         actually act on those accounts, matching the form's own buttons:
                         the teacher role can read every res.partner, so an unrestricted
                         filter would expose the schedule to whoever cannot act on it. -->
                    <separator groups="ems.group_secretary,ems.group_academic_admin"/>
                    <filter name="gw_deactivation_pending" string="Google suspension pending"
                            domain="[('google_ws_deactivation_date', '!=', False)]"
                            groups="ems.group_secretary,ems.group_academic_admin"/>
                    <filter name="gw_deletion_pending" string="Google deletion pending"
                            domain="[('google_ws_deletion_date', '!=', False)]"
                            groups="ems.group_secretary,ems.group_academic_admin"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_exit_course" string="Exit course" context="{'group_by': 'exit_course_id'}"/>
                        <filter name="group_by_exit_type" string="Exit type" context="{'group_by': 'exit_type'}"/>
                        <filter name="group_by_gw_deactivation_date" string="Google suspension date"
                                context="{'group_by': 'google_ws_deactivation_date'}"
                                groups="ems.group_secretary,ems.group_academic_admin"/>
                    </group>
                    <searchpanel>
                        <field name="main_group_id" string="Student group" icon="fa-users" enable_counters="1" />
                    </searchpanel>
                </search>
            </field>		      
        </record>   

         <record model="ir.ui.view" id="view_family_search">
            <field name="name">ems.family.search</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <search>
                    <field name="display_name" string="Provider"  filter_domain="['|', ('display_name', 'ilike', self), ('email', 'ilike', self), ('document_id', 'ilike', self)]" />
                    <field name="document_id" string="Document ID"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="view_provider_search">
            <field name="name">ems.provider.search</field>
            <field name="model">res.partner</field>            
            <field name="arch" type="xml">                                     
                <search>
                    <field name="display_name" string="Provider"  filter_domain="['|', ('display_name', 'ilike', self), ('email', 'ilike', self), ('vat', 'ilike', self)]" />
                    <searchpanel>
                        <field name="commercial_partner_id" string="Company" icon="fa-building" enable_counters="1" />
                    </searchpanel>
                </search>            
            </field>		      
        </record>  
    </data>
</odoo>