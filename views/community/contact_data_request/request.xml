<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Issue #507: contact data update requests - follow-up list, review form and search. -->
        <record id="view_ems_contact_data_request_list" model="ir.ui.view">
            <field name="name">ems.contact.data.request.list</field>
            <field name="model">ems.contact.data.request</field>
            <field name="arch" type="xml">
                <list string="Contact data requests" create="false"
                      decoration-info="state == 'submitted'" decoration-muted="state == 'done'">
                    <header>
                        <button name="%(action_ems_contact_data_request_send)d" type="action"
                                string="Request contact data" class="btn-primary" display="always"/>
                        <button name="action_approve" type="object" string="Approve"/>
                        <button name="action_send_reminder" type="object" string="Send reminder"/>
                    </header>
                    <field name="student_id"/>
                    <field name="group_id"/>
                    <field name="course_id" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-warning="state == 'pending'" decoration-info="state == 'submitted'"
                           decoration-success="state == 'done'"/>
                    <field name="has_possible_duplicate" string="Duplicate?" optional="show"/>
                    <field name="sent_date" optional="show"/>
                    <field name="reminder_count" optional="show"/>
                    <field name="submitted_date" optional="show"/>
                    <field name="review_uid" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_ems_contact_data_request_form" model="ir.ui.view">
            <field name="name">ems.contact.data.request.form</field>
            <field name="model">ems.contact.data.request</field>
            <field name="arch" type="xml">
                <form string="Contact data request" create="false">
                    <header>
                        <button name="action_approve" type="object" string="Approve" class="btn-primary"
                                invisible="state != 'submitted'"/>
                        <button name="action_open_reject_wizard" type="object" string="Return to the family"
                                invisible="state != 'submitted'"/>
                        <button name="action_send_reminder" type="object" string="Send reminder"
                                invisible="state != 'pending'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="student_id" readonly="1"/></h1>
                        </div>
                        <div class="alert alert-warning" role="alert" invisible="not has_possible_duplicate">
                            A new family contact shares a mobile number with another contact under a
                            different name: approving creates a new contact. Check whether it is the same
                            person before approving.
                        </div>
                        <group>
                            <group>
                                <field name="group_id"/>
                                <field name="tutor_id"/>
                                <field name="course_id" readonly="1"/>
                                <field name="has_possible_duplicate" invisible="1"/>
                            </group>
                            <group>
                                <field name="sent_date"/>
                                <field name="reminder_count"/>
                                <field name="last_reminder_date" invisible="not last_reminder_date"/>
                                <field name="submitted_date"/>
                                <field name="submitted_uid" invisible="not submitted_uid"/>
                                <field name="review_uid" invisible="not review_uid"/>
                                <field name="review_date" invisible="not review_date"/>
                            </group>
                        </group>
                        <group string="Returned to the family" invisible="not rejection_reason">
                            <field name="rejection_reason" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Missing when sent" invisible="not missing_fields">
                            <field name="missing_fields" nolabel="1" colspan="2"/>
                        </group>
                        <separator string="Changes"/>
                        <field name="line_ids" readonly="1">
                            <list create="false" delete="false" edit="false"
                                  decoration-success="action == 'create'" decoration-danger="action == 'remove'">
                                <field name="person_name"/>
                                <field name="action"/>
                                <field name="field_label"/>
                                <field name="old_value"/>
                                <field name="new_value"/>
                                <field name="relation_type_id" optional="show"/>
                                <field name="matched_partner_id" optional="show"/>
                                <field name="possible_duplicate_id" optional="show"
                                       decoration-warning="possible_duplicate_id"/>
                                <field name="also_student_ids" widget="many2many_tags" optional="show"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ems_contact_data_request_search" model="ir.ui.view">
            <field name="name">ems.contact.data.request.search</field>
            <field name="model">ems.contact.data.request</field>
            <field name="arch" type="xml">
                <search string="Contact data requests">
                    <field name="student_id"/>
                    <field name="group_id"/>
                    <filter name="pending" string="Pending answer" domain="[('state', '=', 'pending')]"/>
                    <filter name="submitted" string="To review" domain="[('state', '=', 'submitted')]"/>
                    <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter name="overdue" string="Pending for more than a week"
                            domain="[('state', '=', 'pending'), ('sent_date', '&lt;', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter name="possible_duplicate" string="Possible duplicate" domain="[('has_possible_duplicate', '=', True)]"/>
                    <separator/>
                    <filter name="current_course" string="Current academic year" domain="[('course_id.is_current', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_group" string="Group" context="{'group_by': 'group_id'}"/>
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_by_course" string="Academic Year" context="{'group_by': 'course_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_ems_contact_data_request" model="ir.actions.act_window">
            <field name="name">Contact data requests</field>
            <field name="res_model">ems.contact.data.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_current_course': 1, 'create': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No contact data request yet</p>
                <p>Use "Request contact data" to ask students and families to review their contact
                    details from the portal.</p>
            </field>
        </record>

        <record id="view_ems_contact_data_request_reject_wizard_form" model="ir.ui.view">
            <field name="name">ems.contact.data.request.reject.wizard.form</field>
            <field name="model">ems.contact.data.request.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Return to the family">
                    <p>The family gets an email with this reason and can send their details again from the portal.</p>
                    <field name="request_ids" invisible="1"/>
                    <field name="reason" placeholder="What they have to correct"/>
                    <footer>
                        <button name="action_reject" type="object" string="Return" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
