<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_content_list" model="ir.ui.view">
            <field name="name">ems.content.list</field>
            <field name="model">ems.content</field>
            <field name="arch" type="xml">
                <list string="Contents" default_order="code asc, acronym asc">
                    <field name="subject_id"/>
                    <field name="code"/>
                    <field name="acronym"/>
                    <field name="name"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
