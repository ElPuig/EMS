<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_content_search" model="ir.ui.view">
            <field name="name">ems.content.search</field>
            <field name="model">ems.content</field>
            <field name="arch" type="xml">
                <search string="Contents">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="acronym"/>
                    <field name="subject_id"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
