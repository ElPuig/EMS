<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_criteria_list" model="ir.ui.view">
            <field name="name">ems.criteria.list</field>
            <field name="model">ems.criteria</field>
            <field name="arch" type="xml">
                <list string="Evaluation criteria" default_order="code asc, acronym asc">
                    <field name="outcome_id"/>
                    <field name="code"/>
                    <field name="acronym"/>
                    <field name="name"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
