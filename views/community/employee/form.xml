<odoo>
    <data>
        <record model="ir.ui.view" id="view_employee_form">
            <field name="name">ems.employee.form</field>
            <field name="model">hr.employee</field>            
            <field name="inherit_id" ref="hr.view_employee_form"/> 
            <field name="arch" type="xml">

                <xpath expr="//header/button" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Into the native <header>, not a second one: a form has one status bar, and
                     every action on this employee sits in its "Actions" dropdown, never loose in
                     the header (see docs/en/developers/shared/actions_dropdown.md). Native
                     buttons join it too: hr_holidays_attendance's "Deduct Extra Hours" is moved
                     in by view_employee_form_native_actions, which has to run after it. -->
                <xpath expr="//header" position="inside">
                    <field name="google_ws_state" invisible="1"/>
                    <field name="google_signin_missing" invisible="1"/>
                    <field name="google_ws_creation_pending" invisible="1"/>
                    <field name="pending_identification" invisible="1"/>
                    <div name="ems_actions" string="Actions">
                        <button name="action_create_google_account" type="object"
                                string="Create Google account"
                                invisible="google_ws_state != 'none' or google_ws_creation_pending or pending_identification"
                                groups="ems.group_academic_admin,hr.group_hr_user"/>
                        <!-- Corporate email already exists but no EMS user is linked yet
                             (adopt path: manual email, pre-integration staff, or a
                             migration gap) - only links/creates the res.users, no Google
                             Workspace API call. -->
                        <button name="action_create_ems_user" type="object"
                                string="Create EMS User"
                                invisible="google_ws_state != 'pending_user'"
                                groups="ems.group_academic_admin,hr.group_hr_user"/>
                        <button name="action_suspend_google_account" type="object"
                                string="Suspend Google account"
                                invisible="google_ws_state != 'active'"
                                groups="ems.group_academic_admin,hr.group_hr_user"/>
                        <!-- Issue #595: offered while the account exists in Google, EMS user or
                             not; action_reset_google_password() re-checks the groups. -->
                        <button name="action_reset_google_password" type="object"
                                string="Reset Google password"
                                invisible="google_ws_state not in ('active', 'pending_user')"
                                confirm="This gives the teacher's Google account a new password: the current one stops working and new credentials are generated. Continue?"
                                groups="ems.group_academic_admin,hr.group_hr_user"/>
                        <!-- Repair, not a state of its own: the account is active and
                             fully set up, only its user lost the OAuth data needed to
                             sign in with Google, so this shows next to Suspend rather
                             than replacing it. Hidden as soon as the link is back. -->
                        <button name="action_relink_google_signin" type="object"
                                string="Re-link Google sign-in"
                                invisible="not google_signin_missing"
                                groups="ems.group_academic_admin,hr.group_hr_user"/>
                        <button name="action_reactivate_google_account" type="object"
                                string="Reactivate Google account"
                                invisible="google_ws_state != 'suspended'"
                                groups="ems.group_academic_admin,hr.group_hr_user"/>
                        <!-- Grace period (issue #388): archiving only schedules the
                             suspension. The date is not part of google_ws_state - the
                             account is still fully active - so these two are driven by
                             the date field itself. -->
                        <button name="action_cancel_scheduled_deactivation" type="object"
                                string="Cancel scheduled deactivation"
                                invisible="not google_ws_deactivation_date"
                                groups="ems.group_academic_admin,hr.group_hr_user"/>
                    </div>
                </xpath>

                <xpath expr="//sheet" position="before">
                    <!-- Same groups as the buttons above, for the same reason as on the
                         student form: whoever cannot act on the account has no business
                         reading its schedule either. -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not google_ws_deactivation_date"
                         groups="ems.group_academic_admin,hr.group_hr_user">
                        The Google account is scheduled to be deactivated on
                        <field name="google_ws_deactivation_date" readonly="1" nolabel="1"
                               class="oe_inline"/>.
                    </div>
                    <!-- Issue #444's follow-up (2026-09-12) - moved here from inside the "Schedule"
                    page (developer feedback: burying it in a tab meant the teacher/whoever edited
                    their schedule had no way to notice a pending conflict without opening that tab
                    specifically). Same header-adjacent, always-visible placement as the Google
                    account alert above, and the equivalent location to where ems.group's own
                    version of this banner already sits - see that form's own comment. -->
                    <field name="pending_classroom_conflict_count" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not pending_classroom_conflict_count">
                        <p>
                            A classroom change requested from this teacher's own schedule, but <field name="pending_classroom_conflict_count" nolabel="1" class="oe_inline"/>
                            teaching block(s) could not move to it automatically because of a room collision.
                        </p>
                        <button name="action_open_classroom_change_wizard" type="object" string="Resolve pending classrooms" class="btn-warning"/>
                    </div>
                </xpath>

                <field name="work_email" position="attributes">
                    <attribute name="readonly">employee_type in ('teacher', 'asp') and not google_ws_manual_email</attribute>
                    <attribute name="help">Corporate account. It is generated automatically when the Google account is created (or the existing one is adopted). Tick "Assign corporate email manually" to edit it by hand.</attribute>
                </field>

                <field name="work_email" position="after">
                    <field name="google_ws_domain" invisible="1"/>
                    <field name="google_ws_manual_email"
                           invisible="employee_type not in ('teacher', 'asp') or staffing_type == 'vacancy'"
                           groups="ems.group_academic_admin,hr.group_hr_user"/>
                    <label for="google_ws_login" string="Suggested Google username"
                           invisible="employee_type not in ('teacher', 'asp') or work_email or google_ws_manual_email or staffing_type == 'vacancy'"
                           groups="ems.group_academic_admin,hr.group_hr_user"/>
                    <div class="o_row"
                         invisible="employee_type not in ('teacher', 'asp') or work_email or google_ws_manual_email or staffing_type == 'vacancy'"
                         groups="ems.group_academic_admin,hr.group_hr_user">
                        <field name="google_ws_login" placeholder="jdoe" nolabel="1"/>
                        <span class="text-muted">@<field name="google_ws_domain" readonly="1" nolabel="1" class="oe_inline"/></span>
                    </div>
                </field>

                <field name="name" position="replace">
                    <!-- NOTE: I could'nt find a way to setup the placeholders as a computed field using the 'employee_type'... -->
                    <!-- required: the native node being replaced carries it (resource.resource's name
                         is NOT NULL); a vacancy may leave it blank and takes its code as name on
                         create (issue #584). -->
                    <field name="name" placeholder="Teacher's Name" invisible="employee_type != 'teacher'"
                           required="employee_type == 'teacher' and staffing_type != 'vacancy'"/>
                    <field name="name" placeholder="ASP's Name"     invisible="employee_type != 'asp'"
                           required="employee_type == 'asp'"/>
                </field>
                
                <xpath expr="//page[@name='skills_resume']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>  

                <xpath expr="//page[@name='received_badges']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>  
                
                <xpath expr="//field[@name='bank_account_id']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <xpath expr="//label[@for='distance_home_work']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <xpath expr="//div[@name='div_km_home_work']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <!-- Needed by the Google account (recovery + credentials delivery);
                     only enforced on new records (most legacy employees lack it) and on a vacancy
                     being switched to a named teacher, which is when its account gets created. A
                     vacancy itself (issue #584) has nobody to send it to: neither asked nor shown. -->
                <field name="private_email" position="attributes">
                    <attribute name="required">(not id or pending_identification) and employee_type in ('teacher', 'asp') and staffing_type != 'vacancy'</attribute>
                    <attribute name="invisible">staffing_type == 'vacancy'</attribute>
                    <attribute name="help">Personal address, also used as the Google account's recovery email. It can't be the centre's corporate account.</attribute>
                </field>

                <!-- Second occurrence of private_email, on the main screen, last in the right-hand
                     column under Department/Job Position/Manager (issue #391). The field is required
                     to create teaching staff, and a required field buried in a tab means every new
                     teacher starts with a validation error on a screen that does not show what is
                     wrong - so it is surfaced here, where the record is actually filled in.

                     Deliberately a duplicate and not a 'position="move"': it must stay in its
                     original place in the "Private Information" tab too, where anyone maintaining
                     an existing record expects to find it. Both nodes are bound to the same field,
                     so editing either one updates the other live.

                     'required' is repeated here because the position="attributes" above resolves
                     against the first matching node at the time it is applied - the tab's one -
                     and would leave this occurrence without it.

                     Still protected: private_email carries groups="hr.group_hr_user" on the field
                     itself, so sitting outside the page's own group gate changes nothing about who
                     can see it. -->
                <xpath expr="//field[@name='coach_id']" position="after">
                    <field name="private_email"
                           required="(not id or pending_identification) and employee_type in ('teacher', 'asp') and staffing_type != 'vacancy'"
                           invisible="staffing_type == 'vacancy'"
                           help="Personal address, also used as the Google account's recovery email. It can't be the centre's corporate account."/>
                </xpath>

                <xpath expr="//page[@name='personal_information']/group/group[2]" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>  

                <xpath expr="//page[@name='personal_information']/group/group[3]" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>   

                <xpath expr="//page[@name='personal_information']/group/group[4]" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>               

                <!-- Private Contact: HR officers only, so the Department Chief (who gets the tab
                     for the Identification group alone) sees nothing else. Must stay before the
                     insertion below, while it is still group[1]. -->
                <xpath expr="//page[@name='personal_information']/group/group[1]" position="attributes">
                    <attribute name="groups">hr.group_hr_user</attribute>
                </xpath>

                <!-- Identification first, Emergency beside it in the right-hand column, and
                     the native Private Contact after both (the Citizenship/Family/Education groups
                     in between are hidden, so they take no column). -->
                <xpath expr="//page[@name='personal_information']/group/group[1]" position="before">
                    <!-- Identity document and social security number. The HR officers (Head of
                         Studies and above, TAC, the secretariat) edit the native fields - a
                         duplicate of the ones in the hidden "Citizenship" group, bound to
                         the same field. A Department Chief, who lacks hr.group_hr_user, gets the
                         read-only scoped_* copies instead: filled in only for the employees of
                         their own chain of command (see employee.py). -->
                    <group string="Identification" name="identity">
                        <field name="can_view_identity" invisible="1"/>
                        <field name="identification_id" string="Identity document" groups="hr.group_hr_user"/>
                        <field name="ssnid" string="Social Security No" groups="hr.group_hr_user"/>
                        <field name="scoped_identification_id" groups="!hr.group_hr_user"/>
                        <field name="scoped_ssnid" groups="!hr.group_hr_user"/>
                    </group>
                    <group string="Emergency" groups="hr.group_hr_user">
                        <field name="emergency_contact"/>
                        <field name="emergency_phone" class="o_force_ltr"/>
                    </group>
                </xpath>

                <!-- Opened to the Department Chief for the "Identification" group alone: every
                     other group of the tab is hr.group_hr_user-only, and the tab itself only
                     shows on the employees of the viewer's chain of command (can_view_identity,
                     always True for an HR officer). -->
                <xpath expr="//page[@name='personal_information']" position="attributes">
                    <attribute name="groups">hr.group_hr_user,ems.group_department_chief</attribute>
                    <attribute name="invisible">not can_view_identity</attribute>
                </xpath>

                <field name="job_title" position="replace">
                    <field name="job_id" placeholder="Job Position" />
                </field>

                <field name="category_ids" position="replace">
                    <field name="role_ids" placeholder="Roles" widget="role_color_tags" options="{'color_field': 'color', 'no_create_edit': True}" />
                </field>

                <field name="coach_id" position="attributes">
                   <attribute name="invisible">True</attribute>
                </field>

                <field name="parent_id" position="attributes">
                    <attribute name="readonly">1</attribute>
                    <attribute name="help">Set automatically from the employee's department (Department Chief / Seminar Chief). Edit it from the Departments form instead.</attribute>
                </field>

                <field name="employee_type" position="after">
                    <field name="contract_type_id" />
                </field>                  

                <xpath expr="//page[@name='hr_settings']" position="attributes">
                    <attribute name="string">Human Resources</attribute>
                </xpath>

                <!-- Native "Create User" duplicates the header's "Create EMS User"
                     (action_create_ems_user), but bypasses EMS's own Google Workspace
                     account creation/adoption flow (google_ws_state). Hidden so admins
                     only have the EMS-aware path available. -->
                <xpath expr="//page[@name='hr_settings']//button[@name='action_create_user']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//page[@name='hr_settings']/group" position="inside">
                    <group string="Teaching hour reductions" name="teaching_reduction_group" invisible="employee_type != 'teacher'">
                        <field name="teaching_reduction_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <!-- Issue #595: latest credentials PDF (creation or reset), next to the EMS user
                         in this same tab; it holds the temporary password, hence the same groups
                         as the Google actions. -->
                    <group string="Google account" name="google_account_group"
                           invisible="not google_credentials_pdf"
                           groups="base.group_system,ems.group_academic_admin,hr.group_hr_user">
                        <field name="google_credentials_filename" invisible="1"/>
                        <field name="google_credentials_pdf" filename="google_credentials_filename"/>
                    </group>
                </xpath>

                <xpath expr="//group[@name='identification_group']" position="attributes">
                    <attribute name="string">Attendance</attribute>
                </xpath>   

                <xpath expr="//div[hasclass('oe_title')]/h2" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <!-- hr.view_employee_form (native, inherited here) already ships its own
                generic "Archived" ribbon (invisible="active") - adjust it in place instead of
                adding a second, duplicate one (an earlier version of this view did add a
                separate ribbon here, which would have stacked on top of the native one; caught
                before shipping by re-reading hr_employee_views.xml). -->
                <xpath expr="//widget[@name='web_ribbon']" position="attributes">
                    <attribute name="invisible">active or pending_identification or archived_reason_label</attribute>
                    <attribute name="groups">hr.group_hr_user,ems.group_teacher</attribute>
                </xpath>

                <!-- Sibling of the title/avatar ROW (not of oe_title itself, unlike the
                archived_reason_label field below) - matching exactly where hr's own native
                "Archived" ribbon sits (a direct child of <sheet>, before that row), rather than
                a raw <widget name="web_ribbon"> INSIDE the row as a sibling of oe_title (the
                original placement here). A raw <widget> renders .ribbon as its own DOM root
                (position:absolute, so it does not itself consume flex space either way), but as
                a true sibling of .oe_title it would also match web/static/.../ribbon.scss's own
                ".ribbon:not(.o_invisible_modifier) ~ .oe_title { margin-right: 100px }" rule -
                real, layout-affecting margin on the title. archived_reason_label below is safe
                staying a sibling of oe_title because its own .ribbon div sits one level deeper,
                inside its field wrapper (<field widget="ems_archived_reason_ribbon">), so that
                selector never matches it. Found 2026-09-01 while investigating #378's actual
                avatar-jump report - NOT the cause on its own (see the pending_identification
                xpath below, whose comment covers the real cause: a since-removed visible
                schedule_import_code field), but worth fixing to match native structure and avoid
                this latent margin-right risk regardless. -->
                <xpath expr="//div[hasclass('oe_title')]/parent::div[hasclass('row')]" position="before">
                    <widget name="web_ribbon" title="Pending identification" bg_color="ems-ribbon-pending-identification"
                            invisible="not pending_identification"/>
                </xpath>

                <xpath expr="//div[hasclass('oe_title')]" position="before">
                    <!-- Same reason-aware pattern as res.partner (see contact/form.xml): the
                    shared 'ems_archived_reason_ribbon' field widget shows the actual departure
                    reason (archived_reason_label/_color, related to departure_reason_id in
                    employee.py); the native ribbon above (adjusted) only remains for the edge
                    case of an employee archived with no departure reason set at all (e.g.
                    archived directly via the ORM, bypassing hr's departure wizard). Mutually
                    exclusive with "Pending identification" too. Must declare
                    archived_reason_color as its own field, not just reference it via the
                    widget's "color_field" option - see contact/form.xml's own comment on why. -->
                    <field name="archived_reason_color" invisible="1"
                           groups="hr.group_hr_user,ems.group_teacher"/>
                    <field name="archived_reason_label" widget="ems_archived_reason_ribbon"
                           groups="hr.group_hr_user,ems.group_teacher"
                           options="{'color_field': 'archived_reason_color'}"
                           invisible="active or pending_identification or not archived_reason_label"/>
                </xpath>

                <!-- Staffing type (issue #584): a named teacher, or a vacancy with its code and no
                person yet. After the title/avatar ROW, never inside it: a plain <field> there is a
                real, space-consuming flex item and makes the avatar jump (the bug a since-removed
                visible schedule_import_code caused on 2026-09-01, issue #378 follow-up). Shown
                only while creating the record or while it is still a vacancy: switching a vacancy
                to a named teacher is how its identity is confirmed, and a named teacher never goes
                back to being a vacancy. pending_identification is declared
                here for the ribbon and the buttons' conditions above. -->
                <xpath expr="//div[hasclass('oe_title')]/parent::div[hasclass('row')]" position="after">
                    <field name="pending_identification" invisible="1"/>
                    <group name="staffing_group" invisible="employee_type != 'teacher' or (id and not pending_identification)"
                           groups="ems.group_academic_admin,hr.group_hr_user">
                        <field name="staffing_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="schedule_import_code" string="Vacancy code" placeholder="X1"
                               invisible="staffing_type != 'vacancy'"
                               required="staffing_type == 'vacancy'"/>
                    </group>
                </xpath>

                <field name="work_location_id" position="after">
                    <field name="tz" position="move"/>
                </field>
                <!-- Always the company's timezone (models/settings/timezone.py). -->
                <field name="tz" position="attributes">
                    <attribute name="readonly">1</attribute>
                </field>

                <xpath expr="//group[field[@name='resource_calendar_id']]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Schedule" name="schedule" invisible="employee_type == 'asp'">
                        <field name="resource_calendar_id" invisible="1"/>
                        <field name="can_edit_schedule" invisible="1"/>
                        <field name="schedule_attendance_ids" widget="schedule_grid" nolabel="1">
                            <list limit="200">
                                <field name="name"/>
                                <field name="dayofweek"/>
                                <field name="hour_from"/>
                                <field name="hour_to"/>
                                <field name="day_period"/>
                                <field name="subject_id"/>
                                <field name="topic"/>
                                <field name="group_ids"/>
                                <field name="non_teaching"/>
                                <field name="non_teaching_is_break"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="space_id"/>
                            </list>
                        </field>
                    </page>

                    <page string="Teaching" invisible="employee_type == 'asp'">
                        <group string="Tutorships">
                            <field name="tutorship_ids" widget="many2many_tags" nolabel="1" />
                        </group>

                        <group string="Coordination">
                            <field name="headed_department_ids" widget="many2many_tags" nolabel="1" readonly="1"/>
                            <field name="seminar_department_ids" widget="many2many_tags" nolabel="1" readonly="1"/>
                        </group>

                        <group string="Subjects">
                            <field name="teaching_ids" nolabel="1" readonly="1">
                                <list default_order="subject_id asc, group_id asc">
                                    <field name="subject_id" />
                                    <field name="group_id" />
                                </list>
                            </field>
                        </group>
                    </page>
                </xpath>

                <!-- Schedule is the first tab, which also makes it the default active one (the
                     notebook activates its first visible page; for an ASP employee, where it is
                     hidden, the next one takes over). Moved before whichever page comes first by
                     now (hr_skills' Resume, inserted before Work Information), same as the
                     My Profile screen (user_profile_form.xml). -->
                <xpath expr="//notebook/page[1]" position="before">
                    <xpath expr="//page[@name='schedule']" position="move"/>
                </xpath>
            </field>
        </record>  

        <!-- Hiding the attendace aprovers section -->
        <record model="ir.ui.view" id="view_employee_form_inherit_hr_attendance">
            <field name="name">ems.employee_form_inherit_hr_attendance.form</field>
            <field name="model">hr.employee</field>            
            <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance"/> 
            <field name="arch" type="xml">        
                <xpath expr="//group[@name='managers']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>          
            </field>
        </record>

        <!-- Native header buttons into the Actions dropdown (view_employee_form above). A
             separate view because hr_holidays_attendance adds "Deduct Extra Hours" at priority
             120, after view_employee_form: this one must run later still to find it. Matched on
             its context, not its string (translatable) or name (a %(xmlid)d action id). -->
        <record model="ir.ui.view" id="view_employee_form_native_actions">
            <field name="name">ems.employee.form.native.actions</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="priority">130</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='ems_actions']" position="inside">
                    <xpath expr="//header/button[contains(@context, 'deduct_extra_hours')]" position="move"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>