<odoo>
    <data>
        <record model="ir.ui.view" id="view_group_classroom_change_wizard">
            <field name="name">ems.group_classroom_change.wizard</field>
            <field name="model">ems.group_classroom_change_wizard</field>
            <field name="arch" type="xml">
                <form string="Resolve pending classrooms">
                    <sheet>
                        <field name="confirm_disabled" invisible="1"/>
                        <group>
                            <field name="group_id" readonly="1" invisible="not group_id"/>
                            <field name="employee_id" readonly="1" invisible="not employee_id"/>
                        </group>
                        <p>
                            These teaching blocks could not move to the group's new classroom
                            automatically because of a room collision - pick a classroom for
                            each side, or a different resolution, then confirm.
                        </p>
                        <field name="conflict_line_ids" widget="ems_grouped_conflict_lines">
                            <!-- Never rendered directly (see the widget's own template) - only
                                 declares which sub-fields to load, same as the working-schedules
                                 import wizard's own use of this widget. -->
                            <list editable="bottom" create="False" delete="False">
                                <field name="left_label"/>
                                <field name="left_group_key"/>
                                <field name="right_label"/>
                                <field name="kind"/>
                                <field name="resolution"/>
                                <field name="left_space_id"/>
                                <field name="right_space_id"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="confirm_disabled"/>
                        <button name="action_confirm_disabled" string="Confirm" type="button" class="btn-primary" disabled="disabled"
                            invisible="not confirm_disabled"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
