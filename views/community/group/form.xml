<odoo>
    <data>
        <record model="ir.ui.view" id="view_group_form">
            <field name="name">ems.group.form</field>
            <field name="model">ems.group</field>
            <field name="arch" type="xml">
                <form string="Group" js_class="ems_group_form">
                    <!-- Not shown (see "Don't show active field redundantly" convention): the
                    Action menu's Archive/Unarchive only appears at all when 'active' is part of
                    this view's own declared fields, not just the model's - see form_controller.js's
                    archiveEnabled getter (keyed on model.root.activeFields). -->
                    <field name="active" invisible="1"/>
                    <field name="pending_classroom_conflict_count" invisible="1"/>
                    <field name="suggested_space_id" invisible="1"/>
                    <field name="can_edit_schedule" invisible="1"/>
                    <!-- Outside <sheet> (above the white card), matching the equivalent banner on
                    the employee form's own "before sheet" placement (views/community/employee/
                    form.xml) - moved here 2026-09-12 (developer feedback: it used to render INSIDE
                    the card here, unlike the employee form's version). -->
                    <!-- Wording kept origin-neutral (issue #446) - a pending block can come from
                    EITHER this group's own space_id changing (issue #405) OR a single teaching
                    block's classroom being edited directly from this tab (issue #446), and
                    nothing on this model distinguishes which one afterwards. "This group's
                    classroom changed" would be misleading for the second case, so this text -
                    unlike the employee form's own tailored wording for ITS single origin - covers
                    both truthfully instead of picking one. -->
                    <div class="alert alert-warning" role="alert" invisible="not pending_classroom_conflict_count">
                        <p>
                            <field name="pending_classroom_conflict_count" nolabel="1" class="oe_inline"/>
                            teaching block(s) couldn't move to their requested classroom automatically because of a room collision.
                        </p>
                        <button name="action_open_classroom_change_wizard" type="object" string="Resolve pending classrooms" class="btn-warning"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not suggested_space_id">
                        <p>
                            This group's teaching schedule doesn't actually use its assigned classroom - it mostly
                            meets in <field name="suggested_space_id" nolabel="1" class="oe_inline"/> instead.
                        </p>
                        <button name="action_apply_suggested_space" type="object" string="Apply suggested classroom" class="btn-info"/>
                    </div>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <group string="Main data" col="4">
                            <group colspan="2">
                                <field name="group_type" widget="radio" options="{'horizontal': true}" />
                            </group>
                            <group>
                                <field name="shift" />
                            </group>
                            <group>
                                <field name="external_id" />
                            </group>
                            <group colspan="3" invisible="group_type != 'main'">
                                <field name="level_id" required="group_type == 'main'" />
                            </group>
                            <group colspan="2" invisible="group_type != 'main'">
                                <field name="study_id" readonly="level_id == False" domain="[('level_id','=', level_id)]" required="group_type == 'main'" />
                            </group>
                            <group invisible="group_type != 'main'">
                                <field name="course" required="group_type == 'main'" />
                            </group>
                            <group invisible="group_type != 'main'">
                                <field name="acronym" required="group_type == 'main'" />
                            </group>
                            <group colspan="4" invisible="group_type != 'reinforcement'">
                                <field name="name" />
                            </group>
                            <group colspan="2" invisible="group_type != 'main'">
                                <field name="tutor_id" widget="many2one_avatar_employee" />
                            </group>
                            <group invisible="group_type != 'main'">
                                <field name="delegate_id" widget="many2one_avatar" />
                            </group>
                            <group>
                                <field name="space_id" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Students" invisible="group_type != 'main'">
                                 <field name="main_student_ids" widget="many2many">
                                    <list default_order="name asc" >
                                        <field name="image_1920" widget="image" />
                                        <field name="name" class="align-middle"/>
                                        <field name="student_email" class="align-middle"/>
                                        <field name="email" string="Personal Email" class="align-middle"/>
                                        <field name="mobile" class="align-middle"/>
                                        <!-- Needed to open as fullscreen form -->
                                        <field name="id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>

                             <page string="Enrolled">
                                <field name="enrollment_view_ids" widget="many2many">
                                    <list default_order="student_id asc">
                                        <field name="image_1920" widget="image" />
                                        <field name="student_id" class="align-middle"/>
                                        <field name="subject_ids" widget="many2many_tags"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Schedule" name="schedule">
                                <field name="schedule_attendance_ids" widget="readonly_schedule_grid" nolabel="1">
                                    <list limit="200">
                                        <field name="dayofweek"/>
                                        <field name="hour_from"/>
                                        <field name="hour_to"/>
                                        <field name="day_period"/>
                                        <field name="subject_id"/>
                                        <field name="topic"/>
                                        <field name="non_teaching"/>
                                        <field name="non_teaching_is_break"/>
                                        <field name="employee_id"/>
                                        <field name="space_id"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Notes">
                                <field name="notes" placeholder="Write down here your notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>			
        </record>       
    </data>
</odoo>