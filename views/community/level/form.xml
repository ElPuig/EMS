<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="level_view_form" model="ir.ui.view">
            <field name="name">ems.level.form</field>
            <field name="model">ems.level</field>
            <field name="arch" type="xml">
                <form string="Level">
                    <sheet>
                        <group string="Main data" col="4">
                            <group>
                                <field name="acronym"/>
                            </group>
                            <group colspan="3">
                                <field name="name"/>    
                            </group>                            
                        </group>  

                        <notebook>
                            <page string="Studies">
                                <field name="study_ids">
                                    <list default_order="code asc, acronym asc, name asc">
                                        <field name="code"/>
                                        <field name="acronym"/>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Notes">
                                <field name="notes" placeholder="Write down here your notes..."/>
                            </page>
                        </notebook>                  
                    </sheet>	
                </form>
            </field>			
        </record>
    </data>
</odoo>