<odoo>
    <data>
        <record model="ir.ui.view" id="view_role_form">
            <field name="name">ems.role.form</field>
            <field name="model">ems.role</field>
            <field name="arch" type="xml">
                <form string="role">
                    <sheet>
                        <group string="Main data" col="4">
                            <group colspan="2">
                                <field name="name"/>                                
                                <field name="employee_type" invisible="1"/>
                            </group>
                            <group>
                                <field name="color" widget="color" class="ems_color_swatch"/>
                            </group>
                            <group>
                                <field name="unipersonal" />
                                <field name="group_id"/>
                            </group>
                        </group>  

                        <notebook>
                            <page string="Assigned to">
                                <field name="is_hierarchy_managed" invisible="1"/>
                                <div class="alert alert-info" role="alert" invisible="not is_hierarchy_managed">
                                    <field name="hierarchy_managed_message" nolabel="1"/>
                                </div>
                                <field name="employee_ids" mode="kanban" readonly="is_hierarchy_managed" />
                            </page>

                            <page string="Notes">
                                <field name="notes" placeholder="Write down here your notes..."/>
                            </page>
                        </notebook>                  
                    </sheet>	
                </form>
            </field>			
        </record>      
    </data>
</odoo>