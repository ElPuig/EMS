<odoo>
    <data>
        <record model="ir.ui.view" id="view_space_form">
            <field name="name">ems.space.form</field>
            <field name="model">ems.space</field>
            <field name="arch" type="xml">
                <form string="space">
                    <sheet>
                        <group string="Main data" col="2">
                            <group>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="space_type_id"/>
                            </group>
                            <group>
                                <field name="work_location_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Schedule" name="schedule">
                                <field name="schedule_attendance_ids" widget="readonly_schedule_grid" nolabel="1">
                                    <list limit="200">
                                        <field name="dayofweek"/>
                                        <field name="hour_from"/>
                                        <field name="hour_to"/>
                                        <field name="day_period"/>
                                        <field name="subject_id"/>
                                        <field name="topic"/>
                                        <field name="non_teaching"/>
                                        <field name="non_teaching_is_break"/>
                                        <field name="employee_id"/>
                                        <field name="space_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>			
        </record>
    </data>
</odoo>