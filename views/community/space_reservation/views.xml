<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_space_reservation_wizard_form" model="ir.ui.view">
        <field name="name">ems.space_reservation_wizard.form</field>
        <field name="model">ems.space_reservation_wizard</field>
        <field name="arch" type="xml">
            <form string="Reserve a space">
                <group>
                    <field name="mode" widget="radio"/>
                </group>
                <group invisible="mode != 'date'">
                    <group>
                        <field name="date" required="mode == 'date'"/>
                    </group>
                    <group>
                        <field name="space_type_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <group invisible="mode != 'space'">
                    <group>
                        <field name="space_id" required="mode == 'space'" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="date_from" required="mode == 'space'"/>
                        <field name="date_to" required="mode == 'space'"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="start_time" widget="float_time"/>
                    </group>
                    <group>
                        <field name="end_time" widget="float_time"/>
                    </group>
                </group>
                <group>
                    <field name="reason"/>
                </group>
                <div class="mb-3">
                    <button name="action_search" type="object" class="btn btn-primary"
                            string="Search free spaces" invisible="mode != 'date'"/>
                    <button name="action_search" type="object" class="btn btn-primary"
                            string="Search free days" invisible="mode != 'space'"/>
                </div>
                <field name="selected_line_id" invisible="1"/>
                <field name="line_ids" invisible="not line_ids" nolabel="1">
                    <list create="false" delete="false" edit="false" no_open="1" decoration-muted="not is_free and not space_id">
                        <field name="selected" widget="ems_radio_row" options="{'chosen_field': 'selected_line_id'}" nolabel="1"
                               width="40px" invisible="parent.mode == 'space' and not is_free"/>
                        <field name="space_id" column_invisible="parent.mode != 'date'"/>
                        <field name="space_type_id" column_invisible="parent.mode != 'date'" width="200px"/>
                        <field name="date" column_invisible="parent.mode != 'space'"/>
                        <field name="weekday" column_invisible="parent.mode != 'space'"/>
                        <field name="is_free" column_invisible="parent.mode != 'space'" widget="boolean"/>
                        <field name="detail" column_invisible="parent.mode != 'space'"/>
                    </list>
                </field>
                <footer>
                    <button name="action_reserve" type="object" string="Reserve" class="btn-primary"
                            invisible="not selected_line_id"/>
                    <!-- Looks disabled until a result is chosen (a button has no disabled attribute in a view). -->
                    <button name="action_reserve" type="object" string="Reserve" class="btn-primary disabled"
                            invisible="selected_line_id"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_space_reservation_wizard" model="ir.actions.act_window">
        <field name="name">Reserve a space</field>
        <field name="res_model">ems.space_reservation_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_space_reservation_list" model="ir.ui.view">
        <field name="name">ems.space_reservation.list</field>
        <field name="model">ems.space_reservation</field>
        <field name="arch" type="xml">
            <list default_order="start_datetime desc" create="false">
                <header>
                    <button name="%(action_space_reservation_wizard)d" type="action" string="New"
                            class="btn-primary" display="always"/>
                </header>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="space_id"/>
                <field name="reason"/>
                <field name="user_id"/>
                <field name="minute_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_space_reservation_form" model="ir.ui.view">
        <field name="name">ems.space_reservation.form</field>
        <field name="model">ems.space_reservation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="minute_id" invisible="not minute_id" readonly="1"/>
                            <field name="start_datetime" readonly="minute_id"/>
                            <field name="duration" widget="float_time" readonly="minute_id"/>
                            <field name="end_datetime"/>
                        </group>
                        <group>
                            <field name="available_space_ids" invisible="1"/>
                            <field name="space_id" options="{'no_create': True, 'no_open': True}"
                                   domain="[('id', 'in', available_space_ids)]" readonly="minute_id"/>
                            <field name="reason" readonly="minute_id"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_space_reservation_search" model="ir.ui.view">
        <field name="name">ems.space_reservation.search</field>
        <field name="model">ems.space_reservation</field>
        <field name="arch" type="xml">
            <search string="Space reservations">
                <field name="space_id"/>
                <field name="reason"/>
                <field name="user_id"/>
                <filter name="mine" string="My reservations" domain="[('user_id', '=', uid)]"/>
                <filter name="upcoming" string="Upcoming" domain="[('end_datetime', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_space" string="Space" context="{'group_by': 'space_id'}"/>
                    <filter name="group_user" string="Reserved by" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_space_reservation" model="ir.actions.act_window">
        <field name="name">Space reservations</field>
        <field name="res_model">ems.space_reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>

    <menuitem id="menu_space_reservation" name="Space reservations" sequence="2" parent="menu_spaces" action="action_space_reservation"/>
</odoo>
