<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_space_reservation_list" model="ir.ui.view">
        <field name="name">ems.space_reservation.list</field>
        <field name="model">ems.space_reservation</field>
        <field name="arch" type="xml">
            <list default_order="start_datetime desc">
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="space_id"/>
                <field name="reason"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="minute_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_space_reservation_form" model="ir.ui.view">
        <field name="name">ems.space_reservation.form</field>
        <field name="model">ems.space_reservation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="minute_id" invisible="not minute_id" readonly="1"/>
                            <field name="start_datetime" readonly="minute_id"/>
                            <field name="duration" widget="float_time" readonly="minute_id"/>
                            <field name="end_datetime"/>
                        </group>
                        <group>
                            <field name="available_space_ids" invisible="1"/>
                            <field name="space_id" options="{'no_create': True, 'no_open': True}"
                                   domain="[('id', 'in', available_space_ids)]" readonly="minute_id"/>
                            <field name="reason" readonly="minute_id"/>
                            <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_space_reservation_calendar" model="ir.ui.view">
        <field name="name">ems.space_reservation.calendar</field>
        <field name="model">ems.space_reservation</field>
        <field name="arch" type="xml">
            <calendar date_start="start_datetime" date_stop="end_datetime" string="Space reservations"
                      mode="week" color="space_id" quick_create="0" event_open_popup="1">
                <field name="space_id"/>
                <field name="reason"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_space_reservation_search" model="ir.ui.view">
        <field name="name">ems.space_reservation.search</field>
        <field name="model">ems.space_reservation</field>
        <field name="arch" type="xml">
            <search string="Space reservations">
                <field name="space_id"/>
                <field name="reason"/>
                <field name="user_id"/>
                <filter name="mine" string="My reservations" domain="[('user_id', '=', uid)]"/>
                <filter name="upcoming" string="Upcoming" domain="[('end_datetime', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_space" string="Space" context="{'group_by': 'space_id'}"/>
                    <filter name="group_user" string="Reserved by" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_space_reservation" model="ir.actions.act_window">
        <field name="name">Space reservations</field>
        <field name="res_model">ems.space_reservation</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>

    <menuitem id="menu_space_reservation" name="Space reservations" sequence="2" parent="menu_spaces" action="action_space_reservation"/>
</odoo>
