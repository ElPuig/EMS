<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_space_type_search" model="ir.ui.view">
            <field name="name">ems.space_type.search</field>
            <field name="model">ems.space_type</field>
            <field name="arch" type="xml">
                <search string="Space types">
                    <field name="name"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
