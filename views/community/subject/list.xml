<odoo>
    <data>        
        <record model="ir.ui.view" id="view_subject_list">
            <field name="name">ems.subject.list</field>
            <field name="model">ems.subject</field>
            <field name="arch" type="xml">
                <!-- <list expand="True" default_order="study_ids desc, acronym asc">  -->
                <list expand="False" default_order="acronym asc"> 
                    <field name="acronym"/>
                    <field name="name" class="w-50"/>                    
                    <field name="study_ids" widget="many2many_tags"/>
                    <!-- Hidden but needed to filter or display properly -->
                    <field name="code" column_invisible="True"/>                    
                </list>                               
            </field>
        </record>          
    </data>
</odoo>