<odoo>
    <data>
        <record model="ir.ui.view" id="view_subject_search">
            <field name="name">ems.subject.search</field>
            <field name="model">ems.subject</field>            
            <field name="arch" type="xml">                                         
                <search string="Studies">                   
                    <field name="study_ids"/>
                    <group expand="1" string="Group By">                        
                        <filter name="group_by_study" string="Studies" icon="fa-leanpub" domain="[]" context="{'group_by': 'study_ids'}"/>
                    </group>
                 
                    <!-- Does not work for many2many and the use of a view implies a lot of extra effort and complexity. -->
                    <!-- <searchpanel>
                        <field name="study_ids" group_expand="True" groupby="study_ids"/>
                    </searchpanel> -->
                </search>           
            </field>		      
        </record>   
    </data>
</odoo>