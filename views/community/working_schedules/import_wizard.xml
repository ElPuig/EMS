<odoo>
    <data>
        <record model="ir.ui.view" id="view_working_schedules_import_wizard">
            <field name="name">ems.working_schedules_import.wizard</field>
            <field name="model">ems.working_schedules_import_wizard</field>
            <field name="arch" type="xml">
                <form string="Session" js_class="ems_working_schedules_import_wizard_form">
                    <header>
                        <field name="state" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet>
                        <field name="ready_to_import" invisible="1"/>
                        <field name="continue_disabled" invisible="1"/>

                        <!-- Welcome: file upload only - no validation/banners here on purpose. Resolving
                             an unknown e-mail/group, a missing classroom or a schedule conflict is the
                             job of the later steps (2-6, see plans/working_schedule_import_redesign.md),
                             not something this screen should show or block on. -->
                        <div invisible="state != 'intro'">
                            <p>
                                Import a working-schedule batch (one or several planner files). Run this during
                                next-course preparation, once the previous course's schedules have already been
                                archived by the course transition wizard - running it against a course already in
                                progress can create conflicts/overlaps that then need manual resolution in the
                                following steps.
                            </p>
                            <group>
                                <field name="attachment_ids" widget="ems_blocking_many2many_binary" options="{'accepted_file_extensions': '.xml'}"/>
                            </group>
                        </div>

                        <div invisible="state != 'groups'">
                            <div class="alert alert-success" role="alert" invisible="group_line_ids">
                                Every group mentioned in the file was recognized.
                            </div>
                            <field name="group_line_ids" invisible="not group_line_ids">
                                <list editable="bottom" create="False" delete="False">
                                    <field name="raw_name" string="Name found in file"/>
                                    <field name="group_id"/>
                                </list>
                            </field>
                        </div>

                        <div class="alert alert-info" role="alert" invisible="state in ('intro', 'groups', 'override_info')">
                            This step is not implemented yet - "Continue" moves on without asking anything here for now.
                        </div>
                    </sheet>
                    <footer>
                        <!-- "Continue" always occupies the same spot while state != 'override_info' -
                             it renders enabled or disabled depending on 'continue_disabled', rather than
                             appearing/disappearing (developer feedback 2026-08-05). The second button is
                             a purely cosmetic, non-actionable twin (no 'name', type="button", static
                             disabled="disabled") shown only when the real one is hidden, so the label
                             never disappears from view - just its clickable state changes. -->
                        <button name="action_continue" string="Continue" type="object" class="btn-primary"
                            invisible="state == 'override_info' or continue_disabled"/>
                        <button name="action_continue_disabled" string="Continue" type="button" class="btn-primary" disabled="disabled"
                            invisible="state == 'override_info' or not continue_disabled"/>
                        <button name="import_planner_data" string="Import" type="object" class="btn-success"
                            icon="fa-calendar-plus-o" invisible="state != 'override_info'"/>
                        <button name="cancel" string="Cancel" special="cancel" class="btn-danger"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
