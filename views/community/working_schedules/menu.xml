<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>          
        <record model="ir.actions.act_window" id="action_working_schedules_tree">
            <field name="name">Working Schedules</field>
            <field name="res_model">resource.calendar</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_framework', '=', False)]</field>
        </record>

        <menuitem name="Working schedules" sequence="4" id="menu_work_locations" parent="menu_community_config_teachers" action="action_working_schedules_tree"/>

        <record model="ir.actions.act_window" id="action_schedule_frameworks_tree">
            <field name="name">Schedule Frameworks</field>
            <field name="res_model">resource.calendar</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_framework', '=', True)]</field>
            <field name="context">{'default_is_framework': True}</field>
        </record>

        <menuitem name="Schedule frameworks" sequence="1" id="menu_schedule_frameworks" parent="menu_community_config_schedules" action="action_schedule_frameworks_tree"/>
    </data>
</odoo>