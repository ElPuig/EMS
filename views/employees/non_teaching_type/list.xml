<odoo>
    <data>
        <record model="ir.ui.view" id="view_non_teaching_type_list">
            <field name="name">ems.non_teaching_type.list</field>
            <field name="model">ems.non_teaching_type</field>
            <field name="arch" type="xml">
                <list default_order="sequence, name">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="is_break" widget="boolean_toggle"/>
                    <field name="is_fixed" widget="boolean_toggle"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
