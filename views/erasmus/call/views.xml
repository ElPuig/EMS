<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #683 - Erasmus+ calls. See docs/en/developers/erasmus/erasmus.md. -->
        <record id="view_erasmus_call_list" model="ir.ui.view">
            <field name="name">ems.erasmus.call.list</field>
            <field name="model">ems.erasmus.call</field>
            <field name="arch" type="xml">
                <list string="Calls" decoration-muted="state == 'closed'">
                    <field name="name"/>
                    <field name="audience"/>
                    <field name="course_id" optional="show"/>
                    <field name="date_open"/>
                    <field name="date_close"/>
                    <field name="application_count"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                           decoration-success="state == 'published'"/>
                </list>
            </field>
        </record>

        <record id="view_erasmus_call_form" model="ir.ui.view">
            <field name="name">ems.erasmus.call.form</field>
            <field name="model">ems.erasmus.call</field>
            <field name="arch" type="xml">
                <form string="Call">
                    <header>
                        <div name="ems_actions" string="Actions">
                            <button name="action_publish" type="object" string="Publish" class="btn-primary"
                                    invisible="state != 'draft'"
                                    help="Shows the call on the portal to the students of its modalities' levels."/>
                            <!-- The issue-#682 review: the notice of the open call, by email. -->
                            <button name="action_announce" type="object" string="Notify who can apply"
                                    invisible="state != 'published'"
                                    help="Emails the call to every person who can apply to it."/>
                            <button name="action_close" type="object" string="Close applications"
                                    invisible="state != 'published'"
                                    confirm="Applications still in draft will be marked as not submitted. Continue?"/>
                            <button name="action_back_to_draft" type="object" string="Back to draft"
                                    invisible="state != 'published'"/>
                            <button name="action_send_to_panel" type="object" string="Send plans to the panel"
                                    invisible="audience != 'staff' or state != 'closed'"
                                    help="Asks every panel member to rate the mobility plan of every admitted application."/>
                            <!-- Audit D-13: the ties left after every tie-break, drawn by EMS and kept. -->
                            <button name="action_draw_ties" type="object" string="Draw the ties"
                                    invisible="not needs_draw"
                                    groups="ems.group_erasmus_coordinator,ems.group_academic_admin"
                                    confirm="EMS orders each tied set at random and keeps the draw: it cannot be undone. Continue?"
                                    help="Resolves the ties left in the ranking after every tie-break, as the call says."/>
                            <button name="action_schedule_interviews" type="object" string="Schedule interviews"
                                    invisible="audience != 'student' or state != 'closed' or has_provisional_resolution"
                                    groups="ems.group_erasmus,ems.group_academic_admin"
                                    help="Gives the admitted applicants consecutive interview slots, with their evaluators, and sends them the calls."/>
                            <button name="action_offer_place" type="object" string="Offer a free place"
                                    invisible="not has_final_resolution"
                                    help="Offers a place left free by a renunciation to the next reserve of the modality."/>
                            <button name="action_export_participants" type="object" string="Export to spreadsheet"
                                    invisible="not has_final_resolution" groups="ems.group_erasmus,ems.group_academic_admin"
                                    help="Downloads an .xlsx with the people who accepted a place."/>
                            <button name="action_open_destination_choice" type="object" string="Open destination choice"
                                    invisible="audience != 'student' or not has_final_resolution or choice_open"
                                    groups="ems.group_erasmus,ems.group_academic_admin"
                                    help="The selected who accepted their place choose their destination on the portal, by turns in rank order."/>
                        </div>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <!-- The issue-#682 review: each button only in its phase, the latest phase first, so
                             none ends up hidden in "More". -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_applications" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="application_count" widget="statinfo" string="Applications"/>
                            </button>
                            <button name="action_view_mobilities" type="object" class="oe_stat_button" icon="fa-plane"
                                    string="Mobilities" invisible="not has_final_resolution"/>
                            <button name="action_view_offers" type="object" class="oe_stat_button" icon="fa-envelope-open-o"
                                    invisible="not has_final_resolution"
                                    groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value"><field name="places_accepted"/> / <field name="places_total"/></span>
                                    <span class="o_stat_text">Places accepted</span>
                                </div>
                            </button>
                            <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-exclamation-circle"
                                    string="Claims" invisible="not has_provisional_resolution"
                                    groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>
                            <button name="action_view_resolutions" type="object" class="oe_stat_button" icon="fa-gavel"
                                    string="Resolutions" invisible="state != 'closed'"
                                    groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>
                            <button name="action_view_ranking" type="object" class="oe_stat_button" icon="fa-trophy"
                                    string="Ranking" invisible="state != 'closed' or has_final_resolution"/>
                            <button name="action_view_interviews" type="object" class="oe_stat_button" icon="fa-comments"
                                    string="Interviews" invisible="audience != 'student' or state != 'closed' or has_final_resolution"
                                    groups="ems.group_erasmus,ems.group_academic_admin"/>
                            <button name="action_view_plan_ratings" type="object" class="oe_stat_button" icon="fa-star-half-o"
                                    string="Plan ratings" invisible="audience != 'staff' or state != 'closed' or has_final_resolution"
                                    groups="ems.group_erasmus,ems.group_academic_admin"/>
                        </div>
                        <field name="has_final_resolution" invisible="1"/>
                        <field name="has_provisional_resolution" invisible="1"/>
                        <field name="needs_draw" invisible="1"/>
                        <!-- Where the coordinator sees it on opening the call. -->
                        <div class="alert alert-info" role="alert" invisible="not has_final_resolution or not offers_pending"
                             groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin">
                            <field name="offers_pending" class="fw-bold"/> place offers are waiting for an answer
                            (<field name="places_accepted" class="fw-bold"/> of <field name="places_total" class="fw-bold"/> places accepted).
                        </div>
                        <div class="alert alert-warning" role="alert" invisible="not needs_draw">
                            There is a tie in the ranking: the Erasmus coordinator resolves it with a draw (Actions, Draw the ties).
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Erasmus+ internships 2026-27"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="audience" readonly="application_count"/>
                                <field name="staff_level_ids" widget="many2many_tags" invisible="audience != 'staff'"
                                       required="audience == 'staff' and state != 'draft'"/>
                                <field name="validator_ids" widget="many2many_tags" invisible="audience != 'staff'"
                                       required="audience == 'staff' and state != 'draft'"/>
                                <field name="course_id"/>
                                <field name="rules_document" filename="rules_filename"/>
                                <field name="rules_filename" invisible="1"/>
                            </group>
                            <group>
                                <field name="date_open" options="{'show_seconds': False}"/>
                                <field name="date_close" options="{'show_seconds': False}"/>
                                <field name="subsanation_deadline" options="{'show_seconds': False}"/>
                                <field name="interview_deadline" options="{'show_seconds': False}"/>
                                <field name="claims_deadline" options="{'show_seconds': False}"/>
                                <field name="acceptance_deadline" options="{'show_seconds': False}"/>
                                <field name="min_score" invisible="audience == 'staff'"/>
                                <field name="is_accepting"/>
                                <field name="reminder_days"/>
                                <label for="announce_date" invisible="not announce_date"/>
                                <div class="o_row" invisible="not announce_date">
                                    <field name="announce_date" options="{'show_seconds': False}"/>
                                    <span>(<field name="announce_count" class="oe_inline"/> people)</span>
                                </div>
                                <label for="reminder_date" invisible="not reminder_date"/>
                                <div class="o_row" invisible="not reminder_date">
                                    <field name="reminder_date" options="{'show_seconds': False}"/>
                                    <span>(<field name="reminder_count" class="oe_inline"/> people)</span>
                                </div>
                            </group>
                        </group>
                        <!-- The issue-#682 review: ten tabs in two blocks, the selection and the mobility. -->
                        <notebook>
                            <page string="Selection" name="selection_block">
                                <notebook>
                                    <page string="Modalities" name="modalities">
                                        <field name="modality_ids">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="name"/>
                                                <field name="level_ids" widget="many2many_tags"
                                                       column_invisible="parent.audience == 'staff'"/>
                                                <field name="project"/>
                                                <field name="places"/>
                                                <field name="period" column_invisible="parent.audience == 'staff'"/>
                                                <field name="destinations" column_invisible="parent.audience == 'staff'"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Documents" name="documents">
                                        <field name="document_ids">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="name"/>
                                                <field name="requirement"/>
                                                <field name="upload_kind"/>
                                                <field name="single_file" optional="show"/>
                                                <field name="confidential"/>
                                                <field name="panel_visible" column_invisible="parent.audience != 'staff'"/>
                                                <field name="description"/>
                                                <field name="help_url" widget="url" optional="show"/>
                                                <field name="template_filename" column_invisible="1"/>
                                                <field name="template_file" filename="template_filename" optional="show"/>
                                                <field name="file_category" optional="hide"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Information for applicants" name="description">
                                        <field name="description"/>
                                    </page>
                                    <!-- Issue #686: who rates the staff's mobility plans. -->
                                    <page string="Panel" name="panel" invisible="audience != 'staff'">
                                        <field name="panel_ids">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="user_id" options="{'no_create': True}"/>
                                                <field name="post"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Resolutions" name="resolutions" invisible="state != 'closed'">
                                        <field name="resolution_ids" context="{'default_call_id': id}">
                                            <!-- A published resolution is never deleted: no bin here (a draft one, from its own form). -->
                                            <list delete="false">
                                                <field name="kind"/>
                                                <field name="publish_date"/>
                                                <field name="state" widget="badge" decoration-info="state == 'draft'"
                                                       decoration-success="state == 'published'"/>
                                            </list>
                                        </field>
                                        <group string="Draws" invisible="not draw_ids">
                                            <field name="draw_ids" nolabel="1" colspan="2">
                                                <list>
                                                    <field name="date"/>
                                                    <field name="user_id"/>
                                                    <field name="score_total"/>
                                                    <field name="tied_count"/>
                                                    <field name="line_ids" widget="many2many_tags" string="Order drawn"/>
                                                </list>
                                            </field>
                                        </group>
                                        <group string="Places" invisible="not has_final_resolution or audience != 'staff'">
                                            <field name="free_places"/>
                                            <field name="next_reserve_id"/>
                                        </group>
                                        <group string="Places" invisible="not has_final_resolution or audience != 'student'">
                                            <field name="modality_ids" nolabel="1" colspan="2" readonly="1">
                                                <list>
                                                    <field name="name"/>
                                                    <field name="places"/>
                                                    <field name="free_places"/>
                                                    <field name="next_reserve_id"/>
                                                </list>
                                            </field>
                                        </group>
                                    </page>
                                </notebook>
                            </page>
                            <page string="Mobility" name="mobility_block">
                                <notebook>
                                    <!-- Issue #687: mobility preparation. -->
                                    <page string="Destinations" name="destinations" invisible="audience != 'student'">
                                        <group>
                                            <field name="choice_turn_hours"/>
                                            <field name="choice_open"/>
                                        </group>
                                        <field name="destination_ids" context="{'default_call_id': id}">
                                            <list editable="bottom">
                                                <field name="call_id" column_invisible="1"/>
                                                <field name="sequence" widget="handle"/>
                                                <field name="modality_id" options="{'no_create': True}"/>
                                                <field name="name"/>
                                                <field name="country_id"/>
                                                <field name="city"/>
                                                <field name="places"/>
                                                <field name="free_places"/>
                                                <field name="level_ids" widget="many2many_tags"/>
                                                <field name="date_start"/>
                                                <field name="date_end"/>
                                                <field name="host_partner_ids" widget="many2many_tags" optional="hide"/>
                                                <field name="notes" optional="hide"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Mobility documents" name="preparation_documents">
                                        <field name="preparation_document_ids"
                                               context="{'default_stage': 'preparation', 'default_due_basis': 'destination', 'default_due_days': 30}">
                                            <list editable="bottom">
                                                <field name="call_id" column_invisible="1"/>
                                                <field name="sequence" widget="handle"/>
                                                <field name="stage"/>
                                                <field name="name"/>
                                                <field name="requirement"/>
                                                <field name="modality_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                                <field name="project"/>
                                                <field name="sign_participant" string="Participant"/>
                                                <field name="sign_guardian" string="Legal guardian"/>
                                                <field name="sign_director" string="Director"/>
                                                <field name="sign_coordinator" string="Erasmus coordinator"/>
                                                <field name="sign_tutor" string="Centre's tutor"/>
                                                <field name="sign_host" string="Host entity"/>
                                                <field name="sign_template_id" optional="show"
                                                       invisible="not (sign_participant or sign_guardian or sign_director or sign_coordinator or sign_tutor or sign_host)"/>
                                                <field name="open_days" optional="show"/>
                                                <field name="due_basis"/>
                                                <field name="due_days"/>
                                                <field name="handled_by"/>
                                                <field name="description"/>
                                                <field name="file_category" optional="show"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Commitment letter" name="commitment_letter" invisible="audience != 'student'">
                                        <field name="commitment_text"/>
                                    </page>
                                    <page string="Checklist" name="checklist">
                                        <field name="task_ids">
                                            <list editable="bottom">
                                                <field name="call_id" column_invisible="1"/>
                                                <field name="sequence" widget="handle"/>
                                                <field name="stage"/>
                                                <field name="name"/>
                                                <field name="requirement"/>
                                                <field name="modality_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                                <field name="project"/>
                                                <field name="description"/>
                                            </list>
                                        </field>
                                    </page>
                                    <!-- Issue #697: what the participants answer every week of the stay. -->
                                    <page string="Weekly self-assessment" name="self_assessment">
                                        <field name="self_assessment_question_ids">
                                            <list editable="bottom">
                                                <field name="call_id" column_invisible="1"/>
                                                <field name="sequence" widget="handle"/>
                                                <field name="name"/>
                                                <field name="kind"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_erasmus_call" model="ir.actions.act_window">
            <field name="name">Calls</field>
            <field name="res_model">ems.erasmus.call</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- The issue-#682 review: the notice of the open call, confirmed by the Erasmus team. -->
        <record id="view_erasmus_call_announce_form" model="ir.ui.view">
            <field name="name">ems.erasmus.call.announce.form</field>
            <field name="model">ems.erasmus.call.announce</field>
            <field name="arch" type="xml">
                <form string="Notify who can apply">
                    <p class="text-muted">
                        EMS emails the call, with the link to apply on the portal, to each person who can apply to it, at their own address.
                    </p>
                    <div class="alert alert-warning" role="alert" invisible="not announce_date">
                        The notice was already sent on <field name="announce_date" readonly="1" class="oe_inline"/>
                        to <field name="announce_count" class="oe_inline"/> people. Sending it again emails all of them again.
                    </div>
                    <group>
                        <field name="call_id" readonly="1" options="{'no_open': True}"/>
                        <field name="recipient_count"/>
                        <field name="without_email_count" invisible="not without_email_count"/>
                        <field name="reminder_days"/>
                    </group>
                    <footer>
                        <button name="action_send" type="object" string="Send the notice" class="btn-primary"
                                invisible="not recipient_count"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_erasmus_call_announce" model="ir.actions.act_window">
            <field name="name">Notify who can apply</field>
            <field name="res_model">ems.erasmus.call.announce</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
