<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #684 - Erasmus+ interviews: each evaluator scores annex 4's rubric. See
             docs/en/developers/erasmus/erasmus.md. -->
        <record id="view_erasmus_interview_list" model="ir.ui.view">
            <field name="name">ems.erasmus.interview.list</field>
            <field name="model">ems.erasmus.interview</field>
            <field name="arch" type="xml">
                <list string="Interviews" create="false" decoration-muted="state == 'submitted'">
                    <field name="interview_date" options="{'show_seconds': False}"/>
                    <field name="partner_id"/>
                    <field name="call_name" optional="show"/>
                    <field name="modality_name"/>
                    <!-- In "My evaluations" the evaluator is always oneself; no total before scoring. -->
                    <field name="evaluator_id" optional="show" column_invisible="context.get('ems_my_evaluations')"/>
                    <field name="general_score" invisible="state == 'draft'"/>
                    <field name="english_score" invisible="state == 'draft'"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                           decoration-success="state == 'submitted'"/>
                </list>
            </field>
        </record>

        <record id="view_erasmus_interview_search" model="ir.ui.view">
            <field name="name">ems.erasmus.interview.search</field>
            <field name="model">ems.erasmus.interview</field>
            <field name="arch" type="xml">
                <search>
                    <field name="partner_id"/>
                    <field name="evaluator_id"/>
                    <filter name="to_score" string="To score" domain="[('state', '=', 'draft')]"/>
                    <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                    <group>
                        <filter name="group_evaluator" string="Evaluator" context="{'group_by': 'evaluator_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_erasmus_interview_form" model="ir.ui.view">
            <field name="name">ems.erasmus.interview.form</field>
            <field name="model">ems.erasmus.interview</field>
            <field name="arch" type="xml">
                <form string="Interview" create="false">
                    <header>
                        <div name="ems_actions" string="Actions">
                            <button name="action_submit" type="object" string="Submit" class="btn-primary"
                                    invisible="state != 'draft'"/>
                            <button name="action_submit_next" type="object" string="Submit and next"
                                    invisible="state != 'draft'"
                                    help="Submits this interview and opens the next one you still have to score."/>
                            <button name="action_reopen" type="object" string="Reopen"
                                    invisible="state != 'submitted'"/>
                        </div>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="partner_id" readonly="1"/></h1>
                        </div>
                        <field name="is_locked" invisible="1"/>
                        <div class="alert alert-warning" role="alert" invisible="not is_locked">
                            The review deadline has passed: only the Erasmus team can reopen this interview.
                        </div>
                        <group>
                            <group>
                                <field name="call_name"/>
                                <field name="modality_name"/>
                                <field name="evaluator_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="interview_date" options="{'show_seconds': False}"/>
                                <field name="interview_place"/>
                                <field name="submit_date" options="{'show_time': False}"/>
                            </group>
                        </group>
                        <group>
                            <group string="General part (0-5 each)">
                                <field name="motivation" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <div colspan="2" class="text-muted small mb-2 o_ems_erasmus_rubric">0-1: mainly living abroad or leisure, unrelated to the cycle. 2-3: general training motivation. 4-5: explains what they want to learn, how it relates to the cycle and their future, and how they expect to grow.</div>
                                <field name="maturity" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <div colspan="2" class="text-muted small mb-2 o_ems_erasmus_rubric">0-1: no idea of living alone abroad or of the expenses. 2-3: a general idea, with gaps. 4-5: knows how to organise travel, housing, food and the grant.</div>
                                <field name="difficulties" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <div colspan="2" class="text-muted small mb-2 o_ems_erasmus_rubric">0-1: would give up or keep quiet. 2-3: aware of difficulties, vague answers. 4-5: would talk to the company and the Erasmus coordination, look for solutions and not give up.</div>
                                <field name="adaptation" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <div colspan="2" class="text-muted small mb-2 o_ems_erasmus_rubric">0-1: very short or unclear answers. 2-3: communicates correctly. 4-5: clear and confident, open to other cultures and ways of working.</div>
                                <field name="general_score"/>
                            </group>
                            <group string="English part (0-5 each)">
                                <field name="comprehension" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <div colspan="2" class="text-muted small mb-2 o_ems_erasmus_rubric">0-1: does not understand most questions. 2-3: understands simple questions. 4-5: understands without difficulty, work questions too.</div>
                                <field name="fluency" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <div colspan="2" class="text-muted small mb-2 o_ems_erasmus_rubric">0-1: single words. 2-3: a simple conversation with pauses and help. 4-5: fluent, asks and reacts naturally.</div>
                                <field name="accuracy" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <div colspan="2" class="text-muted small mb-2 o_ems_erasmus_rubric">0-1: constant errors, hard to understand. 2-3: errors that do not prevent understanding. 4-5: few errors, varied and professional vocabulary.</div>
                                <field name="english_score"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" readonly="state != 'draft'"/>
                            <field name="rectification_note" invisible="not is_locked"
                                   groups="ems.group_erasmus,ems.group_academic_admin"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_erasmus_my_interviews" model="ir.actions.act_window">
            <field name="name">My evaluations</field>
            <field name="res_model">ems.erasmus.interview</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('evaluator_id', '=', uid)]</field>
            <field name="context">{'search_default_to_score': 1, 'ems_my_evaluations': 1}</field>
            <field name="search_view_id" ref="view_erasmus_interview_search"/>
        </record>

        <record id="action_erasmus_interview" model="ir.actions.act_window">
            <field name="name">Interviews</field>
            <field name="res_model">ems.erasmus.interview</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_erasmus_interview_search"/>
        </record>

        <!-- The issue-#682 review: many interviews at once, from the call. -->
        <record id="view_erasmus_interview_schedule_form" model="ir.ui.view">
            <field name="name">ems.erasmus.interview.schedule.form</field>
            <field name="model">ems.erasmus.interview.schedule</field>
            <field name="arch" type="xml">
                <form string="Schedule interviews">
                    <p class="text-muted">
                        EMS gives each applicant, in the order of the list, the next slot from the first interview on, in the same place, and assigns them the evaluators.
                    </p>
                    <group>
                        <group>
                            <field name="call_id" readonly="1" options="{'no_open': True}"/>
                            <field name="modality_id" options="{'no_create': True}"/>
                            <field name="place"/>
                            <field name="evaluator_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_start" options="{'show_seconds': False}"/>
                            <field name="duration"/>
                            <field name="send_call"/>
                        </group>
                    </group>
                    <field name="application_ids" options="{'no_create': True}">
                        <list>
                            <field name="partner_id"/>
                            <field name="modality_id"/>
                            <field name="interview_date" options="{'show_seconds': False}"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_confirm" type="object" string="Schedule" class="btn-primary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_erasmus_interview_schedule" model="ir.actions.act_window">
            <field name="name">Schedule interviews</field>
            <field name="res_model">ems.erasmus.interview.schedule</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
