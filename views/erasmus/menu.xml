<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #683: the Erasmus team manages calls and applications; the Head of Studies and
             the Director open the applications for the serious-sanction check. Issue #684: whoever has
             an interview to score (ems.group_erasmus_evaluator) sees only "My evaluations". -->
        <menuitem name="Erasmus+" sequence="9" id="menu_erasmus"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_erasmus_evaluator,ems.group_academic_admin"/>

        <menuitem name="Applications" sequence="1" id="menu_erasmus_applications"
                  parent="menu_erasmus" action="action_erasmus_application"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="Ranking" sequence="2" id="menu_erasmus_ranking"
                  parent="menu_erasmus" action="action_erasmus_ranking"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="Interviews" sequence="3" id="menu_erasmus_interviews"
                  parent="menu_erasmus" action="action_erasmus_interview"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>

        <menuitem name="My evaluations" sequence="4" id="menu_erasmus_my_interviews"
                  parent="menu_erasmus" action="action_erasmus_my_interviews"
                  groups="ems.group_erasmus_evaluator"/>

        <!-- Issue #686: the staff's mobility plans, rated by the call's panel. -->
        <menuitem name="Plan ratings" sequence="3" id="menu_erasmus_plan_ratings"
                  parent="menu_erasmus" action="action_erasmus_plan_rating"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>

        <menuitem name="My plan ratings" sequence="4" id="menu_erasmus_my_plan_ratings"
                  parent="menu_erasmus" action="action_erasmus_my_plan_ratings"
                  groups="ems.group_erasmus_evaluator"/>

        <!-- Issue #685: resolutions, place offers and claims; the Head of Studies and the Director read them. -->
        <menuitem name="Resolutions" sequence="5" id="menu_erasmus_resolutions"
                  parent="menu_erasmus" action="action_erasmus_resolution"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="Place offers" sequence="6" id="menu_erasmus_offers"
                  parent="menu_erasmus" action="action_erasmus_offer"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <!-- Issue #687: mobility preparation; the Director validates the staff's activities from here. -->
        <menuitem name="Mobilities" sequence="7" id="menu_erasmus_mobilities"
                  parent="menu_erasmus" action="action_erasmus_mobility"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="Claims" sequence="7" id="menu_erasmus_claims"
                  parent="menu_erasmus" action="action_erasmus_claim"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="Projects" sequence="9" id="menu_erasmus_projects"
                  parent="menu_erasmus" action="action_erasmus_project"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>

        <menuitem name="Calls" sequence="8" id="menu_erasmus_calls"
                  parent="menu_erasmus" action="action_erasmus_call"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>
    </data>
</odoo>
