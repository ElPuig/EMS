<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #683: the Erasmus team manages calls and applications; the Head of Studies and
             the Director read the applications. Issue #684: whoever has an interview to score
             (ems.group_erasmus_evaluator) sees only "My evaluations"; issue #686, a panel member with
             plans to rate (ems.group_erasmus_panel), only "My plan ratings". -->
        <!-- The 2026-11-03 review: every teacher sees the app too, since the staff call is applied to
             from it ("My participation"), right below Meetings (same sequence, created later). -->
        <menuitem name="Erasmus+" sequence="9" id="menu_erasmus"
                  groups="ems.group_teacher,ems.group_erasmus,ems.group_head_of_studies,ems.group_erasmus_evaluator,ems.group_erasmus_panel,ems.group_secretary,ems.group_academic_admin,ems.group_erasmus_group_teacher"/>

        <!-- Sections, like the rest of EMS (the issue-#682 review): the call process, the mobilities
             and the money, which the Erasmus team manages; then what is one's own as a participant
             ("My participation", like Staff attendance's "My time off"); and the configuration. Each
             one shows only to whoever sees one of its entries. Opening the app runs its first entry:
             "My participation" goes after the management sections so the team lands on the calls,
             and the staff call entries last in it so an interviewer or a panel member lands on their own
             scoring; a teacher with nothing else lands on the staff calls. -->
        <menuitem name="My participation" sequence="80" id="menu_erasmus_section_mine" parent="menu_erasmus"
                  groups="ems.group_teacher,ems.group_erasmus_evaluator,ems.group_erasmus_panel,ems.group_erasmus_group_teacher"/>
        <!-- The 2026-11-04 review: staff apply and prepare their mobility here, never on the portal
             (views/erasmus/staff/views.xml). -->
        <menuitem name="Staff calls" sequence="9" id="menu_erasmus_staff_calls"
                  parent="menu_erasmus_section_mine" action="action_erasmus_staff_calls"
                  groups="ems.group_teacher"/>
        <menuitem name="My applications" sequence="10" id="menu_erasmus_my_applications"
                  parent="menu_erasmus_section_mine" action="action_erasmus_my_applications"
                  groups="ems.group_teacher"/>
        <menuitem name="My mobilities" sequence="11" id="menu_erasmus_my_mobilities"
                  parent="menu_erasmus_section_mine" action="action_erasmus_my_mobilities"
                  groups="ems.group_teacher"/>
        <menuitem name="Calls" sequence="10" id="menu_erasmus_section_calls" parent="menu_erasmus"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>
        <menuitem name="Mobilities" sequence="20" id="menu_erasmus_section_mobilities" parent="menu_erasmus"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>
        <menuitem name="Financial management" sequence="30" id="menu_erasmus_section_finances" parent="menu_erasmus"
                  groups="ems.group_erasmus,ems.group_secretary,ems.group_academic_admin"/>
        <menuitem name="Configuration" sequence="90" id="menu_erasmus_section_config" parent="menu_erasmus"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>

        <menuitem name="Applications" sequence="2" id="menu_erasmus_applications"
                  parent="menu_erasmus_section_calls" action="action_erasmus_application"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="Ranking" sequence="3" id="menu_erasmus_ranking"
                  parent="menu_erasmus_section_calls" action="action_erasmus_ranking"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="My evaluations" sequence="1" id="menu_erasmus_my_interviews"
                  parent="menu_erasmus_section_mine" action="action_erasmus_my_interviews"
                  groups="ems.group_erasmus_evaluator"/>

        <!-- The interviews (issue #684) and the panel's plan ratings (issue #686) belong to one call:
             the team opens them from the call's form, not from the menu (the issue-#682 review). -->
        <menuitem name="My plan ratings" sequence="2" id="menu_erasmus_my_plan_ratings"
                  parent="menu_erasmus_section_mine" action="action_erasmus_my_plan_ratings"
                  groups="ems.group_erasmus_panel,-ems.group_erasmus_evaluator"/>

        <!-- Issue #685: resolutions, place offers and claims; the Head of Studies and the Director read them. -->
        <menuitem name="Resolutions" sequence="7" id="menu_erasmus_resolutions"
                  parent="menu_erasmus_section_calls" action="action_erasmus_resolution"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="Place offers" sequence="8" id="menu_erasmus_offers"
                  parent="menu_erasmus_section_calls" action="action_erasmus_offer"
                  groups="ems.group_erasmus,ems.group_academic_admin,-ems.group_head_of_studies"/>

        <!-- Issue #687: mobility preparation; the Director validates the staff's activities from here. -->
        <menuitem name="Individual mobilities" sequence="1" id="menu_erasmus_mobilities"
                  parent="menu_erasmus_section_mobilities" action="action_erasmus_mobility"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <!-- The Head of Studies and the Director don't act on the place offers nor the claims: they
             open them from the call if they need to (the issue-#682 review). An upgrade only adds a
             menu's groups, so the ones taken away are removed explicitly with "-". -->
        <menuitem name="Claims" sequence="6" id="menu_erasmus_claims"
                  parent="menu_erasmus_section_calls" action="action_erasmus_claim"
                  groups="ems.group_erasmus,ems.group_academic_admin,-ems.group_head_of_studies"/>

        <menuitem name="Pending validation" sequence="0" id="menu_erasmus_mobilities_to_validate"
                  parent="menu_erasmus_section_mobilities" action="action_erasmus_mobility_to_validate"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <menuitem name="Projects" sequence="1" id="menu_erasmus_projects"
                  parent="menu_erasmus_section_finances" action="action_erasmus_project"
                  groups="ems.group_erasmus,ems.group_secretary,ems.group_academic_admin"/>

        <menuitem name="Calls" sequence="1" id="menu_erasmus_calls"
                  parent="menu_erasmus_section_calls" action="action_erasmus_call"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>

        <!-- Issue #697: host entities, invoices and grant payments; the Secretary pays the grants and
             reads the invoices. -->
        <menuitem name="Host entities" sequence="1" id="menu_erasmus_host_entities"
                  parent="menu_erasmus_section_config" action="action_erasmus_host_entity"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>

        <menuitem name="Invoices" sequence="2" id="menu_erasmus_invoices"
                  parent="menu_erasmus_section_finances" action="action_erasmus_invoice"
                  groups="ems.group_erasmus,ems.group_secretary,ems.group_academic_admin"/>

        <menuitem name="Grant payments" sequence="3" id="menu_erasmus_payments"
                  parent="menu_erasmus_section_finances" action="action_erasmus_payment"
                  groups="ems.group_erasmus,ems.group_secretary,ems.group_academic_admin"/>

        <!-- Issues #701-#704: group mobilities. The coordinator's overview, and each leader or
             accompanying teacher's own ones. -->
        <menuitem name="Group mobilities" sequence="2" id="menu_erasmus_group_mobilities"
                  parent="menu_erasmus_section_mobilities" action="action_erasmus_group_mobility"
                  groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>

        <!-- Erasmus+ quality (ISO 9001 and the Mobilitat FP network): the indicators and the
             satisfaction surveys, for the team; names only for the coordinator (field groups). -->
        <menuitem name="Quality" sequence="40" id="menu_erasmus_section_quality" parent="menu_erasmus"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>
        <menuitem name="Indicators" sequence="1" id="menu_erasmus_quality_panel"
                  parent="menu_erasmus_section_quality" action="action_erasmus_quality_panel"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>
        <menuitem name="Satisfaction surveys" sequence="2" id="menu_erasmus_satisfaction"
                  parent="menu_erasmus_section_quality" action="action_erasmus_satisfaction"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>
        <menuitem name="Low scores" sequence="3" id="menu_erasmus_satisfaction_low"
                  parent="menu_erasmus_section_quality" action="action_erasmus_satisfaction_low"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>
        <menuitem name="Diffusion actions" sequence="4" id="menu_erasmus_diffusion"
                  parent="menu_erasmus_section_quality" action="action_erasmus_diffusion"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>
        <menuitem name="Earlier courses" sequence="5" id="menu_erasmus_quality_history"
                  parent="menu_erasmus_section_quality" action="action_erasmus_quality_history"
                  groups="ems.group_erasmus,ems.group_academic_admin"/>

        <menuitem name="My group mobilities" sequence="3" id="menu_erasmus_my_group_mobilities"
                  parent="menu_erasmus_section_mine" action="action_erasmus_my_group_mobility"
                  groups="ems.group_erasmus_group_teacher"/>
    </data>
</odoo>
