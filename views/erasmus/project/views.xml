<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #687 - the centre's Erasmus+ projects, to which each mobility is assigned. Their
             documents in five categories, the state of the participants' records, and the ZIP
             exports (ems.erasmus.export), logged. -->
        <record id="view_erasmus_project_list" model="ir.ui.view">
            <field name="name">ems.erasmus.project.list</field>
            <field name="model">ems.erasmus.project</field>
            <field name="arch" type="xml">
                <!-- Issue #782 (10.9): no switch that archives a project with one click: it is archived
                     from Actions, as everywhere in Odoo. -->
                <list string="Projects" decoration-muted="not active">
                    <field name="name"/>
                    <field name="kind"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="keep_until" optional="hide"/>
                    <field name="active" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_erasmus_project_search" model="ir.ui.view">
            <field name="name">ems.erasmus.project.search</field>
            <field name="model">ems.erasmus.project</field>
            <field name="arch" type="xml">
                <search string="Projects">
                    <field name="name"/>
                    <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_erasmus_project_form" model="ir.ui.view">
            <field name="name">ems.erasmus.project.form</field>
            <field name="model">ems.erasmus.project</field>
            <field name="arch" type="xml">
                <form string="Project">
                    <header>
                        <div name="ems_actions" string="Actions">
                            <button name="action_export" type="object" string="Download the project archive (ZIP)"
                                    class="btn-primary" invisible="not id"
                                    groups="ems.group_erasmus,ems.group_secretary,ems.group_academic_admin"
                                    help="Every document of the project as a ZIP in its five categories, with every participant's record, an index of what is missing and the files' hashes."/>
                        </div>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. 2026-1-ES01-KA121-VET-000123456"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="kind"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="budget"/>
                                <field name="final_payment_date"/>
                                <field name="keep_until"/>
                                <field name="retention_hold"/>
                                <field name="retention_note" invisible="not retention_hold" required="retention_hold"/>
                                <field name="retention_notice_date" invisible="not retention_notice_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Documentation" name="documents">
                                <group groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin">
                                    <group>
                                        <field name="record_count"/>
                                        <field name="record_complete_count"/>
                                    </group>
                                    <group>
                                        <field name="record_missing_count" decoration-danger="record_missing_count"/>
                                    </group>
                                </group>
                                <field name="document_ids" context="{'default_project_id': id}">
                                    <list editable="bottom">
                                        <field name="project_id" column_invisible="1"/>
                                        <field name="category"/>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="attachment_ids" widget="many2many_binary"/>
                                        <field name="mobility_ids" widget="many2many_tags" optional="show"
                                               options="{'no_create': True}"
                                               groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>
                                        <field name="participant_category" optional="hide"
                                               groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin"/>
                                        <field name="confidential" optional="show"
                                               groups="ems.group_erasmus,ems.group_academic_admin"/>
                                        <field name="notes" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Mobilities" name="mobilities" groups="ems.group_erasmus,ems.group_head_of_studies,ems.group_academic_admin">
                                <!-- Issue #782 (10.11): both tables with a title, shown only when there is any. -->
                                <separator string="Individual mobilities" invisible="not mobility_ids"/>
                                <field name="mobility_ids" readonly="1" invisible="not mobility_ids">
                                    <list decoration-muted="state == 'cancelled'">
                                        <field name="partner_id"/>
                                        <field name="call_id"/>
                                        <field name="modality_id"/>
                                        <field name="destination_id" optional="show"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="record_progress"/>
                                        <field name="record_missing" string="Pending" decoration-danger="record_missing"
                                               decoration-success="not record_missing"/>
                                        <field name="state" widget="badge"/>
                                        <button name="action_open" type="object" string="Open the record" icon="fa-folder-open-o"/>
                                    </list>
                                </field>
                                <separator string="Group mobilities" invisible="not group_mobility_ids"/>
                                <field name="group_mobility_ids" readonly="1" invisible="not group_mobility_ids">
                                    <list decoration-muted="state == 'cancelled'">
                                        <field name="name"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="selected_count" string="Selected"/>
                                        <field name="documents_missing" string="Pending" decoration-danger="documents_missing"
                                               decoration-success="not documents_missing"/>
                                        <field name="documents_to_review" string="To review"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Invoices" name="invoices" groups="ems.group_erasmus,ems.group_secretary,ems.group_academic_admin">
                                <field name="invoice_ids" readonly="1">
                                    <list>
                                        <field name="date"/>
                                        <field name="name"/>
                                        <field name="supplier_id"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Grant payments" name="payments" groups="ems.group_erasmus,ems.group_secretary,ems.group_academic_admin">
                                <field name="payment_ids" readonly="1">
                                    <list>
                                        <field name="partner_id"/>
                                        <field name="kind"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="state" widget="badge"/>
                                        <field name="paid_date"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Exports" name="exports" groups="ems.group_erasmus,ems.group_secretary,ems.group_academic_admin">
                                <field name="export_ids" readonly="1">
                                    <!-- Issue #782 (10.12): the log the audits ask for, readable: when, who, what
                                         (with the participant's or the group's name), confidential, files. -->
                                    <list>
                                        <field name="date" string="Date" options="{'show_time': False}"/>
                                        <field name="requester_id" string="Who"/>
                                        <field name="subject"/>
                                        <field name="scope" optional="hide"/>
                                        <field name="mobility_id" optional="hide"/>
                                        <field name="include_confidential" string="Confidential"/>
                                        <field name="reason" optional="hide"/>
                                        <field name="file_count" widget="ems_blank_zero"/>
                                        <field name="missing_count" widget="ems_blank_zero" optional="hide"/>
                                        <field name="zip_sha256" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- The dialog that asks for an export: an audit export (with the confidential documents)
             only for the Erasmus coordinator and the administrator, with a reason. -->
        <record id="view_erasmus_export_form" model="ir.ui.view">
            <field name="name">ems.erasmus.export.form</field>
            <field name="model">ems.erasmus.export</field>
            <field name="arch" type="xml">
                <form string="Export">
                    <sheet>
                        <p class="text-muted">
                            A ZIP with the original files in their categories (signed PDFs untouched), an index of every document, also the missing ones (index.csv), a manifest (manifest.json) and the SHA-256 hash of each file (SHA256SUMS) to check the copy archived in Drive. The export is logged with your name.
                        </p>
                        <group>
                            <field name="scope"/>
                            <field name="project_id" invisible="not project_id"/>
                            <field name="mobility_id" invisible="scope != 'record'"/>
                            <field name="group_mobility_id" invisible="scope != 'group'"/>
                            <field name="can_audit" invisible="1"/>
                            <field name="include_confidential" invisible="not can_audit"/>
                            <field name="reason" invisible="not include_confidential" required="include_confidential"/>
                        </group>
                        <div class="alert alert-warning" role="alert" invisible="not include_confidential">
                            The ZIP will include health, inclusion and bank documents. Keep it only where the audit requires it.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_generate" type="object" string="Download the ZIP" class="btn-primary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_erasmus_project" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="res_model">ems.erasmus.project</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
