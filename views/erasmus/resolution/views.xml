<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #685 - Erasmus+ resolutions. See docs/en/developers/erasmus/erasmus.md. -->
        <record id="view_erasmus_resolution_list" model="ir.ui.view">
            <field name="name">ems.erasmus.resolution.list</field>
            <field name="model">ems.erasmus.resolution</field>
            <field name="arch" type="xml">
                <list string="Resolutions">
                    <field name="call_id"/>
                    <field name="group_mobility_id" optional="show"/>
                    <field name="kind"/>
                    <field name="publish_date"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                           decoration-success="state == 'published'"/>
                </list>
            </field>
        </record>

        <record id="view_erasmus_resolution_search" model="ir.ui.view">
            <field name="name">ems.erasmus.resolution.search</field>
            <field name="model">ems.erasmus.resolution</field>
            <field name="arch" type="xml">
                <search string="Resolutions">
                    <field name="call_id"/>
                    <field name="group_mobility_id"/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_call" string="Call" context="{'group_by': 'call_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_erasmus_resolution_form" model="ir.ui.view">
            <field name="name">ems.erasmus.resolution.form</field>
            <field name="model">ems.erasmus.resolution</field>
            <field name="arch" type="xml">
                <form string="Resolution">
                    <header>
                        <div name="ems_actions" string="Actions">
                            <button name="action_prepare" type="object" string="Prepare lines"
                                    invisible="state != 'draft'" groups="ems.group_erasmus,ems.group_academic_admin"
                                    help="Freezes the list as the applications are now. Can be repeated until it is published."/>
                            <button name="action_publish" type="object" string="Publish" class="btn-primary"
                                    invisible="state != 'draft' or not line_ids" groups="ems.group_erasmus_coordinator,ems.group_academic_admin"
                                    confirm="The list will be published on the portal and every applicant will receive their result by email. A published resolution cannot be changed. Continue?"/>
                        </div>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="call_id" readonly="state != 'draft' or line_ids"
                                       required="not group_mobility_id" invisible="group_mobility_id"
                                       options="{'no_create': True}"/>
                                <field name="group_mobility_id" readonly="1" invisible="not group_mobility_id"/>
                                <field name="kind" readonly="state != 'draft' or line_ids"/>
                                <field name="prepare_date"/>
                            </group>
                            <group>
                                <field name="publish_date" invisible="state != 'published'"/>
                                <field name="published_by_id" invisible="state != 'published'"/>
                            </group>
                        </group>
                        <field name="notes" readonly="state != 'draft'" placeholder="Notes for applicants, published with the list."/>
                        <field name="line_ids">
                            <list decoration-success="result in ('admitted', 'selected')"
                                  decoration-warning="result == 'reserve'" decoration-danger="result == 'excluded'">
                                <field name="modality_id"/>
                                <field name="rank" invisible="kind == 'admission'"/>
                                <field name="public_id"/>
                                <field name="partner_id"/>
                                <field name="kind" column_invisible="True"/>
                                <field name="score_a" optional="hide"/>
                                <field name="score_b" optional="hide"/>
                                <field name="score_c" optional="hide"/>
                                <field name="score_d" optional="hide" groups="ems.group_erasmus,ems.group_academic_admin"/>
                                <field name="score_e" optional="hide"/>
                                <field name="score_f" optional="hide"/>
                                <field name="score_total" invisible="kind == 'admission'"/>
                                <field name="result" widget="badge"/>
                            </list>
                        </field>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_erasmus_resolution" model="ir.actions.act_window">
            <field name="name">Resolutions</field>
            <field name="res_model">ems.erasmus.resolution</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_erasmus_resolution_search"/>
        </record>
    </data>
</odoo>
