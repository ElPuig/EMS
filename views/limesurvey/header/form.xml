<odoo>
    <data>
        <record model="ir.ui.view" id="view_limesurvey_header_form">
            <field name="name">ems.limesurvey_header.form</field>
            <field name="model">ems.limesurvey_header</field>
            <field name="arch" type="xml">
                <form string="Survey">
                    <header>
                         <button name="action_draft" 
                                string="Return to draft" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-step-backward"
                                invisible="state != 'uploaded'"/>

                        <button name="action_next" 
                                string="Upload surveys" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-play"
                                invisible="state != 'draft'"/>

                        <!-- This approach does not work :( -->
                        <!-- <button name="action_next" 
                                string="Open surveys" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-arrow-right"
                                readonly="state != 'uploaded'"
                                invisible="state not in ('uploading', 'uploaded')"/> -->

                        <button name="action_next" 
                                string="Open surveys" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-arrow-right"
                                disabled="True"
                                invisible="state != 'uploading'"/>

                        <button name="action_next" 
                                string="Open surveys" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-arrow-right"
                                invisible="state != 'uploaded'"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,uploading,uploaded,open,closed,downloaded"/>
                    </header>
                    <sheet>
                        <group string="Main data" col="4">
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="target"/>
                            </group>
                            <group colspan="2">
                                <field name="level_ids" widget="many2many_tags"/>
                            </group>     
                            <group>
                                <field name="title"/>
                            </group>     
                            <group colspan="3">
                                <field name="description"/>
                            </group>                                                             
                        </group>                        
                        <notebook>
                             <page string="Header's content (TSV)">
                                <field string="" name="tsv_raw_text" widget="ace" options="{'mode': 'text'}" style="min-height: 300px;"/>
                            </page>

                            <page string="Blocks">
                                <field name="limesurvey_block_ids">
                                    <list>
                                        <field name="sort" widget="handle"/>
                                        <field name="name"/>                                        
                                    </list>
                                </field>
                            </page>

                            <page string="Recipients">                                
                                <field name="limesurvey_recipient_ids" readonly="True" force_save="True">
                                    <!-- TODO: allow changes from the admin? no_open using "not user_id_admin" is not working -->
                                    <list default_order="name" no_open="True">
                                        <field name="name"/>
                                        <field name="email"/>
                                        <field name="external_id"/>                                                                               
                                        <field name="status"/> 
                                        <!-- TODO: popup plugin -->
                                        <button name="open_error_popup" type="object" icon="fa-info-circle" title="Open error details." invisible="not error" width="30px"/> 
                                        <button name="refresh" type="object" icon="fa-refresh" title="Refresh (moves the student to a new survey if needed)." width="30px"/> 
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Notes">
                                <field name="notes" placeholder="Write down here your notes..."/>
                            </page>
                        </notebook>                
                    </sheet>	

                   <chatter/>
                </form>
            </field>			
        </record>

        <record model="ir.ui.view" id="view_limesurvey_recipient_error_popup">
            <field name="name">ems.limesurvey_recipient_error.popup</field>
            <field name="model">ems.limesurvey_recipient</field> 
            <field name="arch" type="xml">
                <form string="Error details">
                    <sheet>
                        <field name="error" readonly="1" widget="text"/>
                    </sheet>
                    <footer>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>