<odoo>
    <data>
        <record model="ir.ui.view" id="view_limesurvey_header_form">
            <field name="name">ems.limesurvey_header.form</field>
            <field name="model">ems.limesurvey_header</field>
            <field name="arch" type="xml">
                <form string="Survey">
                    <header>
                        <button name="action_next" 
                                string="Upload surveys" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-play"
                                invisible="state != 'draft'"/>

                        <!-- This approach does not work :( -->
                        <!-- <button name="action_next" 
                                string="Open surveys" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-arrow-right"
                                readonly="state != 'uploaded'"
                                invisible="state not in ('uploading', 'uploaded')"/> -->

                        <button name="action_next" 
                                string="Open surveys" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-arrow-right"
                                disabled="True"
                                invisible="state != 'uploading'"/>

                        <button name="action_next" 
                                string="Open surveys" 
                                type="object" 
                                class="oe_highlight" 
                                icon="fa-arrow-right"
                                invisible="state != 'uploaded'"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,uploading,uploaded,open,closed,downloaded"/>
                    </header>
                    <sheet>
                        <group string="Main data" col="4">
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="target"/>
                            </group>
                            <group colspan="2">
                                <field name="level_ids" widget="many2many_tags"/>
                            </group>     
                            <group>
                                <field name="title"/>
                            </group>     
                            <group colspan="3">
                                <field name="description"/>
                            </group>                                                             
                        </group>
                        <group string="Header's content (tab separated)">
                            <field string="" name="tsv_raw_text" widget="ace" options="{'mode': 'text'}" style="min-height: 300px;"/>
                        </group>
                        
                        <notebook>
                            <page string="Blocks">
                                <field name="limesurvey_block_ids">
                                    <list>
                                        <field name="sort" widget="handle"/>
                                        <field name="name"/>                                        
                                    </list>
                                </field>
                            </page>

                            <page string="Recipients">
                                <field name="limesurvey_recipient_ids" readonly="True" force_save="True">
                                    <list sort="name" no_open="True">
                                        <field name="name"/>
                                        <field name="email"/>
                                        <field name="external_id"/>                                                                               
                                        <field name="status"/> 
                                        <field name="error"/> 
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Notes">
                                <field name="notes" placeholder="Write down here your notes..."/>
                            </page>
                        </notebook>                
                    </sheet>	

                   <chatter/>
                </form>
            </field>			
        </record>
    </data>
</odoo>