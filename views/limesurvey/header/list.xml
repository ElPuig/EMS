<odoo>
    <data>
        <record model="ir.ui.view" id="view_limesurvey_header_list">
            <field name="name">ems.limesurvey_header.list</field>
            <field name="model">ems.limesurvey_header</field>
            <field name="arch" type="xml">
                <list  default_order="name asc" expand="True" >
                    <field name="name"/>
                    <field name="title"/>
                    <field name="target"/>
                    <field name="state"/>                    
                </list>
            </field>
        </record>   
    </data>
</odoo>