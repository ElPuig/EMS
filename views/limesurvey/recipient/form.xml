<odoo>
    <data>
        <record model="ir.ui.view" id="view_limesurvey_recipient_form">
            <field name="name">ems.limesurvey_recipient.form</field>
            <field name="model">ems.limesurvey_recipient</field>
            <field name="arch" type="xml">
                <form string="recipient">
                     <div class="alert alert-warning w-100 text-center mb-2" role="alert" invisible="not is_running">
                        <i title="sping" class="fa fa-circle-o-notch fa-spin me-2"/> 
                        <strong>Processing!</strong> We are uploading the changes to the external API; this may take a few minutes...
                    </div>

                    <header>
                        <!-- NOT IN USE -->
                        <button string="Restore data" 
                            name="action_restore" 
                            confirm="This action will restore the 'main data' and the 'enrollments', saving the changes immediately. It cannot be undone. Do you wish to continue?"
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-undo"
                            invisible="is_running"
                        />

                        <button string="Upload changes" 
                            name="action_upload" 
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-cloud-upload"
                            invisible="is_running"
                        />

                         <!-- IN USE -->
                        <button string="Restore data" 
                            disabled="True"
                            name="action_none"
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-undo"
                            invisible="not is_running"
                        />

                        <button string="Upload changes" 
                            disabled="True"
                            name="action_none"
                            type="object" 
                            class="oe_highlight" 
                            icon="fa-cloud-upload"
                            invisible="not is_running"
                        />
                    </header>

                    <sheet>
                        <group string="Main data" col="4">
                            <group colspan="2">
                                <field name="name"/>
                            </group>
                            <group colspan="2">
                                <field name="email"/>
                            </group>                          
                        </group>

                        <group string="LimeSurvey" col="4">
                            <group colspan="3">
                                <field name="internal_id" readonly="not user_is_admin"/>
                            </group>                           
                            <group>
                                <field string="Survey's ID (LS)" name="external_id" readonly="not user_is_admin"/>
                            </group>                           
                            <group>
                                <field string="User's ID (LS)" name="tid" readonly="not user_is_admin"/>
                            </group>  
                            <group>
                                <field string="User's token (LS)" name="token" readonly="not user_is_admin"/>
                            </group>  
                            <group>
                                <field name="status" readonly="True"/>
                            </group>                                                                           
                        </group>

                        <notebook> 
                            <page string="Error details" invisible="not error">
                                <field string="" name="error" widget="text"/>
                            </page>  

                            <page string="Enrollments" invisible="not student_id">
                                <group>
                                    <field name="wpi_enrolled" />
                                </group>
                                <field name="limesurvey_enrollment_ids">
                                    <list default_order="subject_id.display_name" >
                                        <field name="subject_id"/>
                                        <field name="group_id"/>                                        
                                    </list>

                                    <list editable="top" default_order="subject_id asc, group_id asc">
                                        <field name="subject_id" domain="[('id','not in', inuse_subject_ids)]"/>
                                        <field name="group_id" domain="[('study_id','=', study_id)]"/>
                                        <field name="inuse_subject_ids" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Notes">
                                <field name="notes" placeholder="Write down here your notes..."/>
                            </page>
                        </notebook>
                    </sheet>	
                </form>
            </field>			
        </record>
    </data>
</odoo>