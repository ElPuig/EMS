<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Same model as the Quality screen, different default facets: this one answers "what do I
             owe and by when", which is the question the staff actually has. -->
        <record model="ir.actions.act_window" id="action_minute_agreement">
            <field name="name">Agreements</field>
            <field name="res_model">ems.quality.action</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ems.view_quality_action_search"/>
            <field name="context">{'search_default_mine': 1, 'search_default_open': 1}</field>
        </record>

        <menuitem name="Agreements" sequence="2" id="menu_minutes_agreements"
                  parent="menu_minutes" action="action_minute_agreement"/>
    </data>
</odoo>
