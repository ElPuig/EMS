<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- The call to a meeting, emailed to everybody convened (ems.minute.action_send_call),
             inside the meetings card layout (ems.mail_layout_minutes). -->
        <template id="minute_call_email" name="Minute: call to the meeting">
            <div>
                <t t-call="ems.minute_mail_heading">
                    <t t-if="is_update">
                        <t t-set="warning" t-value="True"/>
                        <t t-set="tag">Updated call</t>
                    </t>
                    <t t-else=""><t t-set="tag">Call to a meeting</t></t>
                </t>
                <p style="margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;">Hello! Here are the details of our next meeting.</p>
                <t t-if="is_update" t-call="ems.minute_mail_note">
                    <t t-set="note">This call replaces the one sent before: check the date, the time, the place and the agenda.</t>
                </t>
                <t t-set="date_title">Date</t>
                <t t-set="time_title">Time</t>
                <t t-set="place_title">Place</t>
                <t t-set="modality_title">Modality</t>
                <t t-set="nature_title">Nature</t>
                <t t-call="ems.minute_mail_facts">
                    <t t-set="facts" t-value="[fact for fact in [(date_title, date_label), (time_title, minute.time),
                        (place_title, minute.place_name), (modality_title, modality_label), (nature_title, nature_label)] if fact[1]]"/>
                </t>
                <t t-if="calendar_url" t-call="ems.minute_mail_button">
                    <t t-set="url" t-value="calendar_url"/>
                    <t t-set="label">Add this meeting to my Google Calendar</t>
                </t>
                <t t-call="ems.minute_mail_agenda">
                    <t t-set="empty">The agenda has not been set yet.</t>
                </t>
                <p t-if="previous_url" style="margin:0 0 12px 0;font-size:14px;line-height:22px;color:#596679;">
                    The minute of the previous meeting can be read before it is approved:
                    <a t-att-href="previous_url" t-out="minute.previous_minute_id.display_name"/>
                </p>
                <p style="margin:0 0 6px 0;font-size:14px;line-height:22px;color:#596679;">Called by <span t-out="convener_name or minute.env.user.name"/>.</p>
            </div>
        </template>
    </data>
</odoo>
