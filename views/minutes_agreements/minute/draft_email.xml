<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- The draft of a minute, emailed to the participants so they review it before it is
             approved (ems.minute.action_send_draft, issue #755): the staff get a link to its PDF,
             the guests from outside EMS get it attached. Inside ems.mail_layout_minutes. -->
        <template id="minute_draft_email" name="Minute: draft for the participants">
            <div>
                <t t-call="ems.minute_mail_heading">
                    <t t-set="tag">Draft minute</t>
                </t>
                <p style="margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;">Please find the draft of the minute of the meeting below, for your review.</p>
                <t t-set="date_title">Date</t>
                <t t-set="approver_title">Approval</t>
                <t t-call="ems.minute_mail_facts">
                    <t t-set="facts" t-value="[fact for fact in [(date_title, '%s, %s' % (date_label, minute.time)), (approver_title, approver_name)] if fact[1]]"/>
                </t>
                <t t-if="pdf_url" t-call="ems.minute_mail_button">
                    <t t-set="url" t-value="pdf_url"/>
                    <t t-set="label">Read the draft (PDF)</t>
                </t>
                <p t-else="" style="margin:0 0 12px 0;font-size:14px;line-height:22px;color:#596679;">The draft is attached to this email as a PDF.</p>
                <p style="margin:0 0 6px 0;font-size:14px;line-height:22px;color:#596679;">If anything needs correcting, please reply to this email.</p>
            </div>
        </template>
    </data>
</odoo>
