<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- A participant's intervention in a meeting held by email, written in EMS (issue #822). -->
    <record id="view_minute_intervention_wizard_form" model="ir.ui.view">
        <field name="name">ems.minute.intervention.wizard.form</field>
        <field name="model">ems.minute.intervention.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>Your intervention is written into the minute and sent to everybody taking part, as an answer to the thread would be.</p>
                <group>
                    <field name="minute_id" invisible="1"/>
                    <field name="agenda_id" options="{'no_create': True, 'no_open': True}" placeholder="Any other business"/>
                    <field name="body" widget="html"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Add the intervention" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
