<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- A meeting held by email (issue #822): both are posted on the minute's own thread, so the
             participants' answers come back to the minute (ems.minute._ems_thread_post), and are
             sent inside ems.mail_layout_minutes like every message of that thread. -->
        <template id="minute_thread_open_email" name="Minute: opening of a meeting held by email">
            <div>
                <t t-call="ems.minute_mail_heading">
                    <t t-set="tag">Meeting held by email</t>
                </t>
                <p style="margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;">Hello! This meeting is held by email: to take part, reply to this email.</p>
                <t t-set="deadline_title">Answers until</t>
                <t t-call="ems.minute_mail_facts">
                    <t t-set="facts" t-value="[(deadline_title, deadline_label)]"/>
                </t>
                <t t-call="ems.minute_mail_note">
                    <t t-set="note">Everybody taking part receives every answer, and each one is written into the minute as an intervention.</t>
                </t>
                <t t-call="ems.minute_mail_agenda">
                    <t t-set="empty">There is no agenda: say what you think of the subject of the email.</t>
                </t>
            </div>
        </template>

        <template id="minute_thread_draft_email" name="Minute: draft of a meeting held by email">
            <div>
                <t t-call="ems.minute_mail_heading">
                    <t t-set="tag">Draft minute</t>
                </t>
                <p style="margin:0 0 20px 0;font-size:14px;line-height:22px;color:#596679;">The time to take part is over. Please find the draft of the minute below, for your review.</p>
                <t t-set="approver_title">Approval</t>
                <t t-if="approver_name" t-call="ems.minute_mail_facts">
                    <t t-set="facts" t-value="[(approver_title, approver_name)]"/>
                </t>
                <t t-call="ems.minute_mail_button">
                    <t t-set="url" t-value="pdf_url"/>
                    <t t-set="label">Read the draft (PDF)</t>
                </t>
                <t t-call="ems.minute_mail_note">
                    <t t-set="note">If anything needs correcting, reply to this email: your answer is recorded as an amendment. If everything is right, there is no need to reply.</t>
                </t>
            </div>
        </template>
    </data>
</odoo>
