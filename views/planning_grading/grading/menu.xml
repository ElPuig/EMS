<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- "Grades" groups the grade-session menus inside "Planning and Grading". -->
        <menuitem name="Grades" sequence="1" id="menu_grades" parent="menu_planning"/>

        <record model="ir.actions.act_window" id="action_grade_session_tree">
            <field name="name">Evaluation by group and subject</field>
            <field name="res_model">ems.grade_session</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Evaluation by group and subject" sequence="1" id="menu_grade_sessions" parent="menu_grades" action="action_grade_session_tree"/>

        <!-- Tutor view: one student at a time, all their subjects of the group's open evaluation. -->
        <record model="ir.actions.client" id="action_grade_tutor_matrix">
            <field name="name">Evaluation for tutors</field>
            <field name="tag">ems.grade_tutor_matrix</field>
        </record>

        <menuitem name="Evaluation for tutors" sequence="2" id="menu_grade_tutor" parent="menu_grades" action="action_grade_tutor_matrix" groups="ems.group_teacher"/>

        <!-- Container for the admin-only session management wizards (defined in wizard.xml). -->
        <menuitem name="Evaluation management" sequence="3" id="menu_grade_management" parent="menu_grades" groups="ems.group_admin"/>
    </data>
</odoo>
