<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_external_record_wizard_form">
            <field name="name">ems.external_record_wizard.form</field>
            <field name="model">ems.external_record_wizard</field>
            <field name="arch" type="xml">
                <form string="Add record from another centre" class="o_ems_wrap_list_headers">
                    <sheet>
                        <div class="alert alert-info" role="alert" invisible="line_ids">
                            Adds to the academic history a course the student took at another
                            centre. Upload the Esfera academic record (PDF) to fill everything in
                            from it; with any other certificate, fill in the record and then add
                            its modules one by one with the grades of each learning outcome (RA).
                        </div>
                        <div class="alert alert-info" role="alert" invisible="not line_ids">
                            Check the grades read from the certificate before creating the record:
                            correct any grade, pick the module of a line that was not recognised,
                            and untick the modules not to import.
                        </div>
                        <div class="alert alert-warning" role="alert" invisible="not certificate_message">
                            <field name="certificate_message" nolabel="1" force_save="1"/>
                        </div>
                        <field name="available_course_ids" invisible="1"/>
                        <field name="available_study_ids" invisible="1"/>
                        <group>
                            <group>
                                <field name="student_id" readonly="1"/>
                                <field name="certificate_file" filename="certificate_filename"/>
                                <field name="certificate_filename" invisible="1"/>
                                <field name="certificate_student_name" force_save="1"
                                       invisible="not certificate_student_identifier"/>
                                <field name="certificate_student_identifier" force_save="1"
                                       invisible="not certificate_student_identifier"/>
                            </group>
                            <group>
                                <field name="course_id" options="{'no_create': True, 'no_open': True}"
                                       domain="[('id', 'in', available_course_ids)]"
                                       invisible="line_ids" required="not line_ids"/>
                                <field name="study_id" options="{'no_create': True, 'no_open': True}"
                                       domain="[('id', 'in', available_study_ids)]"
                                       readonly="not course_id and not line_ids"/>
                                <field name="origin_centre_name"/>
                                <field name="origin_centre_code"/>
                            </group>
                        </group>
                        <field name="line_ids" nolabel="1" invisible="not line_ids">
                            <list editable="bottom" create="0" delete="0"
                                  decoration-bf="kind == 'module'"
                                  decoration-muted="kind == 'module' and not to_import"
                                  decoration-warning="warning">
                                <field name="sequence" column_invisible="1"/>
                                <field name="kind" column_invisible="1"/>
                                <field name="module_key" column_invisible="1"/>
                                <field name="outcome_number" column_invisible="1"/>
                                <field name="course_id" optional="hide" readonly="1" force_save="1"/>
                                <field name="certificate_code" force_save="1" width="170px"/>
                                <field name="label" force_save="1"/>
                                <field name="certificate_text" class="text-muted" force_save="1"/>
                                <!-- Read-only columns are not sent back by the client unless
                                     force_save: without it the grid would reach action_create()
                                     without the codes and courses it was read with. -->
                                <field name="subject_id" options="{'no_create': True, 'no_open': True}"
                                       domain="[('study_ids', '=', parent.study_id)]"
                                       readonly="kind != 'module'"/>
                                <field name="score" class="fw-bold"/>
                                <field name="is_scored" width="80px"/>
                                <field name="to_import" width="80px" readonly="kind != 'module'"
                                       invisible="kind != 'module'"/>
                                <field name="warning"/>
                            </list>
                        </field>
                        <group string="Notes">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_create" type="object" string="Create record"
                                class="btn-primary" data-hotkey="q" invisible="not line_ids"/>
                        <button name="action_create" type="object" string="Create and add modules"
                                class="btn-primary" data-hotkey="q" invisible="line_ids"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_external_record_wizard">
            <field name="name">Add record from another centre</field>
            <field name="res_model">ems.external_record_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <!-- The review grid of a whole certificate needs the room. -->
            <field name="context">{'dialog_size': 'extra-large'}</field>
        </record>
    </data>
</odoo>
