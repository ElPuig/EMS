<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Issue #635: titles obtained, registered in the academic history. -->
        <record id="view_title_import_wizard_form" model="ir.ui.view">
            <field name="name">ems.title_import_wizard.form</field>
            <field name="model">ems.title_import_wizard</field>
            <field name="arch" type="xml">
                <form string="Import titles" js_class="ems_title_import_wizard_form">
                    <sheet>
                        <div class="alert alert-info" role="alert" invisible="line_ids">
                            Registers in the academic history the titles obtained in a course, from
                            Esfera's list of title requests (CSV or Excel). Only the column with the
                            student identifier (IDALU) is required. If the file has the course, the
                            title request status or the student's name, they are used too: rows of
                            another course are left out, and a cancelled request does not count.
                        </div>
                        <div class="alert alert-info" role="alert" invisible="not line_ids or result_html">
                            Check what will happen to each student before registering the titles.
                            A student who no longer has a group leaves the centre as a graduate: the
                            pending enrollments are cancelled, the portal access is revoked and the
                            contact is archived.
                        </div>
                        <group invisible="result_html">
                            <group>
                                <field name="file" filename="file_name" readonly="line_ids"/>
                                <field name="file_name" invisible="1"/>
                            </group>
                            <group>
                                <field name="course_id" options="{'no_create': True, 'no_open': True}"
                                       readonly="line_ids"/>
                                <field name="apply_count" invisible="not line_ids"/>
                            </group>
                        </group>
                        <group invisible="not result_html">
                            <field name="result_html" nolabel="1" colspan="2"/>
                            <field name="log_file" widget="auto_download_binary" filename="log_file_name"
                                   string="Download import log (CSV)"/>
                            <field name="log_file_name" invisible="1"/>
                        </group>
                        <field name="line_ids" nolabel="1" invisible="not line_ids or result_html" readonly="1">
                            <list decoration-success="outcome == 'graduate'"
                                  decoration-info="outcome in ('alumni', 'title')"
                                  decoration-muted="outcome == 'already'"
                                  decoration-warning="outcome in ('no_record', 'not_found', 'cancelled', 'other_course')">
                                <field name="student_identifier"/>
                                <field name="name"/>
                                <field name="record_id" optional="show"/>
                                <field name="outcome"/>
                                <field name="to_apply" column_invisible="1"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_preview" type="object" string="Preview" class="btn-primary"
                                invisible="line_ids"/>
                        <button name="action_apply" type="object" string="Register titles" class="btn-primary"
                                invisible="not apply_count or result_html"
                                confirm="The titles are registered, and the students with no group leave the centre as graduates. Continue?"/>
                        <button special="cancel" string="Close"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_title_import_wizard" model="ir.actions.act_window">
            <field name="name">Import titles</field>
            <field name="res_model">ems.title_import_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'dialog_size': 'extra-large'}</field>
        </record>

        <menuitem name="Import titles" sequence="6" id="menu_title_import_wizard"
                  parent="menu_grades" action="action_title_import_wizard"
                  groups="ems.group_academic_admin,ems.group_secretary"/>

        <record id="view_title_register_wizard_form" model="ir.ui.view">
            <field name="name">ems.title_register_wizard.form</field>
            <field name="model">ems.title_register_wizard</field>
            <field name="arch" type="xml">
                <form string="Register title">
                    <sheet>
                        <group>
                            <field name="student_id" options="{'no_open': True}"/>
                            <field name="available_course_ids" invisible="1"/>
                            <field name="course_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="effect"/>
                        </group>
                        <div class="alert alert-warning" role="alert" invisible="effect != 'graduate'">
                            The student has no group: they leave the centre as a graduate. The pending
                            enrollments are cancelled, the portal access is revoked and the contact is
                            archived.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_apply" type="object" string="Register title" class="btn-primary"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_title_register_wizard" model="ir.actions.act_window">
            <field name="name">Register title</field>
            <field name="res_model">ems.title_register_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
