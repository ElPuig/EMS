<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The authorizations list, its help modal, one response modal per authorization and the
         client-side check on the required data fields - shared by both enrollment pages.

         It lives on its own because an authorization no longer belongs to the enrollment
         (issue #443): the confirmed page has to show the ones sent during the course, and the
         draft page has to keep showing the enrollment's own, with identical behaviour. The
         caller passes `authorizations` (see res.partner.get_portal_authorizations()) and an
         optional `section_number` for the heading. -->
    <template id="portal_authorizations_block" name="Portal Authorizations Block">
                            <!-- mt-4 as well as mb-4: the block is placed between other cards on both pages, and
                                 some of them carry their spacing as mt- rather than mb-, which left
                                 this one glued to the card above it. -->
                            <div class="card shadow-sm mt-4 mb-4" id="portal_authorizations">

                                <div class="card-header bg-light">
                                    <h4 class="mb-0 d-flex align-items-center gap-2">
                                        <t t-if="section_number"><t t-esc="section_number"/>. </t>Authorizations
                                        <button type="button" class="btn btn-link p-0 border-0" 
                                                data-bs-toggle="modal" data-bs-target="#modal_help_authorizations">
                                            <i class="fa fa-question-circle fa-2x text-ems-primary"/>
                                        </button>
                                    </h4>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Title</th>
                                                <th>Status</th>
                                                <th>Document</th>
                                                <th>Response Date</th>
                                                <th class="text-end">Answer</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="authorizations" t-as="auth">
                                                <td><span t-field="auth.template_id.name"/></td>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill #{'bg-warning' if auth.status == 'pending' else 'bg-success' if auth.status == 'yes' else 'bg-danger'}">
                                                        <t t-if="auth.status == 'pending'">Pending</t>
                                                        <t t-if="auth.status == 'yes'">Accepted</t>
                                                        <t t-if="auth.status == 'no'">Rejected</t>
                                                    </span>
                                                </td>
                                                <td>
                                                    <t t-if="auth.signed_document">
                                                        <a t-attf-href="/my/gestion-matriculas/authorization/#{auth.id}/document" 
                                                        target="_blank" class="text-danger text-decoration-none">
                                                            <i class="fa fa-file-pdf-o me-1"/>
                                                            <span t-field="auth.signed_document_name"/>
                                                        </a>
                                                    </t>
                                                    <t t-else="">-</t>
                                                </td>
                                                <td>
                                                    <span t-field="auth.response_date" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-ems ems-auth-answer" data-bs-toggle="modal" t-attf-data-bs-target="#modal_auth_#{auth.id}">
                                                        Respond
                                                    </button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="modal fade" id="modal_help_authorizations" tabindex="-1" role="dialog">
                                <div class="modal-dialog modal-dialog-centered" role="document">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header bg-light">
                                            <h5 class="modal-title">
                                                <i class="fa fa-question-circle me-2 text-ems-primary"/>
                                                Authorizations - Help
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                                        </div>
                                        <div class="modal-body p-4">
                                            <p>You must respond to the authorizations before continuing with the enrollment process.</p>
                                            <p>New authorizations can also appear during the school year, once the enrollment is already confirmed. They show up in this same list.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-ems" data-bs-dismiss="modal">OK</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <t t-foreach="authorizations" t-as="auth">
                                <div class="modal fade" t-attf-id="modal_auth_#{auth.id}" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog">
                                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
                                        <div class="modal-content border-0 shadow-lg">
                                            <form t-attf-action="/my/gestion-matriculas/authorize/#{auth.id}" method="post" data-auth-form="1" class="ems-loading-form">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                
                                                <div class="modal-header bg-light">
                                                    <h5 class="modal-title font-weight-bold" t-field="auth.template_id.name"/>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                
                                                <div class="modal-body text-start p-4" style="min-height: 300px;">
                                                    <div class="article-content" t-field="auth.legal_text_rendered"/>
                                                    <t t-if="auth.template_id.field_ids">
                                                        <hr class="my-3"/>
                                                        <p class="fw-bold small text-muted mb-2">Please fill in the following data:</p>
                                                        <t t-foreach="auth.template_id.field_ids" t-as="field">
                                                            <div class="mb-3">
                                                                <label t-attf-for="field_response_#{field.id}" class="form-label">
                                                                    <t t-esc="field.label"/>
                                                                    <t t-if="field.is_required"><span class="text-danger"> *</span></t>
                                                                </label>
                                                                <input t-if="field.field_type == 'char'"
                                                                       type="text"
                                                                       t-attf-name="field_response_#{field.id}"
                                                                       t-attf-id="field_response_#{field.id}"
                                                                       t-attf-placeholder="#{field.placeholder or ''}"
                                                                       class="form-control"
                                                                       t-att-data-auth-required="'true' if field.is_required else None"/>
                                                                <textarea t-if="field.field_type == 'text'"
                                                                       t-attf-name="field_response_#{field.id}"
                                                                       t-attf-id="field_response_#{field.id}"
                                                                       t-attf-placeholder="#{field.placeholder or ''}"
                                                                       rows="3"
                                                                       class="form-control"
                                                                       t-att-data-auth-required="'true' if field.is_required else None"></textarea>
                                                                <input t-if="field.field_type == 'date'"
                                                                       type="date"
                                                                       t-attf-name="field_response_#{field.id}"
                                                                       t-attf-id="field_response_#{field.id}"
                                                                       class="form-control"
                                                                       t-att-data-auth-required="'true' if field.is_required else None"/>
                                                                <div class="invalid-feedback">This field is required to accept the authorization.</div>
                                                            </div>
                                                        </t>
                                                    </t>
                                                </div>
                                                
                                                <div class="modal-footer bg-light">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                    <button t-if="not auth.template_id.acceptance_only"
                                                        type="submit" name="decision" value="no" class="btn btn-danger">Reject</button>
                                                    <button type="submit" name="decision" value="yes" class="btn btn-success ms-2">Accept Authorization</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>  
                            </t>
                            <script>
                                document.addEventListener('DOMContentLoaded', function() {
                                    document.querySelectorAll('form[data-auth-form]').forEach(function(form) {
                                        form.addEventListener('submit', function(e) {
                                            var submitter = e.submitter;
                                            if (submitter &amp;&amp; submitter.value === 'yes') {
                                                var fields = form.querySelectorAll('[data-auth-required="true"]');
                                                var valid = true;
                                                fields.forEach(function(f) {
                                                    if (!f.value.trim()) {
                                                        f.classList.add('is-invalid');
                                                        valid = false;
                                                    } else {
                                                        f.classList.remove('is-invalid');
                                                    }
                                                });
                                                if (!valid) { e.preventDefault(); }
                                            }
                                        });
                                    });
                                });
                            </script>
    </template>
</odoo>
