<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Issue #835 - certificate requests on the portal. See controllers/portal_certificate.py. -->

    <!-- The applicant's form, shared by a new request (/my/certificats) and the link sent to a
         former student (/my/certificats/<id>): the details every certificate has, mandatory, and
         the ones its type asks for (type_fields, ems.certificate.type.field), each in an input
         field_<id> (and field_<id>_vat for a company's VAT number). -->
    <template id="portal_certificate_fields" name="Certificate request fields">
        <h6 class="fw-bold mt-1">Your details</h6>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" t-attf-for="certificate_student_name#{form_suffix or ''}">Full name <span class="text-danger">*</span></label>
                <input t-attf-id="certificate_student_name#{form_suffix or ''}" type="text" name="student_name" class="form-control" required="required"
                       maxlength="200" t-att-value="defaults.get('student_name')"/>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" t-attf-for="certificate_student_document#{form_suffix or ''}">Identity document (DNI, NIE or passport) <span class="text-danger">*</span></label>
                <input t-attf-id="certificate_student_document#{form_suffix or ''}" type="text" name="student_document" class="form-control" required="required"
                       maxlength="30" t-att-value="defaults.get('student_document')"/>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" t-attf-for="certificate_study_id#{form_suffix or ''}">Study <span class="text-danger">*</span></label>
                <select t-attf-id="certificate_study_id#{form_suffix or ''}" name="study_id" class="form-select" required="required">
                    <option value="">-</option>
                    <t t-foreach="studies" t-as="study">
                        <option t-att-value="study.id" t-att-selected="study.id == defaults.get('study_id')" t-esc="study.name"/>
                    </t>
                </select>
            </div>
        </div>

        <t t-if="type_fields">
            <h6 class="fw-bold mt-2">Certificate details</h6>
            <div class="row">
                <t t-foreach="type_fields" t-as="type_field">
                    <t t-set="input_name" t-value="'field_%s' % type_field.id"/>
                    <t t-set="input_required" t-value="type_field.applicant_input == 'required' and type_field.field_type != 'boolean'"/>
                    <div t-attf-class="mb-3 o_ems_certificate_detail #{'col-12' if type_field.field_type == 'text' else 'col-md-6'}">
                        <t t-if="type_field.field_type == 'boolean'">
                            <div class="form-check mt-2">
                                <input t-att-id="input_name" type="checkbox" t-att-name="input_name" class="form-check-input"
                                       t-att-checked="defaults.get(input_name) or None"/>
                                <label class="form-check-label" t-att-for="input_name" t-esc="type_field.name"/>
                            </div>
                        </t>
                        <t t-else="">
                            <label class="form-label" t-att-for="input_name"><t t-esc="type_field.name"/><span t-if="input_required" class="text-danger"> *</span></label>
                            <textarea t-if="type_field.field_type == 'text'" t-att-id="input_name" t-att-name="input_name" rows="3"
                                      class="form-control" maxlength="2000" t-att-required="input_required or None"
                                      t-esc="defaults.get(input_name) or ''"/>
                            <input t-elif="type_field.field_type == 'number'" t-att-id="input_name" type="number" min="0" step="any"
                                   t-att-name="input_name" class="form-control" t-att-required="input_required or None"
                                   t-att-value="defaults.get(input_name) or ''"/>
                            <input t-elif="type_field.field_type == 'date'" t-att-id="input_name" type="date"
                                   t-att-name="input_name" class="form-control" t-att-required="input_required or None"
                                   t-att-value="defaults.get(input_name) or ''"/>
                            <!-- One of the courses EMS has, or any other written by hand (an older year). -->
                            <input t-elif="type_field.field_type == 'school_year'" t-att-id="input_name" type="text"
                                   t-att-name="input_name" class="form-control" maxlength="20" placeholder="2024-25"
                                   pattern="\s*\d{4}\s*[\-\/]\s*(\d{2}|\d{4})\s*" title="2024-25"
                                   t-attf-list="certificate_courses#{form_suffix or ''}" autocomplete="off" t-att-required="input_required or None"
                                   t-att-value="defaults.get(input_name)"/>
                            <input t-else="" t-att-id="input_name" type="text" t-att-name="input_name" class="form-control"
                                   maxlength="200" t-att-required="input_required or None" t-att-value="defaults.get(input_name)"/>
                        </t>
                        <div t-if="type_field.help" class="form-text" t-esc="type_field.help"/>
                    </div>
                    <div t-if="type_field.field_type == 'company'" class="col-md-6 mb-3 o_ems_certificate_detail">
                        <label class="form-label" t-att-for="'%s_vat' % input_name">VAT number</label>
                        <input t-att-id="'%s_vat' % input_name" type="text" t-att-name="'%s_vat' % input_name" class="form-control"
                               maxlength="30" t-att-value="defaults.get('%s_vat' % input_name)"/>
                    </div>
                </t>
            </div>
            <datalist t-attf-id="certificate_courses#{form_suffix or ''}">
                <option t-foreach="courses or []" t-as="course_name" t-att-value="course_name"/>
            </datalist>
        </t>

        <t t-call="ems.portal_certificate_documents"/>
    </template>

    <!-- The files the applicant may attach: one input per required document of the type they may
         attach (input document_<ems.certificate.type.document id>), and the optional ones. Required
         documents are only demanded before the certificate is issued: the centre may attach the
         ones it has. -->
    <template id="portal_certificate_documents" name="Certificate request documents">
        <h6 class="fw-bold mt-2">Documentation</h6>
        <div class="row">
            <div t-foreach="portal_documents" t-as="portal_document" class="col-md-6 mb-3 o_ems_certificate_document">
                <label class="form-label" t-att-for="'certificate_document_%s' % portal_document.id" t-esc="portal_document.name"/>
                <input t-att-id="'certificate_document_%s' % portal_document.id" type="file"
                       t-att-name="'document_%s' % portal_document.id" class="form-control" multiple="multiple"
                       accept="application/pdf,image/jpeg,image/png"/>
                <div class="form-text">A PDF or photos of its pages. If you do not have it, the centre attaches it.</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" t-attf-for="certificate_documents#{form_suffix or ''}">Other documentation (optional)</label>
                <input t-attf-id="certificate_documents#{form_suffix or ''}" type="file" name="documents" class="form-control" multiple="multiple"
                       accept="application/pdf,image/jpeg,image/png"/>
            </div>
        </div>
    </template>

    <!-- A request's state as the applicant reads it. -->
    <template id="portal_certificate_status" name="Certificate request status">
        <span t-attf-class="badge #{'text-bg-success' if certificate.state == 'issued' else 'text-bg-danger' if certificate.state == 'rejected' else 'text-bg-secondary' if certificate.state == 'cancelled' else 'text-bg-warning' if certificate.state in ('draft', 'documentation') else 'text-bg-info'}"
              t-esc="state_labels.get(certificate.state)"/>
    </template>

    <template id="portal_certificates" name="Certificates">
        <t t-call="portal.portal_layout">
            <div class="container mt-4 o_ems_portal_certificates">
                <style>
                    /* The chevron is drawn here, not as an element: an extra node inside the button
                       would change the translatable term of its label. */
                    .o_ems_certificate_toggle::after { font-family: FontAwesome; content: "\f078"; margin-left: auto; transition: transform .2s; }
                    .o_ems_certificate_toggle:not(.collapsed)::after { transform: rotate(180deg); }
                </style>
                <t t-call="ems.portal_loading_overlay"/>
                <h3 class="mb-1">Certificates</h3>
                <p class="text-muted small mb-3" t-esc="student.name"/>

                <div t-if="viewing_as_family" class="alert alert-info mb-3">
                    <i class="fa fa-user me-1"/> Viewing certificates for: <strong t-esc="student.name"/>
                </div>
                <div t-if="submitted" class="alert alert-success mb-3 o_ems_certificate_submitted">
                    <i class="fa fa-check-circle me-1"/> Your request has been submitted. You will receive the certificate by email.
                </div>
                <div t-if="error == 'missing'" class="alert alert-danger mb-3">
                    <i class="fa fa-exclamation-triangle me-1"/> Fill in all your details: they are mandatory.
                </div>
                <div t-if="error == 'invalid'" class="alert alert-danger mb-3">
                    <i class="fa fa-exclamation-triangle me-1"/> Some details are not written correctly: check the hint under each one.
                </div>

                <!-- One folded card per type, as convalidations: most visits check the requests already
                     made, which an open form would push out of sight. A card opens when asked for
                     (?new=1, the only type) or when its submission came back with an error. -->
                <t t-if="can_request">
                    <div t-foreach="forms" t-as="form" class="card shadow-sm mb-3 o_ems_certificate_new">
                        <t t-set="certificate_type" t-value="form['type']"/>
                        <t t-set="form_suffix" t-value="'_%s' % certificate_type.id"/>
                        <button type="button"
                                t-attf-class="card-header bg-ems-primary text-white border-0 w-100 text-start d-flex align-items-center o_ems_certificate_toggle #{'' if form['open'] else 'collapsed'}"
                                data-bs-toggle="collapse" t-attf-data-bs-target="#certificate_new_body#{form_suffix}"
                                t-attf-aria-controls="certificate_new_body#{form_suffix}" t-att-aria-expanded="'true' if form['open'] else 'false'">
                            <i class="fa fa-plus me-2"/><span>New request</span><span class="mx-1">-</span><span t-esc="certificate_type.name"/>
                        </button>
                        <div t-attf-id="certificate_new_body#{form_suffix}" t-attf-class="collapse #{'show' if form['open'] else ''}">
                        <div class="card-body">
                            <form action="/my/certificats/submit" method="post" enctype="multipart/form-data" class="ems-loading-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="type_id" t-att-value="certificate_type.id"/>
                                <p t-if="certificate_type.description" class="small text-muted" t-esc="certificate_type.description"/>
                                <t t-set="studies" t-value="form['studies']"/>
                                <t t-set="type_fields" t-value="form['type_fields']"/>
                                <t t-set="portal_documents" t-value="form['portal_documents']"/>
                                <t t-call="ems.portal_certificate_fields"/>
                                <button type="submit" class="btn btn-primary">Submit request</button>
                            </form>
                        </div>
                        </div>
                    </div>
                </t>

                <h5 class="mt-4">Your requests</h5>
                <p t-if="not certificates" class="text-muted">You have not requested any certificate yet.</p>
                <div t-foreach="certificates" t-as="certificate" class="card shadow-sm mb-2 o_ems_certificate_request">
                    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <strong t-esc="certificate.type_id.name"/>
                            <span t-if="certificate.name" class="text-muted ms-2" t-esc="certificate.name"/>
                            <div class="small text-muted" t-if="certificate.submission_date">
                                Requested on <t t-out="certificate.submission_date" t-options="{'widget': 'date'}"/>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <t t-call="ems.portal_certificate_status"/>
                            <a t-att-href="certificate.get_portal_url()" class="btn btn-sm btn-outline-primary">Open my request</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- What the request holds, for the applicant to follow it: their details, the certificate's
         details as the centre completed them, where it is and the documentation attached. Only what has a value. -->
    <template id="portal_certificate_summary" name="Certificate request summary">
        <div class="card shadow-sm mb-4 o_ems_certificate_summary">
            <div class="card-body">
                <p t-if="certificate.state == 'in_progress' and certificate.step_id" class="mb-3 o_ems_certificate_step">
                    <i class="fa fa-arrow-right me-1"/>Current step: <strong t-esc="certificate.step_id.name"/>
                </p>
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-bold">Your details</h6>
                        <dl class="row small mb-3">
                            <dt class="col-5">Full name</dt><dd class="col-7" t-esc="certificate.student_name"/>
                            <dt class="col-5">Identity document</dt><dd class="col-7" t-esc="certificate.student_document"/>
                            <dt class="col-5">Study</dt><dd class="col-7" t-esc="certificate.study_id.name"/>
                            <t t-if="certificate.submission_date">
                                <dt class="col-5">Request date</dt>
                                <dd class="col-7"><t t-out="certificate.submission_date" t-options="{'widget': 'date'}"/></dd>
                            </t>
                        </dl>
                    </div>
                    <div t-if="certificate.value_ids" class="col-md-6 o_ems_certificate_summary_details">
                        <h6 class="fw-bold">Certificate details</h6>
                        <t t-set="filled_values" t-value="certificate.value_ids.filtered('display_value')"/>
                        <dl t-if="filled_values" class="row small mb-3">
                            <t t-foreach="filled_values" t-as="line">
                                <dt class="col-5" t-esc="line.name"/><dd class="col-7" t-esc="line.display_value"/>
                                <t t-set="vat" t-value="line.field_type == 'company' and (line.value_company_id.vat or line.value_vat)"/>
                                <t t-if="vat"><dt class="col-5">VAT number</dt><dd class="col-7" t-esc="vat"/></t>
                            </t>
                        </dl>
                        <p t-else="" class="small text-muted">The centre completes these details.</p>
                    </div>
                </div>
                <t t-if="certificate.document_ids or certificate.other_attachment_ids">
                    <h6 class="fw-bold">Documentation</h6>
                    <ul class="list-unstyled small mb-0">
                        <li t-foreach="certificate.document_ids" t-as="line" class="o_ems_certificate_summary_document">
                            <i t-attf-class="fa me-1 #{'fa-check text-success' if line.attachment_ids else 'fa-clock-o text-warning'}"/>
                            <strong t-esc="line.name"/>:
                            <t t-if="line.attachment_ids" t-esc="', '.join(line.attachment_ids.mapped('name'))"/>
                            <span t-else="" class="text-muted">Pending</span>
                        </li>
                        <li t-if="certificate.other_attachment_ids">
                            <i class="fa fa-paperclip me-1"/>
                            <strong>Other documentation</strong>:
                            <t t-esc="', '.join(certificate.other_attachment_ids.mapped('name'))"/>
                        </li>
                    </ul>
                </t>
            </div>
        </div>
    </template>

    <!-- One request, opened with its link (access token). -->
    <template id="portal_certificate" name="Certificate request">
        <t t-call="portal.portal_layout">
            <div class="container mt-4 o_ems_portal_certificate">
                <t t-call="ems.portal_loading_overlay"/>
                <h3 class="mb-1" t-esc="certificate.type_id.name"/>
                <p class="mb-3">
                    <span t-if="certificate.name" class="text-muted me-2" t-esc="certificate.name"/>
                    <t t-call="ems.portal_certificate_status"/>
                </p>

                <div t-if="submitted" class="alert alert-success mb-3 o_ems_certificate_submitted">
                    <i class="fa fa-check-circle me-1"/> Your request has been submitted. You will receive the certificate by email.
                </div>
                <div t-if="updated" class="alert alert-success mb-3 o_ems_certificate_updated">
                    <i class="fa fa-check-circle me-1"/> Your changes have been saved.
                </div>
                <div t-if="replied" class="alert alert-success mb-3 o_ems_certificate_replied">
                    <i class="fa fa-check-circle me-1"/> Your answer has been added to the request.
                </div>
                <div t-if="error == 'missing'" class="alert alert-danger mb-3">
                    <i class="fa fa-exclamation-triangle me-1"/> Fill in all your details: they are mandatory.
                </div>
                <div t-if="error == 'invalid'" class="alert alert-danger mb-3">
                    <i class="fa fa-exclamation-triangle me-1"/> Some details are not written correctly: check the hint under each one.
                </div>
                <div t-if="error == 'reply'" class="alert alert-danger mb-3">
                    <i class="fa fa-exclamation-triangle me-1"/> Write an answer or attach a document before sending.
                </div>

                <t t-if="certificate.state != 'draft'" t-call="ems.portal_certificate_summary"/>

                <!-- The applicant's form: a former student's, sent by the secretariat, and, once the
                     request is in its circuit, open to complete or correct until the centre changes
                     or acts on it (ems.certificate._ems_portal_can_edit). -->
                <div t-if="certificate._ems_portal_can_edit()" class="card shadow-sm mb-4 o_ems_certificate_form">
                    <div class="card-body">
                        <p t-if="certificate.state != 'draft'" class="small mb-2 o_ems_certificate_form_open">
                            <i class="fa fa-pencil me-1"/> You can still complete or correct your details and documents until the centre starts working on your request.
                        </p>
                        <p t-if="certificate.type_id.description" class="small text-muted" t-esc="certificate.type_id.description"/>
                        <form t-attf-action="/my/certificats/#{certificate.id}/submit?access_token=#{access_token}" method="post"
                              enctype="multipart/form-data" class="ems-loading-form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <t t-call="ems.portal_certificate_fields"/>
                            <button t-if="certificate.state == 'draft'" type="submit" class="btn btn-primary">Submit request</button>
                            <button t-else="" type="submit" class="btn btn-primary">Save changes</button>
                        </form>
                    </div>
                </div>

                <div t-if="certificate.state == 'documentation'" class="card shadow-sm mb-4 o_ems_certificate_documentation">
                    <div class="card-body">
                        <p class="fw-bold mb-1">The centre needs some more information:</p>
                        <p style="white-space: pre-line;" t-esc="certificate.info_request"/>
                        <form t-attf-action="/my/certificats/#{certificate.id}/reply?access_token=#{access_token}" method="post"
                              enctype="multipart/form-data" class="ems-loading-form o_ems_certificate_reply">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label class="form-label fw-bold small" for="certificate_reply_message">Answer or add documentation</label>
                            <textarea id="certificate_reply_message" name="message" rows="2" class="form-control form-control-sm mb-2" maxlength="2000"/>
                            <t t-call="ems.portal_certificate_documents"/>
                            <button type="submit" class="btn btn-sm btn-primary">Send</button>
                        </form>
                    </div>
                </div>

                <p t-if="certificate.state == 'in_progress'" class="text-muted">
                    <i class="fa fa-hourglass-half me-1"/> The centre is processing your request. You will receive the certificate by email.
                </p>
                <div t-if="certificate.state == 'rejected'" class="alert alert-danger">
                    <strong>The centre cannot issue this certificate:</strong>
                    <p class="mb-0" style="white-space: pre-line;" t-esc="certificate.reject_reason"/>
                </div>
                <p t-if="certificate.state == 'issued'">
                    <a t-attf-href="/my/certificats/#{certificate.id}/pdf?access_token=#{access_token}" class="btn btn-primary">
                        <i class="fa fa-download me-1"/><t t-if="certificate.document_kind == 'attestation'">Download the accrediting document</t><t t-else="">Download the certificate</t>
                    </a>
                </p>

                <form t-if="certificate._ems_is_cancellable()" t-attf-action="/my/certificats/#{certificate.id}/cancel?access_token=#{access_token}"
                      method="post" class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-times me-1"/>Cancel request</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
