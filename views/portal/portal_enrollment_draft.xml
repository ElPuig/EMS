<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_enrollment_process" name="Enrollment Process">
        <t t-call="portal.portal_layout">
            <div id="enrollment_content" class="container mt-4">
                <div class="row">
                    <div class="col-12">

                        <t t-if="viewing_as_family">
                            <div class="alert alert-info mb-3">
                                <i class="fa fa-user me-1"/> Viewing enrollment data for: <strong t-esc="student.name"/>
                            </div>
                        </t>

                        <t t-if="not enrollment">
                            <div class="alert alert-info">No active enrollment process found.</div>
                            <!-- No enrollment does not mean nothing to answer: an authorization
                                 sent during the course hangs off the student, not off an
                                 enrollment (issue #443). -->
                            <t t-if="authorizations">
                                <t t-call="ems.portal_authorizations_block">
                                <t t-set="authorizations" t-value="authorizations"/>
                                <t t-set="section_number" t-value="''"/>
                            </t>
                            </t>
                        </t>

                        <t t-if="enrollment">
                            <t t-call="ems.portal_loading_overlay"/>
                            <t t-if="message_sent">
                                <div class="modal fade" id="ems-message-sent-modal" tabindex="-1" role="dialog">
                                    <div class="modal-dialog modal-dialog-centered" role="document">
                                        <div class="modal-content border-0 shadow-lg">
                                            <div class="modal-header bg-success text-white">
                                                <h5 class="modal-title">
                                                    <i class="fa fa-check-circle me-2"/>Message sent
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"/>
                                            </div>
                                            <div class="modal-body p-4">
                                                <p class="mb-1"><b>Your message has been sent to the secretary's office:</b></p>
                                                <p class="text-muted"><t t-esc="message_sent"/></p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-success" data-bs-dismiss="modal">OK</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <div class="mb-4">
                                <h3 class="mb-1">
                                    Enrollment <strong><span t-field="enrollment.name"/></strong>
                                </h3>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <span class="badge rounded-pill bg-ems-primary fs-6">
                                        <i class="fa fa-graduation-cap me-1"/>
                                        <span t-field="enrollment.ems_level_id.name"/>
                                    </span>
                                    <span class="badge rounded-pill bg-secondary fs-6">
                                        <i class="fa fa-book me-1"/>
                                        <span t-field="enrollment.ems_study_id.name"/>
                                    </span>
                                    <span class="badge rounded-pill bg-info text-dark fs-6">
                                        <i class="fa fa-clock-o me-1"/>
                                        <span t-field="enrollment.shift"/>
                                    </span>
                                    <span class="badge rounded-pill bg-light text-dark border fs-6">
                                        <i class="fa fa-calendar me-1"/>
                                        <span t-field="enrollment.ems_course_id.name"/>
                                    </span>
                                </div>
                            </div>                        
                            <t t-call="ems.portal_authorizations_block">
                                <t t-set="authorizations" t-value="authorizations"/>
                                <t t-set="section_number" t-value="'1'"/>
                            </t>

                            <div class="modal fade" id="modal_help_enrollment" tabindex="-1" role="dialog">
                                <div class="modal-dialog modal-dialog-centered" role="document">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header bg-light">
                                            <h5 class="modal-title">
                                                <i class="fa fa-question-circle me-2 text-ems-primary"/>
                                                Enrollment details - Help
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                                        </div>
                                        <div class="modal-body p-4">
                                            <p>If you agree with the enrollment, confirm it by clicking on the <strong>"Confirm Enrollment"</strong> button.</p>
                                            <p>If, on the other hand, you have any questions about any part of the enrollment, check the box to the right of the line you wish to consult, write your question or comment in the text box below, and click on the button <strong>"Coments for the secretary's office"</strong>. The secretary's office will review your query as soon as possible.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-ems" data-bs-dismiss="modal">OK</button>
                                        </div>
                                    </div>
                                </div>
                            </div>  
                            <div class="modal fade" id="modal_help_communications" tabindex="-1" role="dialog">
                                <div class="modal-dialog modal-dialog-centered" role="document">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header bg-light">
                                            <h5 class="modal-title">
                                                <i class="fa fa-question-circle me-2 text-ems-primary"/>
                                                Communications - Help
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                                        </div>
                                        <div class="modal-body p-4">
                                            <p>In this section, you will always see the history of messages exchanged with the center's secretary regarding your enrollment.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-ems" data-bs-dismiss="modal">OK</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            

                            <form action="/my/gestion-matriculas/confirm" method="post" class="ems-loading-form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="card shadow-sm">
                                    <div class="card-header bg-light">
                                        <h4 class="mb-0 d-flex align-items-center gap-2">
                                            2. Enrollment details
                                            <button type="button" class="btn btn-link p-0 border-0"
                                                    data-bs-toggle="modal" data-bs-target="#modal_help_enrollment">
                                                <i class="fa fa-question-circle fa-2x text-ems-primary"/>
                                            </button>
                                        </h4>
                                    </div>
                                    <div class="card-body p-4">
                                        <table class="table table-sm table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Item</th>
                                                    <th class="text-end">Price</th>
                                                    <th class="text-center" style="width: 80px;">Comment</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="enrollment.order_line" t-as="line">
                                                    <td><span t-field="line.name"/></td>
                                                    <td class="text-end">
                                                        <t t-if="line.price_unit > 0">
                                                            <t t-if="line.discount > 0">
                                                                <span class="text-decoration-line-through text-muted me-1">
                                                                    <t t-esc="'%.2f €' % line.price_unit"/>
                                                                </span>
                                                                <span class="badge bg-success me-1">
                                                                    <t t-esc="'-%d' % line.discount + '%'"/>
                                                                </span>
                                                            </t>
                                                            <span><t t-esc="'%.2f €' % line.price_subtotal"/></span>
                                                        </t>
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="checkbox" class="form-check-input ems-comment-check"
                                                            name="commented_lines" t-att-value="line.id"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>

                                        <!-- Total -->
                                        <div class="row justify-content-end mt-2">
                                            <div class="col-12 col-md-4">
                                                <table class="table table-sm mb-0">
                                                    <tr class="fw-bold">
                                                        <td>Total</td>
                                                        <td class="text-end">
                                                            <t t-esc="'%.2f €' % enrollment.amount_total"/>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- Caja de comentarios, oculta hasta que se marca algún check -->
                                        <div id="ems-comments-block" class="mt-4" style="display:none;">
                                            <label class="form-label fw-bold">Comments</label>
                                            <textarea id="ems-comments" name="comments" class="form-control" rows="4" 
                                                placeholder="Please describe your comments about the marked items..."/>
                                        </div>

                                        <!-- Selector de forma de pago -->
                                        <div class="mt-4 pt-3 border-top">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-credit-card me-2 text-ems-primary"/>
                                                Payment plan
                                            </label>
                                            <div class="d-flex flex-column gap-2 mt-2">
                                                <t t-foreach="payment_terms" t-as="term">
                                                    <div class="form-check">
                                                        <input type="radio"
                                                               class="form-check-input"
                                                               name="payment_term_id"
                                                               t-att-id="'term_' + str(term.id)"
                                                               t-att-value="term.id"
                                                               t-att-checked="'checked' if enrollment.payment_term_id == term else None"
                                                               t-att-data-requires-fees="'1' if term.ems_requires_fees else '0'"
                                                               required="required"/>
                                                        <label class="form-check-label" t-att-for="'term_' + str(term.id)">
                                                            <t t-esc="term.name"/>
                                                        </label>
                                                    </div>
                                                </t>
                                            </div>

                                            <!-- Deferred payment breakdown (shown when a requires-fees term is selected) -->
                                            <div id="ems-installment-breakdown" class="mt-3 p-3 bg-light rounded" style="display:none;">
                                                <p class="mb-2 fw-bold"><i class="fa fa-info-circle me-1 text-ems-primary"/>Payment schedule:</p>
                                                <table class="table table-sm mb-0">
                                                    <tr>
                                                        <td>Payment 1 — 100% enrollment items + 50% fees</td>
                                                        <td class="text-end fw-bold">
                                                            <t t-esc="'%.2f €' % enrollment.ems_first_installment"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Payment 2 — 50% fees</td>
                                                        <td class="text-end fw-bold">
                                                            <t t-esc="'%.2f €' % enrollment.ems_second_installment"/>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- Mètode de pagament: únicament domiciliació -->
                                        <div class="mt-4 pt-3 border-top">
                                            <label class="form-label fw-bold">
                                                <i class="fa fa-bank me-2 text-ems-primary"/>
                                                Payment method
                                            </label>
                                            <div class="d-flex flex-column gap-2 mt-2">
                                                <div class="form-check">
                                                    <input type="radio" class="form-check-input" name="payment_method"
                                                           id="pm_direct_debit" value="direct_debit"
                                                           checked="checked"/>
                                                    <label class="form-check-label" for="pm_direct_debit">
                                                        <i class="fa fa-university me-1"/>Direct debit (bank charge)
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- Detalls domiciliació -->
                                            <div id="pm-direct-debit-details" class="mt-3">
                                                <!-- IBAN vàlid -->
                                                <t t-if="iban_valid">
                                                    <div class="p-3 bg-light rounded">
                                                        <p class="mb-1 fw-bold"><i class="fa fa-check-circle text-success me-1"/>Your bank account on file:</p>
                                                        <p class="mb-1"><strong>IBAN: </strong><t t-esc="iban_doc.doc_value"/></p>
                                                        <t t-if="iban_doc.doc_value2">
                                                            <p class="mb-1"><strong>Account holder: </strong><t t-esc="iban_doc.doc_value2"/></p>
                                                        </t>
                                                        <t t-if="iban_doc.expiry_date">
                                                            <p class="mb-0"><strong>Valid until: </strong>
                                                                <t t-esc="iban_doc.expiry_date" t-options='{"widget": "date"}'/>
                                                            </p>
                                                        </t>
                                                    </div>
                                                </t>
                                                <!-- IBAN caducat -->
                                                <t t-elif="iban_expired">
                                                    <div class="p-3 border border-warning rounded">
                                                        <p class="mb-1 fw-bold text-warning"><i class="fa fa-exclamation-triangle me-1"/>Your bank account has expired:</p>
                                                        <p class="mb-1"><strong>IBAN: </strong><t t-esc="iban_doc.doc_value"/></p>
                                                        <t t-if="iban_doc.doc_value2">
                                                            <p class="mb-1"><strong>Account holder: </strong><t t-esc="iban_doc.doc_value2"/></p>
                                                        </t>
                                                        <p class="mb-2"><strong>Expired: </strong>
                                                            <t t-esc="iban_doc.expiry_date" t-options='{"widget": "date"}'/>
                                                        </p>
                                                        <div class="form-check">
                                                            <input type="checkbox" class="form-check-input" id="confirm_expired_iban" name="confirm_expired_iban" value="1"/>
                                                            <label class="form-check-label" for="confirm_expired_iban">
                                                                I confirm this bank account for the new enrollment and the entire upcoming academic year
                                                            </label>
                                                        </div>
                                                    </div>
                                                </t>
                                                <!-- Sense IBAN -->
                                                <t t-else="">
                                                    <div class="alert alert-warning mb-0">
                                                        <i class="fa fa-exclamation-triangle me-1"/>
                                                        No bank account registered. Please
                                                        <a href="/my/documentacion">submit your IBAN</a> before selecting this option.
                                                    </div>
                                                </t>
                                            </div>

                                            <div class="alert alert-info mt-3 mb-0 small">
                                                <i class="fa fa-info-circle me-1"/>
                                                The payment method is direct debit. If you have difficulties providing a bank account for the payment of the enrollment, please contact the
                                                <a href="https://elpuig.xeill.net/el-centre/secretaria" target="_blank">School Secretary</a>.
                                            </div>
                                        </div>

                                    </div>
                                </div>
                                <t t-if="enrollment.ems_has_fees">
                                    <div class="alert alert-warning mt-4 mb-0">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        <strong>Bonifications and exemptions:</strong>
                                        if you are entitled to a fee bonification or exemption that is not yet reflected in the amounts above,
                                        <a href="/my/documentacion">upload the supporting document</a>
                                        and wait until it is approved <strong>before confirming your enrollment</strong>.
                                        Benefits approved after confirmation will not be applied automatically.
                                    </div>
                                </t>
                                <div class="mt-4 text-center">
                                    <t t-set="pending_required" t-value="enrollment.ems_authorization_ids.filtered(lambda a: a.template_id.is_required and a.status == 'pending')"/>
                                    <t t-set="missing_payment_term" t-value="not enrollment.payment_term_id"/>
                                    <t t-set="blocked" t-value="pending_required or missing_payment_term"/>

                                    <!-- Botón confirmar: visible por defecto, deshabilitado si faltan condiciones -->
                                    <button type="submit" name="action" value="confirm" id="ems-confirm-btn"
                                            t-attf-class="btn btn-ems btn-lg px-5 #{'disabled' if blocked else ''}"
                                            t-att-disabled="'disabled' if blocked else None"
                                            t-att-title="'Please complete all required authorizations first' if pending_required else 'Please select a payment plan' if missing_payment_term else 'Confirm your enrollment'">
                                        Confirm Enrollment
                                    </button>

                                    <!-- Botón comentarios: oculto por defecto, siempre activo cuando se muestra -->
                                    <button type="submit" name="action" value="comment" id="ems-comment-btn"
                                            class="btn btn-outline-secondary btn-lg px-5"
                                            style="display:none;"
                                            title="Send your comments to the secretary's office">
                                        <i class="fa fa-comment me-2"/>Comments for the secretary's office
                                    </button>
                                </div>
                            </form>    

                            <t t-if="enrollment_messages">
                                <div class="card shadow-sm mt-4">
                                    <div class="card-header bg-light">
                                        <h4 class="mb-0 d-flex align-items-center gap-2">
                                            3. Enrollment Communications
                                            <button type="button" class="btn btn-link p-0 border-0"
                                                    data-bs-toggle="modal" data-bs-target="#modal_help_communications">
                                                <i class="fa fa-question-circle fa-2x text-ems-primary"/>
                                            </button>
                                        </h4>
                                    </div>
                                    <div class="card-body p-4">
                                        <t t-foreach="enrollment_messages" t-as="msg">
                                            <div t-attf-class="d-flex mb-3 #{'justify-content-end' if msg.author_id.id in inner_circle_ids else ''}">
                                                <div t-attf-class="card border-0 shadow-sm px-3 py-2 #{'ems-bubble-student' if msg.author_id.id in inner_circle_ids else 'ems-bubble-center'}"
                                                    style="max-width: 75%;">
                                                    <div class="d-flex justify-content-between gap-3 mb-1">
                                                        <small class="fw-bold"><t t-esc="msg.author_id.name"/></small>
                                                        <small class="opacity-75">
                                                            <t t-esc="msg.date" t-options='{"widget": "datetime"}'/>
                                                        </small>
                                                    </div>
                                                    <div t-out="msg.body"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>                            

                            <script>
                                var confirmBtn = document.getElementById('ems-confirm-btn');
                                var commentBtn = document.getElementById('ems-comment-btn');
                                var hasPaymentTerm = <t t-if="enrollment.payment_term_id">true</t><t t-else="">false</t>;
                                var hasPendingRequiredAuths = <t t-if="pending_required">true</t><t t-else="">false</t>;
                                var ibanValid = <t t-if="iban_valid">true</t><t t-else="">false</t>;
                                var ibanExpired = <t t-if="iban_expired">true</t><t t-else="">false</t>;

                                function updateButtons() {
                                    var anyChecked = document.querySelectorAll('.ems-comment-check:checked').length > 0;
                                    var paymentTermSelected = hasPaymentTerm || document.querySelector('input[name="payment_term_id"]:checked');
                                    var paymentMethodSelected = true; // always direct debit

                                    // Para domiciliación: el IBAN caducado requiere el checkbox
                                    var directDebitOk = true;
                                    if (ibanExpired) {
                                        var renewCheckbox = document.getElementById('confirm_expired_iban');
                                        directDebitOk = renewCheckbox &amp;&amp; renewCheckbox.checked;
                                    } else if (!ibanValid) {
                                        directDebitOk = false;
                                    }

                                    // Mostrar solo uno de los dos botones
                                    confirmBtn.style.display = anyChecked ? 'none' : '';
                                    commentBtn.style.display = anyChecked ? '' : 'none';

                                    // Habilitar/deshabilitar el botón de confirmar
                                    var canConfirm = paymentTermSelected &amp;&amp; paymentMethodSelected &amp;&amp; directDebitOk &amp;&amp; !hasPendingRequiredAuths;
                                    confirmBtn.disabled = !canConfirm;
                                    confirmBtn.classList.toggle('disabled', !canConfirm);

                                    // Bloque de comentarios
                                    document.getElementById('ems-comments-block').style.display = anyChecked ? 'block' : 'none';

                                    // required en pago solo aplica cuando se va a confirmar (no comentar)
                                    document.querySelectorAll('input[name="payment_term_id"]').forEach(function(r) {
                                        r.required = !anyChecked;
                                    });
                                }

                                function updateInstallmentBreakdown() {
                                    var selected = document.querySelector('input[name="payment_term_id"]:checked');
                                    var breakdown = document.getElementById('ems-installment-breakdown');
                                    if (breakdown) {
                                        breakdown.style.display = (selected &amp;&amp; selected.getAttribute('data-requires-fees') === '1') ? '' : 'none';
                                    }
                                }

                                document.querySelectorAll('input[name="payment_term_id"]').forEach(function(r) {
                                    r.addEventListener('change', updateButtons);
                                    r.addEventListener('change', updateInstallmentBreakdown);
                                });
                                updateInstallmentBreakdown();
                                document.querySelectorAll('.ems-comment-check').forEach(function(cb) {
                                    cb.addEventListener('change', updateButtons);
                                });
                                var renewCb = document.getElementById('confirm_expired_iban');
                                if (renewCb) { renewCb.addEventListener('change', updateButtons); }

                                // Inicializar estado del botón
                                updateButtons();

                                // Abrir modal de confirmación si hay mensaje enviado
                                var sentModal = document.getElementById('ems-message-sent-modal');
                                if (sentModal) {
                                    var modal = new bootstrap.Modal(sentModal);
                                    modal.show();
                                }
                            </script>                                                       
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>