<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Reached from the other screens that point at a document (a minute's annexes, a process). -->
        <record model="ir.ui.view" id="view_quality_document_form">
            <field name="name">ems.quality.document.form</field>
            <field name="model">ems.quality.document</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="code" placeholder="PE3.01.15"/></h1>
                            <h2><field name="name" placeholder="Document name"/></h2>
                        </div>
                        <group>
                            <field name="procedure_id"/>
                            <field name="process_id"/>
                            <field name="url" widget="url"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
