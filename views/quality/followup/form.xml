<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- The dialog the agreement's "Add follow-up" opens: the responsible people report progress
             from it on an agreement whose content they may only read. -->
        <record model="ir.ui.view" id="view_quality_followup_form">
            <field name="name">ems.quality.followup.form</field>
            <field name="model">ems.quality.followup</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="action_id" readonly="1"/>
                        <field name="date"/>
                        <field name="state"/>
                        <field name="description"/>
                        <field name="author_employee_id" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Save" special="save" class="btn-primary"/>
                        <button string="Discard" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
