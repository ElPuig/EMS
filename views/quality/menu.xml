<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Root menu of the quality management system. Restricted to the posts that actually
             operate it: the staff-facing application (minutes and agreements) is a separate root
             menu created by phase 2, so nobody from the teaching staff sees a half-built app here. -->
        <menuitem name="Quality" sequence="9" id="menu_quality"
                  groups="ems.group_quality,ems.group_quality_admin,ems.group_head_of_studies,ems.group_secretary,ems.group_director"/>

        <!-- First entry, so clicking Quality lands on its first item, the process map. Everything
             in it opens read-only; whoever may change it does so with 'Edit' on the record itself,
             which is why there is no separate configuration menu. -->
        <menuitem name="Documentation" sequence="1" id="menu_quality_documentation" parent="menu_quality"/>
    </data>
</odoo>
