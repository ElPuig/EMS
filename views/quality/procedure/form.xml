<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Read-only until 'Edit' is pressed: see ems.quality.edit.mode. -->
        <record model="ir.ui.view" id="view_quality_procedure_form">
            <field name="name">ems.quality.procedure.form</field>
            <field name="model">ems.quality.procedure</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="edit_mode" widget="ems_quality_edit_mode" invisible="edit_mode or not can_edit"/>
                        <field name="can_edit" invisible="1"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="code" placeholder="PE3.01" readonly="not edit_mode"/></h1>
                            <h2><field name="name" placeholder="Procedure name" readonly="not edit_mode"/></h2>
                        </div>
                        <group>
                            <field name="process_id" readonly="not edit_mode"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <notebook>
                            <page string="Documents" name="documents">
                                <field name="document_ids" readonly="not edit_mode">
                                    <list editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="url" widget="url"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
