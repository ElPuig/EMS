<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_quality_process_form">
            <field name="name">ems.quality.process.form</field>
            <field name="model">ems.quality.process</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="code" placeholder="PE1"/></h1>
                            <h2><field name="name" placeholder="Process name"/></h2>
                        </div>
                        <group>
                            <field name="kind"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <notebook>
                            <page string="Procedures" name="procedures">
                                <field name="procedure_ids">
                                    <list editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Documents" name="documents">
                                <field name="document_ids">
                                    <list editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="procedure_id"/>
                                        <field name="url" widget="url"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
