<odoo>
    <data>
        <record model="ir.ui.view" id="res_config_settings_view_form">
            <field name="name">res.config.settings.view.form.inherit.ems</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="15"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">               
                <xpath expr="//form" position="inside">
                    <app data-string="EMS Management" string="EMS Management" name="ems">
                        <block title="Course Management Settings" name="ems_course_settings">
                            <setting string="Current course" help="Use this field to select the current course, which will be used for volatile data assignation (like the student's enrollments or the teacher's schedules)." id="current_course_id">
                                <field name="current_course_id" />
                                <div class="content-group mt8">
                                    <button name="%(ems.action_course_transition_wizard)d" type="action"
                                            string="Set up the next course" class="btn-link"
                                            icon="fa-arrow-circle-right"
                                            groups="ems.group_academic_admin"/>
                                </div>
                            </setting>
                        </block>

                         <block title="Center Data" name="ems_email_settings">
                            <setting string="Center code" help="Official Departament d'Educació center code, leading zero included (e.g. 08028047). Used by the GEDAC applicant import to keep only the applicants assigned to this center; the comparison ignores the leading zero the Excel drops." id="center_code">
                                <field name="center_code" placeholder="08028047"/>
                            </setting>
                            <setting string="Secretariat" help="Email address used as the recipient for messages addressed to the center's secretariat (e.g. portal personal-data change requests)." id="secretariat_email">
                                <field name="secretariat_email" widget="email" placeholder="secretaria@example.com"/>
                            </setting>
                        </block>

                         <block title="Student's Attendance Settings" name="ems_attendance_settings">
                            <setting string="Issue notification delay" help="Some attendance statuses (like miss or issue) will be notified (if not adult or authorized) to their families almost inmediatly. This setting setups how many delay is wanted between the assistance creation and its notification." id="attendance_issue_status_delay">
                                <field name="attendance_issue_status_delay" class="text-center" style="width: 5ch;"/>
                                <span class="ms-2">minutes</span>
                            </setting>

                            <setting string="Tutor's attendance report default send time" help="The tutors will receive a daily attendance report at the end of their work tourn but, it its not defined, this time will be used to send the report." id="attendance_issue_tutor_default">
                                <field name="attendance_issue_tutor_default" widget="float_time" />
                            </setting>



                        </block>

                         <block title="Strikes Settings" name="ems_strike_settings">
                            <setting string="Coexistence escalation threshold" help="Every time a student's cumulative strike count reaches a multiple of this number, the matching coexistence coordinator(s) are notified by email (in addition to the usual student/family/tutor notification sent on every strike)." id="strike_escalation_threshold">
                                <field name="strike_escalation_threshold" class="text-center" style="width: 5ch;"/>
                            </setting>
                        </block>

                         <block title="LimeSurvey Settings" name="ems_limesurvey_settings">                          
                            <setting string="LimeSurvey's API endpoint" help="API endpoint (host address) where the LimeSurvey server is listening." id="limesurvey_api">
                                <field name="limesurvey_api" />                              
                            </setting>

                            <setting string="LimeSurvey's username" help="User's name to log in the LimeSurvey server." id="limesurvey_usr">
                                <field name="limesurvey_usr" />                              
                            </setting>

                            <setting string="LimeSurvey's password" help="User's password to log in the LimeSurvey server." id="limesurvey_pwd">
                                <field name="limesurvey_pwd" password="True" />                              
                            </setting>

                            <setting string="Survey's group ID" help="The LimeSurvey API does not allow to create survey groups so, in order to operate properly, a group must be created and its ID provided." id="limesurvey_gid">
                                <field name="limesurvey_gid" />
                            </setting>
                        </block>

                        <block title="Google Workspace Settings" name="ems_google_ws_settings">
                            <setting string="Enable Google Workspace" help="If enabled, a Google Workspace account will be created automatically for each new student." id="google_ws_enabled">
                                <field name="google_ws_enabled"/>
                            </setting>

                            <setting string="Dry-run mode" help="If enabled, the account creation is only logged (no real call to the Google API). Useful for testing." id="google_ws_dry_run">
                                <field name="google_ws_dry_run"/>
                            </setting>

                            <setting string="Workspace domain" help="Corporate domain for student accounts (e.g. elpuig.xeill.net)." id="google_ws_domain">
                                <field name="google_ws_domain"/>
                            </setting>

                            <setting string="OU for minors" help="Organizational Unit path where under-18 students are created." id="google_ws_ou_minor">
                                <field name="google_ws_ou_minor"/>
                            </setting>

                            <setting string="OU for adults (18+)" help="Organizational Unit path where students aged 18 or older are created." id="google_ws_ou_adult">
                                <field name="google_ws_ou_adult"/>
                            </setting>

                            <setting string="OU for suspended students" help="Organizational Unit path where suspended (former) students are moved. Must be inside the students OU so the service account can manage it." id="google_ws_ou_suspended">
                                <field name="google_ws_ou_suspended"/>
                            </setting>

                            <setting string="OU for teachers" help="Organizational Unit path where teacher accounts are created." id="google_ws_ou_teacher">
                                <field name="google_ws_ou_teacher"/>
                            </setting>

                            <setting string="OU for ASP" help="Organizational Unit path where Administrative and Services Personnel accounts are created." id="google_ws_ou_asp">
                                <field name="google_ws_ou_asp"/>
                            </setting>

                            <setting string="OU for suspended staff" help="Organizational Unit path where suspended (former) staff accounts are moved. Must be manageable by the service account role." id="google_ws_ou_staff_suspended">
                                <field name="google_ws_ou_staff_suspended"/>
                            </setting>

                            <setting string="Service Account JSON" help="Paste here the full JSON key of the Google Cloud service account. It is stored encrypted. The service account must have a custom admin role scoped to the managed OUs (students and staff)." id="google_ws_sa_json">
                                <field name="google_ws_sa_json" widget="text" placeholder='{ "type": "service_account", ... }'/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>