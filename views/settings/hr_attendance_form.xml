<odoo>
    <data>
        <record model="ir.ui.view" id="res_config_settings_view_form_hr_attendance_ems">
            <field name="name">res.config.settings.view.form.inherit.hr.attendance.ems</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Auto check-in mode for teachers: separate setting in the Modes block -->
                <xpath expr="//field[@name='absence_management']/ancestor::setting" position="before">
                    <setting string="Auto Check-In Mode for Teachers (EMS)" company_dependent="1" help="Controls how the check-in time is determined when a teacher creates a passing list and they haven't checked in yet today. Disabled: feature off. First: teacher's first scheduled working hour (resource calendar). Start: start time of the attendance schedule used in the session. Current: current clock time.">
                        <field name="auto_checkin_mode" class="w-50"/>
                    </setting>
                </xpath>

                <!-- Replace the tolerance div with our mode selector + conditional fields -->
                <xpath expr="//field[@name='auto_check_out']/following-sibling::div" position="replace">
                    <div invisible="not auto_check_out">
                        <field name="auto_checkout_mode" class="w-50"/>
                        <div invisible="auto_checkout_mode != 'native'">
                            <span class="me-2">Tolerance</span>
                            <field name="auto_check_out_tolerance" class="text-center" style="width: 5ch;"/>
                            <span class="ms-2">Hours</span>
                        </div>
                        <div invisible="auto_checkout_mode != 'ems'">
                            <span class="me-2">Check-out at</span>
                            <field name="auto_checkout_time" widget="float_time" class="text-center" style="width: 5ch;"/>
                            <span class="ms-4 me-2">Retry until</span>
                            <field name="auto_checkout_retry_until" widget="float_time" class="text-center" style="width: 5ch;"/>
                            <div class="text-muted mt-1">
                                This only resolves attendances left open from previous days, never for the current day.
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
