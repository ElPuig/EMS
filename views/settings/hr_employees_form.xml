<odoo>
    <data>
        <record model="ir.ui.view" id="res_config_settings_view_form_hr_employees_ems">
            <field name="name">res.config.settings.view.form.inherit.hr.employees.ems</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='work_organization_setting_container']" position="inside">
                    <setting string="Default first entry time"
                             help="Default start time used when no first entry is defined for a teacher's schedule import."
                             id="schedule_import_first_entry_time">
                        <field name="schedule_import_first_entry_time" widget="float_time"/>
                    </setting>
                    <setting string="Default last entry time"
                             help="End time assigned to the last block of the day when importing a teacher's working schedule."
                             id="schedule_import_last_entry_time">
                        <field name="schedule_import_last_entry_time" widget="float_time"/>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
