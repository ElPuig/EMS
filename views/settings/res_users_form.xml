<odoo>
    <data>
        <record model="ir.ui.view" id="view_users_form_ems">
            <field name="name">res.users.view.form.inherit.ems</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']/group[field[@name='company_ids']]" position="after">
                    <div class="alert alert-info" role="alert">
                        Some permissions below appear blank because they are managed through the EMS
                        categories instead. Enable the debug mode to view or edit them manually.
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
